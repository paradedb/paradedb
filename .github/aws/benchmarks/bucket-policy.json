{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicBenchmarkDownloads",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::paradedb-benchmark/datasets/*",
        "arn:aws:s3:::paradedb-benchmark/benchmarker/*",
        "arn:aws:s3:::paradedb-benchmark/snapshots/*"
      ]
    },
    {
      "Sid": "PublicBenchmarkListings",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::paradedb-benchmark",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "datasets",
            "datasets/*",
            "benchmarker",
            "benchmarker/*",
            "snapshots",
            "snapshots/*"
          ]
        }
      }
    },
    {
      "Sid": "DenyAnonymousWrites",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::paradedb-benchmark/*",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalAccount": "anonymous"
        }
      }
    },
    {
      "Sid": "RequireTLS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::paradedb-benchmark",
        "arn:aws:s3:::paradedb-benchmark/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
