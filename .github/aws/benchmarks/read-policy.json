{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LocateBenchmarkBuckets",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": [
        "arn:aws:s3:::paradedb-benchmark"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "858265286872"
        }
      }
    },
    {
      "Sid": "ListDatasetAndSnapshotPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::paradedb-benchmark"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "datasets",
            "datasets/*",
            "snapshots",
            "snapshots/*",
            "benchmarker",
            "benchmarker/*"
          ]
        },
        "StringEquals": {
          "s3:ResourceAccount": "858265286872"
        }
      }
    },
    {
      "Sid": "ReadDatasetsAndSnapshots",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::paradedb-benchmark/datasets/*",
        "arn:aws:s3:::paradedb-benchmark/snapshots/*",
        "arn:aws:s3:::paradedb-benchmark/benchmarker/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "858265286872"
        }
      }
    }
  ]
}
