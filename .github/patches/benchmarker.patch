diff --git a/benchmarks/Makefile.common b/benchmarks/Makefile.common
index 3e1e7c5..28cae63 100644
--- a/benchmarks/Makefile.common
+++ b/benchmarks/Makefile.common
@@ -40,7 +40,7 @@ CPUS ?= 8
 # Explicit MEMORY overrides apply to every target; only create defaults to 64g.
 ifeq ($(origin MEMORY),undefined)
 MEMORY := 32g
-create _create_backend: MEMORY := 64g
+create _create_backend index _index_backend: MEMORY := 64g
 endif
 SHARED_BUFFERS ?= 24GB
 MAINTENANCE_WORK_MEM ?= 24GB
@@ -49,8 +49,16 @@ MAX_PARALLEL_WORKERS ?= 8
 POSTGRES_SHM_SIZE ?= 16g
 WORKERS ?= 1
 BATCH_SIZE ?= 10000
+# Override to test a custom ParadeDB image (e.g. source build in CI); defaults BUILD=0.
+PARADEDB_IMAGE ?=
+ifdef PARADEDB_IMAGE
+BUILD ?= 0
+else
 BUILD ?= 1
+endif
 RECREATE ?= 0
+# Set to 1 to halt create after loading table data, skipping index creation (used for heap snapshots).
+LOAD_ONLY ?= 0
 OUTPUT ?= live
 OUT_DIR ?= $(REPO_ROOT)/out/$(DATASET)-$(WORKLOAD)-$(QUERY_STYLE)
 LOADER := $(REPO_ROOT)/bin/loader
@@ -62,19 +70,20 @@ export DATA_GZ DATA_CSV CHECKSUMS QUERIES WORKLOAD QUERY_STYLE BACKENDS
 export VUS DURATION PREWARM COOLDOWN SEED TOP_K CPUS MEMORY SHARED_BUFFERS POSTGRES_SHM_SIZE
 export UPDATES_PER_SECOND
 export MAINTENANCE_WORK_MEM MAX_PARALLEL_MAINTENANCE_WORKERS MAX_PARALLEL_WORKERS
-export PARADEDB_PORT POSTGRES_PORT PG_TEXTSEARCH_PORT ELASTICSEARCH_PORT
-export WORKERS BATCH_SIZE BUILD RECREATE OUTPUT OUT_DIR LOADER K6
+export PARADEDB_PORT POSTGRES_PORT PG_TEXTSEARCH_PORT ELASTICSEARCH_PORT PARADEDB_IMAGE
+export WORKERS BATCH_SIZE BUILD RECREATE LOAD_ONLY OUTPUT OUT_DIR LOADER K6

 COMPOSE = docker compose --project-name "$$COMPOSE_PROJECT" --file "$$CONFIG_DIR/compose.yml"
 ifneq ($(strip $(VOLUME_ROOT)),)
 COMPOSE += --file "$$CONFIG_DIR/compose.volumes.yml"
 endif

-.PHONY: help create copy run clean data validate validate-run _create_backend stop
+.PHONY: help create copy index run clean data validate validate-run _create_backend _index_backend stop

 help:
 	@printf '%s\n' \
 	  'make -f Makefile.$(DATASET) create [BACKENDS=paradedb,pg_textsearch,postgres,elasticsearch]' \
+	  'make -f Makefile.$(DATASET) index [BACKENDS=paradedb,pg_textsearch,postgres,elasticsearch]' \
 	  'make -f Makefile.$(DATASET) run WORKLOAD=topk QUERY_STYLE=disjunction BACKENDS=paradedb,postgres' \
 	  'make -f Makefile.$(DATASET) copy BACKENDS=paradedb TARGET_VOLUME_ROOT=/tin/benchmarker' \
 	  '' \
@@ -98,6 +107,8 @@ help:
 	  'Leave VOLUME_ROOT unset for Docker default storage; use the same value for create/run/clean.' \
 	  'copy reads VOLUME_ROOT (default: Docker storage) and requires TARGET_VOLUME_ROOT.' \
 	  'copy preserves completed data/indexes; run the copy by setting VOLUME_ROOT to its target.' \
+	  'index builds indexes against existing/restored data volumes without requiring CSV parts.' \
+	  'LOAD_ONLY=1 halts create after loading table data, skipping index creation.' \
 	  'clean [BACKENDS=<names>] drops benchmark tables/indexes and clears their setup markers.' \
 	  'data streams data.csv.gz.part0000, part0001, ... through gzip into data.csv.' \
 	  'DATA_GZ=<archive-prefix> also accepts a single gzip file for local fixtures.' \
@@ -109,7 +120,7 @@ validate:
 	  command -v "$$dependency" >/dev/null || { echo "Missing dependency: $$dependency" >&2; exit 1; }
 	done
 	[[ "$$PROJECT" =~ ^[a-z0-9][a-z0-9_-]*$$ ]] || { echo 'Invalid PROJECT name' >&2; exit 1; }
-	[[ "$$BUILD" =~ ^[01]$$ && "$$RECREATE" =~ ^[01]$$ ]] || { echo 'BUILD and RECREATE must be 0 or 1' >&2; exit 1; }
+	[[ "$$BUILD" =~ ^[01]$$ && "$$RECREATE" =~ ^[01]$$ && "$$LOAD_ONLY" =~ ^[01]$$ ]] || { echo 'BUILD, RECREATE, and LOAD_ONLY must be 0 or 1' >&2; exit 1; }
 	backends=($${BACKENDS//,/ })
 	(($${#backends[@]} > 0)) || { echo 'BACKENDS must not be empty' >&2; exit 1; }
 	declare -A seen=()
@@ -272,6 +283,11 @@ _create_backend:
 	    else
 	      echo "$$backend: CSV load already complete; resuming index creation"
 	    fi
+	    # When LOAD_ONLY=1 is set, exit before running post.sql to leave the unindexed heap clean (for snapshots).
+	    if [[ "$$LOAD_ONLY" == 1 ]]; then
+	      echo "$$backend: LOAD_ONLY requested; skipping index creation"
+	      exit 0
+	    fi
 	    echo "$$backend: creating index and gathering statistics"
 	    $(COMPOSE) exec -T "$$backend" psql -X -U postgres -d benchmark -v ON_ERROR_STOP=1 < "$$CONFIG_DIR/$$backend/post.sql"
 	  fi
@@ -279,6 +295,56 @@ _create_backend:
 	  echo "$$backend: complete"
 	} 2>&1 | tee "$$log"

+# index builds backend indexes against an existing/restored data volume without requiring
+# the source CSV files. For paradedb, it drops and recreates the extension to pick up unreleased
+# catalog definitions from the container image.
+index: validate
+	@source "$$CONFIG_DIR/volumes.sh"
+	mkdir -p "$$STORAGE_STATE_DIR/logs"
+	exec 9>"$$STATE_DIR/lock"
+	flock -n 9 || { echo "Another create/index/run is using $$PROJECT" >&2; exit 1; }
+	check_volume_configuration
+	prepare_volume_directories
+	backends=($${BACKENDS//,/ })
+	stop_other_storage_containers "$${backends[@]}"
+	if [[ "$$BUILD" == 1 ]]; then
+	  for backend in "$${backends[@]}"; do
+	    case "$$backend" in paradedb|pg_textsearch) $(COMPOSE) build "$$backend";; esac
+	  done
+	fi
+	$(COMPOSE) stop
+	for backend in "$${backends[@]}"; do
+	  $(MAKE) --no-print-directory -f "$$THIS_MAKEFILE" _index_backend BACKEND="$$backend"
+	done
+	echo "Indexing complete. Logs and stage records: $$STORAGE_STATE_DIR"
+
+_index_backend:
+	@source "$$CONFIG_DIR/volumes.sh"
+	backend='$(BACKEND)'
+	case "$$backend" in paradedb|pg_textsearch|postgres|elasticsearch) ;; *) exit 1;; esac
+	check_volume_configuration
+	state="$$STORAGE_STATE_DIR/$$backend"
+	log="$$STORAGE_STATE_DIR/logs/$$(date -u +%Y%m%dT%H%M%S)-$$backend-index.log"
+	{
+	  trap 'rc=$$?; if [[ $$rc -ne 0 ]]; then echo "$$backend: abnormal exit (code $$rc); dumping logs:"; $(COMPOSE) logs --tail 200 "$$backend" || true; fi; $(COMPOSE) stop -t 10 "$$backend" || $(COMPOSE) kill "$$backend"' EXIT
+	  trap 'exit 130' INT
+	  trap 'exit 143' TERM
+	  echo "$$backend: starting for indexing (log: $$log)"
+	  prepare_volume_directories
+	  $(COMPOSE) up -d --wait --wait-timeout 300 --no-build "$$backend"
+	  if [[ "$$backend" == paradedb ]]; then
+	    echo "$$backend: refreshing pg_search extension"
+	    $(COMPOSE) exec -T "$$backend" psql -X -U postgres -d benchmark -v ON_ERROR_STOP=1 \
+	      -c "DROP EXTENSION IF EXISTS pg_search CASCADE; CREATE EXTENSION pg_search CASCADE;"
+	  fi
+	  if [[ -f "$$CONFIG_DIR/$$backend/post.sql" ]]; then
+	    echo "$$backend: creating index and gathering statistics"
+	    $(COMPOSE) exec -T "$$backend" psql -X -U postgres -d benchmark -v ON_ERROR_STOP=1 < "$$CONFIG_DIR/$$backend/post.sql"
+	  fi
+	  date -u +%Y%m%dT%H%M%SZ > "$$state.done"
+	  echo "$$backend: complete"
+	} 2>&1 | tee "$$log"
+
 run: validate-run $(K6)
 	@source "$$CONFIG_DIR/volumes.sh"
 	mkdir -p "$$STORAGE_STATE_DIR" "$$OUT_DIR"
