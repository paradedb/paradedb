# syntax=docker/dockerfile:1
#
# docker/Dockerfile.source
#
# Full, runnable ParadeDB image built from THIS repo's source, for the
# benchmarker and source-image publishing workflows.
#
# Unlike Dockerfile.paradedb-18 (which downloads a *released* pg_search .deb),
# this overlays a pg_search that was compiled from the working tree onto a
# released ParadeDB image. Dockerfile.source-build compiles against the same
# base image so the extension does not depend on newer runner system libraries.
# This Dockerfile just swaps in the result.
# Everything else (Postgres, tuning, bootstrap, other extensions) matches the
# published image, so only pg_search differs from the release.
#
# Build context must contain the exported `artifacts/usr/` tree.
# Pass the same BASE_IMAGE to both Dockerfiles to pick the release.

ARG BASE_IMAGE=paradedb/paradedb:latest-pg18
FROM ${BASE_IMAGE}

# Remove the released extension before installing the source build so old SQL
# scripts cannot survive the overlay. CREATE EXTENSION then uses only the source
# build. Runtime dependencies are supplied by the released base image.
RUN rm -f /usr/lib/postgresql/18/lib/pg_search*.so \
    /usr/share/postgresql/18/extension/pg_search*.control \
    /usr/share/postgresql/18/extension/pg_search*.sql
COPY artifacts/usr/ /usr/

# initdb loads the preloaded extensions, catching missing libraries or symbol
# versions before a benchmark downloads its dataset or Cloud publishes an image.
RUN gosu postgres initdb --no-sync --auth=trust -D /tmp/pg-search-smoke && \
    rm -rf /tmp/pg-search-smoke
