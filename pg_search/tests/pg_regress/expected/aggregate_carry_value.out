\echo 'Test 4: a real MAX(title) compares strings, so title is decoded below the aggregate'
Test 4: a real MAX(title) compares strings, so title is decoded below the aggregate
EXPLAIN (COSTS OFF, TIMING OFF)
SELECT p.rank, MAX(p.title) AS last_title, COUNT(*)
FROM acv_posts p JOIN acv_comments c ON p.id = c.post_id
WHERE p.body ||| 'code'
GROUP BY p.rank
ORDER BY p.rank;
                                                                                                                              QUERY PLAN                                                                                                                              
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: p.rank
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Backend: DataFusion
         Indexes: acv_posts_idx (p), acv_comments_idx (c)
         Group By: rank
         Aggregates: MAX(title), COUNT(*)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Single, gby=[rank@0 as rank], aggr=[max(p_0.title) as agg_0, count(1) as agg_1]
           :   HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@2, post_id@0)], projection=[rank@0, title@1]
           :     CooperativeExec
           :       PgSearchScan: table=p, segments=3, eager=[title], visibility=eager, query={"with_index":{"query":{"match":{"field":"body","value":"code","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
           :     CooperativeExec
           :       PgSearchScan: table=c, segments=1, dynamic_filters=1, visibility=eager, query="all"
(14 rows)

SELECT p.rank, MAX(p.title) AS last_title, COUNT(*)
FROM acv_posts p JOIN acv_comments c ON p.id = c.post_id
WHERE p.body ||| 'code'
GROUP BY p.rank
ORDER BY p.rank;
 rank | last_title | count 
------+------------+-------
    0 | title 3    |    24
    1 | title 3    |    28
    2 | title 3    |    28
(3 rows)

\echo 'Test 5: GROUP BY title without the pk: posts with the same title share a group'
Test 5: GROUP BY title without the pk: posts with the same title share a group
SELECT p.title, COUNT(DISTINCT p.id) AS posts, COUNT(*) AS comments
FROM acv_posts p JOIN acv_comments c ON p.id = c.post_id
WHERE p.body ||| 'code'
GROUP BY p.title
ORDER BY p.title NULLS LAST;
  title  | posts | comments 
---------+-------+----------
 title 0 |     4 |       16
 title 1 |     4 |       16
 title 2 |     4 |       16
 title 3 |     4 |       16
         |     4 |       16
(5 rows)

\echo 'Test 6: a non-string dependent column stays a group key'
Test 6: a non-string dependent column stays a group key
EXPLAIN (COSTS OFF, TIMING OFF)
SELECT p.id, p.rank, COUNT(*) AS n
FROM acv_posts p JOIN acv_comments c ON p.id = c.post_id
WHERE p.body ||| 'code'
GROUP BY p.id, p.rank
ORDER BY n DESC, p.id
LIMIT 3;
                                                                                                                       QUERY PLAN                                                                                                                        
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Backend: DataFusion
         Indexes: acv_posts_idx (p), acv_comments_idx (c)
         Group By: id, rank
         Aggregates: COUNT(*)
         DataFusion Physical Plan: 
           : SortExec: TopK(fetch=3), expr=[agg_0@2 DESC, id@0 ASC NULLS LAST], preserve_partitioning=[false]
           :   AggregateExec: mode=Single, gby=[id@0 as id, rank@1 as rank], aggr=[count(1) as agg_0]
           :     HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, post_id@0)], projection=[id@0, rank@1]
           :       CooperativeExec
           :         PgSearchScan: table=p, segments=3, visibility=eager, query={"with_index":{"query":{"match":{"field":"body","value":"code","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
           :       CooperativeExec
           :         PgSearchScan: table=c, segments=1, dynamic_filters=1, visibility=eager, query="all"
(14 rows)

\echo 'Test 7: ORDER BY the carried title'
Test 7: ORDER BY the carried title
SELECT p.id, p.title, MAX(c.score) AS best
FROM acv_posts p JOIN acv_comments c ON p.id = c.post_id
WHERE p.body ||| 'code'
GROUP BY p.id, p.title
ORDER BY p.title DESC NULLS LAST, p.id
LIMIT 6;
