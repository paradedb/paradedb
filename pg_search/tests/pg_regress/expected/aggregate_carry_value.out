-- A string column that the group keys decide (they hold its table's primary key)
-- is carried through the aggregate with `pdb_carry_value` instead of being a
-- group key. It stays deferred through the join and the aggregate, and is
-- decoded above the Top K, for the output rows only.
CREATE EXTENSION IF NOT EXISTS pg_search;
SET paradedb.enable_aggregate_custom_scan TO on;
SET paradedb.enable_join_custom_scan TO on;
SET max_parallel_workers_per_gather TO 0;
CREATE TABLE acv_posts (
    id SERIAL PRIMARY KEY,
    body TEXT,
    title TEXT,
    rank INT
);
CREATE TABLE acv_comments (
    id SERIAL PRIMARY KEY,
    post_id INTEGER,
    score INT
);
CREATE INDEX acv_posts_idx ON acv_posts
USING paradedb (id, body, (title::pdb.literal), rank);
CREATE INDEX acv_comments_idx ON acv_comments
USING paradedb (id, post_id, score);
-- Three inserts give three segments. The same title shows up in more than one
-- segment and on more than one post, and some posts have no title.
SET paradedb.global_mutable_segment_rows = 0;
INSERT INTO acv_posts (body, title, rank)
SELECT 'code sample ' || i,
       CASE WHEN i % 5 = 0 THEN NULL ELSE 'title ' || (i % 4) END,
       i % 3
FROM generate_series(1, 10) AS i;
INSERT INTO acv_posts (body, title, rank)
SELECT 'code sample ' || i,
       CASE WHEN i % 5 = 0 THEN NULL ELSE 'title ' || (i % 4) END,
       i % 3
FROM generate_series(11, 20) AS i;
INSERT INTO acv_posts (body, title, rank)
SELECT 'other text ' || i, 'title ' || (i % 4), i % 3
FROM generate_series(21, 25) AS i;
RESET paradedb.global_mutable_segment_rows;
INSERT INTO acv_comments (post_id, score)
SELECT 1 + (i % 25), i
FROM generate_series(1, 100) AS i;
\echo 'Test 1: GROUP BY pk, title: title is carried, and decoded above the Top K'
Test 1: GROUP BY pk, title: title is carried, and decoded above the Top K
EXPLAIN (COSTS OFF, TIMING OFF)
SELECT p.id, p.title, MAX(c.score) AS best
FROM acv_posts p JOIN acv_comments c ON p.id = c.post_id
WHERE p.body ||| 'code'
GROUP BY p.id, p.title
ORDER BY best DESC, p.id
LIMIT 5;
                                                                                                                                QUERY PLAN                                                                                                                                
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Backend: DataFusion
         Indexes: acv_posts_idx (p), acv_comments_idx (c)
         Group By: id
         Aggregates: MAX(score)
         DataFusion Physical Plan: 
           : TantivyDecodeExec: decode=[title]
           :   SortExec: TopK(fetch=5), expr=[agg_0@1 DESC, id@0 ASC NULLS LAST], preserve_partitioning=[false]
           :     AggregateExec: mode=Single, gby=[id@0 as id], aggr=[max(c_1.score) as agg_0, pdb_carry_value(p_0.title) as row_1]
           :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, post_id@1)], projection=[id@0, title@1, score@2]
           :         CooperativeExec
           :           PgSearchScan: table=p, segments=3, fetch=[title], visibility=eager, query={"with_index":{"query":{"match":{"field":"body","value":"code","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
           :         CooperativeExec
           :           PgSearchScan: table=c, segments=1, dynamic_filters=1, visibility=eager, query="all"
(15 rows)

SELECT p.id, p.title, MAX(c.score) AS best
FROM acv_posts p JOIN acv_comments c ON p.id = c.post_id
WHERE p.body ||| 'code'
GROUP BY p.id, p.title
ORDER BY best DESC, p.id
LIMIT 5;
 id |  title  | best 
----+---------+------
  1 | title 1 |  100
 20 |         |   94
 19 | title 3 |   93
 18 | title 2 |   92
 17 | title 1 |   91
(5 rows)

\echo 'Test 2: GROUP BY pk only, title in the output'
Test 2: GROUP BY pk only, title in the output
SELECT p.id, p.title, COUNT(*) AS n
FROM acv_posts p JOIN acv_comments c ON p.id = c.post_id
WHERE p.body ||| 'code'
GROUP BY p.id
ORDER BY n DESC, p.id
LIMIT 5;
 id |  title  | n 
----+---------+---
  1 | title 1 | 4
  2 | title 2 | 4
  3 | title 3 | 4
  4 | title 0 | 4
  5 |         | 4
(5 rows)

