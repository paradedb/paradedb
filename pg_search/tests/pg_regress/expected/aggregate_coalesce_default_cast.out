-- Still pushed down: a non-negative integer default on a JSON path.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT AVG(COALESCE((metadata->>'score')::double precision, 2)) FROM cdc_json_int WHERE id @@@ pdb.all();
                                    QUERY PLAN                                    
----------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan) on public.cdc_json_int
   Output: pdb.agg_fn('AVG'::text)
   Index: cdc_json_int_idx
   Tantivy Query: {"with_index":{"query":{"all":{"field":"id"}}}}
     Applies to Aggregates: AVG(metadata.score)
     Aggregate Definition: {"0":{"avg":{"field":"metadata.score","missing":2.0}}}
(6 rows)

SELECT AVG(COALESCE((metadata->>'score')::double precision, 2)) FROM cdc_json_int WHERE id @@@ pdb.all();
 avg 
-----
