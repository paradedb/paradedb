   Output: pdb.agg_fn('COUNT'::text)
   Index: cfd_int_idx
   Tantivy Query: {"with_index":{"query":{"all":{"field":"id"}}}}
     Applies to Aggregates: COUNT(n)
     Aggregate Definition: {"0":{"value_count":{"field":"n","missing":1.5}}}
(6 rows)

SELECT COUNT(COALESCE(n, 1.5)) FROM cfd_int WHERE id @@@ pdb.all();
 count 
-------
