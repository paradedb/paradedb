-- Still pushed down: a fractional default on a float column.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT AVG(COALESCE(x, 1.5)) FROM cfd_float WHERE id @@@ pdb.all();
                             QUERY PLAN                              
---------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan) on public.cfd_float
   Output: pdb.agg_fn('AVG'::text)
   Index: cfd_float_idx
   Tantivy Query: {"with_index":{"query":{"all":{"field":"id"}}}}
     Applies to Aggregates: AVG(x)
     Aggregate Definition: {"0":{"avg":{"field":"x","missing":1.5}}}
(6 rows)

SELECT AVG(COALESCE(x, 1.5)) FROM cfd_float WHERE id @@@ pdb.all();
 avg  
------
 2.75
(1 row)

-- Still pushed down: an integer default on an integer column.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT AVG(COALESCE(n, 2)) FROM cfd_int WHERE id @@@ pdb.all();
