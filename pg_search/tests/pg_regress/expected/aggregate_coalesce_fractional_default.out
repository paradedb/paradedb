SET paradedb.enable_aggregate_custom_scan TO false;
SELECT AVG(COALESCE(n, 1.5)), SUM(COALESCE(n, 1.5)) FROM cfd_int WHERE id @@@ pdb.all();
        avg         | sum 
--------------------+-----
