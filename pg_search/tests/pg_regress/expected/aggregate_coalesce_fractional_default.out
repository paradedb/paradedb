DROP TABLE cfd_json_none;
DROP TABLE cfd_json_int;
DROP TABLE cfd_float;
DROP TABLE cfd_int;
RESET paradedb.enable_aggregate_custom_scan;
RESET max_parallel_workers_per_gather;
