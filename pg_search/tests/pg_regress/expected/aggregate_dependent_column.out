SET plan_cache_mode TO force_generic_plan;
PREPARE dependent_col_by_id(int) AS
SELECT id, kind, created, COUNT(*)
FROM dependent_col_items
WHERE id = $1 AND id @@@ paradedb.all()
GROUP BY id;
EXECUTE dependent_col_by_id(3);
