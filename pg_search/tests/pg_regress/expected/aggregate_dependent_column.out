----+------+------------+-------
  3 | d    | 01-04-2024 |     1
(1 row)

EXECUTE dependent_col_by_id(4);
 id | kind | created | count 
----+------+---------+-------
  4 | a    |         |     1
(1 row)

EXECUTE dependent_col_by_id(999);
 id | kind | created | count 
----+------+---------+-------
(0 rows)

DEALLOCATE dependent_col_by_id;
RESET plan_cache_mode;
