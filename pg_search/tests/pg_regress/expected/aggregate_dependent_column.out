\echo 'Test 16: a window over an expression of a DATE() key reads the timestamp from a row'
Test 16: a window over an expression of a DATE() key reads the timestamp from a row
CREATE TABLE dependent_col_days (id INT PRIMARY KEY, ts TIMESTAMP);
INSERT INTO dependent_col_days
SELECT g, TIMESTAMP '2024-01-01 00:00' + (g * INTERVAL '7 hours') FROM generate_series(1, 30) g;
CREATE INDEX dependent_col_days_idx ON dependent_col_days USING paradedb (id, ts);
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT date(ts)::text AS d, COUNT(*) AS n, SUM(COUNT(*)) OVER () AS total
FROM dependent_col_days
WHERE id @@@ paradedb.all()
GROUP BY date(ts)
ORDER BY 1;
                                                                                                                            QUERY PLAN                                                                                                                            
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: (((date(ts)))::text), (count(*)), (sum((count(*))) OVER w1), (date(ts))
   Sort Key: (((date(dependent_col_days.ts)))::text)
   ->  WindowAgg
         Output: ((date(ts)))::text, (count(*)), sum((count(*))) OVER w1, (date(ts))
         Window: w1 AS ()
         ->  Custom Scan (ParadeDB Aggregate Scan)
               Output: (date(ts)), ts, (count(*))
               Backend: DataFusion
               Indexes: dependent_col_days_idx (dependent_col_days)
               Group By: date(ts)
               Aggregates: COUNT(*)
               DataFusion Physical Plan: 
                 : AggregateExec: mode=Single, gby=[pdb_timestamp_to_date(ts@1) as pdb_timestamp_to_date(dependent_col_days_0.ts)], aggr=[count(1) as agg_0, first_value(dependent_col_days_0.ts) ORDER BY [dependent_col_days_0.ctid_0 ASC NULLS LAST] as row_1]
                 :   ProjectionExec: expr=[ctid@0 as ctid_0, ts@1 as ts]
                 :     CooperativeExec
                 :       PgSearchScan: table=dependent_col_days, segments=1, visibility=eager, query={"with_index":{"query":"all"}}
(17 rows)

