-- Preserve NULL keys, nested paths, missing filtered groups, and output ordering.
\i common/common_setup.sql
CREATE EXTENSION IF NOT EXISTS pg_search;
-- Disable parallel workers to avoid differences in plans
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan to OFF;
SET paradedb.enable_columnar_exec = true;
SET paradedb.enable_aggregate_custom_scan TO on;
CREATE TABLE flatten_paths (id int, a int, b int, value int);
INSERT INTO flatten_paths VALUES
 (1, NULL, NULL, 2), (2, NULL, 1, 3), (3, 1, NULL, 4),
 (4, 1, 1, 5), (5, 1, 1, 6), (6, 2, 2, 7);
CREATE INDEX flatten_paths_idx ON flatten_paths USING paradedb (id, a, b, value);
EXPLAIN (COSTS OFF)
SELECT a, b, count(*), sum(value) FROM flatten_paths
WHERE id @@@ pdb.all() GROUP BY a, b ORDER BY a, b;
                                                                                                                                                QUERY PLAN                                                                                                                                                
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan) on flatten_paths
   Index: flatten_paths_idx
   Tantivy Query: {"with_index":{"query":{"all":{"field":"id"}}}}
     Applies to Aggregates: COUNT(*), SUM(value)
     Group By: a, b
     Aggregate Definition: {"grouped":{"aggs":{"grouped":{"aggs":{"0":{"sum":{"field":"value","missing":null,"none_if_no_match":true}}},"terms":{"field":"b","order":{"_key":"asc"},"segment_size":65000,"size":65000}}},"terms":{"field":"a","order":{"_key":"asc"},"segment_size":65000,"size":65000}}}
(6 rows)

SELECT a, b, count(*), sum(value) FROM flatten_paths
WHERE id @@@ pdb.all() GROUP BY a, b ORDER BY a, b;
 a | b | count | sum 
---+---+-------+-----
 1 | 1 |     2 |  11
 1 |   |     1 |   4
 2 | 2 |     1 |   7
   | 1 |     1 |   3
   |   |     1 |   2
(5 rows)

EXPLAIN (COSTS OFF)
SELECT a, b, count(*), count(*) FILTER (WHERE value > 4),
 sum(value) FILTER (WHERE value < 4) FROM flatten_paths
WHERE id @@@ pdb.all() GROUP BY a, b ORDER BY a DESC, b DESC;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           QUERY PLAN                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan) on flatten_paths
   Index: flatten_paths_idx
   Tantivy Query: {"with_index":{"query":{"all":{"field":"id"}}}}
     Applies to Aggregates: COUNT(*), COUNT(*), SUM(value)
     Group By: a, b
     Aggregate Definition: {"0":{"aggs":{"grouped":{"aggs":{"grouped":{"aggs":{"0":{"filter":"*"}},"terms":{"field":"b","order":{"_key":"desc"},"segment_size":65000,"size":65000}}},"terms":{"field":"a","order":{"_key":"desc"},"segment_size":65000,"size":65000}}},"filter":{"query":"all","type":"FilterQuery"}},"1":{"aggs":{"grouped":{"aggs":{"grouped":{"aggs":{"0":{"filter":"*"}},"terms":{"field":"b","order":{"_key":"desc"},"segment_size":65000,"size":65000}}},"terms":{"field":"a","order":{"_key":"desc"},"segment_size":65000,"size":65000}}},"filter":{"query":{"range":{"field":"value","lower_bound":{"excluded":4},"upper_bound":null}},"type":"FilterQuery"}},"2":{"aggs":{"grouped":{"aggs":{"grouped":{"aggs":{"0":{"sum":{"field":"value","missing":null,"none_if_no_match":true}}},"terms":{"field":"b","order":{"_key":"desc"},"segment_size":65000,"size":65000}}},"terms":{"field":"a","order":{"_key":"desc"},"segment_size":65000,"size":65000}}},"filter":{"query":{"range":{"field":"value","lower_bound":null,"upper_bound":{"excluded":4}}},"type":"FilterQuery"}},"filter_sentinel":{"aggs":{"grouped":{"aggs":{"grouped":{"aggs":{"0":{"filter":"*"},"1":{"sum":{"field":"value","missing":null,"none_if_no_match":true}}},"terms":{"field":"b","order":{"_key":"desc"},"segment_size":65000,"size":65000}}},"terms":{"field":"a","order":{"_key":"desc"},"segment_size":65000,"size":65000}}},"filter":{"query":{"with_index":{"query":{"all":{"field":"id"}}}},"type":"FilterQuery"}}}
(6 rows)

SELECT a, b, count(*), count(*) FILTER (WHERE value > 4),
 sum(value) FILTER (WHERE value < 4) FROM flatten_paths
WHERE id @@@ pdb.all() GROUP BY a, b ORDER BY a DESC, b DESC;
 a | b | count | count | sum 
---+---+-------+-------+-----
   |   |     1 |     0 |   2
   | 1 |     1 |     0 |   3
 2 | 2 |     1 |     1 |    
 1 |   |     1 |     0 |    
 1 | 1 |     2 |     2 |    
(5 rows)

-- Many groups, with groups 35-39 missing from the second filter
CREATE TABLE flatten_many (id int, g int, value int);
INSERT INTO flatten_many SELECT i, i % 40, i FROM generate_series(1, 400) i;
CREATE INDEX flatten_many_idx ON flatten_many USING paradedb (id, g, value);
EXPLAIN (COSTS OFF)
SELECT g, count(*), count(*) FILTER (WHERE value > 200),
 sum(value) FILTER (WHERE g < 35) FROM flatten_many
WHERE id @@@ pdb.all() GROUP BY g ORDER BY g;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              QUERY PLAN                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan) on flatten_many
   Index: flatten_many_idx
   Tantivy Query: {"with_index":{"query":{"all":{"field":"id"}}}}
     Applies to Aggregates: COUNT(*), COUNT(*), SUM(value)
     Group By: g
     Aggregate Definition: {"0":{"aggs":{"grouped":{"aggs":{"0":{"filter":"*"}},"terms":{"field":"g","order":{"_key":"asc"},"segment_size":65000,"size":65000}}},"filter":{"query":"all","type":"FilterQuery"}},"1":{"aggs":{"grouped":{"aggs":{"0":{"filter":"*"}},"terms":{"field":"g","order":{"_key":"asc"},"segment_size":65000,"size":65000}}},"filter":{"query":{"range":{"field":"value","lower_bound":{"excluded":200},"upper_bound":null}},"type":"FilterQuery"}},"2":{"aggs":{"grouped":{"aggs":{"0":{"sum":{"field":"value","missing":null,"none_if_no_match":true}}},"terms":{"field":"g","order":{"_key":"asc"},"segment_size":65000,"size":65000}}},"filter":{"query":{"range":{"field":"g","lower_bound":null,"upper_bound":{"excluded":35}}},"type":"FilterQuery"}},"filter_sentinel":{"aggs":{"grouped":{"aggs":{"0":{"filter":"*"},"1":{"sum":{"field":"value","missing":null,"none_if_no_match":true}}},"terms":{"field":"g","order":{"_key":"asc"},"segment_size":65000,"size":65000}}},"filter":{"query":{"with_index":{"query":{"all":{"field":"id"}}}},"type":"FilterQuery"}}}
(6 rows)

