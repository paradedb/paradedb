         ->  Custom Scan (ParadeDB Base Scan) on having_items
               Table: having_items
               Index: having_items_idx
               Exec Method: ColumnarExecState
               Columnar: account_id
               Scores: false
               Full Index Scan: true
               Tantivy Query: {"with_index":{"query":"all"}}
(13 rows)

SELECT *
FROM (
    SELECT account_id, COUNT(*) AS n
    FROM having_items
    WHERE id @@@ paradedb.all()
    GROUP BY account_id
