-- Under MPP every task bounds its own output with the multi-key TopK before
-- the rows cross to the leader.
SET paradedb.mpp_min_rows TO 0;
SET max_parallel_workers_per_gather TO 2;
SET max_parallel_workers TO 8;
SET min_parallel_table_scan_size TO 0;
SET parallel_setup_cost TO 0;
SET parallel_tuple_cost TO 0;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT w.researcher_id
FROM multicolumn_topk_work_items w
JOIN multicolumn_topk_researchers r ON w.researcher_id = r.researcher_id
WHERE w.abstract_text @@@ 'cancer' OR r.bio @@@ 'cancer'
GROUP BY w.researcher_id
ORDER BY MAX(w.item_date) DESC NULLS LAST, w.researcher_id DESC
LIMIT 1;
                                                                                                                     QUERY PLAN                                                                                                                     
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: w.researcher_id, (max(w.item_date))
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: w.researcher_id, (max(w.item_date))
         Backend: DataFusion
         Indexes: multicolumn_topk_work_items_idx (w), multicolumn_topk_researchers_idx (r)
         Group By: researcher_id
         Aggregates: MAX(item_date)
         DataFusion Physical Plan: 
           : ┌───── DistributedExec
           : │ SortPreservingMergeExec: [agg_0@1 DESC NULLS LAST, researcher_id@0 DESC], fetch=1
           : │   [Stage 3] => NetworkCoalesceExec: output_partitions=4, input_tasks=2
           : └──────────────────────────────────────────────────
           :   ┌───── Stage 3 ── tasks=2, partitions=2
           :   │ SortExec: TopK(fetch=1), expr=[agg_0@1 DESC NULLS LAST, researcher_id@0 DESC], preserve_partitioning=[true]
           :   │   AggregateExec: mode=FinalPartitioned, gby=[researcher_id@0 as researcher_id], aggr=[max(w_0.item_date) as agg_0]
           :   │     [Stage 2] => NetworkShuffleExec: output_partitions=2, input_tasks=2
           :   └──────────────────────────────────────────────────
           :     ┌───── Stage 2 ── tasks=2, partitions=4
           :     │ RepartitionExec: partitioning=Hash([researcher_id@0], 4), input_partitions=1
           :     │   AggregateExec: mode=Partial, gby=[researcher_id@0 as researcher_id], aggr=[max(w_0.item_date) as agg_0]
           :     │     HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(researcher_id@0, researcher_id@0)], filter=__w_0_tag_0@0 OR __r_1_tag_0@1, projection=[researcher_id@2, item_date@3]
           :     │       CoalescePartitionsExec
           :     │         [Stage 1] => NetworkBroadcastExec: partitions_per_consumer=1, stage_partitions=2, input_tasks=2
           :     │       DistributedLeafExec:
