-- Three keys, the first one a filtered count.
SELECT explain_redact_oid($$
SELECT w.researcher_id
FROM multicolumn_topk_work_items w
JOIN multicolumn_topk_researchers r ON w.researcher_id = r.researcher_id
WHERE w.abstract_text @@@ 'cancer' OR r.bio @@@ 'cancer'
GROUP BY w.researcher_id
ORDER BY
  COUNT(*) FILTER (WHERE w.category = 'Tradeshows' AND w.abstract_text @@@ 'cancer') DESC,
  MAX(w.item_date) DESC NULLS LAST,
  w.researcher_id ASC
LIMIT 3
$$, 'COSTS OFF, VERBOSE, TIMING OFF');
                                                                                                                                                                                                                                                                                        explain_redact_oid                                                                                                                                                                                                                                                                                         
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: w.researcher_id, (count(*) FILTER (WHERE ((w.category = 'Tradeshows'::text) AND paradedb.search_with_query_input_ctid_or_row_strict(w.work_id, '{"with_index":{"oid":N,"query":{"parse_with_field":{"field":"abstract_text","query_string":"cancer","lenient":null,"conjunction_mode":null}}}}'::paradedb.searchqueryinput, w.ctid, CASE WHEN (paradedb.ctid_is_valid(w.ctid) IS NOT TRUE) THEN (ARRAY[w.*])::record[] WHEN (paradedb.xmin_is_visible(w.xmin, w.tableoid, w.ctid) IS NOT TRUE) THEN (ARRAY[w.*])::record[] ELSE '{}'::record[] END, ROW())))), (max(w.item_date))
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: w.researcher_id, (count(*) FILTER (WHERE ((w.category = 'Tradeshows'::text) AND paradedb.search_with_query_input_ctid_or_row_strict(w.work_id, '{"with_index":{"oid":N,"query":{"parse_with_field":{"field":"abstract_text","query_string":"cancer","lenient":null,"conjunction_mode":null}}}}'::paradedb.searchqueryinput, w.ctid, CASE WHEN (paradedb.ctid_is_valid(w.ctid) IS NOT TRUE) THEN (ARRAY[w.*])::record[] WHEN (paradedb.xmin_is_visible(w.xmin, w.tableoid, w.ctid) IS NOT TRUE) THEN (ARRAY[w.*])::record[] ELSE '{}'::record[] END, ROW())))), (max(w.item_date))
         Backend: DataFusion
         Indexes: multicolumn_topk_work_items_idx (w), multicolumn_topk_researchers_idx (r)
         Group By: researcher_id
         Aggregates: COUNT(*), MAX(item_date)
         DataFusion Physical Plan: 
           : SortExec: TopK(fetch=3), expr=[agg_0@1 DESC, agg_1@2 DESC NULLS LAST, researcher_id@0 ASC NULLS LAST], preserve_partitioning=[false]
           :   AggregateExec: mode=Single, gby=[researcher_id@0 as researcher_id], aggr=[count(1) FILTER (WHERE w_0.category = Utf8View("Tradeshows") AND w_0.__w_0_tag_0) as agg_0, max(w_0.item_date) as agg_1]
           :     TantivyDecodeExec: decode=[category]
           :       TantivyFetchExec: fetch=[category]
           :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(researcher_id@0, researcher_id@0)], filter=__w_0_tag_0@0 OR __r_1_tag_0@1, projection=[researcher_id@2, item_date@3, category@4, __w_0_tag_0@5]
           :           CooperativeExec
           :             PgSearchScan: table=r, segments=2, visibility=eager, tag_0={"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"cancer","lenient":null,"conjunction_mode":null}}}}
           :           CooperativeExec
           :             PgSearchScan: table=w, segments=2, dynamic_filters=1, visibility=eager, tag_0={"with_index":{"query":{"parse_with_field":{"field":"abstract_text","query_string":"cancer","lenient":null,"conjunction_mode":null}}}}
(18 rows)

