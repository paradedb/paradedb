-- One key that cannot be pushed keeps the whole sort in Postgres. A TopK on
-- the first key alone could drop researcher 2 before the tie-breaker runs.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT w.researcher_id
FROM multicolumn_topk_work_items w
JOIN multicolumn_topk_researchers r ON w.researcher_id = r.researcher_id
WHERE w.abstract_text @@@ 'cancer' OR r.bio @@@ 'cancer'
GROUP BY w.researcher_id
ORDER BY MAX(w.item_date) DESC NULLS LAST, (w.researcher_id % 2) ASC
LIMIT 1;
                                                                                                                  QUERY PLAN                                                                                                                  
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: w.researcher_id, (max(w.item_date)), ((w.researcher_id % 2))
   ->  Sort
         Output: w.researcher_id, (max(w.item_date)), ((w.researcher_id % 2))
         Sort Key: (max(w.item_date)) DESC NULLS LAST, ((w.researcher_id % 2))
         ->  Custom Scan (ParadeDB Aggregate Scan)
               Output: w.researcher_id, (max(w.item_date)), (w.researcher_id % 2)
               Backend: DataFusion
               Indexes: multicolumn_topk_work_items_idx (w), multicolumn_topk_researchers_idx (r)
               Group By: researcher_id
               Aggregates: MAX(item_date)
               DataFusion Physical Plan: 
                 : AggregateExec: mode=Single, gby=[researcher_id@0 as researcher_id], aggr=[max(w_0.item_date) as agg_0]
                 :   HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(researcher_id@0, researcher_id@0)], filter=__w_0_tag_0@0 OR __r_1_tag_0@1, projection=[researcher_id@2, item_date@3]
                 :     CooperativeExec
                 :       PgSearchScan: table=r, segments=2, visibility=eager, tag_0={"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"cancer","lenient":null,"conjunction_mode":null}}}}
                 :     CooperativeExec
                 :       PgSearchScan: table=w, segments=2, dynamic_filters=1, visibility=eager, tag_0={"with_index":{"query":{"parse_with_field":{"field":"abstract_text","query_string":"cancer","lenient":null,"conjunction_mode":null}}}}
(18 rows)

