(3 rows)

-- Test 2.2: GROUP BY category with HAVING filter
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT p.category, COUNT(*), AVG(p.price)
FROM agg_nonequi_products p
JOIN agg_nonequi_promos pr ON p.price <= pr.max_price
WHERE p.description @@@ 'laptop OR jacket OR shoes'
GROUP BY p.category
HAVING COUNT(*) > 1
ORDER BY p.category;
WARNING:  Aggregate Scan (DataFusion) not used: CROSS JOINs are not supported (no equi-join keys) (table: join)
WARNING:  JoinScan not used: at least one equi-join key (e.g., a.id = b.id) is required (tables: p, pr)
                                                                                         QUERY PLAN                                                                                         
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: p.category
   ->  HashAggregate
         Group Key: p.category
         Filter: (count(*) > 1)
         ->  Nested Loop
               Join Filter: (p.price <= pr.max_price)
               ->  Custom Scan (ParadeDB Base Scan) on agg_nonequi_products p
                     Table: agg_nonequi_products
                     Index: agg_nonequi_products_idx
                     Exec Method: ColumnarExecState
                     Fast Fields: category, price
                     Scores: false
                     Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"laptop OR jacket OR shoes","lenient":null,"conjunction_mode":null}}}}
               ->  Materialize
                     ->  Seq Scan on agg_nonequi_promos pr
(16 rows)

SELECT p.category, COUNT(*), AVG(p.price)
FROM agg_nonequi_products p
JOIN agg_nonequi_promos pr ON p.price <= pr.max_price
WHERE p.description @@@ 'laptop OR jacket OR shoes'
GROUP BY p.category
HAVING COUNT(*) > 1
ORDER BY p.category;
WARNING:  Aggregate Scan (DataFusion) not used: CROSS JOINs are not supported (no equi-join keys) (table: join)
WARNING:  JoinScan not used: at least one equi-join key (e.g., a.id = b.id) is required (tables: p, pr)
