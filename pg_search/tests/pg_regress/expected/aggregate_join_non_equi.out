-- =============================================================================
-- SECTION 3: Non-Equi OUTER JOIN Aggregates
-- =============================================================================
-- Test 3.1: Scalar LEFT JOIN aggregate (ensuring unmatched rows count toward COUNT(*) but null in COUNT(pr.id))
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT COUNT(*), COUNT(pr.id), SUM(p.price)
FROM agg_nonequi_products p
LEFT JOIN agg_nonequi_promos pr ON p.category = pr.promo_code AND p.price > pr.max_price
WHERE p.description @@@ 'laptop OR jacket OR keyboard';
WARNING:  Aggregate Scan (DataFusion) not used: outer-join ON residual predicates are not supported (table: join)
WARNING:  JoinScan not used: outer joins support only equi-join conditions in the ON clause (tables: p, pr)
                                                                                          QUERY PLAN                                                                                           
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Aggregate
   ->  Hash Right Join
         Hash Cond: (pr.promo_code = p.category)
         Join Filter: (p.price > pr.max_price)
         ->  Seq Scan on agg_nonequi_promos pr
         ->  Hash
               ->  Custom Scan (ParadeDB Base Scan) on agg_nonequi_products p
                     Table: agg_nonequi_products
                     Index: agg_nonequi_products_idx
                     Exec Method: ColumnarExecState
                     Fast Fields: category, price
                     Scores: false
                     Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"laptop OR jacket OR keyboard","lenient":null,"conjunction_mode":null}}}}
(13 rows)

SELECT COUNT(*), COUNT(pr.id), SUM(p.price)
FROM agg_nonequi_products p
LEFT JOIN agg_nonequi_promos pr ON p.category = pr.promo_code AND p.price > pr.max_price
WHERE p.description @@@ 'laptop OR jacket OR keyboard';
WARNING:  Aggregate Scan (DataFusion) not used: outer-join ON residual predicates are not supported (table: join)
