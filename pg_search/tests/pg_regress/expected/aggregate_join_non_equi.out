-- =============================================================================
-- SECTION 4: 3-Table Non-Equi JOIN Aggregates
-- =============================================================================
-- Test 4.1: 3 tables joined via mixed equi and non-equi conditions
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT t.tier_name, COUNT(*), SUM(p.price)
FROM agg_nonequi_products p
JOIN agg_nonequi_promos pr ON p.category = pr.promo_code AND p.price <= pr.max_price
JOIN agg_nonequi_tiers t ON p.price >= t.threshold_price
WHERE p.description @@@ 'laptop OR keyboard'
GROUP BY t.tier_name
ORDER BY t.tier_name;
WARNING:  Aggregate Scan (DataFusion) not used: CROSS JOINs are not supported (no equi-join keys) (table: join)
WARNING:  JoinScan not used: at least one equi-join key (e.g., a.id = b.id) is required (tables: p, t)
                                                                                           QUERY PLAN                                                                                            
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 GroupAggregate
   Group Key: t.tier_name
   ->  Sort
         Sort Key: t.tier_name
         ->  Nested Loop
               Join Filter: (p.price >= t.threshold_price)
               ->  Hash Join
                     Hash Cond: (pr.promo_code = p.category)
                     Join Filter: (p.price <= pr.max_price)
                     ->  Seq Scan on agg_nonequi_promos pr
                     ->  Hash
                           ->  Custom Scan (ParadeDB Base Scan) on agg_nonequi_products p
                                 Table: agg_nonequi_products
                                 Index: agg_nonequi_products_idx
                                 Exec Method: ColumnarExecState
                                 Fast Fields: category, price
                                 Scores: false
                                 Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"laptop OR keyboard","lenient":null,"conjunction_mode":null}}}}
               ->  Seq Scan on agg_nonequi_tiers t
(19 rows)

SELECT t.tier_name, COUNT(*), SUM(p.price)
FROM agg_nonequi_products p
JOIN agg_nonequi_promos pr ON p.category = pr.promo_code AND p.price <= pr.max_price
JOIN agg_nonequi_tiers t ON p.price >= t.threshold_price
WHERE p.description @@@ 'laptop OR keyboard'
GROUP BY t.tier_name
ORDER BY t.tier_name;
WARNING:  Aggregate Scan (DataFusion) not used: CROSS JOINs are not supported (no equi-join keys) (table: join)
WARNING:  JoinScan not used: at least one equi-join key (e.g., a.id = b.id) is required (tables: p, t)
