-- =============================================================================
-- SECTION 6: Fallback / Rejection
-- =============================================================================
-- Add an unindexed column
ALTER TABLE agg_nonequi_products ADD COLUMN unindexed_stock INT;
UPDATE agg_nonequi_products SET unindexed_stock = 10;
-- Test 6.1: Non-equi join on unindexed column should gracefully fall back
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT COUNT(*)
FROM agg_nonequi_products p
JOIN agg_nonequi_promos pr ON p.unindexed_stock < pr.min_rating
WHERE p.description @@@ 'laptop';
WARNING:  Aggregate Scan (DataFusion) not used: the selected lower join path contains a predicate that AggregateScan cannot classify (table: join)
WARNING:  JoinScan not used: at least one equi-join key (e.g., a.id = b.id) is required (tables: p, pr)
                                                                               QUERY PLAN                                                                                
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Aggregate
   ->  Nested Loop
         Join Filter: (p.unindexed_stock < pr.min_rating)
         ->  Seq Scan on agg_nonequi_promos pr
         ->  Materialize
               ->  Custom Scan (ParadeDB Base Scan) on agg_nonequi_products p
                     Table: agg_nonequi_products
                     Index: agg_nonequi_products_idx
                     Exec Method: NormalScanExecState
                     Scores: false
                     Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"laptop","lenient":null,"conjunction_mode":null}}}}
(11 rows)

