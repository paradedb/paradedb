RESET paradedb.defer_string_decode;
-- =============================================================================
-- MPP: each worker groups its segments on ordinals and decodes its groups
-- =============================================================================
SET max_parallel_workers_per_gather TO 3;
SET max_parallel_workers TO 8;
SET min_parallel_table_scan_size TO 0;
SET parallel_setup_cost TO 0;
SET parallel_tuple_cost TO 0;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT category, COUNT(*), SUM(price)
FROM aog_products
WHERE description @@@ 'widget'
GROUP BY category
ORDER BY category;
                                                                                                                 QUERY PLAN                                                                                                                 
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: category, (count(*)), (sum(price))
   Sort Key: aog_products.category
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: category, (count(*)), (sum(price))
         Backend: DataFusion
         Indexes: aog_products_idx (aog_products)
         Group By: category
         Aggregates: COUNT(*), SUM(price)
         DataFusion Physical Plan: 
           : ┌───── DistributedExec
           : │ CoalescePartitionsExec
           : │   [Stage 2] => NetworkCoalesceExec: output_partitions=9, input_tasks=3
           : └──────────────────────────────────────────────────
           :   ┌───── Stage 2 ── tasks=3, partitions=3
           :   │ AggregateExec: mode=FinalPartitioned, gby=[category@0 as category], aggr=[count(1) as agg_0, numeric64_sum(aog_products_0.price, 2) as agg_1]
           :   │   [Stage 1] => NetworkShuffleExec: output_partitions=3, input_tasks=3
           :   └──────────────────────────────────────────────────
           :     ┌───── Stage 1 ── tasks=3, partitions=9
           :     │ RepartitionExec: partitioning=Hash([category@0], 9), input_partitions=1
           :     │   TantivyDecodeExec: decode=[category]
           :     │     AggregateExec: mode=Partial, gby=[category@0 as category], aggr=[count(1) as agg_0, numeric64_sum(aog_products_0.price, 2) as agg_1]
           :     │       TantivyFetchExec: fetch=[category]
           :     │         DistributedLeafExec:
           :     │           t0: PgSearchScan: table=aog_products, segments=3, visibility=eager, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"widget","lenient":null,"conjunction_mode":null}}}}
           :     │           t1: PgSearchScan: table=aog_products, segments=3, visibility=eager, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"widget","lenient":null,"conjunction_mode":null}}}}
           :     │           t2: PgSearchScan: table=aog_products, segments=3, visibility=eager, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"widget","lenient":null,"conjunction_mode":null}}}}
           :     └──────────────────────────────────────────────────
(28 rows)

SELECT category, COUNT(*), SUM(price)
FROM aog_products
