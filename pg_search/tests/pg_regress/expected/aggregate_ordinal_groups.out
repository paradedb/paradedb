-- DISTINCT is a group by with no aggregates.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT DISTINCT category
FROM aog_products
WHERE description @@@ 'widget'
ORDER BY category;
                                                                                                            QUERY PLAN                                                                                                            
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: category
   Sort Key: aog_products.category
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: category
         Backend: DataFusion
         Indexes: aog_products_idx (aog_products)
         Group By: category
         DataFusion Physical Plan: 
           : AggregateExec: mode=Final, gby=[category@0 as category], aggr=[]
           :   TantivyDecodeExec: decode=[category]
           :     AggregateExec: mode=Partial, gby=[category@0 as category], aggr=[]
           :       TantivyFetchExec: fetch=[category]
           :         CooperativeExec
           :           PgSearchScan: table=aog_products, segments=3, visibility=eager, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"widget","lenient":null,"conjunction_mode":null}}}}
(15 rows)

