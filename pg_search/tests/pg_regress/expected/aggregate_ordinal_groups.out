SET paradedb.enable_aggregate_custom_scan TO off;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.category, COUNT(*), SUM(r.stars)
FROM aog_products p JOIN aog_reviews r ON r.product_id = p.id
WHERE p.description @@@ 'widget'
GROUP BY p.category
ORDER BY p.category;
WARNING:  JoinScan not used: aggregates are not supported. Enable paradedb.enable_aggregate_custom_scan to optimize this query. (tables: p, r)
                                                                                  QUERY PLAN                                                                                   
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: p.category, (count(*)), (sum(r.stars))
   Sort Key: p.category
   ->  HashAggregate
         Output: p.category, count(*), sum(r.stars)
         Group Key: p.category
         ->  Hash Join
               Output: p.category, r.stars
               Inner Unique: true
               Hash Cond: (r.product_id = p.id)
               ->  Seq Scan on public.aog_reviews r
                     Output: r.id, r.product_id, r.stars
               ->  Hash
                     Output: p.category, p.id
                     ->  Custom Scan (ParadeDB Base Scan) on public.aog_products p
                           Output: p.category, p.id
                           Table: aog_products
                           Index: aog_products_idx
                           Worker Selection: Row-capped
                           Exec Method: ColumnarExecState
                           Fast Fields: category, id
                           Scores: false
                           Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"widget","lenient":null,"conjunction_mode":null}}}}
(23 rows)

