SET paradedb.enable_aggregate_custom_scan TO on;
-- Two string keys group together on their ordinal pairs.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT category, brand, COUNT(*), SUM(price)
FROM aog_products
WHERE description @@@ 'widget'
GROUP BY category, brand
ORDER BY category, brand;
                                                                                                            QUERY PLAN                                                                                                            
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: category, brand, (count(*)), (sum(price))
   Sort Key: aog_products.category, aog_products.brand
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: category, brand, (count(*)), (sum(price))
         Backend: DataFusion
         Indexes: aog_products_idx (aog_products)
         Group By: brand, category
         Aggregates: COUNT(*), SUM(price)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Final, gby=[category@0 as category, brand@1 as brand], aggr=[count(1) as agg_0, numeric64_sum(aog_products_0.price, 2) as agg_1]
           :   TantivyDecodeExec: decode=[category, brand]
           :     AggregateExec: mode=Partial, gby=[category@0 as category, brand@1 as brand], aggr=[count(1) as agg_0, numeric64_sum(aog_products_0.price, 2) as agg_1]
           :       TantivyFetchExec: fetch=[category, brand]
           :         CooperativeExec
           :           PgSearchScan: table=aog_products, segments=2, visibility=eager, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"widget","lenient":null,"conjunction_mode":null}}}}
(16 rows)

