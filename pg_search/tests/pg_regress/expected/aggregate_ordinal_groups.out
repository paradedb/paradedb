SET paradedb.enable_aggregate_custom_scan TO on;
-- A string from the null-supplying side of an outer join stays deferred through
-- the join: a null-extended row is a NULL ordinal, which counts as no note.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.category, COUNT(*), COUNT(n.note)
FROM aog_products p LEFT JOIN aog_notes n ON n.product_id = p.id
WHERE p.description @@@ 'widget'
GROUP BY p.category
ORDER BY p.category;
                                                                                                                QUERY PLAN                                                                                                                 
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: p.category, (count(*)), (count(n.note))
   Sort Key: p.category
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: p.category, (count(*)), (count(n.note))
         Backend: DataFusion
         Indexes: aog_products_idx (p), aog_notes_idx (n)
         Group By: category
         Aggregates: COUNT(*), COUNT(note)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Final, gby=[category@0 as category], aggr=[count(1) as agg_0, count(n_1.note) as agg_1]
           :   TantivyDecodeExec: decode=[category]
           :     AggregateExec: mode=Partial, gby=[category@0 as category], aggr=[count(1) as agg_0, count(n_1.note) as agg_1]
           :       TantivyDecodeExec: decode=[note]
           :         HashJoinExec: mode=CollectLeft, join_type=Right, on=[(product_id@0, id@0)], projection=[category@3, note@1]
           :           CooperativeExec
           :             PgSearchScan: table=n, segments=1, fetch=[note], visibility=eager, query="all"
           :           CooperativeExec
           :             PgSearchScan: table=p, segments=3, fetch=[category], visibility=eager, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"widget","lenient":null,"conjunction_mode":null}}}}
(19 rows)

SELECT p.category, COUNT(*), COUNT(n.note)
FROM aog_products p LEFT JOIN aog_notes n ON n.product_id = p.id
WHERE p.description @@@ 'widget'
GROUP BY p.category
ORDER BY p.category;
