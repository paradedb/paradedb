-- =============================================================================
-- A fan-out join: the scan resolves the ordinals, the partial aggregate groups
-- the joined rows on them, and one row per group is decoded
-- =============================================================================
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.category, COUNT(*), SUM(r.stars)
FROM aog_products p JOIN aog_reviews r ON r.product_id = p.id
WHERE p.description @@@ 'widget'
GROUP BY p.category
ORDER BY p.category;
                                                                                                               QUERY PLAN                                                                                                                
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: p.category, (count(*)), (sum(r.stars))
   Sort Key: p.category
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: p.category, (count(*)), (sum(r.stars))
         Backend: DataFusion
         Indexes: aog_products_idx (p), aog_reviews_idx (r)
         Group By: category
         Aggregates: COUNT(*), SUM(stars)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Final, gby=[category@0 as category], aggr=[count(1) as agg_0, sum(r_1.stars) as agg_1]
           :   TantivyDecodeExec: decode=[category]
           :     AggregateExec: mode=Partial, gby=[category@0 as category], aggr=[count(1) as agg_0, sum(r_1.stars) as agg_1]
           :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@0)], projection=[category@1, stars@3]
           :         CooperativeExec
           :           PgSearchScan: table=p, segments=2, fetch=[category], visibility=eager, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"widget","lenient":null,"conjunction_mode":null}}}}
           :         CooperativeExec
           :           PgSearchScan: table=r, segments=1, dynamic_filters=1, visibility=eager, query="all"
(18 rows)

SELECT p.category, COUNT(*), SUM(r.stars)
