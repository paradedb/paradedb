-- =============================================================================
-- Opting out: with the decode pinned to the scan, the aggregate sees strings
-- =============================================================================
SET paradedb.defer_string_decode = off;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT category, COUNT(*), SUM(price)
FROM aog_products
WHERE description @@@ 'widget'
GROUP BY category
ORDER BY category;
                                                                                                         QUERY PLAN                                                                                                         
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: category, (count(*)), (sum(price))
   Sort Key: aog_products.category
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: category, (count(*)), (sum(price))
         Backend: DataFusion
         Indexes: aog_products_idx (aog_products)
         Group By: category
         Aggregates: COUNT(*), SUM(price)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Single, gby=[category@0 as category], aggr=[count(1) as agg_0, numeric64_sum(aog_products_0.price, 2) as agg_1]
           :   CooperativeExec
           :     PgSearchScan: table=aog_products, segments=3, visibility=eager, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"widget","lenient":null,"conjunction_mode":null}}}}
(13 rows)

