RESET pinned_key.account;
\echo 'Test 5.6: two stored values are equal to one constant'
Test 5.6: two stored values are equal to one constant
-- At a daylight saving change, two `timestamp` values are equal to one
-- `timestamptz` constant. PostgreSQL has one group, and reads the key from one
-- of its rows.
CREATE TABLE pinned_key_dst (id SERIAL PRIMARY KEY, ts TIMESTAMP, amount NUMERIC(10, 2), kind TEXT);
INSERT INTO pinned_key_dst (ts, amount, kind) VALUES
    ('2024-03-10 02:30', 1.5, 'a'),
    ('2024-03-10 03:30', 2.5, 'a'),
    ('2024-03-10 04:30', 4, 'b');
CREATE INDEX pinned_key_dst_idx ON pinned_key_dst USING paradedb (id, ts, amount, (kind::pdb.literal));
SET timezone = 'America/New_York';
EXPLAIN (COSTS OFF, TIMING OFF)
SELECT ts, SUM(amount)
FROM pinned_key_dst
WHERE ts = TIMESTAMPTZ '2024-03-10 07:30:00+00' AND id @@@ paradedb.all()
GROUP BY ts;
                                                                                                                                       QUERY PLAN                                                                                                                                       
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Backend: DataFusion
   Indexes: pinned_key_dst_idx (pinned_key_dst)
   Aggregates: SUM(amount)
   DataFusion Physical Plan: 
     : AggregateExec: mode=Single, gby=[true as __one_group], aggr=[numeric64_sum(pinned_key_dst_0.amount, 2) as agg_0, first_value(pinned_key_dst_0.ts) ORDER BY [pinned_key_dst_0.ctid_0 ASC NULLS LAST] as row_0], ordering_mode=Sorted
     :   ProjectionExec: expr=[ctid@0 as ctid_0, ts@1 as ts, amount@2 as amount]
     :     CooperativeExec
     :       PgSearchScan: table=pinned_key_dst, segments=1, visibility=eager, query={"boolean":{"must":[{"with_index":{"query":"all"}},{"heap_filter":{"indexed_query":"all","always_filters":[{"heap_filter":"(ts = 'Sun Mar 10 03:30:00 2024 EDT'::timestamp with time zone)"}]}}]}}
(9 rows)

SELECT ts, SUM(amount)
FROM pinned_key_dst
WHERE ts = TIMESTAMPTZ '2024-03-10 07:30:00+00' AND id @@@ paradedb.all()
GROUP BY ts;
            ts            | sum  
--------------------------+------
