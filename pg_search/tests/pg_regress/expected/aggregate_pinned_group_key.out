SET paradedb.enable_aggregate_custom_scan TO on;
\echo 'Test 11.1: pdb.agg() that only the Tantivy backend runs, with a pinned key -> error'
Test 11.1: pdb.agg() that only the Tantivy backend runs, with a pinned key -> error
SELECT account_id, pdb.agg('{"percentiles": {"field": "price", "percents": [50]}}'::jsonb)
FROM pinned_key_items
WHERE account_id = 1 AND id @@@ paradedb.all()
GROUP BY account_id;
ERROR:  Cannot execute pdb.agg: the DataFusion backend cannot run this spec, and the Tantivy backend cannot return a column that PostgreSQL does not group on, such as a GROUP BY key that the WHERE clause sets to one value
\echo 'Test 11.2: the same, with a column that the primary key decides -> error'
Test 11.2: the same, with a column that the primary key decides -> error
SELECT id, kind, pdb.agg('{"stats": {"field": "price"}}'::jsonb)
FROM pinned_key_items
WHERE id @@@ paradedb.all()
GROUP BY id
ORDER BY id
LIMIT 2;
ERROR:  Cannot execute pdb.agg: the DataFusion backend cannot run this spec, and the Tantivy backend cannot return a column that PostgreSQL does not group on, such as a GROUP BY key that the WHERE clause sets to one value
\echo 'Test 11.3: the same spec, when PostgreSQL groups on every key'
Test 11.3: the same spec, when PostgreSQL groups on every key
SELECT account_id, pdb.agg('{"stats": {"field": "region"}}'::jsonb) -> 'count' AS region_count
FROM pinned_key_items
WHERE account_id IN (2, 3) AND id @@@ paradedb.all()
GROUP BY account_id
ORDER BY account_id;
 account_id | region_count 
------------+--------------
          2 | 10
          3 | 40
(2 rows)

SET paradedb.enable_aggregate_custom_scan TO off;
SELECT account_id, COUNT(region) AS region_count
FROM pinned_key_items
WHERE account_id IN (2, 3) AND id @@@ paradedb.all()
GROUP BY account_id
ORDER BY account_id;
 account_id | region_count 
------------+--------------
          2 |           10
          3 |           40
(2 rows)

SET paradedb.enable_aggregate_custom_scan TO on;
CREATE TABLE pinned_key_internal (id SERIAL PRIMARY KEY, agg_0 INT, __one_group INT, k TEXT);
INSERT INTO pinned_key_internal (agg_0, __one_group, k)
SELECT g % 3, g % 2, (ARRAY['a', 'b'])[(g % 2) + 1] FROM generate_series(1, 30) g;
CREATE INDEX pinned_key_internal_idx ON pinned_key_internal
USING paradedb (id, agg_0, __one_group, (k::pdb.literal));
\echo 'Test 12.1: a pinned column named like an aggregate output'
Test 12.1: a pinned column named like an aggregate output
EXPLAIN (COSTS OFF, TIMING OFF)
SELECT agg_0, k, COUNT(*)
FROM pinned_key_internal
WHERE agg_0 = 1 AND id @@@ paradedb.all()
GROUP BY agg_0, k
ORDER BY k;
                                                                                            QUERY PLAN                                                                                             
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: k
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Backend: DataFusion
         Indexes: pinned_key_internal_idx (pinned_key_internal)
         Group By: k
         Aggregates: COUNT(*)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Final, gby=[k@0 as k], aggr=[count(1) as _agg_0, first_value(pinned_key_internal_0.agg_0) ORDER BY [pinned_key_internal_0.ctid_0 ASC NULLS LAST] as _row_1]
           :   TantivyDecodeExec: decode=[k]
           :     AggregateExec: mode=Partial, gby=[k@1 as k], aggr=[count(1) as _agg_0, first_value(pinned_key_internal_0.agg_0) ORDER BY [pinned_key_internal_0.ctid_0 ASC NULLS LAST] as _row_1]
           :       TantivyFetchExec: fetch=[k]
           :         ProjectionExec: expr=[ctid@0 as ctid_0, k@1 as k, agg_0@2 as agg_0]
           :           CooperativeExec
           :             PgSearchScan: table=pinned_key_internal, segments=1, visibility=eager, query={"boolean":{"must":[{"with_index":{"query":"all"}},{"term":{"field":"agg_0","value":1}}]}}
(15 rows)

