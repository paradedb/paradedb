(4 rows)

-- =====================================================================
-- SECTION 6b: The pin and the aggregate are in a nested query
-- =====================================================================
-- PostgreSQL plans each query level on its own, and the scan sees the level
-- that holds the aggregate.
\echo 'Test 6b.1: the grouped subquery is joined to another table'
Test 6b.1: the grouped subquery is joined to another table
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT grouped.account_id, grouped.kind, grouped.n
FROM (
    SELECT account_id, kind, COUNT(*) AS n
    FROM pinned_key_items
    WHERE account_id = 2 AND id @@@ paradedb.all()
    GROUP BY account_id, kind
) AS grouped
JOIN (VALUES (1::bigint), (2), (3)) AS accounts (id) ON accounts.id = grouped.account_id
ORDER BY grouped.kind;
                                                                                                    QUERY PLAN                                                                                                    
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: account_id, kind, (count(*))
   Sort Key: kind
   ->  Hash Join
         Output: account_id, kind, (count(*))
         Hash Cond: ("*VALUES*".column1 = account_id)
         ->  Values Scan on "*VALUES*"
               Output: "*VALUES*".column1
         ->  Hash
               Output: account_id, kind, (count(*))
               ->  Custom Scan (ParadeDB Aggregate Scan)
                     Output: account_id, kind, (count(*))
                     Backend: DataFusion
                     Indexes: pinned_key_items_idx (pinned_key_items)
                     Group By: kind
                     Aggregates: COUNT(*)
                     DataFusion Physical Plan: 
                       : AggregateExec: mode=Final, gby=[kind@0 as kind], aggr=[count(1) as agg_0, first_value(pinned_key_items_0.account_id) ORDER BY [pinned_key_items_0.ctid_0 ASC NULLS LAST] as row_1]
                       :   TantivyDecodeExec: decode=[kind]
                       :     AggregateExec: mode=Partial, gby=[kind@1 as kind], aggr=[count(1) as agg_0, first_value(pinned_key_items_0.account_id) ORDER BY [pinned_key_items_0.ctid_0 ASC NULLS LAST] as row_1]
                       :       TantivyFetchExec: fetch=[kind]
                       :         ProjectionExec: expr=[ctid@0 as ctid_0, kind@1 as kind, account_id@2 as account_id]
                       :           CooperativeExec
                       :             PgSearchScan: table=pinned_key_items, segments=1, visibility=eager, query={"boolean":{"must":[{"with_index":{"query":"all"}},{"term":{"field":"account_id","value":2}}]}}
(24 rows)

SELECT grouped.account_id, grouped.kind, grouped.n
FROM (
    SELECT account_id, kind, COUNT(*) AS n
    FROM pinned_key_items
    WHERE account_id = 2 AND id @@@ paradedb.all()
    GROUP BY account_id, kind
) AS grouped
JOIN (VALUES (1::bigint), (2), (3)) AS accounts (id) ON accounts.id = grouped.account_id
ORDER BY grouped.kind;
 account_id | kind | n  
------------+------+----
          2 | a    | 10
          2 | b    | 10
          2 | c    | 10
          2 | d    | 10
(4 rows)

\echo 'Test 6b.2: an outer aggregate over the pinned aggregate'
Test 6b.2: an outer aggregate over the pinned aggregate
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT kind, SUM(n), COUNT(*)
FROM (
    SELECT account_id, kind, COUNT(*) AS n
    FROM pinned_key_items
    WHERE account_id = 2 AND id @@@ paradedb.all()
    GROUP BY account_id, kind
) AS grouped
GROUP BY kind
ORDER BY kind;
