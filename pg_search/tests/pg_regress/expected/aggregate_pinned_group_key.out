\echo 'Test 2.1: pinned key and free key'
Test 2.1: pinned key and free key
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT COUNT(*) AS count_all, account_id, kind
FROM pinned_key_items
WHERE region = 1 AND account_id = 1 AND id @@@ paradedb.all()
GROUP BY account_id, kind
ORDER BY kind;
                                                                                                               QUERY PLAN                                                                                                                
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: (count(*)), account_id, kind
   Sort Key: pinned_key_items.kind
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: (count(*)), account_id, kind
         Backend: DataFusion
         Indexes: pinned_key_items_idx (pinned_key_items)
         Group By: kind
         Aggregates: COUNT(*)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Final, gby=[kind@0 as kind], aggr=[count(1) as agg_0, first_value(pinned_key_items_0.account_id) ORDER BY [pinned_key_items_0.ctid_0 ASC NULLS LAST] as row_1]
           :   TantivyDecodeExec: decode=[kind]
           :     AggregateExec: mode=Partial, gby=[kind@1 as kind], aggr=[count(1) as agg_0, first_value(pinned_key_items_0.account_id) ORDER BY [pinned_key_items_0.ctid_0 ASC NULLS LAST] as row_1]
           :       TantivyFetchExec: fetch=[kind]
           :         ProjectionExec: expr=[ctid@0 as ctid_0, kind@1 as kind, account_id@2 as account_id]
           :           CooperativeExec
           :             PgSearchScan: table=pinned_key_items, segments=1, visibility=eager, query={"boolean":{"must":[{"with_index":{"query":"all"}},{"term":{"field":"region","value":1}},{"term":{"field":"account_id","value":1}}]}}
(17 rows)

SELECT COUNT(*) AS count_all, account_id, kind
FROM pinned_key_items
WHERE region = 1 AND account_id = 1 AND id @@@ paradedb.all()
GROUP BY account_id, kind
ORDER BY kind;
 count_all | account_id | kind 
-----------+------------+------
        10 |          1 | a
        10 |          1 | b
        10 |          1 | c
        10 |          1 | d
(4 rows)

