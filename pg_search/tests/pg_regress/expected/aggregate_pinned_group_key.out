\echo 'Test 2.5: pdb.agg()'
Test 2.5: pdb.agg()
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT account_id, kind, pdb.agg('{"avg": {"field": "price"}}'::jsonb)
FROM pinned_key_items
WHERE account_id = 1 AND id @@@ paradedb.all()
GROUP BY account_id, kind
ORDER BY kind;
                                                                                                                                QUERY PLAN                                                                                                                                 
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: account_id, kind, (pdb.agg('{"avg": {"field": "price"}}'::jsonb))
   Sort Key: pinned_key_items.kind
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: account_id, kind, (pdb.agg('{"avg": {"field": "price"}}'::jsonb))
         Backend: DataFusion
         Indexes: pinned_key_items_idx (pinned_key_items)
         Group By: kind
         Aggregates: pdb.agg({"avg":{"field":"price"}})
         DataFusion Physical Plan: 
           : AggregateExec: mode=Final, gby=[kind@0 as kind], aggr=[first_value(pinned_key_items_0.account_id) ORDER BY [pinned_key_items_0.ctid_0 ASC NULLS LAST] as row_1, count(pinned_key_items_0.price) as __pdb_m0, sum(pinned_key_items_0.price) as __pdb_m1]
           :   TantivyDecodeExec: decode=[kind]
           :     AggregateExec: mode=Partial, gby=[kind@1 as kind], aggr=[first_value(pinned_key_items_0.account_id) ORDER BY [pinned_key_items_0.ctid_0 ASC NULLS LAST] as row_1, count(pinned_key_items_0.price) as __pdb_m0, sum(pinned_key_items_0.price) as __pdb_m1]
           :       TantivyFetchExec: fetch=[kind]
           :         ProjectionExec: expr=[ctid@0 as ctid_0, kind@1 as kind, account_id@2 as account_id, price@3 as price]
