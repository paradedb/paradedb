Test 13: a JSON path determined by the primary key
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT id, metadata->>'color' AS color, COUNT(*) FROM pruned_keys
WHERE id @@@ paradedb.all()
GROUP BY id
ORDER BY id;
                                                                                                    QUERY PLAN                                                                                                     
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan) on pruned_keys
   Index: pruned_keys_idx
   Tantivy Query: {"with_index":{"query":"all"}}
     Applies to Aggregates: COUNT(*)
     Group By: id, metadata.color
     Aggregate Definition: {"grouped":{"aggs":{"grouped":{"terms":{"field":"metadata.color","segment_size":65000,"size":65000}}},"terms":{"field":"id","order":{"_key":"asc"},"segment_size":65000,"size":65000}}}
(6 rows)

SELECT id, metadata->>'color' AS color, COUNT(*) FROM pruned_keys
WHERE id @@@ paradedb.all()
GROUP BY id
ORDER BY id;
 id | color | count 
----+-------+-------
  1 | red   |     1
