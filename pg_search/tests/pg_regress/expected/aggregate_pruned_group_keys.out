  3 | blue  |     1
  4 | red   |     1
  5 | blue  |     1
  6 | red   |     1
  7 | blue  |     1
  8 | red   |     1
  9 | green |     1
 10 |       |     1
(10 rows)

\echo 'Test 14: a constant key under a pulled-up subquery'
Test 14: a constant key under a pulled-up subquery
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT s.account_id, s.kind, COUNT(*)
FROM (SELECT * FROM pruned_keys WHERE account_id = 1 AND id @@@ paradedb.all()) s
GROUP BY s.account_id, s.kind;
                                                                                        QUERY PLAN                                                                                        
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan) on pruned_keys
   Index: pruned_keys_idx
   Tantivy Query: {"boolean":{"must":[{"with_index":{"query":"all"}},{"term":{"field":"account_id","value":1}}]}}
     Applies to Aggregates: COUNT(*)
     Group By: kind, account_id
     Aggregate Definition: {"grouped":{"aggs":{"grouped":{"terms":{"field":"account_id","segment_size":65000,"size":65000}}},"terms":{"field":"kind","segment_size":65000,"size":65000}}}
(6 rows)

SELECT s.account_id, s.kind, COUNT(*)
FROM (SELECT * FROM pruned_keys WHERE account_id = 1 AND id @@@ paradedb.all()) s
GROUP BY s.account_id, s.kind
ORDER BY s.kind;
 account_id |  kind   | count 
------------+---------+-------
          1 | invoice |     2
          1 | payout  |     1
          1 | refund  |     1
          1 |         |     1
(4 rows)

\echo 'Test 15: a key equal to an outer column in a correlated subquery'
Test 15: a key equal to an outer column in a correlated subquery
SELECT a.id,
       (SELECT COUNT(*) FROM pruned_keys b
        WHERE b.account_id = a.account_id AND b.id @@@ paradedb.all()
        GROUP BY b.account_id) AS same_account
FROM pruned_keys a
WHERE a.id IN (1, 6, 9)
ORDER BY a.id;
 id | same_account 
----+--------------
  1 |            5
  6 |            3
  9 |            2
(3 rows)

\echo 'Test 16: a key equal to an outer column in a LATERAL subquery'
Test 16: a key equal to an outer column in a LATERAL subquery
SELECT a.id, l.kind, l.count
FROM pruned_keys a,
     LATERAL (SELECT b.account_id, b.kind, COUNT(*) FROM pruned_keys b
              WHERE b.account_id = a.account_id AND b.id @@@ paradedb.all()
              GROUP BY b.account_id, b.kind) l
WHERE a.id IN (6, 9)
ORDER BY a.id, l.kind;
 id |  kind   | count 
----+---------+-------
  6 | invoice |     1
  6 | refund  |     2
  9 | invoice |     1
  9 | payout  |     1
(4 rows)

