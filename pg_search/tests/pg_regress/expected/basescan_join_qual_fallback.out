----+----+--------
  3 |  3 | t
  3 |  7 | t
  4 |  4 | t
  4 |  8 | t
(4 rows)

-- Control: the same query without pdb.score() returns the correct 4 rows.
SELECT d.id, t.id
FROM docs d JOIN tags t ON t.doc_id = d.id
WHERE (d.body @@@ 'sheriff' OR t.label @@@ 'tag')
  AND COALESCE(d.org_id = 1, false)
ORDER BY d.id, t.id;
