---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Custom Scan (ParadeDB Base Scan) on providers
         Table: providers
         Index: providers_paradedb
         Bitmap Intersection: providers_specialty
         Exec Method: TopKScanExecState
         Scores: false
            TopK Order By: id asc
            TopK Limit: 5
         Tantivy Query: {"boolean":{"must":[{"heap_filter":{"indexed_query":{"boolean":{"must":[{"with_index":{"query":{"term":{"field":"description","value":"cardiology"}}}}]}},"always_filters":[],"recheck_filters":[{"heap_filter":"('specialty13'::text = specialty)"}],"uses_tid_bitmap":true,"bitmap_consumer_id":0}}]}}
         ->  Bitmap Index Scan on providers_specialty
               Index Cond: (specialty = 'specialty13'::text)
(12 rows)

SELECT count(*) AS commuted_count FROM (
    SELECT id FROM providers
    WHERE description === 'cardiology' AND 'specialty13' = specialty) q;
