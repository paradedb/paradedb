ORDER BY id LIMIT 5;
                                                                                                                                       QUERY PLAN                                                                                                                                        
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Custom Scan (ParadeDB Base Scan) on providers
         Table: providers
         Index: providers_paradedb
         Exec Method: TopKScanExecState
         Scores: false
            TopK Order By: id asc
            TopK Limit: 5
         Tantivy Query: {"boolean":{"must":[{"with_index":{"query":{"term":{"field":"description","value":"cardiology"}}}},{"boolean":{"must":["all"],"must_not":[{"heap_filter":{"indexed_query":"all","always_filters":[{"heap_filter":"(location <@ '<(50,50),5>'::circle)"}]}}]}}]}}
(9 rows)

