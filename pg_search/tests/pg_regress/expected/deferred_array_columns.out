     :   SortExec: TopK(fetch=8), expr=[id@2 ASC NULLS LAST, c_1_labels@1 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[p, c], pruned=[p]
     :       UnnestExec
     :         TantivyDecodeExec: decode=[labels]
     :           ProjectionExec: expr=[ctid_1@0 as ctid_1, labels@1 as c_1_labels, id@2 as id, ctid_0@3 as ctid_0]
     :             HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, post_id@2)], projection=[ctid_1@2, labels@3, id@5, ctid_0@1]
     :               CooperativeExec
     :                 PgSearchScan: table=p, segments=2, query={"with_index":{"query":{"match":{"field":"title","value":"alpha","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :               CooperativeExec
