-- A list column (here `text[]`) that a DataFusion plan reads from the index leaves its scan
-- as a doc address and is read and decoded once, at the point that consumes it, the way a
-- string column is. One row of a list holds many terms, so a list has no term ordinal step:
-- no fetch node takes it and `paradedb.defer_column_fetch` does not apply to it. Each shape
-- is checked again with `paradedb.defer_string_decode = off`, which reads every list in the
-- scan; the rows must match.
CREATE EXTENSION IF NOT EXISTS pg_search;
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan TO off;
SET paradedb.enable_join_custom_scan = on;
SET paradedb.enable_aggregate_custom_scan = on;
DROP TABLE IF EXISTS dac_comments CASCADE;
DROP TABLE IF EXISTS dac_posts CASCADE;
CREATE TABLE dac_posts (
    id SERIAL PRIMARY KEY,
    title TEXT,
    tags TEXT[]
);
CREATE TABLE dac_comments (
    id SERIAL PRIMARY KEY,
    post_id INTEGER,
    author TEXT,
    labels TEXT[]
);
CREATE INDEX dac_posts_idx ON dac_posts USING paradedb (id, title, (tags::pdb.literal));
CREATE INDEX dac_comments_idx ON dac_comments USING paradedb (id, post_id, (author::pdb.literal), (labels::pdb.literal));
-- Two insert batches per table give each index two segments, so one batch above a join
-- holds rows of both. Some arrays are NULL and some are empty.
SET paradedb.global_mutable_segment_rows = 0;
INSERT INTO dac_posts (title, tags)
SELECT
    CASE WHEN i % 3 = 0 THEN 'alpha post ' || i ELSE 'beta post ' || i END,
    CASE WHEN i % 7 = 0 THEN NULL WHEN i % 5 = 0 THEN ARRAY[]::TEXT[] ELSE ARRAY['t' || (i % 4), 'all'] END
FROM generate_series(1, 15) AS i;
INSERT INTO dac_posts (title, tags)
SELECT
    CASE WHEN i % 3 = 0 THEN 'alpha post ' || i ELSE 'beta post ' || i END,
    CASE WHEN i % 7 = 0 THEN NULL WHEN i % 5 = 0 THEN ARRAY[]::TEXT[] ELSE ARRAY['t' || (i % 4), 'all'] END
FROM generate_series(16, 30) AS i;
-- Three comments on each of posts 1 to 20; posts 21 to 30 have none.
INSERT INTO dac_comments (post_id, author, labels)
SELECT
    (i - 1) % 20 + 1,
    'author ' || (i % 4),
    CASE WHEN i % 6 = 0 THEN NULL WHEN i % 9 = 0 THEN ARRAY[]::TEXT[] ELSE ARRAY['l' || (i % 3), 'c' || (i % 2)] END
FROM generate_series(1, 30) AS i;
INSERT INTO dac_comments (post_id, author, labels)
SELECT
    (i - 1) % 20 + 1,
    'author ' || (i % 4),
    CASE WHEN i % 6 = 0 THEN NULL WHEN i % 9 = 0 THEN ARRAY[]::TEXT[] ELSE ARRAY['l' || (i % 3), 'c' || (i % 2)] END
FROM generate_series(31, 60) AS i;
RESET paradedb.global_mutable_segment_rows;
SHOW paradedb.defer_column_fetch;
 paradedb.defer_column_fetch 
-----------------------------
 auto
(1 row)

SHOW paradedb.defer_string_decode;
 paradedb.defer_string_decode 
------------------------------
 auto
(1 row)

-- =============================================================================
-- Aggregating over an unnested list
-- =============================================================================
-- `id` is the primary key of the posts, so a comment meets at most one post: the labels
-- cross the join as doc addresses and are read once, just below the unnest.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT l, COUNT(*)
FROM dac_posts p
JOIN dac_comments c ON c.post_id = p.id
CROSS JOIN LATERAL unnest(c.labels) AS l
WHERE p.title ||| 'alpha'
GROUP BY l
ORDER BY l;
                                                                                                                          QUERY PLAN                                                                                                                           
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: l.l, (count(*))
   Sort Key: l.l
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: l.l, (count(*))
         Backend: DataFusion
         Indexes: dac_posts_idx (p), dac_comments_idx (c)
         Group By: labels
         Aggregates: COUNT(*)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Single, gby=[c_1_labels@0 as c_1_labels], aggr=[count(1) as agg_0]
           :   UnnestExec
           :     TantivyDecodeExec: decode=[labels]
           :       ProjectionExec: expr=[labels@0 as c_1_labels]
           :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, post_id@1)], projection=[labels@1]
           :           CooperativeExec
           :             PgSearchScan: table=p, segments=2, visibility=eager, query={"with_index":{"query":{"match":{"field":"title","value":"alpha","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
           :           CooperativeExec
           :             PgSearchScan: table=c, segments=2, dynamic_filters=1, visibility=eager, query="all"
(19 rows)

SELECT l, COUNT(*)
FROM dac_posts p
JOIN dac_comments c ON c.post_id = p.id
CROSS JOIN LATERAL unnest(c.labels) AS l
WHERE p.title ||| 'alpha'
GROUP BY l
ORDER BY l;
 l  | count 
----+-------
 c0 |     6
 c1 |     8
 l0 |     2
 l1 |     6
 l2 |     6
(5 rows)

-- A post meets each of its comments, so its tags would be read once per comment above the
-- join. The scan reads them once instead.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT t, COUNT(*)
FROM dac_posts p
JOIN dac_comments c ON c.post_id = p.id
CROSS JOIN LATERAL unnest(p.tags) AS t
WHERE p.title ||| 'alpha'
GROUP BY t
ORDER BY t;
                                                                                                                                QUERY PLAN                                                                                                                                 
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: t.t, (count(*))
   Sort Key: t.t
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: t.t, (count(*))
         Backend: DataFusion
         Indexes: dac_posts_idx (p), dac_comments_idx (c)
         Group By: tags
         Aggregates: COUNT(*)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Single, gby=[p_0_tags@0 as p_0_tags], aggr=[count(1) as agg_0]
           :   UnnestExec
           :     ProjectionExec: expr=[tags@0 as p_0_tags]
           :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, post_id@0)], projection=[tags@0]
           :         CooperativeExec
           :           PgSearchScan: table=p, segments=2, eager=[tags], visibility=eager, query={"with_index":{"query":{"match":{"field":"title","value":"alpha","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
           :         CooperativeExec
           :           PgSearchScan: table=c, segments=2, dynamic_filters=1, visibility=eager, query="all"
(18 rows)

SELECT t, COUNT(*)
FROM dac_posts p
JOIN dac_comments c ON c.post_id = p.id
CROSS JOIN LATERAL unnest(p.tags) AS t
WHERE p.title ||| 'alpha'
GROUP BY t
ORDER BY t;
  t  | count 
-----+-------
 all |    15
 t0  |     3
 t1  |     3
 t2  |     6
 t3  |     3
