           : AggregateExec: mode=Single, gby=[c_1_labels@0 as c_1_labels], aggr=[count(1) as agg_0]
           :   UnnestExec
           :     TantivyDecodeExec: decode=[labels]
           :       ProjectionExec: expr=[labels@0 as c_1_labels]
           :         HashJoinExec: mode=CollectLeft, join_type=Left, on=[(id@0, post_id@1)], projection=[labels@1]
           :           CooperativeExec
           :             PgSearchScan: table=p, segments=2, visibility=eager, query={"with_index":{"query":{"match":{"field":"title","value":"alpha","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
           :           CooperativeExec
           :             PgSearchScan: table=c, segments=2, dynamic_filters=1, visibility=eager, query="all"
(19 rows)

