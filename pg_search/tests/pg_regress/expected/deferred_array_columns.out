-- A string and a list at one decode point: the string's term ordinals are fetched first,
-- and the decode reads the string from its ordinals and the list from its doc addresses.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT c.author, l, COUNT(*)
FROM dac_posts p
JOIN dac_comments c ON c.post_id = p.id
CROSS JOIN LATERAL unnest(c.labels) AS l
WHERE p.title ||| 'alpha'
GROUP BY c.author, l
ORDER BY c.author, l;
                                                                                                                           QUERY PLAN                                                                                                                            
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: c.author, l.l, (count(*))
   Sort Key: c.author, l.l
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: c.author, l.l, (count(*))
         Backend: DataFusion
         Indexes: dac_posts_idx (p), dac_comments_idx (c)
         Group By: author, labels
         Aggregates: COUNT(*)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Single, gby=[author@0 as author, c_1_labels@1 as c_1_labels], aggr=[count(1) as agg_0]
           :   UnnestExec
           :     TantivyDecodeExec: decode=[author, labels]
           :       TantivyFetchExec: fetch=[author]
           :         ProjectionExec: expr=[author@0 as author, labels@1 as c_1_labels]
           :           HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, post_id@2)], projection=[author@1, labels@2]
           :             CooperativeExec
           :               PgSearchScan: table=p, segments=2, visibility=eager, query={"with_index":{"query":{"match":{"field":"title","value":"alpha","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
           :             CooperativeExec
           :               PgSearchScan: table=c, segments=2, dynamic_filters=1, visibility=eager, query="all"
(20 rows)

