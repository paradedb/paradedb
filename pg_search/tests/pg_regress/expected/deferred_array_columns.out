-- =============================================================================
-- Other shapes that unnest a list above the join
-- =============================================================================
-- pdb.agg terms on a list unnests it above the join, and the list is read just below.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT pdb.agg('{"terms": {"field": "c.labels", "order": {"_key": "asc"}}}')
FROM dac_posts p JOIN dac_comments c ON c.post_id = p.id
WHERE p.title ||| 'alpha';
                                                                                                                           QUERY PLAN                                                                                                                            
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Output: (pdb.agg('{"terms": {"field": "c.labels", "order": {"_key": "asc"}}}'::jsonb))
   Backend: DataFusion
   Indexes: dac_posts_idx (p), dac_comments_idx (c)
   Aggregates: pdb.agg({"terms":{"field":"c.labels","order":{"_key":"asc"}}})
   DataFusion Physical Plan: 
     : CoalescePartitionsExec
     :   ProjectionExec: expr=[__grouping_id@1 as __grouping_id, __pdb_k0@0 as __pdb_k0, __pdb_m0@2 as __pdb_m0]
     :     UnionExec
     :       ProjectionExec: expr=[NULL as __pdb_k0, 1 as __grouping_id, __pdb_m0@0 as __pdb_m0]
     :         AggregateExec: mode=Single, gby=[], aggr=[count(1) as __pdb_m0]
     :           HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, post_id@0)], projection=[]
     :             CooperativeExec
     :               PgSearchScan: table=p, segments=2, visibility=eager, query={"with_index":{"query":{"match":{"field":"title","value":"alpha","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :             CooperativeExec
     :               PgSearchScan: table=c, segments=2, dynamic_filters=1, visibility=eager, query="all"
     :       ProjectionExec: expr=[__pdb_k0@0 as __pdb_k0, 0 as __grouping_id, __pdb_m0@1 as __pdb_m0]
     :         AggregateExec: mode=Single, gby=[c_1_labels@0 as __pdb_k0], aggr=[count(1) as __pdb_m0]
     :           UnnestExec
     :             TantivyDecodeExec: decode=[labels]
     :               ProjectionExec: expr=[labels@0 as c_1_labels]
     :                 HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, post_id@0)], projection=[labels@2]
     :                   CooperativeExec
     :                     PgSearchScan: table=p, segments=2, visibility=eager, query={"with_index":{"query":{"match":{"field":"title","value":"alpha","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :                   CooperativeExec
     :                     PgSearchScan: table=c, segments=2, dynamic_filters=1, visibility=eager, query="all"
