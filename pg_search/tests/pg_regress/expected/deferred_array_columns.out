-- The same list under a join scan: a worker reads it and folds it into the partial terms
-- aggregate, and the leader merges the partials.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT c.id, pdb.agg('{"terms": {"field": "c.labels", "order": {"_key": "asc"}}}'::jsonb) OVER ()
FROM dac_posts p JOIN dac_comments c ON c.post_id = p.id
WHERE p.title ||| 'alpha'
ORDER BY c.id
LIMIT 3;
                                                                                                               QUERY PLAN                                                                                                                
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: c.id, (pdb.window_agg('pdb.agg(''{"terms":{"field":"c.labels","order":{"_key":"asc"}}}'') OVER ()'::text))
   Relation Tree: p INNER c
   Join Cond: c.post_id = p.id
   Limit: 3
   Order By: c.id asc
   DataFusion Physical Plan: 
     : ┌───── DistributedExec
     : │ ProjectionExec: expr=[get_field(__topk@0, c0) as col_1, window_agg_1@1 as col_2, get_field(__topk@0, c1) as ctid_1]
     : │   GlobalLimitExec: skip=0, fetch=3
     : │     UnnestExec
     : │       AggregateExec: mode=Final, gby=[], aggr=[topk_as_agg(c_1.id, c_1.ctid_1, 3, [1]) ORDER BY [c_1.id ASC NULLS LAST] as __topk, pdb_agg({"terms":{"field":"c.labels","order":{"_key":"asc"}}}) as window_agg_1]
     : │         CoalescePartitionsExec
     : │           [Stage 2] => NetworkCoalesceExec: output_partitions=2, input_tasks=2
     : └──────────────────────────────────────────────────
     :   ┌───── Stage 2 ── tasks=2, partitions=2
     :   │ AggregateExec: mode=Partial, gby=[], aggr=[topk_as_agg(c_1.id, c_1.ctid_1, 3, [1]) ORDER BY [c_1.id ASC NULLS LAST] as __topk, pdb_agg({"terms":{"field":"c.labels","order":{"_key":"asc"}}}) as window_agg_1]
     :   │   TantivyDecodeExec: decode=[labels]
     :   │     VisibilityFilterExec: tables=[p, c], pruned=[p]
     :   │       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, post_id@1)], projection=[id@4, ctid_1@2, labels@5, ctid_0@1]
     :   │         CoalescePartitionsExec
     :   │           [Stage 1] => NetworkBroadcastExec: partitions_per_consumer=1, stage_partitions=2, input_tasks=2
     :   │         DistributedLeafExec:
     :   │           t0: PgSearchScan: table=c, segments=2, dynamic_filters=1, query="all"
     :   │           t1: PgSearchScan: table=c, segments=2, dynamic_filters=1, query="all"
     :   └──────────────────────────────────────────────────
     :     ┌───── Stage 1 ── tasks=2, partitions=4
     :     │ BroadcastExec: input_partitions=1, consumer_tasks=2, output_partitions=2
     :     │   DistributedLeafExec:
     :     │     t0: PgSearchScan: table=p, segments=2, query={"with_index":{"query":{"match":{"field":"title","value":"alpha","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :     │     t1: PgSearchScan: table=p, segments=2, query={"with_index":{"query":{"match":{"field":"title","value":"alpha","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :     └──────────────────────────────────────────────────
(32 rows)

