SELECT f.id, f.title
FROM dfd_documents d JOIN dfd_files f ON f.document_id = d.id
WHERE d.category @@@ 'PROJECT_ALPHA'
ORDER BY f.title ASC, f.id ASC
LIMIT 5;
                                                                                                  QUERY PLAN                                                                                                   
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: f.id, f.title
   ->  Custom Scan (ParadeDB Join Scan)
         Output: f.id, f.title
         Relation Tree: f INNER d
         Join Cond: d.id = f.document_id
         Limit: 5
         Order By: f.title asc, f.id asc
         DataFusion Physical Plan: 
           : ProjectionExec: expr=[id@2 as col_1, title@1 as col_2, ctid_0@0 as ctid_0, ctid_1@3 as ctid_1]
           :   SortExec: TopK(fetch=5), expr=[title@1 ASC NULLS LAST, id@2 ASC NULLS LAST], preserve_partitioning=[false]
           :     TantivyDecodeExec: decode=[title]
           :       TantivyFetchExec: fetch=[title]
           :         VisibilityFilterExec: tables=[f, d]
           :           TantivyFetchExec: fetch=[ctid_0, ctid_1]
           :             HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, document_id@1)], projection=[ctid_0@2, title@4, id@5, ctid_1@0]
           :               CooperativeExec
           :                 PgSearchScan: table=d, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"category","query_string":"PROJECT_ALPHA","lenient":null,"conjunction_mode":null}}}}
