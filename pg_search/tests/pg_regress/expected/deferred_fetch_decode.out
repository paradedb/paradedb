SELECT f.id, f.title, f.content
FROM dfd_documents d JOIN dfd_files f ON f.document_id = d.id
WHERE d.category @@@ 'GAMMA_DIVISION'
ORDER BY f.title DESC NULLS FIRST, f.content ASC
LIMIT 5;
                                                                                                 QUERY PLAN                                                                                                 
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: f.id, f.title, f.content
   ->  Custom Scan (ParadeDB Join Scan)
         Output: f.id, f.title, f.content
         Relation Tree: f INNER d
         Join Cond: d.id = f.document_id
         Limit: 5
         Order By: f.title desc, f.content asc
         DataFusion Physical Plan: 
           : ProjectionExec: expr=[NULL as col_1, title@1 as col_2, content@2 as col_3, ctid_0@0 as ctid_0, ctid_1@3 as ctid_1]
           :   TantivyDecodeExec: decode=[title, content]
           :     TantivyFetchExec: fetch=[title, content]
           :       SegmentedTopKExec: expr=[title@1 DESC, content@2 ASC NULLS LAST], k=5, visibility_checks=[f, d]
           :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, document_id@1)], projection=[ctid_0@2, title@4, content@5, ctid_1@0]
           :           CooperativeExec
           :             PgSearchScan: table=d, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"category","query_string":"GAMMA_DIVISION","lenient":null,"conjunction_mode":null}}}}
           :           CooperativeExec
           :             PgSearchScan: table=f, segments=2, dynamic_filters=2, query="all"
(18 rows)

