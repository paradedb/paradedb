RESET paradedb.enable_segmented_topk;
-- An aggregate over the join decodes its group key above the visibility filter.
SET paradedb.enable_aggregate_late_materialization = on;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT f.title, COUNT(*)
FROM dfd_documents d JOIN dfd_files f ON f.document_id = d.id
WHERE d.category @@@ 'BETA_GROUP'
GROUP BY f.title
ORDER BY f.title NULLS LAST
LIMIT 5;
                                                                                                    QUERY PLAN                                                                                                    
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: f.title, (count(*))
   ->  Sort
         Output: f.title, (count(*))
         Sort Key: f.title
         ->  Custom Scan (ParadeDB Aggregate Scan)
               Output: f.title, (count(*))
               Backend: DataFusion
               Indexes: dfd_documents_idx (d), dfd_files_idx (f)
               Group By: title
               Aggregates: COUNT(*)
               DataFusion Physical Plan: 
                 : SortExec: TopK(fetch=5), expr=[title@0 ASC NULLS LAST], preserve_partitioning=[false]
                 :   AggregateExec: mode=Single, gby=[title@0 as title], aggr=[count(1) as agg_0]
                 :     TantivyDecodeExec: decode=[title]
                 :       TantivyFetchExec: fetch=[title]
                 :         VisibilityFilterExec: tables=[d, f]
                 :           TantivyFetchExec: fetch=[ctid_0, ctid_1]
                 :             HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, document_id@0)], projection=[title@3, ctid_0@1, ctid_1@4]
                 :               CooperativeExec
                 :                 PgSearchScan: table=d, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"category","query_string":"BETA_GROUP","lenient":null,"conjunction_mode":null}}}}
                 :               CooperativeExec
                 :                 PgSearchScan: table=f, segments=2, dynamic_filters=2, query="all"
(23 rows)

