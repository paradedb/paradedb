           : ProjectionExec: expr=[id@2 as col_1, title@1 as col_2, ctid_0@0 as ctid_0, ctid_1@3 as ctid_1]
           :   TantivyDecodeExec: decode=[title]
           :     TantivyFetchExec: fetch=[title]
           :       SegmentedTopKExec: expr=[title@1 DESC, id@2 ASC NULLS LAST], k=4, visibility_checks=[f, d]
           :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, document_id@1)], projection=[ctid_0@2, title@4, id@5, ctid_1@0]
           :           CooperativeExec
           :             PgSearchScan: table=d, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"category","query_string":"BETA_GROUP","lenient":null,"conjunction_mode":null}}}}
           :           CooperativeExec
           :             PgSearchScan: table=f, segments=2, dynamic_filters=2, query="all"
