-- A group with a multi-word alternative takes the best of its alternatives, and the explanation
-- has the one that the row holds.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT id,
       pdb.explain_score(id)->>'description' AS description,
       jsonb_path_query_array(pdb.explain_score(id), '$.details[*].description') AS alternatives
FROM explain_products
WHERE description ||| (SELECT pdb.expand('trainers', rule) FROM explain_synonyms) ORDER BY id;
                                                                                                 QUERY PLAN                                                                                                 
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: id, ((pdb.explain_score(id) ->> 'description'::text)), (jsonb_path_query_array(pdb.explain_score(id), '$."details"[*]."description"'::jsonpath, '{}'::jsonb, false))
   Sort Key: explain_products.id
   ->  Custom Scan (ParadeDB Base Scan) on public.explain_products
         Output: id, (pdb.explain_score(id) ->> 'description'::text), jsonb_path_query_array(pdb.explain_score(id), '$."details"[*]."description"'::jsonpath, '{}'::jsonb, false)
         Table: explain_products
         Index: explain_products_idx
         Worker Selection: Cost model
         Exec Method: NormalScanExecState
         Scores: true
         Tantivy Query: {"with_index":{"query":{"match":{"field":"description","value":"trainers","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
         Synonyms: explain_synonyms_idx
(12 rows)

SELECT id,
       pdb.explain_score(id)->>'description' AS description,
       jsonb_path_query_array(pdb.explain_score(id), '$.details[*].description') AS alternatives
FROM explain_products
WHERE description ||| (SELECT pdb.expand('trainers', rule) FROM explain_synonyms) ORDER BY id;
 id |        description         |         alternatives         
----+----------------------------+------------------------------
  4 | DisjunctionMax. max of ... | ["Phrase Scorer"]
  6 | DisjunctionMax. max of ... | ["TermQuery, product of..."]
(2 rows)

-- The explanation of a Top K row has the score of that row.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT id, pdb.score(id), (pdb.explain_score(id)->>'value')::real = pdb.score(id) AS same
FROM explain_products
WHERE description ||| (SELECT pdb.expand('red sofa', rule) FROM explain_synonyms)
ORDER BY pdb.score(id) DESC, id LIMIT 3;
                                                                                                 QUERY PLAN                                                                                                 
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: id, (pdb.score(id)), ((((pdb.explain_score(id) ->> 'value'::text))::real = pdb.score(id)))
   ->  Custom Scan (ParadeDB Base Scan) on public.explain_products
         Output: id, pdb.score(id), (((pdb.explain_score(id) ->> 'value'::text))::real = pdb.score(id))
         Table: explain_products
         Index: explain_products_idx
         Worker Selection: Cost model
         Exec Method: TopKScanExecState
         Scores: true
            TopK Order By: pdb.score() desc, id asc
            TopK Limit: 3
         Tantivy Query: {"with_index":{"query":{"match":{"field":"description","value":"red sofa","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
         Synonyms: explain_synonyms_idx
(13 rows)

SELECT id, pdb.score(id), (pdb.explain_score(id)->>'value')::real = pdb.score(id) AS same
FROM explain_products
WHERE description ||| (SELECT pdb.expand('red sofa', rule) FROM explain_synonyms)
ORDER BY pdb.score(id) DESC, id LIMIT 3;
 id |   score   | same 
----+-----------+------
  1 | 1.9584033 | t
  2 | 1.5528046 | t
  3 | 1.1704489 | t
(3 rows)

-- A row that matches one side of an `OR` explains with that side, also when the other side
-- first matches a later row.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT id, pdb.score(id), (pdb.explain_score(id)->>'value')::real = pdb.score(id) AS same
FROM explain_products WHERE description ||| 'red' OR id > 4 ORDER BY id;
                                                                                                                                               QUERY PLAN                                                                                                                                                
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: id, (pdb.score(id)), ((((pdb.explain_score(id) ->> 'value'::text))::real = pdb.score(id)))
   Sort Key: explain_products.id
   ->  Custom Scan (ParadeDB Base Scan) on public.explain_products
         Output: id, pdb.score(id), (((pdb.explain_score(id) ->> 'value'::text))::real = pdb.score(id))
         Table: explain_products
         Index: explain_products_idx
         Worker Selection: Cost model
         Exec Method: NormalScanExecState
         Scores: true
         Tantivy Query: {"boolean":{"should":[{"with_index":{"query":{"match":{"field":"description","value":"red","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}},{"range":{"field":"id","lower_bound":{"excluded":4},"upper_bound":null}}]}}
(11 rows)

SELECT id, pdb.score(id), (pdb.explain_score(id)->>'value')::real = pdb.score(id) AS same
FROM explain_products WHERE description ||| 'red' OR id > 4 ORDER BY id;
 id |   score    | same 
----+------------+------
  1 |  0.7879545 | t
  2 | 0.47566426 | t
  5 |  1.7879546 | t
  6 |          1 | t
(4 rows)

-- The Join Scan does not explain a score, so the Base Scan of the table does.
CREATE TABLE explain_orders (id int PRIMARY KEY, product_id int, note text);
INSERT INTO explain_orders VALUES (1, 1, 'fast'), (2, 2, 'slow'), (3, 5, 'fast');
CREATE INDEX explain_orders_idx ON explain_orders USING bm25 (id, product_id, note);
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT o.id, p.id, (pdb.explain_score(p.id)->>'value')::real = pdb.score(p.id) AS same
FROM explain_orders o JOIN explain_products p ON p.id = o.product_id
WHERE p.description ||| 'red' ORDER BY pdb.score(p.id) DESC, o.id LIMIT 2;
WARNING:  JoinScan not used: pdb.explain_score is not supported (tables: o, p)
                                                                                                       QUERY PLAN                                                                                                        
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: o.id, p.id, (((((pdb.explain_score(p.id)) ->> 'value'::text))::real = (pdb.score(p.id)))), (pdb.score(p.id))
   ->  Sort
         Output: o.id, p.id, (((((pdb.explain_score(p.id)) ->> 'value'::text))::real = (pdb.score(p.id)))), (pdb.score(p.id))
         Sort Key: (pdb.score(p.id)) DESC, o.id
         ->  Nested Loop
               Output: o.id, p.id, ((((pdb.explain_score(p.id)) ->> 'value'::text))::real = (pdb.score(p.id))), (pdb.score(p.id))
               Inner Unique: true
               Join Filter: (o.product_id = p.id)
               ->  Seq Scan on public.explain_orders o
                     Output: o.id, o.product_id, o.note
               ->  Materialize
                     Output: p.id, (pdb.explain_score(p.id)), (pdb.score(p.id)), (pdb.score(p.id)), (pdb.explain_score(p.id)), (pdb.score(p.id)), (pdb.score(p.id))
                     ->  Custom Scan (ParadeDB Base Scan) on public.explain_products p
                           Output: p.id, pdb.explain_score(p.id), pdb.score(p.id), pdb.score(p.id), pdb.explain_score(p.id), pdb.score(p.id), pdb.score(p.id)
                           Table: explain_products
                           Index: explain_products_idx
                           Worker Selection: Cost model
                           Exec Method: NormalScanExecState
                           Scores: true
                           Tantivy Query: {"with_index":{"query":{"match":{"field":"description","value":"red","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(21 rows)

SELECT o.id, p.id, (pdb.explain_score(p.id)->>'value')::real = pdb.score(p.id) AS same
FROM explain_orders o JOIN explain_products p ON p.id = o.product_id
WHERE p.description ||| 'red' ORDER BY pdb.score(p.id) DESC, o.id LIMIT 2;
WARNING:  JoinScan not used: pdb.explain_score is not supported (tables: o, p)
 id | id | same 
----+----+------
  1 |  1 | t
  3 |  5 | t
(2 rows)

-- The scan gives the explanation with its output, so a `WHERE` clause can't read it.
SELECT id FROM explain_products
WHERE description ||| 'red' AND (pdb.explain_score(id)->>'value')::real > 0.5;
ERROR:  `pdb.explain_score` must be in the `SELECT` list of a query that a ParadeDB scan evaluates
-- A query with no search operator has no score to explain.
SELECT id, pdb.explain_score(id) FROM explain_products WHERE id = 1;
ERROR:  `pdb.explain_score` must be in the `SELECT` list of a query that a ParadeDB scan evaluates
DROP TABLE explain_products, explain_orders, explain_synonyms;
