-- A synonym group is one term. Its frequency is the sum over the words of the group that the
-- row holds, and row 2 holds two of them.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT id,
       pdb.explain_score(id)->>'description' AS description,
       jsonb_pretty(pdb.explain_score(id) #> '{details,2,details,0}') AS frequency
FROM explain_products
WHERE description ||| (SELECT pdb.expand('sofa', rule) FROM explain_synonyms) ORDER BY id;
                                                                                               QUERY PLAN                                                                                               
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: id, ((pdb.explain_score(id) ->> 'description'::text)), (jsonb_pretty((pdb.explain_score(id) #> '{details,2,details,0}'::text[])))
   Sort Key: explain_products.id
   ->  Custom Scan (ParadeDB Base Scan) on public.explain_products
         Output: id, (pdb.explain_score(id) ->> 'description'::text), jsonb_pretty((pdb.explain_score(id) #> '{details,2,details,0}'::text[]))
         Table: explain_products
         Index: explain_products_idx
         Worker Selection: Cost model
         Exec Method: NormalScanExecState
         Scores: true
         Tantivy Query: {"with_index":{"query":{"match":{"field":"description","value":"sofa","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
         Synonyms: explain_synonyms_idx
(12 rows)

SELECT id,
       pdb.explain_score(id)->>'description' AS description,
       jsonb_pretty(pdb.explain_score(id) #> '{details,2,details,0}') AS frequency
FROM explain_products
WHERE description ||| (SELECT pdb.expand('sofa', rule) FROM explain_synonyms) ORDER BY id;
