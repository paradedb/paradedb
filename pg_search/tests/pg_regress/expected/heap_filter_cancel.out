         Columnar: id
         Scores: false
         Tantivy Query: {"boolean":{"must":[{"with_index":{"query":{"match":{"field":"body","value":"fox","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}},{"boolean":{"should":[{"heap_filter":{"indexed_query":"all","always_filters":[{"heap_filter":"(pg_cancel_backend(((pg_backend_pid() + (id - id)) + (0 * (nextval('heap_filter_cancel_calls'::regclass))::integer))) IS FALSE)"}]}},{"heap_filter":{"indexed_query":"all","always_filters":[{"heap_filter":"(extra = '-1'::integer)"}]}}]}}]}}
(8 rows)

SELECT id FROM heap_filter_cancel
WHERE body ||| 'fox' AND (
    pg_cancel_backend(pg_backend_pid() + (id - id)
        + 0 * nextval('heap_filter_cancel_calls')::integer) IS FALSE
    OR extra = -1
