   Output: pdb.agg_fn('COUNT(*)'::text)
   Index: idx_inet
   Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"ip","query_string":"1.2.3.4","lenient":null,"conjunction_mode":null}}}}
