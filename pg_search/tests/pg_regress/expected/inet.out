CREATE EXTENSION IF NOT EXISTS pg_search;
SET paradedb.enable_aggregate_custom_scan TO on;
DROP TABLE IF EXISTS tbl_inet;
CREATE TABLE tbl_inet (id int, ip inet);
CREATE INDEX idx_inet
    ON tbl_inet
    USING bm25 (id, ip)
    WITH (key_field = 'id');
INSERT INTO tbl_inet (id, ip) VALUES
    (1, '192.168.1.5/24'),
    (2, '192.168.1.5/32'),
    (3, '1.2.3.4'),
    (4, '::ffff:1.2.3.4'),
    (5, '255.255.255.255'),
    (6, '::1'),
    (7, NULL);
SELECT count(*) FROM tbl_inet WHERE ip @@@ '1.2.3.4';
 count 
-------
     1
(1 row)

EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF, VERBOSE)
SELECT count(*) FROM tbl_inet WHERE ip @@@ '1.2.3.4';
                                                                  QUERY PLAN                                                                   
-----------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan) on public.tbl_inet
   Output: pdb.agg_fn('COUNT(*)'::text)
   Index: idx_inet
   Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"ip","query_string":"1.2.3.4","lenient":null,"conjunction_mode":null}}}}
     Applies to Aggregates: COUNT(*)
     Aggregate Definition: {"0":{"value_count":{"field":"ctid","missing":null}}}
(6 rows)

