-- without this the Aggregate Scan takes the unpartitioned join and no heap filter shows
SET paradedb.enable_aggregate_custom_scan = off;
SELECT explain_4643($$
SELECT count(*)
FROM orders_plain o JOIN products p ON o.order_id = p.product_id
WHERE o.customer_name ||| 'John' OR p.description ||| 'blue'
$$);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       explain_4643                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Aggregate
   ->  Hash Join
         Hash Cond: (o.order_id = p.product_id)
         Join Filter: (paradedb.search_with_query_input_ctid_or_row(o.order_id, '{"with_index":{"oid":N,"query":{"match":{"field":"customer_name","value":"John","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}'::paradedb.searchqueryinput, o.ctid, CASE WHEN (paradedb.ctid_is_valid(o.ctid) IS NOT TRUE) THEN (ARRAY[o.*])::record[] WHEN (paradedb.xmin_is_visible(o.xmin, o.tableoid, o.ctid) IS NOT TRUE) THEN (ARRAY[o.*])::record[] ELSE '{}'::record[] END, ROW()) OR paradedb.search_with_query_input_ctid_or_row(p.product_id, '{"with_index":{"oid":N,"query":{"match":{"field":"description","value":"blue","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}'::paradedb.searchqueryinput, p.ctid, CASE WHEN (paradedb.ctid_is_valid(p.ctid) IS NOT TRUE) THEN (ARRAY[p.*])::record[] WHEN (paradedb.xmin_is_visible(p.xmin, p.tableoid, p.ctid) IS NOT TRUE) THEN (ARRAY[p.*])::record[] ELSE '{}'::record[] END, ROW()))
         ->  Seq Scan on orders_plain o
         ->  Hash
               ->  Seq Scan on products p
