DROP TABLE orders_part CASCADE;
DROP TABLE products CASCADE;
DROP TABLE leak_part CASCADE;
DROP TABLE leak_plain CASCADE;
DROP TABLE dup_part CASCADE;
DROP TABLE ml_part CASCADE;
