  $$EXECUTE issue_5751_cross_param(0)$$,
  true
) = issue_5751_result(
  $$SELECT count(*)
    FROM issue_5751_entries e
    JOIN issue_5751_series s ON s.id = e.series_id
    WHERE s.id + 0 > e.series_id$$,
  false
) AS cross_param_matches_postgres;
