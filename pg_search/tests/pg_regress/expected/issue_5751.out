TRUNCATE issue_5751_entries, issue_5751_series;
SELECT count(*) AS empty_count
FROM issue_5751_entries e
JOIN issue_5751_series s ON s.id = e.series_id
WHERE s.state = 'active' AND e.user_id = 'u1';
