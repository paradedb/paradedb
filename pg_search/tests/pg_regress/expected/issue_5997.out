-- RelabelType varchar::text is still a raw sort on the varchar column.
EXPLAIN (COSTS OFF, TIMING OFF)
SELECT title_vc FROM issue_5997
WHERE title @@@ 'doc'
ORDER BY title_vc::text COLLATE "C"
LIMIT 4;
                                                                     QUERY PLAN                                                                     
----------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Custom Scan (ParadeDB Base Scan) on issue_5997
         Table: issue_5997
         Index: issue_5997_idx
         Exec Method: TopKScanExecState
         Scores: false
            TopK Order By: title_vc asc
            TopK Limit: 4
         Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"doc","lenient":null,"conjunction_mode":null}}}}
(9 rows)

