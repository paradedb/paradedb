-- AggregateScan shares the sort classifier. More distinct n than LIMIT so a
-- numeric pushdown would return the wrong set (1, 2, 3, 4), not only order.
SET paradedb.enable_aggregate_custom_scan = on;
EXPLAIN (COSTS OFF, TIMING OFF)
SELECT n::text AS t, count(*) FROM issue_5997
WHERE title @@@ 'doc'
GROUP BY n::text
ORDER BY n::text COLLATE "C"
LIMIT 4;
                                                                        QUERY PLAN                                                                        
----------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Sort
         Sort Key: ((n)::text) COLLATE "C"
         ->  Custom Scan (ParadeDB Aggregate Scan) on issue_5997
               Index: issue_5997_idx
               Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"doc","lenient":null,"conjunction_mode":null}}}}
                 Applies to Aggregates: COUNT(*)
                 Group By: n
                 Limit: 4
                 Aggregate Definition: {"grouped":{"terms":{"field":"n","segment_size":65000,"size":65000}}}
(10 rows)

SELECT n::text AS t, count(*) FROM issue_5997
WHERE title @@@ 'doc'
GROUP BY n::text
ORDER BY n::text COLLATE "C"
LIMIT 4;
  t  | count 
-----+-------
 1   |     1
 10  |     1
 100 |     1
 11  |     1
(4 rows)

RESET paradedb.enable_aggregate_custom_scan;
DROP TABLE issue_5997 CASCADE;
