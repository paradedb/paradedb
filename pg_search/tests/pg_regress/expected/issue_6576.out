-- 8) A set-returning function in the SELECT list. Postgres can't evaluate it
--    as a per-row projection after the scan, so it still declines.
EXPLAIN (COSTS OFF)
SELECT s.id, unnest(s.tags) AS tag
FROM issue_6576_s s JOIN issue_6576_e e ON e.s_id = s.id
WHERE s.id @@@ paradedb.match('title', 'dragon') AND e.id @@@ paradedb.term('u', 'u1')
ORDER BY s.id LIMIT 5;
                                                                                                        QUERY PLAN                                                                                                         
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  ProjectSet
         ->  Result
               ->  Sort
                     Sort Key: s.id
                     ->  Hash Join
                           Hash Cond: (s.id = e.s_id)
                           ->  Custom Scan (ParadeDB Base Scan) on issue_6576_s s
                                 Table: issue_6576_s
                                 Index: issue_6576_s_idx
                                 Exec Method: NormalScanExecState
                                 Scores: false
                                 Tantivy Query: {"with_index":{"query":{"match":{"field":"title","value":"dragon","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":null}}}}
                           ->  Hash
                                 ->  Custom Scan (ParadeDB Base Scan) on issue_6576_e e
                                       Table: issue_6576_e
                                       Index: issue_6576_e_idx
                                       Exec Method: NormalScanExecState
                                       Scores: false
                                       Tantivy Query: {"with_index":{"query":{"term":{"field":"u","value":"u1"}}}}
(20 rows)

EXPLAIN (COSTS OFF)
SELECT s.id, regexp_split_to_table(s.path, '/') AS part
FROM issue_6576_s s JOIN issue_6576_e e ON e.s_id = s.id
WHERE s.id @@@ paradedb.match('title', 'dragon') AND e.id @@@ paradedb.term('u', 'u1')
ORDER BY s.id LIMIT 5;
                                                                                                        QUERY PLAN                                                                                                         
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  ProjectSet
         ->  Result
               ->  Sort
                     Sort Key: s.id
