SET paradedb.enable_join_custom_scan = on;
-- 5) An expression over a non-columnar column used as an ORDER BY key: the
--    scan sorts on it, so it should still decline, but without a message.
--    Any SRF in the target list sets hasTargetSRFs, which will cause the query
--    to be declined earlier by the LIMIT pushdown check.
EXPLAIN (COSTS OFF)
SELECT s.id, 'x/' || s.path AS url
FROM issue_6576_s s JOIN issue_6576_e e ON e.s_id = s.id
WHERE s.id @@@ paradedb.match('title', 'dragon') AND e.id @@@ paradedb.term('u', 'u1')
ORDER BY 'x/' || s.path, s.id LIMIT 5;
WARNING:  JoinScan not used: unsupported ORDER BY expression shape; expressions must match an indexed expression or be a sum of pdb.score() calls (tables: e, s)
                                                                                                  QUERY PLAN                                                                                                   
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Sort
         Sort Key: (('x/'::text || s.path)), s.id
         ->  Hash Join
               Hash Cond: (s.id = e.s_id)
               ->  Custom Scan (ParadeDB Base Scan) on issue_6576_s s
                     Table: issue_6576_s
                     Index: issue_6576_s_idx
                     Exec Method: NormalScanExecState
                     Scores: false
                     Tantivy Query: {"with_index":{"query":{"match":{"field":"title","value":"dragon","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":null}}}}
               ->  Hash
                     ->  Custom Scan (ParadeDB Base Scan) on issue_6576_e e
                           Table: issue_6576_e
                           Index: issue_6576_e_idx
                           Exec Method: NormalScanExecState
                           Scores: false
                           Tantivy Query: {"with_index":{"query":{"term":{"field":"u","value":"u1"}}}}
(18 rows)

-- 6) An expression over a non-columnar column used as a DISTINCT key: the scan
--    deduplicates on it, so it still declines.
EXPLAIN (COSTS OFF)
SELECT DISTINCT 'x/' || s.path AS url
FROM issue_6576_s s JOIN issue_6576_e e ON e.s_id = s.id
WHERE s.id @@@ paradedb.match('title', 'dragon') AND e.id @@@ paradedb.term('u', 'u1')
LIMIT 5;
WARNING:  JoinScan not used: DISTINCT columns must be columnar indexed (tables: e, s)
                                                                                                  QUERY PLAN                                                                                                   
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  HashAggregate
         Group Key: ('x/'::text || s.path)
         ->  Hash Join
               Hash Cond: (s.id = e.s_id)
               ->  Custom Scan (ParadeDB Base Scan) on issue_6576_s s
                     Table: issue_6576_s
                     Index: issue_6576_s_idx
                     Exec Method: NormalScanExecState
                     Scores: false
                     Tantivy Query: {"with_index":{"query":{"match":{"field":"title","value":"dragon","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":null}}}}
               ->  Hash
                     ->  Custom Scan (ParadeDB Base Scan) on issue_6576_e e
                           Table: issue_6576_e
                           Index: issue_6576_e_idx
                           Exec Method: NormalScanExecState
                           Scores: false
                           Tantivy Query: {"with_index":{"query":{"term":{"field":"u","value":"u1"}}}}
(18 rows)

-- 7) An expression over a non-columnar column and a LATERAL unnest column.
--    The unnest column is an output of the scan, so Postgres can evaluate the
--    expression after it. It must take the Join Scan.
EXPLAIN (COSTS OFF)
SELECT s.id, s.path || ':' || t AS x
FROM issue_6576_s s JOIN issue_6576_e e ON e.s_id = s.id
CROSS JOIN LATERAL unnest(s.tags) AS t
WHERE s.id @@@ paradedb.match('title', 'dragon')
ORDER BY s.id, t LIMIT 5;
                                                                                                                         QUERY PLAN                                                                                                                         
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: (s INNER e) CROSS JOIN LATERAL UNNEST (tags)
   Join Cond: e.s_id = s.id
   Limit: 5
   Order By: e.s_id asc, tags asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, NULL as col_2, s_0_tags@1 as col_3, ctid_0@0 as ctid_0]
     :   SortExec: TopK(fetch=5), expr=[s_id@3 ASC NULLS LAST, s_0_tags@1 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[s, e], pruned=[e]
     :       UnnestExec
     :         ProjectionExec: expr=[ctid_0@2 as ctid_0, tags@3 as s_0_tags, id@4 as id, s_id@0 as s_id, ctid_1@1 as ctid_1]
     :           HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(s_id@0, id@2)]
     :             CooperativeExec
     :               PgSearchScan: table=e, segments=1, query="all"
     :             CooperativeExec
     :               PgSearchScan: table=s, segments=1, dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"title","value":"dragon","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":null}}}}
(16 rows)

SELECT s.id, s.path || ':' || t AS x
FROM issue_6576_s s JOIN issue_6576_e e ON e.s_id = s.id
CROSS JOIN LATERAL unnest(s.tags) AS t
WHERE s.id @@@ paradedb.match('title', 'dragon')
ORDER BY s.id, t LIMIT 5;
