SET paradedb.enable_join_custom_scan = on;
-- 3) An inner join projecting an expression over non-columnar columns of both
--    sides. It must take the Join Scan.
EXPLAIN (COSTS OFF)
SELECT s.id, 'x/' || s.path AS url, s.path || ':' || e.note AS tag
FROM issue_6576_s s JOIN issue_6576_e e ON e.s_id = s.id
WHERE s.id @@@ paradedb.match('title', 'dragon') AND e.id @@@ paradedb.term('u', 'u1')
ORDER BY s.rating DESC, s.id LIMIT 5;
                                                                                                                       QUERY PLAN                                                                                                                       
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: s INNER e
   Join Cond: e.s_id = s.id
   Limit: 5
   Order By: s.rating desc, e.s_id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@1 as col_1, NULL as col_2, NULL as col_3, rating@2 as col_4, ctid_0@0 as ctid_0, ctid_1@3 as ctid_1]
     :   SortExec: TopK(fetch=5), expr=[rating@2 DESC, s_id@4 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[s, e]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(s_id@1, id@1)], projection=[ctid_0@2, id@3, rating@4, ctid_1@0, s_id@1]
     :         CooperativeExec
     :           PgSearchScan: table=e, segments=1, query={"with_index":{"query":{"term":{"field":"u","value":"u1"}}}}
     :         CooperativeExec
     :           PgSearchScan: table=s, segments=1, dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"title","value":"dragon","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":null}}}}
(14 rows)

SELECT s.id, 'x/' || s.path AS url, s.path || ':' || e.note AS tag
FROM issue_6576_s s JOIN issue_6576_e e ON e.s_id = s.id
WHERE s.id @@@ paradedb.match('title', 'dragon') AND e.id @@@ paradedb.term('u', 'u1')
ORDER BY s.rating DESC, s.id LIMIT 5;
