SET paradedb.enable_join_custom_scan = on;
-- 4) A left join whose expression reads a non-columnar column of the
--    null-extended side. Unmatched rows evaluate the expression over NULL
--    inputs, and rows whose `note` is NULL do the same.
--
--    Control: the bare column takes the Join Scan.
EXPLAIN (COSTS OFF)
SELECT s.id, e.note
FROM issue_6576_s s LEFT JOIN issue_6576_e e ON e.s_id = s.id
WHERE s.id @@@ paradedb.match('title', 'dragon')
ORDER BY s.id LIMIT 10;
                                                                                                                       QUERY PLAN                                                                                                                       
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: s LEFT e
   Join Cond: e.s_id = s.id
   Limit: 10
   Order By: s.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@1 as col_1, NULL as col_2, ctid_0@0 as ctid_0, ctid_1@2 as ctid_1]
     :   SortExec: TopK(fetch=10), expr=[id@1 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[s]
     :       HashJoinExec: mode=CollectLeft, join_type=Right, on=[(s_id@1, id@1)], projection=[ctid_0@2, id@3, ctid_1@0]
     :         CooperativeExec
     :           PgSearchScan: table=e, segments=1, visibility=eager, query="all"
     :         CooperativeExec
     :           PgSearchScan: table=s, segments=1, dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"title","value":"dragon","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":null}}}}
(14 rows)

EXPLAIN (COSTS OFF)
SELECT s.id, coalesce('n/' || e.note, 'none') AS note_url
FROM issue_6576_s s LEFT JOIN issue_6576_e e ON e.s_id = s.id
WHERE s.id @@@ paradedb.match('title', 'dragon')
ORDER BY s.id LIMIT 10;
                                                                                                                       QUERY PLAN                                                                                                                       
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: s LEFT e
   Join Cond: e.s_id = s.id
   Limit: 10
   Order By: s.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@1 as col_1, NULL as col_2, ctid_0@0 as ctid_0, ctid_1@2 as ctid_1]
     :   SortExec: TopK(fetch=10), expr=[id@1 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[s]
     :       HashJoinExec: mode=CollectLeft, join_type=Right, on=[(s_id@1, id@1)], projection=[ctid_0@2, id@3, ctid_1@0]
     :         CooperativeExec
     :           PgSearchScan: table=e, segments=1, visibility=eager, query="all"
     :         CooperativeExec
     :           PgSearchScan: table=s, segments=1, dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"title","value":"dragon","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":null}}}}
(14 rows)

