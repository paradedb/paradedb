-- =============================================================================
-- DATE: d::text in an anti-join
-- =============================================================================
EXPLAIN (COSTS OFF)
SELECT s.id, s.d::text AS d FROM i6577_s s
WHERE s.id @@@ paradedb.match('title', 'dragon')
  AND NOT EXISTS (SELECT 1 FROM i6577_e e WHERE e.s_id = s.id AND e.id @@@ paradedb.term('u', 'u1'))
ORDER BY paradedb.score(s.id) DESC, s.rating DESC, s.id LIMIT 3;
                                                                                                                       QUERY PLAN                                                                                                                       
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: s ANTI e
   Join Cond: e.s_id = s.id
   Limit: 3
   Order By: pdb.score(s) desc, s.rating desc, s.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, pdb_eval_expr_coerceviaio_19bc6715(d@4) as col_2, pdb.score(s)@0 as col_3, rating@3 as col_4, ctid_0@1 as ctid_0]
     :   SortExec: TopK(fetch=3), expr=[pdb.score(s)@0 DESC, rating@3 DESC, id@2 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[s]
     :       HashJoinExec: mode=CollectLeft, join_type=RightAnti, on=[(s_id@0, id@2)]
     :         CooperativeExec
     :           PgSearchScan: table=e, segments=1, visibility=eager, query={"with_index":{"query":{"term":{"field":"u","value":"u1"}}}}
     :         CooperativeExec
     :           PgSearchScan: table=s, segments=1, dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"title","value":"dragon","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":null}}}}
(14 rows)

