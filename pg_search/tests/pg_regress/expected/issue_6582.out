-- 5) A rescan of the scan for each outer row.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT k, x.*
FROM generate_series(1, 2) AS k,
     LATERAL (
         SELECT c.id, paradedb.score(c.id) AS score
         FROM issue_6582_chunks c
         WHERE c.body @@@ 'fred' AND c.id <= 100
         ORDER BY (c.id IN (SELECT chunk_id FROM issue_6582_terms WHERE term_id = k)) DESC,
                  score DESC,
                  c.id
         LIMIT 3
     ) x
ORDER BY k, x.id;
                                                                                                                               QUERY PLAN                                                                                                                               
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: k.k, c.id, (paradedb.score(c.id))
   Sort Key: k.k, c.id
   ->  Nested Loop
         Output: k.k, c.id, (paradedb.score(c.id))
         ->  Function Scan on pg_catalog.generate_series k
               Output: k.k
               Function Call: generate_series(1, 2)
         ->  Limit
               Output: c.id, (paradedb.score(c.id)), ((ANY (c.id = (hashed SubPlan 1).col1)))
               ->  Sort
                     Output: c.id, (paradedb.score(c.id)), ((ANY (c.id = (hashed SubPlan 1).col1)))
                     Sort Key: ((ANY (c.id = (hashed SubPlan 1).col1))) DESC, (paradedb.score(c.id)) DESC, c.id
                     ->  Custom Scan (ParadeDB Base Scan) on public.issue_6582_chunks c
                           Output: c.id, paradedb.score(c.id), (ANY (c.id = (hashed SubPlan 1).col1))
                           Table: issue_6582_chunks
                           Index: issue_6582_chunks_idx
                           Worker Selection: Cost model
                           Exec Method: NormalScanExecState
                           Scores: true
                           Tantivy Query: {"boolean":{"must":[{"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"fred","lenient":null,"conjunction_mode":null}}}},{"range":{"field":"id","lower_bound":null,"upper_bound":{"included":100}}}]}}
                           SubPlan 1
                             ->  Seq Scan on public.issue_6582_terms
                                   Output: issue_6582_terms.chunk_id
                                   Filter: (issue_6582_terms.term_id = k.k)
(25 rows)

