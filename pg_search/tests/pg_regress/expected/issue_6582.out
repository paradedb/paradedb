-- 4) A Top K scan.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT id, paradedb.score(id) AS score,
       id IN (SELECT chunk_id - 4 FROM issue_6582_terms WHERE term_id = 2) AS tagged
FROM issue_6582_chunks
WHERE body @@@ 'fred' AND id <= 60
ORDER BY score DESC, id
LIMIT 5;
                                                                                                                     QUERY PLAN                                                                                                                      
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: issue_6582_chunks.id, (paradedb.score(issue_6582_chunks.id)), ((ANY (issue_6582_chunks.id = (hashed SubPlan 1).col1)))
   ->  Custom Scan (ParadeDB Base Scan) on public.issue_6582_chunks
         Output: issue_6582_chunks.id, paradedb.score(issue_6582_chunks.id), (ANY (issue_6582_chunks.id = (hashed SubPlan 1).col1))
         Table: issue_6582_chunks
         Index: issue_6582_chunks_idx
         Worker Selection: Cost model
         Exec Method: TopKScanExecState
         Scores: true
            TopK Order By: pdb.score() desc, id asc
            TopK Limit: 5
         Tantivy Query: {"boolean":{"must":[{"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"fred","lenient":null,"conjunction_mode":null}}}},{"range":{"field":"id","lower_bound":null,"upper_bound":{"included":60}}}]}}
         SubPlan 1
           ->  Seq Scan on public.issue_6582_terms
                 Output: (issue_6582_terms.chunk_id - 4)
                 Filter: (issue_6582_terms.term_id = 2)
(16 rows)

SELECT id, paradedb.score(id) AS score,
