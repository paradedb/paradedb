-- Regression coverage for issue #6699.
--
-- Search predicates (`|||`, `&&&`, `@@@`) inside an aggregate FILTER clause
-- must be pushed down to the DataFusion aggregate scan as tagged scan columns,
-- rather than falling back to a native GroupAggregate that evaluates the
-- search operator row by row.
\i common/common_setup.sql
CREATE EXTENSION IF NOT EXISTS pg_search;
-- Disable parallel workers to avoid differences in plans
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan to OFF;
SET paradedb.enable_columnar_exec = true;
SET paradedb.enable_aggregate_custom_scan TO on;
CREATE TABLE issue_6699_authors (
    author_id INTEGER PRIMARY KEY,
    name TEXT,
    bio TEXT
);
CREATE TABLE issue_6699_articles (
    id SERIAL PRIMARY KEY,
    author_id INTEGER,
    category TEXT,
    body TEXT,
    created_at DATE
);
INSERT INTO issue_6699_authors (author_id, name, bio) VALUES
    (1, 'alice', 'database engineer'),
    (2, 'bob', 'frontend developer'),
    (3, 'carol', 'writes about database internals'),
    (4, 'dave', 'gardening enthusiast');
INSERT INTO issue_6699_articles (author_id, category, body, created_at) VALUES
    (1, 'tutorial', 'intro to database indexing', '2024-01-01'),
    (1, 'tutorial', 'database query planning', '2024-02-01'),
    (1, 'news', 'database release notes', '2024-03-01'),
    (2, 'tutorial', 'css layout tutorial', '2024-01-15'),
    (2, 'tutorial', 'database for frontend developers', '2024-04-01'),
    (3, 'opinion', 'why I love search engines', '2024-05-01'),
    (3, 'tutorial', 'search engine basics', '2024-02-15'),
    (4, 'news', 'gardening in winter', '2024-06-01'),
    (4, 'tutorial', 'database of plants', '2024-06-15');
CREATE INDEX issue_6699_authors_idx ON issue_6699_authors
USING paradedb (author_id, name, bio);
CREATE INDEX issue_6699_articles_idx ON issue_6699_articles
USING paradedb (id, author_id, (category::pdb.literal), body, created_at);
-- Postgres's rendering of the FILTER expression embeds the index OID, which
-- changes on every database creation; mask it so the plan is stable.
CREATE FUNCTION issue_6699_explain(query text) RETURNS SETOF text LANGUAGE plpgsql AS $$
DECLARE
    line text;
BEGIN
    FOR line IN EXECUTE 'EXPLAIN (COSTS OFF, TIMING OFF) ' || query LOOP
        RETURN NEXT regexp_replace(line, '"oid":\d+', '"oid":N', 'g');
    END LOOP;
END;
$$;
-- The query from the issue: a filtered COUNT that is projected and used for
-- ranking. The FILTER's search predicate also appears in WHERE, so its tag can
-- be reused. The plan should be a ParadeDB Aggregate Scan whose DataFusion
-- aggregate filter references a tag column rather than a native Aggregate.
SELECT issue_6699_explain($$
SELECT
    a.author_id,
    COUNT(*) FILTER (
        WHERE a.category = 'tutorial'
          AND a.body ||| 'database'
    ) AS tutorial_count,
    MAX(a.created_at) AS latest_date
FROM issue_6699_articles a
JOIN issue_6699_authors u ON a.author_id = u.author_id
WHERE a.body ||| 'database'
   OR u.bio ||| 'database'
GROUP BY a.author_id
ORDER BY
    COUNT(*) FILTER (
        WHERE a.category = 'tutorial'
          AND a.body ||| 'database'
    ) DESC,
    MAX(a.created_at) DESC NULLS LAST,
    a.author_id
LIMIT 15 OFFSET 0
$$);
                                                                                                                                                                                                                                                                                                                  issue_6699_explain                                                                                                                                                                                                                                                                                                                  
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Sort
         Sort Key: (count(*) FILTER (WHERE ((a.category = 'tutorial'::text) AND paradedb.search_with_query_input_ctid_or_row_strict(a.id, '{"with_index":{"oid":N,"query":{"match":{"field":"body","value":"database","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}'::paradedb.searchqueryinput, a.ctid, CASE WHEN (paradedb.ctid_is_valid(a.ctid) IS NOT TRUE) THEN (ARRAY[a.*])::record[] WHEN (paradedb.xmin_is_visible(a.xmin, a.tableoid, a.ctid) IS NOT TRUE) THEN (ARRAY[a.*])::record[] ELSE '{}'::record[] END, ROW())))) DESC, (max(a.created_at)) DESC NULLS LAST, a.author_id
         ->  Custom Scan (ParadeDB Aggregate Scan)
               Backend: DataFusion
               Indexes: issue_6699_articles_idx (a), issue_6699_authors_idx (u)
               Group By: author_id
               Aggregates: COUNT(*), MAX(created_at)
               DataFusion Physical Plan: 
                 : AggregateExec: mode=Single, gby=[author_id@0 as author_id], aggr=[count(1) FILTER (WHERE a_0.category = Utf8View("tutorial") AND a_0.__a_0_tag_0) as agg_0, max(a_0.created_at) as agg_1]
                 :   TantivyDecodeExec: decode=[category]
                 :     TantivyFetchExec: fetch=[category]
                 :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(author_id@0, author_id@0)], filter=__a_0_tag_0@0 OR __u_1_tag_0@1, projection=[author_id@2, created_at@3, category@4, __a_0_tag_0@5]
                 :         CooperativeExec
                 :           PgSearchScan: table=u, segments=1, visibility=eager, tag_0={"with_index":{"query":{"match":{"field":"bio","value":"database","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
                 :         CooperativeExec
                 :           PgSearchScan: table=a, segments=1, dynamic_filters=1, visibility=eager, tag_0={"with_index":{"query":{"match":{"field":"body","value":"database","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(17 rows)

SELECT
    a.author_id,
    COUNT(*) FILTER (
        WHERE a.category = 'tutorial'
          AND a.body ||| 'database'
    ) AS tutorial_count,
    MAX(a.created_at) AS latest_date
FROM issue_6699_articles a
JOIN issue_6699_authors u ON a.author_id = u.author_id
WHERE a.body ||| 'database'
   OR u.bio ||| 'database'
GROUP BY a.author_id
ORDER BY
    COUNT(*) FILTER (
        WHERE a.category = 'tutorial'
          AND a.body ||| 'database'
    ) DESC,
    MAX(a.created_at) DESC NULLS LAST,
    a.author_id
LIMIT 15 OFFSET 0;
 author_id | tutorial_count | latest_date 
-----------+----------------+-------------
         1 |              2 | 03-01-2024
         4 |              1 | 06-15-2024
         2 |              1 | 04-01-2024
         3 |              0 | 05-01-2024
(4 rows)

-- FILTER search predicates that do not appear in WHERE, on both sides of the
-- join and with each search operator, each need their own tag column.
SELECT issue_6699_explain($$
SELECT a.author_id,
       COUNT(*) FILTER (WHERE a.body ||| 'search') AS search_count,
       COUNT(*) FILTER (WHERE a.body &&& 'database query') AS planning_count,
       COUNT(*) FILTER (WHERE a.body @@@ pdb.term('engine')) AS engine_count,
       COUNT(*) FILTER (WHERE NOT (u.bio ||| 'database')) AS other_bio_count
FROM issue_6699_articles a
JOIN issue_6699_authors u ON a.author_id = u.author_id
WHERE a.id @@@ pdb.all()
GROUP BY a.author_id
$$);
                                                                                                                                                                                                                                                                                       issue_6699_explain                                                                                                                                                                                                                                                                                        
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Backend: DataFusion
   Indexes: issue_6699_articles_idx (a), issue_6699_authors_idx (u)
   Group By: author_id
   Aggregates: COUNT(*), COUNT(*), COUNT(*), COUNT(*)
   DataFusion Physical Plan: 
     : AggregateExec: mode=Single, gby=[author_id@0 as author_id], aggr=[count(1) FILTER (WHERE a_0.__a_0_tag_0) as agg_0, count(1) FILTER (WHERE a_0.__a_0_tag_1) as agg_1, count(1) FILTER (WHERE a_0.__a_0_tag_2) as agg_2, count(1) FILTER (WHERE NOT u_1.__u_1_tag_0) as agg_3]
     :   HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(author_id@0, author_id@0)], projection=[author_id@2, __a_0_tag_0@3, __a_0_tag_1@4, __a_0_tag_2@5, __u_1_tag_0@1]
     :     CooperativeExec
     :       PgSearchScan: table=u, segments=1, visibility=eager, tag_0={"with_index":{"query":{"match":{"field":"bio","value":"database","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :     CooperativeExec
     :       PgSearchScan: table=a, segments=1, dynamic_filters=1, visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}, tag_0={"with_index":{"query":{"match":{"field":"body","value":"search","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}, tag_1={"with_index":{"query":{"match":{"field":"body","value":"database query","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":true}}}}, tag_2={"with_index":{"query":{"term":{"field":"body","value":"engine"}}}}
(12 rows)

SELECT a.author_id,
       COUNT(*) FILTER (WHERE a.body ||| 'search') AS search_count,
       COUNT(*) FILTER (WHERE a.body &&& 'database query') AS planning_count,
       COUNT(*) FILTER (WHERE a.body @@@ pdb.term('engine')) AS engine_count,
       COUNT(*) FILTER (WHERE NOT (u.bio ||| 'database')) AS other_bio_count
FROM issue_6699_articles a
JOIN issue_6699_authors u ON a.author_id = u.author_id
WHERE a.id @@@ pdb.all()
GROUP BY a.author_id
ORDER BY a.author_id;
 author_id | search_count | planning_count | engine_count | other_bio_count 
-----------+--------------+----------------+--------------+-----------------
         1 |            0 |              1 |            0 |               0
         2 |            0 |              0 |            0 |               2
         3 |            2 |              0 |            1 |               0
         4 |            0 |              0 |            0 |               2
(4 rows)

DROP FUNCTION issue_6699_explain(text);
DROP TABLE issue_6699_articles;
DROP TABLE issue_6699_authors;
