EXPLAIN (COSTS OFF)
SELECT count(*) FROM issue_6739_repro
WHERE body @@@ 'document'
  AND (
    tags @> jsonb_build_array('never1')
    OR tags @> jsonb_build_array('never2')
    OR tags @> jsonb_build_array('never3')
  );
