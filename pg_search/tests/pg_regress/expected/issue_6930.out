-- Integer operands are cast to float natively, rounding like PostgreSQL
CREATE TABLE issue_6930_n (id int PRIMARY KEY, body text, s int2, i int4, l int8);
INSERT INTO issue_6930_n VALUES
    (1, 'ok', 7, 7, 7), (2, 'ok', -3, 16777217, 9007199254740993), (3, 'ok', 0, 0, 0);
CREATE INDEX issue_6930_n_idx ON issue_6930_n USING paradedb (id, body, s, i, l);
EXPLAIN (COSTS OFF)
SELECT a.x / n.i, a.y / n.s, n.l::float4 FROM issue_6930_a a JOIN issue_6930_n n ON n.id = a.id
WHERE a.body @@@ 'ok' AND (a.x / n.l) >= 0 LIMIT 20;
                                                                                                                 QUERY PLAN                                                                                                                 
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: a INNER n
   Join Cond: n.id = a.id
   Join Predicate: heap:((a.x / (n.l)::double precision) >= '0'::double precision)
   Limit: 20
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[pdb_float_div(x@2, CAST(i@7 AS Float64)) as col_1, pdb_float_div(CAST(CAST(y@3 AS Float32) AS Float64), CAST(s@8 AS Float64)) as col_2, CAST(l@6 AS Float32) as col_3, ctid_0@0 as ctid_0, ctid_1@4 as ctid_1]
     :   GlobalLimitExec: skip=0, fetch=20
     :     VisibilityFilterExec: tables=[a, n]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, id@1)], filter=pdb_float_div(x@0, CAST(l@1 AS Float64)) >= 0, projection=[ctid_0@5, id@6, x@7, y@8, ctid_1@0, id@1, l@2, i@3, s@4]
     :         CooperativeExec
     :           PgSearchScan: table=n, segments=1, query="all"
     :         CooperativeExec
     :           PgSearchScan: table=a, segments=1, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"ok","lenient":null,"conjunction_mode":null}}}}
(14 rows)

SELECT a.id, a.x / n.s AS f8s, a.x / n.i AS f8i, a.x / n.l AS f8l, a.y / n.i AS f4i,
       n.l::float8 AS l8, n.l::float4 AS l4, n.i::real AS i4, a.x > n.i AS gt
FROM issue_6930_a a JOIN issue_6930_n n ON n.id = a.id
WHERE a.body @@@ 'ok' AND a.id IN (1, 2) ORDER BY a.id LIMIT 20;
