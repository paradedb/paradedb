-- MPP workers and Aggregate Scan run the native UDFs too. Separate inserts create
-- multiple index segments for the workers to scan.
CREATE TABLE issue_6931_m (id int PRIMARY KEY, body text, grp int4, a int4);
CREATE TABLE issue_6931_n (id int PRIMARY KEY, tag text, b int4);
CREATE INDEX issue_6931_m_idx ON issue_6931_m USING paradedb (id, body, grp, a);
CREATE INDEX issue_6931_n_idx ON issue_6931_n USING paradedb (id, tag, b);
SET paradedb.global_mutable_segment_rows TO 0;
INSERT INTO issue_6931_m SELECT g, 'x', g % 3, g FROM generate_series(1, 130) g;
INSERT INTO issue_6931_m SELECT g, 'x', g % 3, g FROM generate_series(131, 260) g;
INSERT INTO issue_6931_n SELECT g, 'y', 1 FROM generate_series(1, 130) g;
INSERT INTO issue_6931_n SELECT g, 'y', 1 FROM generate_series(131, 260) g;
RESET paradedb.global_mutable_segment_rows;
ANALYZE issue_6931_m;
ANALYZE issue_6931_n;
SET paradedb.enable_aggregate_custom_scan TO on;
SET paradedb.mpp_min_rows TO 0;
SET max_parallel_workers TO 8;
SET max_parallel_workers_per_gather TO 3;
SET min_parallel_table_scan_size TO 0;
SET parallel_setup_cost TO 0;
SET parallel_tuple_cost TO 0;
-- The join filter's pdb_int_mul runs in a worker stage under DistributedExec
EXPLAIN (COSTS OFF)
SELECT m.id, m.a + n.b FROM issue_6931_m m JOIN issue_6931_n n ON n.id = m.id
WHERE m.body @@@ 'x' AND m.a * n.b > 3 ORDER BY m.id LIMIT 5;
                                                                                                QUERY PLAN                                                                                                
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: m INNER n
   Join Cond: n.id = m.id
   Join Predicate: heap:((m.a * n.b) > 3)
   Limit: 5
   Order By: n.id asc
   DataFusion Physical Plan: 
     : ┌───── DistributedExec
     : │ ProjectionExec: expr=[id@1 as col_1, pdb_int_add(CAST(a@2 AS Int32), CAST(b@5 AS Int32)) as col_2, ctid_0@0 as ctid_0, ctid_1@3 as ctid_1]
     : │   SortPreservingMergeExec: [id@4 ASC NULLS LAST], fetch=5
     : │     [Stage 2] => NetworkCoalesceExec: output_partitions=2, input_tasks=2
     : └──────────────────────────────────────────────────
     :   ┌───── Stage 2 ── tasks=2, partitions=2
     :   │ SortExec: TopK(fetch=5), expr=[id@1 ASC NULLS LAST], preserve_partitioning=[true]
     :   │   VisibilityFilterExec: tables=[m, n]
     :   │     HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, id@1)], filter=pdb_int_mul(CAST(a@0 AS Int32), CAST(b@1 AS Int32)) > 3
     :   │       CoalescePartitionsExec
     :   │         [Stage 1] => NetworkBroadcastExec: partitions_per_consumer=1, stage_partitions=2, input_tasks=2
     :   │       DistributedLeafExec:
     :   │         t0: PgSearchScan: table=n, segments=2, dynamic_filters=1, query="all"
     :   │         t1: PgSearchScan: table=n, segments=2, dynamic_filters=1, query="all"
     :   └──────────────────────────────────────────────────
     :     ┌───── Stage 1 ── tasks=2, partitions=4
     :     │ BroadcastExec: input_partitions=1, consumer_tasks=2, output_partitions=2
     :     │   DistributedLeafExec:
     :     │     t0: PgSearchScan: table=m, segments=2, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"x","lenient":null,"conjunction_mode":null}}}}
     :     │     t1: PgSearchScan: table=m, segments=2, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"x","lenient":null,"conjunction_mode":null}}}}
     :     └──────────────────────────────────────────────────
