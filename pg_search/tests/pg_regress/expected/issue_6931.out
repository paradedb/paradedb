-- Non-integer operands with an integer result (date - date) stay on the fallback
CREATE TABLE issue_6931_d (id int PRIMARY KEY, body text, d date);
CREATE TABLE issue_6931_f (id int PRIMARY KEY, tag text, d date);
INSERT INTO issue_6931_d VALUES (1, 'alpha', '2024-03-01');
INSERT INTO issue_6931_f VALUES (1, 'x', '2024-01-01');
CREATE INDEX issue_6931_d_idx ON issue_6931_d USING paradedb (id, body, d);
CREATE INDEX issue_6931_f_idx ON issue_6931_f USING paradedb (id, tag, d);
EXPLAIN (COSTS OFF)
SELECT d.id, d.d - f.d FROM issue_6931_d d JOIN issue_6931_f f ON f.id = d.id
WHERE d.body @@@ 'alpha' LIMIT 10;
                                                                                      QUERY PLAN                                                                                       
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: d INNER f
   Join Cond: f.id = d.id
   Limit: 10
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@1 as col_1, pdb_eval_expr_opexpr_a341d102(d@2, d@4) as col_2, ctid_0@0 as ctid_0]
     :   GlobalLimitExec: skip=0, fetch=10
     :     VisibilityFilterExec: tables=[d, f]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, id@0)]
     :         CooperativeExec
     :           PgSearchScan: table=d, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"alpha","lenient":null,"conjunction_mode":null}}}}
     :         CooperativeExec
     :           PgSearchScan: table=f, segments=1, dynamic_filters=1, query="all"
(13 rows)

SELECT d.id, d.d - f.d FROM issue_6931_d d JOIN issue_6931_f f ON f.id = d.id
WHERE d.body @@@ 'alpha' LIMIT 10;
 id | ?column? 
----+----------
  1 |       60
(1 row)

-- The operation comes from the operator's function, not its symbol
CREATE OPERATOR public.- (LEFTARG = int4, RIGHTARG = int4, FUNCTION = int4pl);
EXPLAIN (COSTS OFF)
SELECT l.id, l.a OPERATOR(public.-) r.b FROM issue_6931_l l JOIN issue_6931_r r ON r.id = l.id
WHERE l.body @@@ 'small' LIMIT 10;
                                                                                      QUERY PLAN                                                                                       
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: l INNER r
   Join Cond: r.id = l.id
   Limit: 10
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@1 as col_1, pdb_int_add(CAST(a@2 AS Int32), CAST(b@4 AS Int32)) as col_2, ctid_0@0 as ctid_0]
     :   GlobalLimitExec: skip=0, fetch=10
     :     VisibilityFilterExec: tables=[l, r]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, id@0)]
     :         CooperativeExec
     :           PgSearchScan: table=l, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"small","lenient":null,"conjunction_mode":null}}}}
     :         CooperativeExec
     :           PgSearchScan: table=r, segments=1, dynamic_filters=1, query="all"
(13 rows)

SELECT l.id, l.a OPERATOR(public.-) r.b FROM issue_6931_l l JOIN issue_6931_r r ON r.id = l.id
WHERE l.body @@@ 'small' LIMIT 10;
 id | ?column? 
----+----------
  3 |        7
(1 row)

DROP OPERATOR public.- (int4, int4);
RESET paradedb.enable_join_custom_scan;
DROP TABLE issue_6931_i;
DROP TABLE issue_6931_e;
DROP TABLE issue_6931_l;
DROP TABLE issue_6931_r;
DROP TABLE issue_6931_d;
DROP TABLE issue_6931_f;
