-- string_agg with a separator column runs in the Aggregate Scan (#7198).
-- Each view runs on the Aggregate Scan, then on PostgreSQL; the results must match.
CREATE EXTENSION IF NOT EXISTS pg_search;
SET max_parallel_workers_per_gather = 0;
SET paradedb.enable_join_custom_scan = off;
CREATE TABLE issue_7198_a (id int PRIMARY KEY, name text, sep text, grp int);
CREATE TABLE issue_7198_b (id int PRIMARY KEY, a_id int, sep text);
INSERT INTO issue_7198_a VALUES
    (1, NULL, '#', 1), (2, 'b', '-', 1), (3, 'c', NULL, 1), (4, '', '+', 1), (5, 'é', '→ ', 1),
    (6, 'x', '-', 2), (7, 'y', ';', 2), (8, 'z', '|', 2),
    (9, NULL, '!', 3), (10, NULL, NULL, 3);
INSERT INTO issue_7198_b
SELECT g, g, CASE WHEN g = 7 THEN NULL ELSE '/' END FROM generate_series(1, 10) g;
CREATE INDEX issue_7198_a_idx ON issue_7198_a
USING paradedb (id, (name::pdb.literal), (sep::pdb.literal), grp);
CREATE INDEX issue_7198_b_idx ON issue_7198_b USING paradedb (id, a_id, (sep::pdb.literal));
-- The #7150 repro, with the separator column in the index.
CREATE VIEW issue_7198_repro AS
SELECT string_agg(a.name, a.sep ORDER BY a.id) AS s
FROM issue_7198_a a JOIN issue_7198_b b ON b.a_id = a.id
WHERE a.id @@@ pdb.all() AND a.grp = 2;
-- Both orders, and a separator from the joined table.
CREATE VIEW issue_7198_grouped AS
SELECT a.grp,
       string_agg(a.name, a.sep ORDER BY a.id) AS asc_sep,
       string_agg(a.name, a.sep ORDER BY a.id DESC) AS desc_sep,
       string_agg(a.name, b.sep ORDER BY a.id) AS join_sep
FROM issue_7198_a a JOIN issue_7198_b b ON b.a_id = a.id
WHERE a.id @@@ pdb.all()
GROUP BY a.grp;
-- Without ORDER BY the order is unspecified, so accept any valid order.
CREATE VIEW issue_7198_unordered AS
SELECT string_agg(a.name, a.sep)
       IN ('x;y|z', 'x|z;y', 'y-x|z', 'y|z-x', 'z-x;y', 'z;y-x') AS valid
FROM issue_7198_a a JOIN issue_7198_b b ON b.a_id = a.id
WHERE a.id @@@ pdb.all() AND a.grp = 2;
EXPLAIN (COSTS OFF) SELECT * FROM issue_7198_repro;
                                                                                             QUERY PLAN                                                                                              
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Backend: DataFusion
   Indexes: issue_7198_a_idx (a), issue_7198_b_idx (b)
   Aggregates: STRING_AGG(name, sep)
   DataFusion Physical Plan: 
     : AggregateExec: mode=Single, gby=[], aggr=[pdb_string_agg(a_0.name, a_0.sep) ORDER BY [a_0.id ASC NULLS LAST] as agg_0]
     :   HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@2, a_id@0)], projection=[name@0, sep@1, id@2]
     :     CooperativeExec
     :       PgSearchScan: table=a, segments=1, eager=[name, sep], visibility=eager, query={"boolean":{"must":[{"with_index":{"query":{"all":{"field":"id"}}}},{"term":{"field":"grp","value":2}}]}}
     :     CooperativeExec
     :       PgSearchScan: table=b, segments=1, dynamic_filters=1, visibility=eager, query="all"
(11 rows)

EXPLAIN (COSTS OFF) SELECT * FROM issue_7198_grouped ORDER BY grp;
                                                                                                                                                                   QUERY PLAN                                                                                                                                                                    
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: a.grp
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Backend: DataFusion
         Indexes: issue_7198_a_idx (a), issue_7198_b_idx (b)
         Group By: grp
         Aggregates: STRING_AGG(name, sep), STRING_AGG(name, sep), STRING_AGG(name, sep)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Single, gby=[grp@2 as grp], aggr=[pdb_string_agg(__common_expr_1, __common_expr_2) ORDER BY [a_0.id ASC NULLS LAST] as agg_0, pdb_string_agg(__common_expr_1, __common_expr_2) ORDER BY [a_0.id DESC NULLS FIRST] as agg_1, pdb_string_agg(__common_expr_1, b_1.sep) ORDER BY [a_0.id ASC NULLS LAST] as agg_2]
           :   ProjectionExec: expr=[CAST(name@1 AS Utf8) as __common_expr_1, CAST(sep@2 AS Utf8) as __common_expr_2, grp@0 as grp, id@3 as id, sep@4 as sep]
           :     TantivyDecodeExec: decode=[sep]
           :       TantivyFetchExec: fetch=[sep]
           :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@3, a_id@1)]
           :           CooperativeExec
           :             PgSearchScan: table=a, segments=1, eager=[name, sep], visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
           :           CooperativeExec
           :             PgSearchScan: table=b, segments=1, dynamic_filters=1, visibility=eager, query="all"
(17 rows)

