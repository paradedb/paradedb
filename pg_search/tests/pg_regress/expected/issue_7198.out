RESET paradedb.enable_aggregate_custom_scan;
-- Still PostgreSQL: a separator expression, and DISTINCT.
SELECT string_agg(a.name, a.sep || '' ORDER BY a.id)
FROM issue_7198_a a JOIN issue_7198_b b ON b.a_id = a.id
WHERE a.id @@@ pdb.all() AND a.grp = 2;
WARNING:  Aggregate Scan (DataFusion) not used: aggregate argument must be a direct column reference; wrapped expressions (COALESCE, casts) are not supported for aggregate-on-join (table: join)
 string_agg 
------------
 x;y|z
(1 row)

SELECT string_agg(DISTINCT a.name, a.sep)
FROM issue_7198_a a JOIN issue_7198_b b ON b.a_id = a.id
WHERE a.id @@@ pdb.all() AND a.grp = 2;
WARNING:  Aggregate Scan (DataFusion) not used: string_agg(DISTINCT ...) with a non-constant separator is not supported for aggregate-on-join (table: join)
 string_agg 
------------
 x;y|z
(1 row)

-- MPP: workers run the Partial aggregate and the leader merges their states.
-- Separate inserts create multiple index segments for MPP workers to scan.
SET paradedb.global_mutable_segment_rows = 0;
CREATE TABLE issue_7198_ma (id int PRIMARY KEY, name text, sep text, grp int);
CREATE TABLE issue_7198_mb (id int PRIMARY KEY, a_id int);
CREATE INDEX issue_7198_ma_idx ON issue_7198_ma
USING paradedb (id, (name::pdb.literal), (sep::pdb.literal), grp);
CREATE INDEX issue_7198_mb_idx ON issue_7198_mb USING paradedb (id, a_id);
INSERT INTO issue_7198_ma
SELECT g, CASE WHEN g % 7 = 0 THEN NULL ELSE 'v' || g END,
       (ARRAY['-', ';', '|', NULL, ', '])[g % 5 + 1], g % 4
FROM generate_series(1, 500) g;
INSERT INTO issue_7198_ma
SELECT g, CASE WHEN g % 7 = 0 THEN NULL ELSE 'v' || g END,
       (ARRAY['-', ';', '|', NULL, ', '])[g % 5 + 1], g % 4
FROM generate_series(501, 1000) g;
INSERT INTO issue_7198_mb SELECT g, g FROM generate_series(1, 500) g;
INSERT INTO issue_7198_mb SELECT g, g FROM generate_series(501, 1000) g;
RESET paradedb.global_mutable_segment_rows;
ANALYZE issue_7198_ma;
ANALYZE issue_7198_mb;
CREATE VIEW issue_7198_mpp AS
SELECT a.grp,
       md5(string_agg(a.name, a.sep ORDER BY a.id)) AS asc_sep,
       md5(string_agg(a.name, a.sep ORDER BY a.id DESC)) AS desc_sep
FROM issue_7198_ma a JOIN issue_7198_mb b ON b.a_id = a.id
WHERE a.id @@@ pdb.all()
GROUP BY a.grp;
SET max_parallel_workers_per_gather = 3;
SET max_parallel_workers = 8;
SET min_parallel_table_scan_size = 0;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET paradedb.mpp_min_rows = 0;
SET paradedb.enable_join_custom_scan = on;
EXPLAIN (COSTS OFF) SELECT * FROM issue_7198_mpp ORDER BY grp;
                                                                                                                                QUERY PLAN                                                                                                                                 
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: a.grp
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Backend: DataFusion
         Indexes: issue_7198_ma_idx (a), issue_7198_mb_idx (b)
         Group By: grp
         Aggregates: STRING_AGG(name, sep), STRING_AGG(name, sep)
         DataFusion Physical Plan: 
           : ┌───── DistributedExec
           : │ CoalescePartitionsExec
           : │   [Stage 3] => NetworkCoalesceExec: output_partitions=6, input_tasks=2
           : └──────────────────────────────────────────────────
           :   ┌───── Stage 3 ── tasks=2, partitions=3
           :   │ AggregateExec: mode=FinalPartitioned, gby=[grp@0 as grp], aggr=[pdb_string_agg(__common_expr_1, __common_expr_2) ORDER BY [a_0.id ASC NULLS LAST] as agg_0, pdb_string_agg(__common_expr_1, __common_expr_2) ORDER BY [a_0.id DESC NULLS FIRST] as agg_1]
           :   │   [Stage 2] => NetworkShuffleExec: output_partitions=3, input_tasks=2
           :   └──────────────────────────────────────────────────
           :     ┌───── Stage 2 ── tasks=2, partitions=6
           :     │ RepartitionExec: partitioning=Hash([grp@0], 6), input_partitions=1
           :     │   AggregateExec: mode=Partial, gby=[grp@2 as grp], aggr=[pdb_string_agg(__common_expr_1, __common_expr_2) ORDER BY [a_0.id ASC NULLS LAST] as agg_0, pdb_string_agg(__common_expr_1, __common_expr_2) ORDER BY [a_0.id DESC NULLS FIRST] as agg_1]
           :     │     ProjectionExec: expr=[CAST(name@1 AS Utf8) as __common_expr_1, CAST(sep@2 AS Utf8) as __common_expr_2, grp@0 as grp, id@3 as id]
           :     │       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@3, a_id@0)]
           :     │         CoalescePartitionsExec
           :     │           [Stage 1] => NetworkBroadcastExec: partitions_per_consumer=1, stage_partitions=2, input_tasks=2
           :     │         DistributedLeafExec:
           :     │           t0: PgSearchScan: table=b, segments=2, dynamic_filters=1, visibility=eager, query="all"
           :     │           t1: PgSearchScan: table=b, segments=2, dynamic_filters=1, visibility=eager, query="all"
           :     └──────────────────────────────────────────────────
           :       ┌───── Stage 1 ── tasks=2, partitions=4
           :       │ BroadcastExec: input_partitions=1, consumer_tasks=2, output_partitions=2
           :       │   DistributedLeafExec:
           :       │     t0: PgSearchScan: table=a, segments=2, eager=[name, sep], visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
           :       │     t1: PgSearchScan: table=a, segments=2, eager=[name, sep], visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
           :       └──────────────────────────────────────────────────
(33 rows)

