GROUP BY s, t ORDER BY s ASC NULLS FIRST, t DESC NULLS LAST;
   s    |   t    | count 
--------+--------+-------
 <null> | x      |     1
 <null> |        |     1
 <null> | <null> |     2
        | x      |     1
        |        |     1
        | <null> |     1
