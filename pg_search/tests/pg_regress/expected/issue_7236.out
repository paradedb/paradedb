(9 rows)

SELECT s, COUNT(*) FILTER (WHERE n <= 5), COUNT(*) FILTER (WHERE n > 5)
FROM issue_7236 WHERE issue_7236 @@@ pdb.all()
GROUP BY s ORDER BY s ASC NULLS FIRST;
   s    | count | count 
--------+-------+-------
 <null> |     2 |     2
        |     3 |     0
 a      |     0 |     3
(3 rows)

SELECT s, COUNT(*) FILTER (WHERE n <= 5), COUNT(*) FILTER (WHERE n > 5)
FROM issue_7236 WHERE issue_7236 @@@ pdb.all()
GROUP BY s ORDER BY s DESC NULLS LAST;
   s    | count | count 
--------+-------+-------
 a      |     0 |     3
        |     3 |     0
 <null> |     2 |     2
(3 rows)

RESET paradedb.enable_aggregate_custom_scan;
DROP TABLE issue_7236;
-- Keep the estimate below the cap so these queries exercise Tantivy truncation.
CREATE TABLE issue_7236_cap (id int, s text) WITH (autovacuum_enabled = false);
INSERT INTO issue_7236_cap SELECT g, '' FROM generate_series(1, 100) g;
CREATE INDEX issue_7236_cap_idx ON issue_7236_cap USING paradedb (id, (s::pdb.literal));
ANALYZE issue_7236_cap;
INSERT INTO issue_7236_cap VALUES (101, NULL), (102, 'a');
-- Truncation must not discard either bucket before the NULL/empty-string swap.
SET paradedb.max_term_agg_buckets = 1;
SELECT s, COUNT(*) FROM issue_7236_cap WHERE id @@@ pdb.all()
GROUP BY s ORDER BY s ASC NULLS FIRST LIMIT 1;
ERROR:  GROUP BY exceeded paradedb.max_term_agg_buckets (1); truncated buckets cannot preserve NULL and empty string ordering. Raise paradedb.max_term_agg_buckets to cover the group cardinality.
SET paradedb.max_term_agg_buckets = 2;
EXPLAIN (COSTS OFF)
SELECT s, COUNT(*) FROM issue_7236_cap WHERE id @@@ pdb.all()
GROUP BY s ORDER BY s DESC NULLS LAST LIMIT 2;
                                                      QUERY PLAN                                                       
-----------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Custom Scan (ParadeDB Aggregate Scan) on issue_7236_cap
         Index: issue_7236_cap_idx
         Tantivy Query: {"with_index":{"query":{"all":{"field":"id"}}}}
           Applies to Aggregates: COUNT(*)
           Group By: s
           Limit: 2
           Aggregate Definition: {"grouped":{"terms":{"field":"s","order":{"_key":"desc"},"segment_size":2,"size":2}}}
(8 rows)

SELECT s, COUNT(*) FROM issue_7236_cap WHERE id @@@ pdb.all()
GROUP BY s ORDER BY s DESC NULLS LAST LIMIT 2;
ERROR:  GROUP BY exceeded paradedb.max_term_agg_buckets (2); truncated buckets cannot preserve NULL and empty string ordering. Raise paradedb.max_term_agg_buckets to cover the group cardinality.
-- Truncation remains safe when the sentinel already has the correct order.
SELECT s, COUNT(*) FROM issue_7236_cap WHERE id @@@ pdb.all()
GROUP BY s ORDER BY s ASC NULLS LAST LIMIT 2;
 s | count 
---+-------
   |   100
 a |     1
(2 rows)

-- A sufficient cap lets both affected orderings return the correct rows.
SET paradedb.max_term_agg_buckets = 3;
SELECT s, COUNT(*) FROM issue_7236_cap WHERE id @@@ pdb.all()
GROUP BY s ORDER BY s ASC NULLS FIRST LIMIT 1;
   s    | count 
--------+-------
 <null> |     1
(1 row)

SELECT s, COUNT(*) FROM issue_7236_cap WHERE id @@@ pdb.all()
GROUP BY s ORDER BY s DESC NULLS LAST LIMIT 2;
 s | count 
---+-------
 a |     1
   |   100
(2 rows)

RESET paradedb.max_term_agg_buckets;
DROP TABLE issue_7236_cap;
