--------+-------
 <null> |     4
 a      |     3
        |     3
(3 rows)

SELECT s, COUNT(*) FROM issue_7236 WHERE issue_7236 @@@ pdb.all()
GROUP BY s ORDER BY s ASC NULLS FIRST LIMIT 1;
   s    | count 
--------+-------
