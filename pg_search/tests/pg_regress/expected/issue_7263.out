(1 row)

SELECT MAX(id) FROM issue_7263_t WHERE body ||| 'nomatch';
 max 
-----
    
(1 row)

-- COALESCE: a NULL reads as the default, and an exact default survives
SELECT MAX(COALESCE(b, 0)), MIN(COALESCE(b, 0)) FROM issue_7263_t WHERE body ||| 'void OR late';
       max        | min 
------------------+-----
 9007199254740993 |   0
(1 row)

SELECT MAX(COALESCE(b, 1234567890123456789)) FROM issue_7263_t WHERE body ||| 'void';
         max         
---------------------
 1234567890123456789
(1 row)

SELECT MIN(COALESCE(id, 5)) FROM issue_7263_t WHERE body ||| 'payment';
         min         
---------------------
 1234567890123456001
(1 row)

SELECT grp, MAX(COALESCE(b, 7)) FROM issue_7263_t WHERE body ||| 'payment' GROUP BY grp ORDER BY grp;
 grp |         max         
-----+---------------------
   1 | 9223372036854775807
   2 |    9007199254740993
   3 |                   7
(3 rows)

SELECT COUNT(COALESCE(b, 0)), SUM(COALESCE(b, 0)), MAX(COALESCE(b, 0))
FROM issue_7263_t WHERE body ||| 'payment';
 count | sum |         max         
-------+-----+---------------------
     5 |  -1 | 9223372036854775807
(1 row)

SELECT SUM(COALESCE(id, 0)) FROM issue_7263_t WHERE body ||| 'payment';
         sum         
---------------------
 6172839450617280805
(1 row)

-- The default also applies to rows a LEFT JOIN leaves unmatched
EXPLAIN (COSTS OFF)
SELECT MIN(COALESCE(u.v, -1)), MAX(COALESCE(u.v, -1)), COUNT(COALESCE(u.v, -1))
FROM issue_7263_t t LEFT JOIN issue_7263_u u ON t.grp = u.grp WHERE t.body ||| 'payment';
                                                                                                                      QUERY PLAN                                                                                                                      
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Backend: DataFusion
   Indexes: issue_7263_t_idx (t), issue_7263_u_idx (u)
   Aggregates: MIN(COALESCE(v, -1)), MAX(COALESCE(v, -1)), COUNT(COALESCE(v, -1))
   DataFusion Physical Plan: 
     : AggregateExec: mode=Single, gby=[], aggr=[min(__common_expr_1) as agg_0, max(__common_expr_1) as agg_1, count(__common_expr_1) as agg_2]
     :   ProjectionExec: expr=[CASE WHEN v@0 IS NOT NULL THEN v@0 ELSE -1 END as __common_expr_1]
     :     HashJoinExec: mode=CollectLeft, join_type=Right, on=[(grp@1, grp@0)], projection=[v@0]
     :       CooperativeExec
     :         PgSearchScan: table=u, segments=1, visibility=eager, query="all"
     :       CooperativeExec
     :         PgSearchScan: table=t, segments=1, visibility=eager, query={"with_index":{"query":{"match":{"field":"body","value":"payment","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(12 rows)

SELECT MIN(COALESCE(u.v, -1)), MAX(COALESCE(u.v, -1)), COUNT(COALESCE(u.v, -1))
FROM issue_7263_t t LEFT JOIN issue_7263_u u ON t.grp = u.grp WHERE t.body ||| 'payment';
 min |       max        | count 
-----+------------------+-------
  -1 | 9007199254740993 |     7
(1 row)

