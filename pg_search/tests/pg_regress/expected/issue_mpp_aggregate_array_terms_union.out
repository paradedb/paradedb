SELECT
    pdb.agg('{"terms": {"field": "category", "size": 10}}')::text = :'c1_categories' AS categories_match,
    pdb.agg('{"terms": {"field": "tags", "size": 10}}')::text = :'c1_author_tags' AS author_tags_match
FROM mpp_arr_posts p
JOIN mpp_arr_authors a ON p.author_id = a.id
WHERE p.title ||| 'rust'
  AND a.id @@@ pdb.all();
 categories_match | author_tags_match 
------------------+-------------------
 t                | t
(1 row)

-- C2: the same facets listed the other way round, so the scalar child is the
-- one whose child-local numbering differs from the outer one.
SELECT
    pdb.agg('{"terms": {"field": "tags", "size": 10}}')::text = :'c1_author_tags' AS author_tags_match,
    pdb.agg('{"terms": {"field": "category", "size": 10}}')::text = :'c1_categories' AS categories_match
FROM mpp_arr_posts p
JOIN mpp_arr_authors a ON p.author_id = a.id
WHERE p.title ||| 'rust'
  AND a.id @@@ pdb.all();
 author_tags_match | categories_match 
-------------------+------------------
 t                 | t
(1 row)

-- C3: three union children.
EXPLAIN (COSTS OFF)
SELECT
    pdb.agg('{"terms": {"field": "category", "size": 10}}') AS categories,
    pdb.agg('{"terms": {"field": "tags", "size": 10}}') AS author_tags,
    pdb.agg('{"terms": {"field": "keywords", "size": 10}}') AS keywords
FROM mpp_arr_posts p
JOIN mpp_arr_authors a ON p.author_id = a.id
WHERE p.title ||| 'rust'
  AND a.id @@@ pdb.all();
                                                                                                                                     QUERY PLAN                                                                                                                                      
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Backend: DataFusion
   Indexes: mpp_arr_posts_idx (p), mpp_arr_authors_idx (a)
   Aggregates: pdb.agg({"terms":{"size":10,"field":"category"}}), pdb.agg({"terms":{"size":10,"field":"tags"}}), pdb.agg({"terms":{"size":10,"field":"keywords"}})
   DataFusion Physical Plan: 
     : ┌───── DistributedExec
     : │ CoalescePartitionsExec
     : │   [Stage 7] => NetworkCoalesceExec: output_partitions=9, input_tasks=3
     : └──────────────────────────────────────────────────
     :   ┌───── Stage 7 ── tasks=3, partitions=9
     :   │ ProjectionExec: expr=[__grouping_id@3 as __grouping_id, __pdb_k0@0 as __pdb_k0, __pdb_k1@1 as __pdb_k1, __pdb_k2@2 as __pdb_k2, __pdb_m0@4 as __pdb_m0]
     :   │   DistributedUnionExec: t0:[c0] t1:[c1] t2:[c2]
     :   │     ProjectionExec: expr=[__pdb_k0@0 as __pdb_k0, NULL as __pdb_k1, NULL as __pdb_k2, CASE CAST(__grouping_id@1 AS UInt64) WHEN 1 THEN 7 WHEN 0 THEN 3 ELSE 0 END as __grouping_id, __pdb_m0@2 as __pdb_m0]
     :   │       AggregateExec: mode=FinalPartitioned, gby=[__pdb_k0@0 as __pdb_k0, __grouping_id@1 as __grouping_id], aggr=[count(1) as __pdb_m0]
     :   │         [Stage 2] => NetworkShuffleExec: output_partitions=3, input_tasks=2
     :   │     ProjectionExec: expr=[NULL as __pdb_k0, __pdb_k1@0 as __pdb_k1, NULL as __pdb_k2, 5 as __grouping_id, __pdb_m0@1 as __pdb_m0]
     :   │       AggregateExec: mode=FinalPartitioned, gby=[__pdb_k1@0 as __pdb_k1], aggr=[count(1) as __pdb_m0]
     :   │         [Stage 4] => NetworkShuffleExec: output_partitions=3, input_tasks=2
     :   │     ProjectionExec: expr=[NULL as __pdb_k0, NULL as __pdb_k1, __pdb_k2@0 as __pdb_k2, 6 as __grouping_id, __pdb_m0@1 as __pdb_m0]
     :   │       AggregateExec: mode=FinalPartitioned, gby=[__pdb_k2@0 as __pdb_k2], aggr=[count(1) as __pdb_m0]
     :   │         [Stage 6] => NetworkShuffleExec: output_partitions=3, input_tasks=2
     :   └──────────────────────────────────────────────────
     :     ┌───── Stage 2 ── tasks=2, partitions=3
     :     │ RepartitionExec: partitioning=Hash([__pdb_k0@0, __grouping_id@1], 3), input_partitions=1
     :     │   AggregateExec: mode=Partial, gby=[(NULL as __pdb_k0), (category@0 as __pdb_k0)], aggr=[count(1) as __pdb_m0]
     :     │     TantivyDecodeExec: decode=[category]
     :     │       TantivyFetchExec: fetch=[category]
     :     │         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, author_id@0)], projection=[category@2]
     :     │           CoalescePartitionsExec
     :     │             [Stage 1] => NetworkBroadcastExec: partitions_per_consumer=1, stage_partitions=2, input_tasks=2
     :     │           DistributedLeafExec:
     :     │             t0: PgSearchScan: table=p, segments=2, dynamic_filters=1, visibility=eager, query={"with_index":{"query":{"match":{"field":"title","value":"rust","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :     │             t1: PgSearchScan: table=p, segments=2, dynamic_filters=1, visibility=eager, query={"with_index":{"query":{"match":{"field":"title","value":"rust","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :     └──────────────────────────────────────────────────
     :       ┌───── Stage 1 ── tasks=2, partitions=4
     :       │ BroadcastExec: input_partitions=1, consumer_tasks=2, output_partitions=2
     :       │   DistributedLeafExec:
     :       │     t0: PgSearchScan: table=a, segments=2, visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
     :       │     t1: PgSearchScan: table=a, segments=2, visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
     :       └──────────────────────────────────────────────────
     :     ┌───── Stage 4 ── tasks=2, partitions=3
     :     │ RepartitionExec: partitioning=Hash([__pdb_k1@0], 3), input_partitions=1
     :     │   AggregateExec: mode=Partial, gby=[a_1_tags@0 as __pdb_k1], aggr=[count(1) as __pdb_m0]
     :     │     UnnestExec
     :     │       ProjectionExec: expr=[tags@0 as a_1_tags]
     :     │         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, author_id@0)], projection=[tags@1]
     :     │           CoalescePartitionsExec
     :     │             [Stage 3] => NetworkBroadcastExec: partitions_per_consumer=1, stage_partitions=2, input_tasks=2
     :     │           DistributedLeafExec:
     :     │             t0: PgSearchScan: table=p, segments=2, dynamic_filters=1, visibility=eager, query={"with_index":{"query":{"match":{"field":"title","value":"rust","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :     │             t1: PgSearchScan: table=p, segments=2, dynamic_filters=1, visibility=eager, query={"with_index":{"query":{"match":{"field":"title","value":"rust","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
