-- Tests for deferred visibility in JoinScan
--
-- Verifies that packed DocAddresses are correctly resolved to real heap TIDs
-- by VisibilityFilterExec across different join topologies:
--   1. Basic INNER JOIN with VisibilityFilterExec in EXPLAIN
--   2. Mixed INNER + SEMI join tree with join-level search predicates
--   3. Self-join (repeated indexrelid) where one branch is ctid-only
--   4. INNER JOIN with concurrent dead tuples (LIMIT counts only visible rows)
--   5. Mixed INNER + ANTI join with per-predicate deferred visibility
CREATE EXTENSION IF NOT EXISTS pg_search;
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan TO OFF;
SET paradedb.enable_join_custom_scan TO on;
-- =============================================================================
-- SETUP
-- =============================================================================
DROP TABLE IF EXISTS items CASCADE;
DROP TABLE IF EXISTS tags CASCADE;
DROP TABLE IF EXISTS reviews CASCADE;
CREATE TABLE items (
    id INTEGER PRIMARY KEY,
    name TEXT,
    description TEXT,
    tag_id INTEGER
);
CREATE TABLE tags (
    id INTEGER PRIMARY KEY,
    label TEXT,
    category TEXT
);
CREATE TABLE reviews (
    id INTEGER PRIMARY KEY,
    item_id INTEGER,
    body TEXT,
    rating INTEGER
);
INSERT INTO items (id, name, description, tag_id) VALUES
(1, 'Wireless Mouse', 'ergonomic wireless mouse with Bluetooth', 10),
(2, 'USB Cable', 'high-speed USB-C cable for data transfer', 20),
(3, 'Keyboard', 'mechanical keyboard with RGB lighting', 10),
(4, 'Monitor Stand', 'adjustable monitor stand for ergonomic setup', 30),
(5, 'Webcam', 'HD webcam for video conferencing', 20),
(6, 'Headphones', 'wireless noise-canceling headphones', 10),
(7, 'Mouse Pad', 'large gaming mouse pad', 30),
(8, 'Cable Organizer', 'desktop cable organizer', 20);
INSERT INTO tags (id, label, category) VALUES
(10, 'peripherals', 'hardware accessories for computers'),
(20, 'cables', 'connectivity and data transfer cables'),
(30, 'stands', 'ergonomic desk accessories and stands');
INSERT INTO reviews (id, item_id, body, rating) VALUES
(100, 1, 'great wireless mouse very ergonomic', 5),
(101, 1, 'decent mouse but battery drains fast', 3),
(102, 2, 'perfect cable for fast charging', 5),
(103, 3, 'amazing keyboard love the RGB', 5),
(104, 4, 'solid monitor stand adjustable', 4),
(105, 5, 'webcam works great for meetings', 4),
(106, 6, 'noise canceling is excellent', 5),
(107, 7, 'nice large mouse pad', 4),
(108, 8, 'keeps cables organized and tidy', 4);
CREATE INDEX items_idx ON items USING paradedb (id, name, description, tag_id)
WITH (
    key_field = 'id',
    numeric_fields = '{"tag_id": {"fast": true}}'
);
CREATE INDEX tags_idx ON tags USING paradedb (id, label, category)
WITH (key_field = 'id');
CREATE INDEX reviews_idx ON reviews USING paradedb (id, item_id, body, rating)
WITH (
    key_field = 'id',
    numeric_fields = '{"item_id": {"fast": true}, "rating": {"fast": true}}'
);
-- =============================================================================
-- TEST 1: Basic INNER JOIN — verify VisibilityFilterExec appears in plan
-- =============================================================================
-- The physical plan should contain VisibilityFilterExec when deferred
-- visibility is active.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT i.id, i.name, t.label
FROM items i
JOIN tags t ON i.tag_id = t.id
WHERE i.description @@@ 'wireless'
ORDER BY i.id
LIMIT 5;
                                                                                                      QUERY PLAN                                                                                                      
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: i.id, i.name, t.label
   Relation Tree: i INNER t
   Join Cond: i.tag_id = t.id
   Limit: 5
   Order By: i.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@0 as col_1, NULL as col_2, NULL as col_3, ctid_0@1 as ctid_0, ctid_1@2 as ctid_1]
     :   SortExec: TopK(fetch=5), expr=[id@0 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[i, t]
     :       TantivyFetchExec: fetch=[ctid_0, ctid_1]
     :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(tag_id@1, id@0)], projection=[id@0, ctid_0@2, ctid_1@4]
     :           CooperativeExec
     :             PgSearchScan: table=i, segments=1, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"wireless","lenient":null,"conjunction_mode":null}}}}
     :           CooperativeExec
     :             PgSearchScan: table=t, segments=1, dynamic_filters=1, query="all"
(16 rows)

-- Verify results are correct
SELECT i.id, i.name, t.label
FROM items i
JOIN tags t ON i.tag_id = t.id
WHERE i.description @@@ 'wireless'
ORDER BY i.id
LIMIT 5;
 id |      name      |    label    
----+----------------+-------------
  1 | Wireless Mouse | peripherals
  6 | Headphones     | peripherals
(2 rows)

-- =============================================================================
-- TEST 2: Mixed INNER + SEMI join tree
-- (items INNER JOIN tags) with EXISTS on reviews
-- The SEMI join is a barrier — visibility resolved per-child below it.
-- The INNER join defers visibility to root.
-- =============================================================================
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT i.id, i.name
FROM items i
JOIN tags t ON i.tag_id = t.id
WHERE i.description @@@ 'wireless OR keyboard'
  AND EXISTS (
    SELECT 1 FROM reviews r
    WHERE r.item_id = i.id
      AND r.body @@@ 'great'
  )
ORDER BY i.id
LIMIT 5;
WARNING:  JoinScan not used: search operators in join ON clause are not supported (tables: i, r, t)
                                                                                         QUERY PLAN                                                                                          
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: i.id, i.name
   ->  Nested Loop
         Output: i.id, i.name
         Inner Unique: true
         Join Filter: (i.tag_id = t.id)
         ->  Merge Semi Join
               Output: i.id, i.name, i.tag_id
               Merge Cond: (i.id = r.item_id)
               ->  Sort
                     Output: i.id, i.name, i.tag_id
                     Sort Key: i.id
                     ->  Custom Scan (ParadeDB Base Scan) on public.items i
                           Output: i.id, i.name, i.tag_id
                           Table: items
                           Index: items_idx
                           Worker Selection: Cost model
                           Exec Method: NormalScanExecState
                           Scores: false
                           Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"wireless OR keyboard","lenient":null,"conjunction_mode":null}}}}
               ->  Sort
                     Output: r.item_id
                     Sort Key: r.item_id
                     ->  Custom Scan (ParadeDB Base Scan) on public.reviews r
                           Output: r.item_id
                           Table: reviews
                           Index: reviews_idx
                           Worker Selection: Cost model
                           Exec Method: ColumnarExecState
                           Fast Fields: item_id
                           Scores: false
                           Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"great","lenient":null,"conjunction_mode":null}}}}
         ->  Seq Scan on public.tags t
               Output: t.id, t.label, t.category
(34 rows)

SELECT i.id, i.name
FROM items i
JOIN tags t ON i.tag_id = t.id
WHERE i.description @@@ 'wireless OR keyboard'
  AND EXISTS (
    SELECT 1 FROM reviews r
    WHERE r.item_id = i.id
      AND r.body @@@ 'great'
  )
ORDER BY i.id
LIMIT 5;
WARNING:  JoinScan not used: search operators in join ON clause are not supported (tables: i, r, t)
 id |      name      
----+----------------
  1 | Wireless Mouse
(1 row)

-- =============================================================================
-- TEST 3: Self-join — same index scanned twice with different predicates
-- One branch searches for 'wireless', the other for 'keyboard'.
-- Both share the same indexrelid but have different FFHelper layouts.
-- =============================================================================
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT a.id, a.name AS wireless_name, b.id, b.name AS keyboard_name
FROM items a
JOIN items b ON a.tag_id = b.tag_id
WHERE a.description @@@ 'wireless'
  AND b.description @@@ 'keyboard'
ORDER BY a.id, b.id
LIMIT 5;
                                                                                                      QUERY PLAN                                                                                                      
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: a.id, a.name, b.id, b.name
   Relation Tree: a INNER b
   Join Cond: a.tag_id = b.tag_id
   Limit: 5
   Order By: a.id asc, b.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@0 as col_1, NULL as col_2, id@2 as col_3, NULL as col_4, ctid_0@1 as ctid_0, ctid_1@3 as ctid_1]
     :   SortExec: TopK(fetch=5), expr=[id@0 ASC NULLS LAST, id@2 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[a, b]
     :       TantivyFetchExec: fetch=[ctid_0, ctid_1]
     :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(tag_id@1, tag_id@1)], projection=[id@3, ctid_0@5, id@0, ctid_1@2]
     :           CooperativeExec
     :             PgSearchScan: table=b, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"keyboard","lenient":null,"conjunction_mode":null}}}}
     :           CooperativeExec
     :             PgSearchScan: table=a, segments=1, dynamic_filters=2, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"wireless","lenient":null,"conjunction_mode":null}}}}
(16 rows)

SELECT a.id, a.name AS wireless_name, b.id, b.name AS keyboard_name
FROM items a
JOIN items b ON a.tag_id = b.tag_id
WHERE a.description @@@ 'wireless'
  AND b.description @@@ 'keyboard'
ORDER BY a.id, b.id
LIMIT 5;
 id | wireless_name  | id | keyboard_name 
----+----------------+----+---------------
  1 | Wireless Mouse |  3 | Keyboard
  6 | Headphones     |  3 | Keyboard
(2 rows)

-- =============================================================================
-- TEST 4: INNER JOIN with dead tuples (LIMIT must count only visible rows)
-- Insert rows, delete some, then query. VisibilityFilterExec must filter
-- the dead rows so LIMIT returns the correct count.
-- =============================================================================
-- Add extra rows then delete some to create dead tuples
INSERT INTO items (id, name, description, tag_id) VALUES
(9, 'Deleted Wireless Speaker', 'portable wireless speaker with bass', 10),
(10, 'Deleted Wireless Charger', 'fast wireless charging pad', 20);
DELETE FROM items WHERE id IN (9, 10);
-- The deleted rows should NOT appear in results
SELECT i.id, i.name, t.label
FROM items i
JOIN tags t ON i.tag_id = t.id
WHERE i.description @@@ 'wireless'
ORDER BY i.id
LIMIT 10;
 id |      name      |    label    
----+----------------+-------------
  1 | Wireless Mouse | peripherals
  6 | Headphones     | peripherals
(2 rows)

-- =============================================================================
-- TEST 5: Mixed INNER + ANTI join
-- Find items that have NO reviews with rating < 4
-- =============================================================================
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT i.id, i.name
FROM items i
JOIN tags t ON i.tag_id = t.id
WHERE i.description @@@ 'wireless OR mouse'
  AND NOT EXISTS (
    SELECT 1 FROM reviews r
    WHERE r.item_id = i.id
      AND r.rating < 4
  )
ORDER BY i.id
LIMIT 5;
                                                                                                                          QUERY PLAN                                                                                                                           
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: i.id, i.name
   Relation Tree: (i INNER t) ANTI r
   Join Cond: r.item_id = i.id, i.tag_id = t.id
   Join Filter: (r.rating < 4)
   Limit: 5
   Order By: i.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@0 as col_1, NULL as col_2, ctid_0@1 as ctid_0, ctid_1@2 as ctid_1]
     :   SortExec: TopK(fetch=5), expr=[id@0 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[i, t]
     :       TantivyFetchExec: fetch=[ctid_0, ctid_1]
     :         HashJoinExec: mode=CollectLeft, join_type=RightAnti, on=[(item_id@0, id@0)]
     :           CooperativeExec
     :             PgSearchScan: table=r, segments=1, visibility=eager, query={"boolean":{"must":[{"range":{"field":"rating","lower_bound":null,"upper_bound":{"excluded":4}}},{"range":{"field":"rating","lower_bound":null,"upper_bound":{"excluded":4}}}]}}
     :           HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(tag_id@1, id@0)], projection=[id@0, ctid_0@2, ctid_1@4]
     :             CooperativeExec
     :               PgSearchScan: table=i, segments=2, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"wireless OR mouse","lenient":null,"conjunction_mode":null}}}}
     :             CooperativeExec
     :               PgSearchScan: table=t, segments=1, dynamic_filters=1, query="all"
(20 rows)

SELECT i.id, i.name
FROM items i
JOIN tags t ON i.tag_id = t.id
WHERE i.description @@@ 'wireless OR mouse'
  AND NOT EXISTS (
    SELECT 1 FROM reviews r
    WHERE r.item_id = i.id
      AND r.rating < 4
  )
ORDER BY i.id
LIMIT 5;
 id |    name    
----+------------
  6 | Headphones
  7 | Mouse Pad
(2 rows)

-- =============================================================================
-- CLEANUP
-- =============================================================================
DROP TABLE IF EXISTS reviews CASCADE;
DROP TABLE IF EXISTS tags CASCADE;
DROP TABLE IF EXISTS items CASCADE;
RESET max_parallel_workers_per_gather;
RESET enable_indexscan;
RESET paradedb.enable_join_custom_scan;
