-- TEST 4: COALESCE — DISTINCT COALESCE(s.name, 'N/A')
-- =============================================================================
EXPLAIN (COSTS OFF)
SELECT DISTINCT COALESCE(s.name, 'N/A') AS safe_supplier, p.name
FROM dex_products p
         JOIN dex_suppliers s ON p.supplier_id = s.id
WHERE p.description @@@ 'wireless' AND s.info @@@ 'electronics'
ORDER BY p.name
    LIMIT 10;
