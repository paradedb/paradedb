-- TEST 3: OpExpr — DISTINCT arithmetic expression
-- =============================================================================
EXPLAIN (COSTS OFF)
SELECT DISTINCT p.supplier_id * 10 + p.id AS combo_id, p.name
FROM dex_products p
         JOIN dex_suppliers s ON p.supplier_id = s.id
WHERE p.description @@@ 'wireless' AND s.info @@@ 'electronics'
ORDER BY p.name
    LIMIT 10;
