\i common/common_setup.sql
CREATE EXTENSION IF NOT EXISTS pg_search;
-- Disable parallel workers to avoid differences in plans
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan to OFF;
SET paradedb.enable_columnar_exec = true;
-- A HOT update leaves the index pointing at the old line pointer, and VACUUM then turns
-- that line pointer into a redirect on an all-visible page. The join scan fetches its final
-- rows by that ctid, so the fetch has to follow the redirect.
SET paradedb.enable_join_custom_scan TO on;
DROP TABLE IF EXISTS hot_users CASCADE;
DROP TABLE IF EXISTS hot_orders CASCADE;
CREATE TABLE hot_users (
    id INTEGER PRIMARY KEY,
    name TEXT,
    age INTEGER,
    -- In no index at all, so an update of it is a HOT update.
    rating INTEGER
);
CREATE TABLE hot_orders (
    id INTEGER PRIMARY KEY,
    user_id INTEGER,
    note TEXT
);
INSERT INTO hot_users (id, name, age, rating) VALUES
(1, 'alice', 30, 1),
(2, 'bob', 41, 1),
(3, 'alice', 25, 1),
(4, 'bob', 37, 1),
(5, 'carol', 52, 1),
(6, 'bob', 29, 1);
INSERT INTO hot_orders (id, user_id, note) VALUES
(10, 1, 'first order'),
(11, 2, 'second order'),
(12, 2, 'third order'),
(13, 3, 'fourth order'),
(14, 4, 'fifth order'),
(15, 5, 'sixth order'),
(16, 6, 'seventh order');
CREATE INDEX hot_users_idx ON hot_users USING paradedb (id, name, age)
WITH (
    key_field = 'id',
    text_fields = '{"name": {"tokenizer": {"type": "keyword"}, "fast": true}}',
    numeric_fields = '{"age": {"fast": true}}'
);
CREATE INDEX hot_orders_idx ON hot_orders USING paradedb (id, user_id, note)
WITH (
    key_field = 'id',
    numeric_fields = '{"user_id": {"fast": true}}'
);
CREATE EXTENSION IF NOT EXISTS pageinspect;
CREATE EXTENSION IF NOT EXISTS pg_visibility;
CREATE TEMP TABLE hot_users_roots AS
SELECT ctid AS root_ctid FROM hot_users WHERE id IN (2, 4);
UPDATE hot_users SET rating = rating + 1 WHERE id IN (2, 4);
VACUUM (FREEZE, TRUNCATE false) hot_users;
-- The scan only keeps a root ctid while the page is all-visible, and the root only loses its
-- tuple once it is a redirect. If either is false here, the queries below prove nothing.
SELECT bool_and(all_visible) AS page_all_visible
FROM pg_visibility_map('hot_users')
WHERE blkno IN (SELECT (root_ctid::text::point)[0]::bigint FROM hot_users_roots);
 page_all_visible 
------------------
 t
(1 row)

SELECT bool_and(p.lp_flags = 2) AS roots_are_redirects
FROM hot_users_roots r
JOIN heap_page_items(get_raw_page('hot_users', (r.root_ctid::text::point)[0]::integer)) p
  ON p.lp = (r.root_ctid::text::point)[1]::smallint;
 roots_are_redirects 
---------------------
 t
(1 row)

-- Both bobs with a HOT-updated row must still come back.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT u.id, u.name, u.rating, o.note
FROM hot_users u
JOIN hot_orders o ON o.user_id = u.id
WHERE u.name @@@ 'bob'
ORDER BY u.id, o.id
LIMIT 10;
                                                                                         QUERY PLAN                                                                                          
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: u.id, u.name, u.rating, o.note, o.id
   ->  Custom Scan (ParadeDB Join Scan)
         Output: u.id, u.name, u.rating, o.note, o.id
         Relation Tree: o INNER u
         Join Cond: u.id = o.user_id
         Limit: 10
         Order By: o.user_id asc, o.id asc
         DataFusion Physical Plan: 
           : ProjectionExec: expr=[id@4 as col_1, NULL as col_2, NULL as col_3, NULL as col_4, id@2 as col_5, ctid_0@0 as ctid_0, ctid_1@3 as ctid_1]
           :   SortExec: TopK(fetch=10), expr=[user_id@1 ASC NULLS LAST, id@2 ASC NULLS LAST], preserve_partitioning=[false]
           :     VisibilityFilterExec: tables=[o, u]
           :       TantivyFetchExec: fetch=[ctid_0, ctid_1]
           :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, user_id@1)], projection=[ctid_0@2, user_id@3, id@4, ctid_1@0, id@1]
           :           CooperativeExec
           :             PgSearchScan: table=u, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"name","query_string":"bob","lenient":null,"conjunction_mode":null}}}}
           :           CooperativeExec
           :             PgSearchScan: table=o, segments=1, dynamic_filters=2, query="all"
(18 rows)

SELECT u.id, u.name, u.rating, o.note
FROM hot_users u
JOIN hot_orders o ON o.user_id = u.id
WHERE u.name @@@ 'bob'
ORDER BY u.id, o.id
LIMIT 10;
 id | name | rating |     note      
----+------+--------+---------------
  2 | bob  |      2 | second order
  2 | bob  |      2 | third order
  4 | bob  |      2 | fifth order
  6 | bob  |      1 | seventh order
(4 rows)

-- Sorted by a fast text column, so the top-k runs against the deferred column.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT u.id, u.name, u.rating, o.note
FROM hot_users u
JOIN hot_orders o ON o.user_id = u.id
WHERE u.name @@@ 'bob OR alice'
ORDER BY u.name, u.id, o.id
LIMIT 4;
                                                                                              QUERY PLAN                                                                                              
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: u.id, u.name, u.rating, o.note, o.id
   ->  Custom Scan (ParadeDB Join Scan)
         Output: u.id, u.name, u.rating, o.note, o.id
         Relation Tree: o INNER u
         Join Cond: u.id = o.user_id
         Limit: 4
         Order By: u.name asc, o.user_id asc, o.id asc
         DataFusion Physical Plan: 
           : ProjectionExec: expr=[id@4 as col_1, name@5 as col_2, NULL as col_3, NULL as col_4, id@2 as col_5, ctid_0@0 as ctid_0, ctid_1@3 as ctid_1]
           :   TantivyDecodeExec: decode=[name]
           :     TantivyFetchExec: fetch=[name]
           :       SegmentedTopKExec: expr=[name@5 ASC NULLS LAST, user_id@1 ASC NULLS LAST, id@2 ASC NULLS LAST], k=4, visibility_checks=[o, u]
           :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, user_id@1)], projection=[ctid_0@3, user_id@4, id@5, ctid_1@0, id@1, name@2]
           :           CooperativeExec
           :             PgSearchScan: table=u, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"name","query_string":"bob OR alice","lenient":null,"conjunction_mode":null}}}}
           :           CooperativeExec
           :             PgSearchScan: table=o, segments=1, dynamic_filters=1, query="all"
(18 rows)

SELECT u.id, u.name, u.rating, o.note
FROM hot_users u
JOIN hot_orders o ON o.user_id = u.id
WHERE u.name @@@ 'bob OR alice'
ORDER BY u.name, u.id, o.id
LIMIT 4;
 id | name  | rating |     note     
----+-------+--------+--------------
  1 | alice |      1 | first order
  3 | alice |      1 | fourth order
  2 | bob   |      2 | second order
  2 | bob   |      2 | third order
(4 rows)

-- The nullable side of an outer join is checked for visibility inside its own scan.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT o.id, o.note, u.id, u.name, u.rating
FROM hot_orders o
LEFT JOIN hot_users u ON o.user_id = u.id
WHERE o.note @@@ 'order'
ORDER BY o.id
LIMIT 10;
                                                                                          QUERY PLAN                                                                                           
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: o.id, o.note, u.id, u.name, u.rating
   ->  Custom Scan (ParadeDB Join Scan)
         Output: o.id, o.note, u.id, u.name, u.rating
         Relation Tree: u RIGHT o
         Join Cond: o.user_id = u.id
         Limit: 10
         Order By: o.id asc
         DataFusion Physical Plan: 
           : ProjectionExec: expr=[id@3 as col_1, NULL as col_2, id@1 as col_3, NULL as col_4, NULL as col_5, ctid_0@0 as ctid_0, ctid_1@2 as ctid_1]
           :   SortExec: TopK(fetch=10), expr=[id@3 ASC NULLS LAST], preserve_partitioning=[false]
           :     VisibilityFilterExec: tables=[o]
           :       TantivyFetchExec: fetch=[ctid_1]
           :         HashJoinExec: mode=CollectLeft, join_type=Right, on=[(id@1, user_id@1)], projection=[ctid_0@0, id@1, ctid_1@2, id@4]
           :           CooperativeExec
           :             PgSearchScan: table=u, segments=1, visibility=eager, query="all"
           :           CooperativeExec
           :             PgSearchScan: table=o, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"note","query_string":"order","lenient":null,"conjunction_mode":null}}}}
(18 rows)

SELECT o.id, o.note, u.id, u.name, u.rating
FROM hot_orders o
LEFT JOIN hot_users u ON o.user_id = u.id
WHERE o.note @@@ 'order'
ORDER BY o.id
LIMIT 10;
 id |     note      | id | name  | rating 
----+---------------+----+-------+--------
 10 | first order   |  1 | alice |      1
 11 | second order  |  2 | bob   |      2
