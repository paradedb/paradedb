-- =====================================================================
-- TEST 6: Facet aggregation (COUNT DISTINCT) over unnest on 3-table join
-- =====================================================================
EXPLAIN (COSTS OFF)
SELECT
    t AS tag,
    count(DISTINCT p.id) AS product_count
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
LEFT JOIN jlu_stores s ON b.id = s.brand_id
CROSS JOIN LATERAL unnest(b.tags) AS t
WHERE (
    p.title @@@ 'Smart'
    OR b.brand_name @@@ 'Electronics'
    OR s.store_name @@@ 'Electronics'
)
GROUP BY t
ORDER BY product_count DESC, t
LIMIT 10;
WARNING:  Aggregate Scan (DataFusion) not used: RTI 6 is not a plain relation (rtekind: 3), which is not supported (table: join)
                                                                                                                                                                                                                                                                                                                QUERY PLAN                                                                                                                                                                                                                                                                                                                 
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Sort
         Sort Key: (count(DISTINCT p.id)) DESC, t.t
         ->  GroupAggregate
               Group Key: t.t
               ->  Sort
                     Sort Key: t.t, p.id
                     ->  Nested Loop
                           ->  Hash Join
                                 Hash Cond: (b.product_id = p.id)
                                 Join Filter: ((p.id @@@ '{"with_index":{"oid":14735076,"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}}'::paradedb.searchqueryinput) OR (b.id @@@ '{"with_index":{"oid":14735077,"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}}'::paradedb.searchqueryinput) OR (s.id @@@ '{"with_index":{"oid":14735078,"query":{"parse_with_field":{"field":"store_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}}'::paradedb.searchqueryinput))
                                 ->  Nested Loop Left Join
                                       Join Filter: (b.id = s.brand_id)
                                       ->  Seq Scan on jlu_brands b
                                       ->  Materialize
                                             ->  Seq Scan on jlu_stores s
                                 ->  Hash
                                       ->  Seq Scan on jlu_products p
                           ->  Function Scan on unnest t
(19 rows)

SELECT
    t AS tag,
    count(DISTINCT p.id) AS product_count
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
LEFT JOIN jlu_stores s ON b.id = s.brand_id
CROSS JOIN LATERAL unnest(b.tags) AS t
WHERE (
    p.title @@@ 'Smart'
    OR b.brand_name @@@ 'Electronics'
    OR s.store_name @@@ 'Electronics'
)
GROUP BY t
ORDER BY product_count DESC, t
LIMIT 10;
WARNING:  Aggregate Scan (DataFusion) not used: RTI 6 is not a plain relation (rtekind: 3), which is not supported (table: join)
     tag      | product_count 
--------------+---------------
 bestseller   |             1
 home_theater |             1
(2 rows)

-- =====================================================================
-- TEST 7: Truncated TopK pushdown strictly respecting unnested sort order
-- =====================================================================
EXPLAIN (COSTS OFF)
SELECT
    p.id,
    c AS category
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
CROSS JOIN LATERAL unnest(p.categories) AS c
WHERE p.title @@@ 'Smart'
ORDER BY p.id, c ASC
LIMIT 2;
WARNING:  JoinScan not used: LIMIT pushdown is unsafe due to un-absorbed relations (tables: b, p)
                                                                               QUERY PLAN                                                                               
------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Sort
         Sort Key: p.id, c.c
         ->  Nested Loop
               ->  Nested Loop
                     Join Filter: (p.id = b.product_id)
                     ->  Custom Scan (ParadeDB Base Scan) on jlu_products p
                           Table: jlu_products
                           Index: jlu_products_idx
                           Exec Method: NormalScanExecState
                           Scores: false
                           Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}}
                     ->  Seq Scan on jlu_brands b
               ->  Function Scan on unnest c
(14 rows)

SELECT
    p.id,
    c AS category
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
CROSS JOIN LATERAL unnest(p.categories) AS c
WHERE p.title @@@ 'Smart'
ORDER BY p.id, c ASC
LIMIT 2;
WARNING:  JoinScan not used: LIMIT pushdown is unsafe due to un-absorbed relations (tables: b, p)
 id |  category   
----+-------------
  3 | electronics
  3 | home
(2 rows)

