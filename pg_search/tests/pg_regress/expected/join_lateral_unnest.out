-- =====================================================================
-- TEST 9: CROSS JOIN LATERAL unnest drops empty arrays and NULLs
-- =====================================================================
EXPLAIN (COSTS OFF)
SELECT
    p.id,
    p.title,
    t AS tag
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
CROSS JOIN LATERAL unnest(b.tags) AS t
WHERE (p.title @@@ 'Category' OR b.brand_name @@@ 'Brand')
ORDER BY p.id, t
LIMIT 10;
WARNING:  JoinScan not used: LIMIT pushdown is unsafe due to un-absorbed relations (tables: b, p)
                                                                                                                                                                                                       QUERY PLAN                                                                                                                                                                                                        
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Sort
         Sort Key: p.id, t.t
         ->  Nested Loop
               ->  Hash Join
                     Hash Cond: (b.product_id = p.id)
                     Join Filter: ((p.id @@@ '{"with_index":{"oid":14735076,"query":{"parse_with_field":{"field":"title","query_string":"Category","lenient":null,"conjunction_mode":null}}}}'::paradedb.searchqueryinput) OR (b.id @@@ '{"with_index":{"oid":14735077,"query":{"parse_with_field":{"field":"brand_name","query_string":"Brand","lenient":null,"conjunction_mode":null}}}}'::paradedb.searchqueryinput))
                     ->  Seq Scan on jlu_brands b
                     ->  Hash
                           ->  Seq Scan on jlu_products p
               ->  Function Scan on unnest t
(11 rows)

SELECT
    p.id,
    p.title,
    t AS tag
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
CROSS JOIN LATERAL unnest(b.tags) AS t
WHERE (p.title @@@ 'Category' OR b.brand_name @@@ 'Brand')
ORDER BY p.id, t
LIMIT 10;
WARNING:  JoinScan not used: LIMIT pushdown is unsafe due to un-absorbed relations (tables: b, p)
