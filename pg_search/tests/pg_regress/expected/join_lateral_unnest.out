-- =====================================================================
-- Tests for JoinScan and AggregateScan pushdown with LATERAL unnest
-- over multi-table joins.
--
-- Focuses on non-aggregate JoinScan queries with LATERAL unnest, with
-- one representative facet aggregate test.
--
-- Exercises:
-- 1. 2-table INNER JOIN + CROSS JOIN LATERAL unnest + LIMIT (JoinScan)
-- 2. 3-table JOIN + CROSS JOIN LATERAL unnest + LIMIT (JoinScan)
-- 3. LEFT JOIN LATERAL unnest (preserving NULL and empty array rows) (JoinScan)
-- 4. Multiple CROSS JOIN LATERAL unnests across different joined tables (JoinScan)
-- 5. Filtering on the unnested column in WHERE (JoinScan)
-- 6. Facet aggregation (COUNT DISTINCT) over unnested array on 3-table join (AggregateScan)
-- =====================================================================
CREATE EXTENSION IF NOT EXISTS pg_search;
SET max_parallel_workers_per_gather = 0;
SET paradedb.enable_aggregate_custom_scan TO on;
SET paradedb.enable_range_partitioned_join TO off;
-- =====================================================================
-- Test Data Setup
-- =====================================================================
CREATE TABLE jlu_products (
    id SERIAL PRIMARY KEY,
    title TEXT,
    categories TEXT[],
    price FLOAT
);
CREATE TABLE jlu_brands (
    id SERIAL PRIMARY KEY,
    product_id INTEGER,
    brand_name TEXT,
    tags TEXT[]
);
CREATE TABLE jlu_stores (
    id SERIAL PRIMARY KEY,
    brand_id INTEGER,
    store_name TEXT,
    regions TEXT[]
);
INSERT INTO jlu_products (title, categories, price) VALUES
    ('Flagship Smartphone Pro', ARRAY['electronics', 'mobile'], 999.00),
    ('Noise Canceling Headphones', ARRAY['electronics', 'audio'], 299.00),
    ('Smart TV 4K OLED', ARRAY['electronics', 'video', 'home'], 1499.00),
    ('Ergonomic Office Chair', ARRAY['furniture', 'office'], 350.00),
    ('Mechanical Keyboard RGB', ARRAY['electronics', 'accessories'], 120.00),
    ('Mystery Item No Category', NULL, 50.00),
    ('Sample Item Empty Category', ARRAY[]::TEXT[], 25.00);
INSERT INTO jlu_brands (product_id, brand_name, tags) VALUES
    (1, 'TechCorp Global', ARRAY['premium', 'bestseller']),
    (2, 'SoundMaster Audio', ARRAY['audio_gear', 'wireless']),
    (3, 'VisionPlus Electronics', ARRAY['home_theater', 'bestseller']),
    (4, 'ErgoWorks Design', ARRAY['ergonomic']),
    (5, 'KeyPro Gaming', ARRAY['gaming', 'peripherals']),
    (6, 'GenericBrand', NULL),
    (7, 'ClearanceBrand', ARRAY[]::TEXT[]);
INSERT INTO jlu_stores (brand_id, store_name, regions) VALUES
    (1, 'TechCorp Flagship NYC', ARRAY['north_america', 'east_coast']),
    (2, 'SoundMaster London', ARRAY['europe', 'uk']),
    (3, 'VisionPlus Tokyo', ARRAY['asia', 'japan']),
    (4, 'ErgoWorks Berlin', ARRAY['europe', 'germany']),
    (5, 'KeyPro Online', ARRAY['global']);
-- =====================================================================
-- BM25 Index Creation with Array Fast Fields
-- =====================================================================
CREATE INDEX jlu_products_idx ON jlu_products
USING paradedb (id, title, (categories::pdb.literal), price)
WITH (key_field='id');
CREATE INDEX jlu_brands_idx ON jlu_brands
USING paradedb (id, product_id, brand_name, (tags::pdb.literal))
WITH (key_field='id');
CREATE INDEX jlu_stores_idx ON jlu_stores
USING paradedb (id, brand_id, store_name, (regions::pdb.literal))
WITH (key_field='id');
-- =====================================================================
-- TEST 1: Basic 2-table INNER JOIN with CROSS JOIN LATERAL unnest + LIMIT
-- =====================================================================
EXPLAIN (COSTS OFF)
SELECT
    p.id,
    p.title,
    b.brand_name,
    c AS category
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
CROSS JOIN LATERAL unnest(p.categories) AS c
WHERE p.title @@@ 'Smart' OR b.brand_name @@@ 'Electronics'
ORDER BY p.id, c
LIMIT 5;
                                                                                                                                            QUERY PLAN                                                                                                                                             
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: (p INNER b) CROSS JOIN LATERAL UNNEST (categories)
   Join Cond: p.id = b.product_id
   Join Predicate: (p:{"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}} OR b:{"with_index":{"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}})
   Limit: 5
   Order By: p.id asc, categories asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@0 as col_1, NULL as col_2, NULL as col_3, p_0_categories@1 as col_4, ctid_0@2 as ctid_0, ctid_1@3 as ctid_1]
     :   SortExec: TopK(fetch=5), expr=[id@0 ASC NULLS LAST, p_0_categories@1 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[p, b]
     :       TantivyFetchExec: fetch=[ctid_0, ctid_1]
     :         UnnestExec
     :           ProjectionExec: expr=[id@0 as id, categories@1 as p_0_categories, ctid_0@2 as ctid_0, ctid_1@3 as ctid_1]
     :             HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@0)], filter=__p_0_tag_0@0 OR __b_1_tag_0@1, projection=[id@0, categories@1, ctid_0@2, ctid_1@5]
     :               CooperativeExec
     :                 PgSearchScan: table=p, segments=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}}
     :               CooperativeExec
     :                 PgSearchScan: table=b, segments=1, dynamic_filters=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}}
(18 rows)

SELECT
    p.id,
    p.title,
    b.brand_name,
    c AS category
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
CROSS JOIN LATERAL unnest(p.categories) AS c
WHERE p.title @@@ 'Smart' OR b.brand_name @@@ 'Electronics'
ORDER BY p.id, c
LIMIT 5;
 id |      title       |       brand_name       |  category   
----+------------------+------------------------+-------------
  3 | Smart TV 4K OLED | VisionPlus Electronics | electronics
  3 | Smart TV 4K OLED | VisionPlus Electronics | home
  3 | Smart TV 4K OLED | VisionPlus Electronics | video
(3 rows)

-- =====================================================================
-- TEST 2: 3-table JOIN with CROSS JOIN LATERAL unnest on 2nd table + LIMIT
-- =====================================================================
EXPLAIN (COSTS OFF)
SELECT
    p.id,
    p.title,
    b.brand_name,
    s.store_name,
    t AS tag
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
LEFT JOIN jlu_stores s ON b.id = s.brand_id
CROSS JOIN LATERAL unnest(b.tags) AS t
WHERE (
    p.title @@@ 'Smart'
    OR b.brand_name @@@ 'Electronics'
    OR s.store_name @@@ 'Electronics'
)
ORDER BY p.id, t
LIMIT 10;
                                                                                                                                                                                                                   QUERY PLAN                                                                                                                                                                                                                    
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: ((p INNER b) LEFT s) CROSS JOIN LATERAL UNNEST (tags)
   Join Cond: b.id = s.brand_id, p.id = b.product_id
   Join Predicate: (p:{"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}} OR b:{"with_index":{"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}} OR s:{"with_index":{"query":{"parse_with_field":{"field":"store_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}})
   Limit: 10
   Order By: p.id asc, tags asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@0 as col_1, NULL as col_2, NULL as col_3, NULL as col_4, b_1_tags@2 as col_5, ctid_0@1 as ctid_0, ctid_1@3 as ctid_1, ctid_2@4 as ctid_2]
     :   SortExec: TopK(fetch=10), expr=[id@0 ASC NULLS LAST, b_1_tags@2 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[p, b]
     :       TantivyFetchExec: fetch=[ctid_0, ctid_1]
     :         UnnestExec
     :           ProjectionExec: expr=[id@0 as id, ctid_0@1 as ctid_0, tags@2 as b_1_tags, ctid_1@3 as ctid_1, ctid_2@4 as ctid_2]
     :             FilterExec: __p_0_tag_0@2 OR __b_1_tag_0@5 OR __s_2_tag_0@7, projection=[id@0, ctid_0@1, tags@3, ctid_1@4, ctid_2@6]
     :               HashJoinExec: mode=CollectLeft, join_type=Right, on=[(brand_id@0, id@3)], projection=[id@3, ctid_0@4, __p_0_tag_0@5, tags@7, ctid_1@8, __b_1_tag_0@9, ctid_2@1, __s_2_tag_0@2]
     :                 CooperativeExec
     :                   PgSearchScan: table=s, segments=1, visibility=eager, tag_0={"with_index":{"query":{"parse_with_field":{"field":"store_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}}
     :                 HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@1)], projection=[id@0, ctid_0@1, __p_0_tag_0@2, id@3, tags@5, ctid_1@6, __b_1_tag_0@7]
     :                   CooperativeExec
     :                     PgSearchScan: table=p, segments=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}}
     :                   CooperativeExec
     :                     PgSearchScan: table=b, segments=1, dynamic_filters=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}}
(22 rows)

SELECT
    p.id,
    p.title,
    b.brand_name,
    s.store_name,
    t AS tag
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
LEFT JOIN jlu_stores s ON b.id = s.brand_id
CROSS JOIN LATERAL unnest(b.tags) AS t
WHERE (
    p.title @@@ 'Smart'
    OR b.brand_name @@@ 'Electronics'
    OR s.store_name @@@ 'Electronics'
)
ORDER BY p.id, t
LIMIT 10;
 id |      title       |       brand_name       |    store_name    |     tag      
----+------------------+------------------------+------------------+--------------
  3 | Smart TV 4K OLED | VisionPlus Electronics | VisionPlus Tokyo | bestseller
  3 | Smart TV 4K OLED | VisionPlus Electronics | VisionPlus Tokyo | home_theater
(2 rows)

-- =====================================================================
-- TEST 3: LEFT JOIN LATERAL unnest (preserves NULL and empty array rows)
-- =====================================================================
EXPLAIN (COSTS OFF)
SELECT
    p.id,
    p.title,
    b.brand_name,
    t AS tag
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
LEFT JOIN LATERAL unnest(b.tags) AS t ON true
WHERE p.title @@@ 'Smart OR Mystery OR Empty' OR b.brand_name @@@ 'Electronics'
ORDER BY p.id, t NULLS LAST
LIMIT 10;
                                                                                                                                                      QUERY PLAN                                                                                                                                                       
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: (p INNER b) LEFT JOIN LATERAL UNNEST (tags)
   Join Cond: p.id = b.product_id
   Join Predicate: (p:{"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart OR Mystery OR Empty","lenient":null,"conjunction_mode":null}}}} OR b:{"with_index":{"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}})
   Limit: 10
   Order By: p.id asc, tags asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@0 as col_1, NULL as col_2, NULL as col_3, b_1_tags@2 as col_4, ctid_0@1 as ctid_0, ctid_1@3 as ctid_1]
     :   SortExec: TopK(fetch=10), expr=[id@0 ASC NULLS LAST, b_1_tags@2 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[p, b]
     :       TantivyFetchExec: fetch=[ctid_0, ctid_1]
     :         UnnestExec
     :           ProjectionExec: expr=[id@0 as id, ctid_0@1 as ctid_0, tags@2 as b_1_tags, ctid_1@3 as ctid_1]
     :             HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@0)], filter=__p_0_tag_0@0 OR __b_1_tag_0@1, projection=[id@0, ctid_0@1, tags@4, ctid_1@5]
     :               CooperativeExec
     :                 PgSearchScan: table=p, segments=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart OR Mystery OR Empty","lenient":null,"conjunction_mode":null}}}}
     :               CooperativeExec
     :                 PgSearchScan: table=b, segments=1, dynamic_filters=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}}
(18 rows)

SELECT
    p.id,
    p.title,
    b.brand_name,
    t AS tag
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
LEFT JOIN LATERAL unnest(b.tags) AS t ON true
WHERE p.title @@@ 'Smart OR Mystery OR Empty' OR b.brand_name @@@ 'Electronics'
ORDER BY p.id, t NULLS LAST
LIMIT 10;
 id |           title            |       brand_name       |     tag      
----+----------------------------+------------------------+--------------
  3 | Smart TV 4K OLED           | VisionPlus Electronics | bestseller
  3 | Smart TV 4K OLED           | VisionPlus Electronics | home_theater
  6 | Mystery Item No Category   | GenericBrand           | 
  7 | Sample Item Empty Category | ClearanceBrand         | 
(4 rows)

-- =====================================================================
-- TEST 4: Multiple CROSS JOIN LATERAL unnests across different tables
-- =====================================================================
EXPLAIN (COSTS OFF)
SELECT
    p.id,
    p.title,
    c AS category,
    r AS region
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
JOIN jlu_stores s ON b.id = s.brand_id
CROSS JOIN LATERAL unnest(p.categories) AS c
CROSS JOIN LATERAL unnest(s.regions) AS r
WHERE p.title @@@ 'Smart' OR b.brand_name @@@ 'Electronics'
ORDER BY p.id, c, r
LIMIT 10;
                                                                                                                                            QUERY PLAN                                                                                                                                             
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: (((p INNER b) INNER s) CROSS JOIN LATERAL UNNEST (categories)) CROSS JOIN LATERAL UNNEST (regions)
   Join Cond: b.id = s.brand_id, p.id = b.product_id
   Join Predicate: (p:{"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}} OR b:{"with_index":{"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}})
   Limit: 10
   Order By: p.id asc, categories asc, regions asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@0 as col_1, NULL as col_2, p_0_categories@1 as col_3, s_2_regions@4 as col_4, ctid_0@2 as ctid_0, ctid_1@3 as ctid_1, ctid_2@5 as ctid_2]
     :   SortExec: TopK(fetch=10), expr=[id@0 ASC NULLS LAST, p_0_categories@1 ASC NULLS LAST, s_2_regions@4 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[p, b, s]
     :       TantivyFetchExec: fetch=[ctid_0, ctid_1, ctid_2]
     :         UnnestExec
     :           ProjectionExec: expr=[id@0 as id, p_0_categories@1 as p_0_categories, ctid_0@2 as ctid_0, ctid_1@3 as ctid_1, regions@4 as s_2_regions, ctid_2@5 as ctid_2]
     :             UnnestExec
     :               ProjectionExec: expr=[id@0 as id, categories@1 as p_0_categories, ctid_0@2 as ctid_0, ctid_1@3 as ctid_1, regions@4 as regions, ctid_2@5 as ctid_2]
     :                 HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(brand_id@0, id@3)], projection=[id@3, categories@4, ctid_0@5, ctid_1@7, regions@1, ctid_2@2]
     :                   CooperativeExec
     :                     PgSearchScan: table=s, segments=1, query="all"
     :                   HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@1)], filter=__p_0_tag_0@0 OR __b_1_tag_0@1, projection=[id@0, categories@1, ctid_0@2, id@4, ctid_1@6]
     :                     CooperativeExec
     :                       PgSearchScan: table=p, segments=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}}
     :                     CooperativeExec
     :                       PgSearchScan: table=b, segments=1, dynamic_filters=2, tag_0={"with_index":{"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}}
(23 rows)

SELECT
    p.id,
    p.title,
    c AS category,
    r AS region
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
JOIN jlu_stores s ON b.id = s.brand_id
CROSS JOIN LATERAL unnest(p.categories) AS c
CROSS JOIN LATERAL unnest(s.regions) AS r
WHERE p.title @@@ 'Smart' OR b.brand_name @@@ 'Electronics'
ORDER BY p.id, c, r
LIMIT 10;
 id |      title       |  category   | region 
----+------------------+-------------+--------
  3 | Smart TV 4K OLED | electronics | asia
  3 | Smart TV 4K OLED | electronics | japan
  3 | Smart TV 4K OLED | home        | asia
  3 | Smart TV 4K OLED | home        | japan
  3 | Smart TV 4K OLED | video       | asia
  3 | Smart TV 4K OLED | video       | japan
(6 rows)

-- =====================================================================
-- TEST 5: Filtering on the unnested column in WHERE
-- =====================================================================
EXPLAIN (COSTS OFF)
SELECT
    p.id,
    p.title,
    b.brand_name,
    t AS tag
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
CROSS JOIN LATERAL unnest(b.tags) AS t
WHERE (p.title @@@ 'Smart' OR b.brand_name @@@ 'Electronics')
  AND t = 'bestseller'
ORDER BY p.id, t
LIMIT 10;
                                                                                                                                                               QUERY PLAN                                                                                                                                                                
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: (p INNER b) CROSS JOIN LATERAL UNNEST (tags)
   Join Cond: p.id = b.product_id
   Join Predicate: ((p:{"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}} OR b:{"with_index":{"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}}) AND heap:(t.t = 'bestseller'::text))
   Limit: 10
   Order By: p.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@0 as col_1, NULL as col_2, NULL as col_3, b_1_tags@2 as col_4, ctid_0@1 as ctid_0, ctid_1@3 as ctid_1]
     :   SortExec: TopK(fetch=10), expr=[id@0 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[p, b]
     :       TantivyFetchExec: fetch=[ctid_0, ctid_1]
     :         FilterExec: b_1_tags@2 = bestseller
     :           UnnestExec
     :             ProjectionExec: expr=[id@0 as id, ctid_0@1 as ctid_0, tags@2 as b_1_tags, ctid_1@3 as ctid_1]
     :               HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@0)], filter=__p_0_tag_0@0 OR __b_1_tag_0@1, projection=[id@0, ctid_0@1, tags@4, ctid_1@5]
     :                 CooperativeExec
     :                   PgSearchScan: table=p, segments=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}}
     :                 CooperativeExec
     :                   PgSearchScan: table=b, segments=1, dynamic_filters=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}}
(19 rows)

SELECT
    p.id,
    p.title,
    b.brand_name,
    t AS tag
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
CROSS JOIN LATERAL unnest(b.tags) AS t
WHERE (p.title @@@ 'Smart' OR b.brand_name @@@ 'Electronics')
  AND t = 'bestseller'
ORDER BY p.id, t
LIMIT 10;
 id |      title       |       brand_name       |    tag     
----+------------------+------------------------+------------
  3 | Smart TV 4K OLED | VisionPlus Electronics | bestseller
(1 row)

-- =====================================================================
-- TEST 5b: Filtering on unnested column when column is omitted from SELECT
-- =====================================================================
EXPLAIN (COSTS OFF)
SELECT
    p.id,
    p.title,
    b.brand_name
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
CROSS JOIN LATERAL unnest(b.tags) AS t
WHERE (p.title @@@ 'Smart' OR b.brand_name @@@ 'Electronics')
  AND t = 'bestseller'
ORDER BY p.id
LIMIT 10;
                                                                                                                                                               QUERY PLAN                                                                                                                                                                
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: (p INNER b) CROSS JOIN LATERAL UNNEST (tags)
   Join Cond: p.id = b.product_id
   Join Predicate: ((p:{"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}} OR b:{"with_index":{"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}}) AND heap:(t.t = 'bestseller'::text))
   Limit: 10
   Order By: p.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@0 as col_1, NULL as col_2, NULL as col_3, ctid_0@1 as ctid_0, ctid_1@2 as ctid_1]
     :   SortExec: TopK(fetch=10), expr=[id@0 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[p, b]
     :       TantivyFetchExec: fetch=[ctid_0, ctid_1]
     :         FilterExec: b_1_tags@2 = bestseller, projection=[id@0, ctid_0@1, ctid_1@3]
     :           UnnestExec
     :             ProjectionExec: expr=[id@0 as id, ctid_0@1 as ctid_0, tags@2 as b_1_tags, ctid_1@3 as ctid_1]
     :               HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@0)], filter=__p_0_tag_0@0 OR __b_1_tag_0@1, projection=[id@0, ctid_0@1, tags@4, ctid_1@5]
     :                 CooperativeExec
     :                   PgSearchScan: table=p, segments=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}}
     :                 CooperativeExec
     :                   PgSearchScan: table=b, segments=1, dynamic_filters=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}}
(19 rows)

SELECT
    p.id,
    p.title,
    b.brand_name
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
CROSS JOIN LATERAL unnest(b.tags) AS t
WHERE (p.title @@@ 'Smart' OR b.brand_name @@@ 'Electronics')
