-- =====================================================================
-- TEST 6: Facet aggregation (COUNT DISTINCT) over unnest on 3-table join
-- =====================================================================
EXPLAIN (COSTS OFF)
SELECT
    t AS tag,
    count(DISTINCT p.id) AS product_count
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
LEFT JOIN jlu_stores s ON b.id = s.brand_id
CROSS JOIN LATERAL unnest(b.tags) AS t
WHERE (
    p.title @@@ 'Smart'
    OR b.brand_name @@@ 'Electronics'
    OR s.store_name @@@ 'Electronics'
)
GROUP BY t
ORDER BY product_count DESC, t
LIMIT 10;
                                                                                                                       QUERY PLAN                                                                                                                       
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Sort
         Sort Key: (count(DISTINCT p.id)) DESC, t.t
         ->  Custom Scan (ParadeDB Aggregate Scan)
               Backend: DataFusion
               Indexes: jlu_products_idx (p), jlu_brands_idx (b), jlu_stores_idx (s)
               Group By: tags
               Aggregates: COUNT(DISTINCT)(id)
               DataFusion Physical Plan: 
                 : AggregateExec: mode=Single, gby=[b_1_tags@1 as b_1_tags], aggr=[count(DISTINCT p_0.id) as agg_0]
                 :   UnnestExec
                 :     ProjectionExec: expr=[id@0 as id, tags@1 as b_1_tags]
                 :       FilterExec: __p_0_tag_0@1 OR __b_1_tag_0@3 OR __s_2_tag_0@4, projection=[id@0, tags@2]
                 :         HashJoinExec: mode=CollectLeft, join_type=Right, on=[(brand_id@0, id@2)], projection=[id@2, __p_0_tag_0@3, tags@5, __b_1_tag_0@6, __s_2_tag_0@1]
                 :           CooperativeExec
                 :             PgSearchScan: table=s, segments=1, visibility=eager, tag_0={"with_index":{"query":{"parse_with_field":{"field":"store_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}}
                 :           HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@1)], projection=[id@0, __p_0_tag_0@1, id@2, tags@4, __b_1_tag_0@5]
                 :             CooperativeExec
                 :               PgSearchScan: table=p, segments=1, visibility=eager, tag_0={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}}
                 :             CooperativeExec
                 :               PgSearchScan: table=b, segments=1, dynamic_filters=1, visibility=eager, tag_0={"with_index":{"query":{"parse_with_field":{"field":"brand_name","query_string":"Electronics","lenient":null,"conjunction_mode":null}}}}
(21 rows)

SELECT
    t AS tag,
    count(DISTINCT p.id) AS product_count
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
LEFT JOIN jlu_stores s ON b.id = s.brand_id
CROSS JOIN LATERAL unnest(b.tags) AS t
WHERE (
    p.title @@@ 'Smart'
    OR b.brand_name @@@ 'Electronics'
    OR s.store_name @@@ 'Electronics'
)
GROUP BY t
ORDER BY product_count DESC, t
LIMIT 10;
     tag      | product_count 
--------------+---------------
 bestseller   |             1
 home_theater |             1
(2 rows)

-- =====================================================================
-- TEST 7: Truncated TopK pushdown strictly respecting unnested sort order
-- =====================================================================
EXPLAIN (COSTS OFF)
SELECT
    p.id,
    c AS category
FROM jlu_products p
JOIN jlu_brands b ON p.id = b.product_id
CROSS JOIN LATERAL unnest(p.categories) AS c
WHERE p.title @@@ 'Smart'
ORDER BY p.id, c ASC
LIMIT 2;
                                                                                          QUERY PLAN                                                                                          
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: (p INNER b) CROSS JOIN LATERAL UNNEST (categories)
   Join Cond: p.id = b.product_id
   Limit: 2
   Order By: p.id asc, categories asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@0 as col_1, p_0_categories@1 as col_2, ctid_0@2 as ctid_0, ctid_1@3 as ctid_1]
     :   SortExec: TopK(fetch=2), expr=[id@0 ASC NULLS LAST, p_0_categories@1 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[p, b]
     :       TantivyFetchExec: fetch=[ctid_0, ctid_1]
     :         UnnestExec
     :           ProjectionExec: expr=[id@0 as id, categories@1 as p_0_categories, ctid_0@2 as ctid_0, ctid_1@3 as ctid_1]
     :             HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@0)], projection=[id@0, categories@1, ctid_0@2, ctid_1@4]
     :               CooperativeExec
     :                 PgSearchScan: table=p, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"Smart","lenient":null,"conjunction_mode":null}}}}
     :               CooperativeExec
     :                 PgSearchScan: table=b, segments=1, dynamic_filters=1, query="all"
(17 rows)

