-- =============================================================================
-- SECTION 3: Non-Equi OUTER JOINs
-- =============================================================================
-- Test 3.1: LEFT JOIN with pure non-equi ON condition
-- Preserved left rows with no qualifying offer must be null-extended
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT i.id, i.name, i.price, o.promo_name, o.max_price
FROM nonequi_items i
LEFT JOIN nonequi_offers o ON i.price > o.max_price AND o.min_rating >= 4
WHERE i.description @@@ 'keyboard OR cable OR headset'
ORDER BY i.id, o.id NULLS LAST
LIMIT 10;
WARNING:  JoinScan not used: at least one equi-join key (e.g., a.id = b.id) is required (tables: i, o)
                                                                                          QUERY PLAN                                                                                           
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: i.id, i.name, i.price, o.promo_name, o.max_price, o.id
   ->  Sort
         Output: i.id, i.name, i.price, o.promo_name, o.max_price, o.id
         Sort Key: i.id, o.id
         ->  Nested Loop Left Join
               Output: i.id, i.name, i.price, o.promo_name, o.max_price, o.id
               Join Filter: (i.price > o.max_price)
               ->  Custom Scan (ParadeDB Base Scan) on public.nonequi_items i
                     Output: i.id, i.name, i.price
                     Table: nonequi_items
                     Index: nonequi_items_idx
                     Worker Selection: Cost model
                     Exec Method: NormalScanExecState
                     Scores: false
                     Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"keyboard OR cable OR headset","lenient":null,"conjunction_mode":null}}}}
               ->  Materialize
                     Output: o.promo_name, o.max_price, o.id
                     ->  Seq Scan on public.nonequi_offers o
                           Output: o.promo_name, o.max_price, o.id
                           Filter: (o.min_rating >= 4)
(21 rows)

