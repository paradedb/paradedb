   ->  Sort
         Output: i.id, i.name, o.promo_name, i.category, o.target_category, o.id
         Sort Key: i.id, o.id
         ->  Nested Loop
               Output: i.id, i.name, o.promo_name, i.category, o.target_category, o.id
               Join Filter: (i.category <> o.target_category)
               ->  Custom Scan (ParadeDB Base Scan) on public.nonequi_items i
                     Output: i.id, i.name, i.category
                     Table: nonequi_items
                     Index: nonequi_items_idx
                     Worker Selection: Cost model
                     Exec Method: NormalScanExecState
                     Scores: false
                     Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"wireless","lenient":null,"conjunction_mode":null}}}}
               ->  Custom Scan (ParadeDB Base Scan) on public.nonequi_offers o
                     Output: o.promo_name, o.target_category, o.id
                     Table: nonequi_offers
                     Index: nonequi_offers_idx
                     Worker Selection: Cost model
                     Exec Method: NormalScanExecState
                     Scores: false
                     Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"budget","lenient":null,"conjunction_mode":null}}}}
(24 rows)

