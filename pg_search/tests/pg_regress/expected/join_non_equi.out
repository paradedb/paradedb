         ->  Custom Scan (ParadeDB Join Scan)
               Output: i.id, i.name, i.price, i.rating, o.promo_name, o.id
               Relation Tree: o INNER i
               Join Cond: i.category = o.target_category
               Join Predicate: (heap:{OPEXPR :opno 1757 :opfuncid 1721 :opresulttype 16 :opretset false :opcollid 0 :inputcollid 0 :args ({VAR :varno 1 :varattno 5 :vartype 1700 :vartypmod 655366 :varcollid 0 :varnullingrels (b) :varlevelsup 0 :varreturningtype 0 :varnosyn 1 :varattnosyn 5 :location -1} {VAR :varno 2 :varattno 5 :vartype 1700 :vartypmod 655366 :varcollid 0 :varnullingrels (b) :varlevelsup 0 :varreturningtype 0 :varnosyn 2 :varattnosyn 5 :location -1}) :location -1} AND heap:{OPEXPR :opno 525 :opfuncid 150 :opresulttype 16 :opretset false :opcollid 0 :inputcollid 0 :args ({VAR :varno 1 :varattno 6 :vartype 23 :vartypmod -1 :varcollid 0 :varnullingrels (b) :varlevelsup 0 :varreturningtype 0 :varnosyn 1 :varattnosyn 6 :location -1} {VAR :varno 2 :varattno 7 :vartype 23 :vartypmod -1 :varcollid 0 :varnullingrels (b) :varlevelsup 0 :varreturningtype 0 :varnosyn 2 :varattnosyn 7 :location -1}) :location -1})
               Limit: 10
               Order By: i.id asc, o.id asc
               DataFusion Physical Plan: 
                 : ProjectionExec: expr=[id@5 as col_1, NULL as col_2, price@3 as col_3, rating@4 as col_4, NULL as col_5, id@1 as col_6, ctid_0@0 as ctid_0, ctid_1@2 as ctid_1]
                 :   SortExec: TopK(fetch=10), expr=[id@5 ASC NULLS LAST, id@1 ASC NULLS LAST], preserve_partitioning=[false]
                 :     VisibilityFilterExec: tables=[o, i]
                 :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(category@1, target_category@1)], filter=min_price@0 <= price@2 AND min_rating@1 <= rating@3, projection=[ctid_0@5, id@9, ctid_1@0, price@2, rating@3, id@4]
                 :         CooperativeExec
