               ->  Materialize
                     Output: o.promo_name, o.min_rating, o.id
                     ->  Custom Scan (ParadeDB Base Scan) on public.nonequi_offers o
                           Output: o.promo_name, o.min_rating, o.id
                           Table: nonequi_offers
                           Index: nonequi_offers_idx
                           Worker Selection: Cost model
                           Exec Method: NormalScanExecState
                           Scores: false
                           Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"exclusive OR value","lenient":null,"conjunction_mode":null}}}}
(20 rows)

