SELECT i.id, i.name, o.promo_name, i.rating, o.min_rating
FROM nonequi_items i
JOIN nonequi_offers o ON i.rating >= o.min_rating
WHERE o.description @@@ 'exclusive OR value'
ORDER BY i.id, o.id
LIMIT 10;
