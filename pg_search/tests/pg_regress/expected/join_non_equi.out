         ->  Hash Right Join
               Output: i.id, i.name, o.promo_name, i.price, o.min_price, o.id
               Hash Cond: (o.target_category = i.category)
               Join Filter: (i.price < o.min_price)
               ->  Seq Scan on public.nonequi_offers o
                     Output: o.id, o.promo_name, o.description, o.target_category, o.min_price, o.max_price, o.min_rating
               ->  Hash
                     Output: i.id, i.name, i.price, i.category
                     ->  Custom Scan (ParadeDB Base Scan) on public.nonequi_items i
                           Output: i.id, i.name, i.price, i.category
                           Table: nonequi_items
                           Index: nonequi_items_idx
                           Worker Selection: Cost model
                           Exec Method: NormalScanExecState
                           Scores: false
                           Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"cable OR mat OR mouse","lenient":null,"conjunction_mode":null}}}}
(21 rows)

SELECT i.id, i.name, o.promo_name, i.price, o.min_price
FROM nonequi_items i
LEFT JOIN nonequi_offers o ON i.category = o.target_category AND i.price < o.min_price
WHERE i.description @@@ 'cable OR mat OR mouse'
ORDER BY i.id, o.id NULLS LAST
LIMIT 10;
