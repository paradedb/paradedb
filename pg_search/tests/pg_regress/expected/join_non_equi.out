   ->  Result
         Output: i.id, i.name, o.promo_name, i.price, o.max_price, o.id
         ->  Custom Scan (ParadeDB Join Scan)
               Output: i.id, i.name, i.price, o.promo_name, o.max_price, o.id
               Relation Tree: o INNER i
               Join Cond: i.category = o.target_category
               Join Predicate: heap:{OPEXPR :opno 1755 :opfuncid 1723 :opresulttype 16 :opretset false :opcollid 0 :inputcollid 0 :args ({VAR :varno 1 :varattno 5 :vartype 1700 :vartypmod 655366 :varcollid 0 :varnullingrels (b) :varlevelsup 0 :varreturningtype 0 :varnosyn 1 :varattnosyn 5 :location -1} {VAR :varno 2 :varattno 6 :vartype 1700 :vartypmod 655366 :varcollid 0 :varnullingrels (b) :varlevelsup 0 :varreturningtype 0 :varnosyn 2 :varattnosyn 6 :location -1}) :location -1}
               Limit: 10
               Order By: i.id asc, o.id asc
               DataFusion Physical Plan: 
                 : ProjectionExec: expr=[id@5 as col_1, NULL as col_2, price@4 as col_3, NULL as col_4, max_price@1 as col_5, id@2 as col_6, ctid_0@0 as ctid_0, ctid_1@3 as ctid_1]
                 :   SortExec: TopK(fetch=10), expr=[id@5 ASC NULLS LAST, id@2 ASC NULLS LAST], preserve_partitioning=[false]
                 :     VisibilityFilterExec: tables=[o, i]
                 :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(category@1, target_category@1)], filter=max_price@0 >= price@1, projection=[ctid_0@4, max_price@6, id@7, ctid_1@0, price@2, id@3]
                 :         CooperativeExec
                 :           PgSearchScan: table=i, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"cable OR riser OR mat","lenient":null,"conjunction_mode":null}}}}
                 :         CooperativeExec
                 :           PgSearchScan: table=o, segments=1, dynamic_filters=2, query="all"
(20 rows)

