-- Test 1.3: Range condition (price BETWEEN min_price AND max_price)
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT i.id, i.name, o.promo_name, i.price, o.min_price, o.max_price
FROM nonequi_items i
JOIN nonequi_offers o ON i.price >= o.min_price AND i.price <= o.max_price
WHERE i.description @@@ 'keyboard OR mouse OR headset'
ORDER BY i.id, o.id
LIMIT 10;
WARNING:  JoinScan not used: at least one equi-join key (e.g., a.id = b.id) is required (tables: i, o)
                                                                                             QUERY PLAN                                                                                              
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: i.id, i.name, o.promo_name, i.price, o.min_price, o.max_price, o.id
   ->  Sort
         Output: i.id, i.name, o.promo_name, i.price, o.min_price, o.max_price, o.id
         Sort Key: i.id, o.id
         ->  Nested Loop
               Output: i.id, i.name, o.promo_name, i.price, o.min_price, o.max_price, o.id
               Join Filter: ((i.price >= o.min_price) AND (i.price <= o.max_price))
               ->  Seq Scan on public.nonequi_offers o
                     Output: o.id, o.promo_name, o.description, o.target_category, o.min_price, o.max_price, o.min_rating
               ->  Materialize
                     Output: i.id, i.name, i.price
                     ->  Custom Scan (ParadeDB Base Scan) on public.nonequi_items i
                           Output: i.id, i.name, i.price
                           Table: nonequi_items
                           Index: nonequi_items_idx
                           Worker Selection: Cost model
                           Exec Method: NormalScanExecState
                           Scores: false
                           Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"keyboard OR mouse OR headset","lenient":null,"conjunction_mode":null}}}}
(20 rows)

