-- An outer join keeps the parse-tree nesting.
EXPLAIN (COSTS OFF)
SELECT b.id, r.id
FROM jo_books b
LEFT JOIN jo_reviews r ON r.book_id = b.id
JOIN jo_authors a ON a.id = b.author_id
WHERE a.bio @@@ 'orchid'
ORDER BY b.id, r.id LIMIT 5;
                                                                                      QUERY PLAN                                                                                       
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: (b LEFT r) INNER a
   Join Cond: a.id = b.author_id, r.book_id = b.id
   Limit: 5
   Order By: b.id asc, r.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@1 as col_1, id@3 as col_2, ctid_0@0 as ctid_0, ctid_1@2 as ctid_1]
     :   SortExec: TopK(fetch=5), expr=[id@1 ASC NULLS LAST, id@3 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[b, a], pruned=[a]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, author_id@1)], projection=[ctid_0@2, id@4, ctid_1@5, id@6, ctid_2@1]
     :         CooperativeExec
     :           PgSearchScan: table=a, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"orchid","lenient":null,"conjunction_mode":null}}}}
     :         HashJoinExec: mode=CollectLeft, join_type=Left, on=[(id@2, book_id@1)], projection=[ctid_0@0, author_id@1, id@2, ctid_1@3, id@5]
     :           CooperativeExec
     :             PgSearchScan: table=b, segments=1, dynamic_filters=1, query="all"
     :           CooperativeExec
     :             PgSearchScan: table=r, segments=1, dynamic_filters=1, visibility=eager, query="all"
(17 rows)

