-- physical plan follows.
EXPLAIN (COSTS OFF)
SELECT b.id, r.id
FROM jo_reviews r
JOIN jo_books b ON r.book_id = b.id
JOIN jo_authors a ON a.id = b.author_id
WHERE a.bio @@@ 'orchid' AND r.body @@@ 'lovely'
ORDER BY b.id, r.id LIMIT 5;
                                                                                                QUERY PLAN                                                                                                 
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
