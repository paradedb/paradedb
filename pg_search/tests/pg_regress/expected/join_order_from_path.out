RESET paradedb.enable_aggregate_custom_scan;
RESET paradedb.enable_join_custom_scan;
RESET max_parallel_workers_per_gather;
DROP TABLE jo_reviews;
DROP TABLE jo_books;
DROP TABLE jo_authors;
