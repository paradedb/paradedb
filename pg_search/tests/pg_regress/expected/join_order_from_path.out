FROM jo_books b
JOIN jo_reviews r ON r.book_id = b.id
JOIN jo_authors a ON a.id = b.author_id
WHERE a.bio @@@ 'orchid' AND r.body @@@ 'lovely'
ORDER BY b.id, r.id LIMIT 5;
