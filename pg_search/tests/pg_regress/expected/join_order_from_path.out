-- The aggregate path builds the same chain.
EXPLAIN (COSTS OFF, VERBOSE)
SELECT a.name, COUNT(*)
FROM jo_books b
JOIN jo_reviews r ON r.book_id = b.id
JOIN jo_authors a ON a.id = b.author_id
WHERE a.bio @@@ 'orchid' AND r.body @@@ 'lovely'
GROUP BY a.name
ORDER BY a.name;
                                                                                                          QUERY PLAN                                                                                                           
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: a.name, (count(*))
   Sort Key: a.name
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: a.name, (count(*))
         Backend: DataFusion
         Indexes: jo_books_idx (b), jo_authors_idx (a), jo_reviews_idx (r)
         Group By: name
         Aggregates: COUNT(*)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Single, gby=[name@0 as name], aggr=[count(1) as agg_0]
           :   HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, book_id@0)], projection=[name@1]
           :     HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, author_id@1)], projection=[id@2, name@0]
           :       CooperativeExec
           :         PgSearchScan: table=a, segments=1, eager=[name], visibility=eager, query={"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"orchid","lenient":null,"conjunction_mode":null}}}}
           :       CooperativeExec
           :         PgSearchScan: table=b, segments=1, dynamic_filters=1, visibility=eager, query="all"
           :     CooperativeExec
           :       PgSearchScan: table=r, segments=1, dynamic_filters=1, visibility=eager, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"lovely","lenient":null,"conjunction_mode":null}}}}
(19 rows)

SELECT a.name, COUNT(*)
FROM jo_books b
JOIN jo_reviews r ON r.book_id = b.id
JOIN jo_authors a ON a.id = b.author_id
WHERE a.bio @@@ 'orchid' AND r.body @@@ 'lovely'
GROUP BY a.name
ORDER BY a.name;
   name    | count 
-----------+-------
