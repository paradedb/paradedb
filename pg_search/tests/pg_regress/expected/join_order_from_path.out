-- An ON condition over three relations links the authors only once books and
-- reviews have joined. The planner estimates books and the two authors as the
-- smallest pair, but that pair has no join condition of its own, so the chain
-- does not start there.
EXPLAIN (COSTS OFF)
SELECT b.id, r.id
FROM jo_books b
JOIN jo_reviews r ON r.book_id = b.id
JOIN jo_authors a ON a.id > b.author_id + r.rating
WHERE a.bio @@@ 'orchid'
ORDER BY b.id, r.id LIMIT 5;
                                                                                                         QUERY PLAN                                                                                                         
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: (b INNER r) INNER a
   Join Cond: r.book_id = b.id
   Join Filter: (a.id > (b.author_id + r.rating))
   Limit: 5
   Order By: r.book_id asc, r.id asc
   DataFusion Physical Plan: 
     : SortExec: TopK(fetch=5), expr=[col_1@0 ASC NULLS LAST, col_2@1 ASC NULLS LAST], preserve_partitioning=[false]
     :   ProjectionExec: expr=[id@0 as col_1, id@1 as col_2, ctid_0@2 as ctid_0, ctid_1@3 as ctid_1]
     :     VisibilityFilterExec: tables=[b, r, a], pruned=[a]
     :       ProjectionExec: expr=[ctid_0@2 as ctid_0, id@4 as id, ctid_1@5 as ctid_1, book_id@7 as book_id, id@8 as id, ctid_2@1 as ctid_2]
     :         NestedLoopJoinExec: join_type=Inner, filter=id@0 > join_proj_push_down_1@1, projection=[id@0, ctid_2@1, ctid_0@2, author_id@3, id@4, ctid_1@5, rating@6, book_id@7, id@8]
     :           CooperativeExec
     :             PgSearchScan: table=a, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"orchid","lenient":null,"conjunction_mode":null}}}}
     :           ProjectionExec: expr=[ctid_0@0 as ctid_0, author_id@1 as author_id, id@2 as id, ctid_1@3 as ctid_1, rating@4 as rating, book_id@5 as book_id, id@6 as id, author_id@1 + rating@4 as join_proj_push_down_1]
     :             HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@2, book_id@2)]
     :               CooperativeExec
     :                 PgSearchScan: table=b, segments=1, query="all"
     :               CooperativeExec
     :                 PgSearchScan: table=r, segments=1, dynamic_filters=1, query="all"
(20 rows)

