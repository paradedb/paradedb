-- Two ON conditions that meet at one join after the rebuild land there as
-- one filter.
EXPLAIN (COSTS OFF)
SELECT b.id, r.id
FROM jo_books b
JOIN jo_reviews r ON r.book_id = b.id AND r.rating > b.author_id % 3
JOIN jo_authors a ON a.id = b.author_id AND r.rating <> b.author_id % 5
WHERE a.bio @@@ 'orchid' AND r.body @@@ 'lovely'
ORDER BY b.id, r.id LIMIT 5;
                                                                                                        QUERY PLAN                                                                                                        
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: (b INNER a) INNER r
   Join Cond: r.book_id = b.id, a.id = b.author_id
   Join Filter: ((r.rating <> (b.author_id % 5)) AND (r.rating > (b.author_id % 3)))
   Limit: 5
   Order By: r.book_id asc, r.id asc
   DataFusion Physical Plan: 
     : SortExec: TopK(fetch=5), expr=[col_1@0 ASC NULLS LAST, col_2@1 ASC NULLS LAST], preserve_partitioning=[false]
     :   ProjectionExec: expr=[id@0 as col_1, id@1 as col_2, ctid_0@2 as ctid_0, ctid_2@3 as ctid_2]
     :     VisibilityFilterExec: tables=[b, a, r], pruned=[a]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, book_id@1)], filter=rating@1 != author_id@0 % 5 AND rating@1 > author_id@0 % 3, projection=[ctid_0@0, id@1, ctid_2@4, book_id@5, id@7, ctid_1@3]
     :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, author_id@2)], projection=[ctid_0@2, id@3, author_id@4, ctid_1@1]
     :           CooperativeExec
     :             PgSearchScan: table=a, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"orchid","lenient":null,"conjunction_mode":null}}}}
     :           CooperativeExec
     :             PgSearchScan: table=b, segments=1, dynamic_filters=1, query="all"
     :         CooperativeExec
     :           PgSearchScan: table=r, segments=1, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"lovely","lenient":null,"conjunction_mode":null}}}}
(18 rows)

