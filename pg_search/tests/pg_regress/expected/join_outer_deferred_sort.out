-- =============================================================================
-- A plain integer column with the deferred column's name on the other relation
-- =============================================================================
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT d.id, d.tag, r.tag FROM oj_dim d JOIN oj_ref r ON d.k = r.k WHERE d.txt @@@ 'alpha' ORDER BY d.tag, r.tag LIMIT 5;
                                                                                            QUERY PLAN                                                                                             
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: d.id, d.tag, r.tag
   Relation Tree: d INNER r
   Join Cond: d.k = r.k
   Limit: 5
   Order By: d.tag asc, r.tag asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@0 as col_1, tag@1 as col_2, tag@3 as col_3, ctid_0@2 as ctid_0, ctid_1@4 as ctid_1]
     :   TantivyDecodeExec: decode=[tag]
     :     SegmentedTopKExec: expr=[tag@1 ASC NULLS LAST, tag@3 ASC NULLS LAST], k=5, visibility_checks=[d, r]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(k@1, k@0)], projection=[id@0, tag@2, ctid_0@3, tag@5, ctid_1@6]
     :         CooperativeExec
     :           PgSearchScan: table=d, segments=2, fetch=[tag], query={"with_index":{"query":{"parse_with_field":{"field":"txt","query_string":"alpha","lenient":null,"conjunction_mode":null}}}}
     :         CooperativeExec
     :           PgSearchScan: table=r, segments=1, dynamic_filters=1, query="all"
(15 rows)

SELECT d.id, d.tag, r.tag FROM oj_dim d JOIN oj_ref r ON d.k = r.k WHERE d.txt @@@ 'alpha' ORDER BY d.tag, r.tag LIMIT 5;
