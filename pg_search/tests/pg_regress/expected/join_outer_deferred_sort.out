-- =============================================================================
-- A third relation under the outer join
-- =============================================================================
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT d.id, d.tag, f.id, s.id FROM oj_dim d RIGHT JOIN oj_fact f ON d.k = f.k CROSS JOIN oj_side s WHERE f.txt @@@ 'beta' ORDER BY d.tag, f.id, s.id LIMIT 70;
                                                                                       QUERY PLAN                                                                                        
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: d.id, d.tag, f.id, s.id
   Relation Tree: (f LEFT d) INNER s
   Join Cond: d.k = f.k
   Limit: 70
   Order By: d.tag asc, f.id asc, s.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, tag@3 as col_2, id@0 as col_3, id@5 as col_4, ctid_0@1 as ctid_0, ctid_1@4 as ctid_1, ctid_2@6 as ctid_2]
     :   TantivyDecodeExec: decode=[tag]
     :     SegmentedTopKExec: expr=[tag@3 ASC NULLS LAST, id@0 ASC NULLS LAST, id@5 ASC NULLS LAST], k=70, visibility_checks=[f, s]
     :       ProjectionExec: expr=[id@2 as id, ctid_0@3 as ctid_0, id@4 as id, tag@5 as tag, ctid_1@6 as ctid_1, id@0 as id, ctid_2@1 as ctid_2]
     :         CrossJoinExec
     :           CooperativeExec
     :             PgSearchScan: table=s, segments=1, query="all"
     :           HashJoinExec: mode=CollectLeft, join_type=Right, on=[(k@1, k@1)], projection=[id@4, ctid_0@6, id@0, tag@2, ctid_1@3]
     :             CooperativeExec
     :               PgSearchScan: table=d, segments=2, fetch=[tag], visibility=eager, query="all"
     :             CooperativeExec
     :               PgSearchScan: table=f, segments=1, query={"with_index":{"query":{"parse_with_field":{"field":"txt","query_string":"beta","lenient":null,"conjunction_mode":null}}}}
(19 rows)

