-- An outer join with a predicate the scan can't push down.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT count(*), ju.metadata->'brand'
FROM ju FULL JOIN jp ON ju.id = jp.id
WHERE (ju.name @@@ 'bob') OR ((ju.name IS NULL) AND (ju.name @@@ 'bob'))
GROUP BY ju.metadata->'brand'
ORDER BY 2;
                                                                 QUERY PLAN                                                                  
---------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan) on public.ju
   Output: pdb.agg_fn('COUNT(*)'::text), (ju.metadata -> 'brand'::text)
   Index: ju_idx
   Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"name","query_string":"bob","lenient":null,"conjunction_mode":null}}}}
     Applies to Aggregates: COUNT(*)
     Group By: metadata.brand
     Aggregate Definition: {"grouped":{"terms":{"field":"metadata.brand","order":{"_key":"asc"},"segment_size":65000,"size":65000}}}
(7 rows)

SELECT count(*), ju.metadata->'brand'
FROM ju FULL JOIN jp ON ju.id = jp.id
WHERE (ju.name @@@ 'bob') OR ((ju.name IS NULL) AND (ju.name @@@ 'bob'))
GROUP BY ju.metadata->'brand'
ORDER BY 2;
 count | ?column? 
-------+----------
    20 | "apple"
     2 | 
(2 rows)

-- The same queries without the custom scans, as the reference.
SET paradedb.enable_custom_scan TO false;
SET paradedb.enable_join_custom_scan TO false;
SET paradedb.enable_aggregate_custom_scan TO false;
SELECT ju.metadata->>'brand', count(*)
FROM ju JOIN jp ON ju.id = jp.id
WHERE ju.name IS NOT NULL
GROUP BY 1
ORDER BY 1;
 ?column? | count 
----------+-------
 apple    |    20
          |     2
(2 rows)

