-- The query parser keeps the slop and the prefix of a quoted phrase on a JSON path.
CREATE EXTENSION IF NOT EXISTS pg_search;
DROP TABLE IF EXISTS json_phrases;
CREATE TABLE json_phrases (id int PRIMARY KEY, m jsonb);
INSERT INTO json_phrases VALUES
    (1, '{"note": "big tv stand"}'),
    (2, '{"note": "big red tv"}'),
    (3, '{"note": "big tvs"}');
CREATE INDEX json_phrases_idx ON json_phrases USING bm25 (id, m);
SELECT id FROM json_phrases WHERE m @@@ 'note:"big tv"' ORDER BY id;
 id 
----
  1
(1 row)

SELECT id FROM json_phrases WHERE m @@@ 'note:"big tv"~1' ORDER BY id;
 id 
----
  1
  2
(2 rows)

SELECT id FROM json_phrases WHERE m @@@ 'note:"big tv"*' ORDER BY id;
 id 
----
  1
  3
(2 rows)

-- A prefix phrase needs two words, as on a text field.
SELECT id FROM json_phrases WHERE m @@@ 'note:"tv"*';
ERROR:  could not parse query string 'm:(note:"tv"*)'.
           make sure to use column:term pairs, and to capitalize AND/OR.
DROP TABLE json_phrases;
