DROP TABLE IF EXISTS public.key_field_uuid_raw;
CREATE TABLE public.key_field_uuid_raw
(
    id uuid default gen_random_uuid() not null primary key,
    metadata_json jsonb DEFAULT '{}'::jsonb NOT NULL
);
CREATE INDEX test_search_index on public.key_field_uuid_raw
    USING paradedb (id, (metadata_json::pdb.literal_normalized('normalizer=lowercase')), (metadata_json::pdb.literal('alias=metadata_json_new')));
