-- =============================================================================
-- MPP: the decision is made before the plan is cut into stages
-- =============================================================================
SET max_parallel_workers_per_gather TO 3;
SET max_parallel_workers TO 8;
SET min_parallel_table_scan_size TO 0;
SET parallel_setup_cost TO 0;
SET parallel_tuple_cost TO 0;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.id, p.title
FROM lmp_posts p JOIN lmp_comments c ON c.post_id = p.id
WHERE p.body @@@ 'alpha'
ORDER BY p.title DESC, p.id ASC
LIMIT 5;
                                                                                                   QUERY PLAN                                                                                                   
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: p.id, p.title
   ->  Custom Scan (ParadeDB Join Scan)
         Output: p.id, p.title
         Relation Tree: c INNER p
         Join Cond: p.id = c.post_id
         Limit: 5
         Order By: p.title desc, c.post_id asc
         DataFusion Physical Plan: 
           : ┌───── DistributedExec
           : │ ProjectionExec: expr=[id@3 as col_1, title@4 as col_2, ctid_0@0 as ctid_0, ctid_1@2 as ctid_1]
           : │   SortPreservingMergeExec: [title@4 DESC, post_id@1 ASC NULLS LAST], fetch=5
           : │     [Stage 2] => NetworkCoalesceExec: output_partitions=6, input_tasks=2
           : └──────────────────────────────────────────────────
           :   ┌───── Stage 2 ── tasks=2, partitions=6
           :   │ LocalLimitExec: fetch=5
           :   │   TantivyDecodeExec: decode=[title]
           :   │     SegmentedTopKExec: expr=[title@4 DESC, post_id@1 ASC NULLS LAST], k=5, visibility_checks=[c, p]
           :   │       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, post_id@1)], projection=[ctid_0@3, post_id@4, ctid_1@0, id@1, title@2]
           :   │         CoalescePartitionsExec
           :   │           [Stage 1] => NetworkBroadcastExec: partitions_per_consumer=1, stage_partitions=2, input_tasks=2
           :   │         RepartitionExec: partitioning=RoundRobinBatch(3), input_partitions=1
           :   │           DistributedLeafExec:
           :   │             t0: PgSearchScan: table=c, segments=2, dynamic_filters=1, query="all"
           :   │             t1: PgSearchScan: table=c, segments=2, dynamic_filters=1, query="all"
           :   └──────────────────────────────────────────────────
           :     ┌───── Stage 1 ── tasks=2, partitions=4
           :     │ BroadcastExec: input_partitions=1, consumer_tasks=2, output_partitions=2
           :     │   DistributedLeafExec:
           :     │     t0: PgSearchScan: table=p, segments=2, fetch=[title], query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"alpha","lenient":null,"conjunction_mode":null}}}}
           :     │     t1: PgSearchScan: table=p, segments=2, fetch=[title], query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"alpha","lenient":null,"conjunction_mode":null}}}}
           :     └──────────────────────────────────────────────────
(32 rows)

