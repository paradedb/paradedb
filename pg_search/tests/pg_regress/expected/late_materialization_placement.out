-- A non-equi join fans out whatever the keys are.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT c.id, c.author
FROM lmp_posts p JOIN lmp_comments c ON c.post_id < p.id
WHERE p.body @@@ 'alpha'
ORDER BY c.author ASC, c.id ASC
LIMIT 5;
                                                                                         QUERY PLAN                                                                                          
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: c.id, c.author
   ->  Custom Scan (ParadeDB Join Scan)
         Output: c.id, c.author
         Relation Tree: c INNER p
         Join Filter: (c.post_id < p.id)
         Limit: 5
         Order By: c.author asc, c.id asc
         DataFusion Physical Plan: 
           : ProjectionExec: expr=[id@2 as col_1, author@1 as col_2, ctid_0@0 as ctid_0, ctid_1@3 as ctid_1]
           :   TantivyDecodeExec: decode=[author]
           :     SegmentedTopKExec: expr=[author@1 ASC NULLS LAST, id@2 ASC NULLS LAST], k=5, visibility_checks=[c, p]
           :       NestedLoopJoinExec: join_type=Inner, filter=post_id@0 < id@1, projection=[ctid_0@2, author@4, id@5, ctid_1@0]
           :         CooperativeExec
           :           PgSearchScan: table=p, segments=2, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"alpha","lenient":null,"conjunction_mode":null}}}}
           :         CooperativeExec
           :           PgSearchScan: table=c, segments=2, fetch=[author], query="all"
(17 rows)

