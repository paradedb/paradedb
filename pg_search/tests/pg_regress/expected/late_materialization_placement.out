SET paradedb.enable_aggregate_late_materialization = on;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.title, COUNT(*)
FROM lmp_posts p JOIN lmp_comments c ON c.post_id = p.id
WHERE p.body @@@ 'alpha'
GROUP BY p.title
ORDER BY p.title
LIMIT 5;
                                                                                                                QUERY PLAN                                                                                                                 
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: p.title, (count(*))
   ->  Sort
         Output: p.title, (count(*))
         Sort Key: p.title
         ->  Custom Scan (ParadeDB Aggregate Scan)
               Output: p.title, (count(*))
               Backend: DataFusion
               Indexes: lmp_posts_idx (p), lmp_comments_idx (c)
               Group By: title
               Aggregates: COUNT(*)
               DataFusion Physical Plan: 
                 : ┌───── DistributedExec
                 : │ SortPreservingMergeExec: [title@0 ASC NULLS LAST], fetch=5
                 : │   [Stage 3] => NetworkCoalesceExec: output_partitions=6, input_tasks=2
                 : └──────────────────────────────────────────────────
                 :   ┌───── Stage 3 ── tasks=2, partitions=3
                 :   │ SortExec: TopK(fetch=5), expr=[title@0 ASC NULLS LAST], preserve_partitioning=[true]
                 :   │   AggregateExec: mode=FinalPartitioned, gby=[title@0 as title], aggr=[count(1) as agg_0]
                 :   │     [Stage 2] => NetworkShuffleExec: output_partitions=3, input_tasks=2
                 :   └──────────────────────────────────────────────────
                 :     ┌───── Stage 2 ── tasks=2, partitions=6
                 :     │ RepartitionExec: partitioning=Hash([title@0], 6), input_partitions=3
                 :     │   AggregateExec: mode=Partial, gby=[title@0 as title], aggr=[count(1) as agg_0]
                 :     │     VisibilityFilterExec: tables=[p, c]
                 :     │       TantivyFetchExec: fetch=[ctid_0, ctid_1]
                 :     │         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, post_id@0)], projection=[title@1, ctid_0@2, ctid_1@4]
                 :     │           CoalescePartitionsExec
                 :     │             [Stage 1] => NetworkBroadcastExec: partitions_per_consumer=1, stage_partitions=2, input_tasks=2
                 :     │           RepartitionExec: partitioning=RoundRobinBatch(3), input_partitions=1
                 :     │             DistributedLeafExec:
                 :     │               t0: PgSearchScan: table=c, segments=2, dynamic_filters=1, query="all"
                 :     │               t1: PgSearchScan: table=c, segments=2, dynamic_filters=1, query="all"
                 :     └──────────────────────────────────────────────────
                 :       ┌───── Stage 1 ── tasks=2, partitions=4
                 :       │ BroadcastExec: input_partitions=1, consumer_tasks=2, output_partitions=2
                 :       │   DistributedLeafExec:
                 :       │     t0: PgSearchScan: table=p, segments=2, eager=[title], dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"alpha","lenient":null,"conjunction_mode":null}}}}
                 :       │     t1: PgSearchScan: table=p, segments=2, eager=[title], dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"alpha","lenient":null,"conjunction_mode":null}}}}
                 :       └──────────────────────────────────────────────────
(40 rows)

SELECT p.title, COUNT(*)
FROM lmp_posts p JOIN lmp_comments c ON c.post_id = p.id
WHERE p.body @@@ 'alpha'
GROUP BY p.title
ORDER BY p.title
LIMIT 5;
