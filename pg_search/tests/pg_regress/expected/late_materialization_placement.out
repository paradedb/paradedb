-- =============================================================================
-- Aggregates: nothing above bounds the rows, so a fan-out decodes in the scan
-- =============================================================================
SET paradedb.enable_aggregate_late_materialization = on;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.title, COUNT(*)
FROM lmp_posts p JOIN lmp_comments c ON c.post_id = p.id
WHERE p.body @@@ 'alpha'
GROUP BY p.title
ORDER BY p.title
LIMIT 5;
                                                                                                              QUERY PLAN                                                                                                               
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: p.title, (count(*))
   ->  Sort
         Output: p.title, (count(*))
         Sort Key: p.title
         ->  Custom Scan (ParadeDB Aggregate Scan)
               Output: p.title, (count(*))
               Backend: DataFusion
               Indexes: lmp_posts_idx (p), lmp_comments_idx (c)
               Group By: title
               Aggregates: COUNT(*)
               DataFusion Physical Plan: 
                 : SortExec: TopK(fetch=5), expr=[title@0 ASC NULLS LAST], preserve_partitioning=[false]
                 :   AggregateExec: mode=Single, gby=[title@0 as title], aggr=[count(1) as agg_0]
                 :     VisibilityFilterExec: tables=[p, c]
                 :       TantivyFetchExec: fetch=[ctid_0, ctid_1]
                 :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, post_id@0)], projection=[title@1, ctid_0@2, ctid_1@4]
                 :           CooperativeExec
                 :             PgSearchScan: table=p, segments=2, eager=[title], dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"alpha","lenient":null,"conjunction_mode":null}}}}
                 :           CooperativeExec
                 :             PgSearchScan: table=c, segments=2, dynamic_filters=1, query="all"
(21 rows)

