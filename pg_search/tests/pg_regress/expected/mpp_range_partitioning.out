DROP TABLE mpp_rp_orders;
DROP TABLE mpp_rp_customers;
DROP TABLE mpp_rp_categories;
DROP TABLE mpp_rp_topics;
DROP TABLE mpp_rp_posts;
DROP TABLE mpp_rp_users;
