CREATE EXTENSION IF NOT EXISTS pg_search;
SET max_parallel_workers_per_gather = 0;
-- This test verifies that complex multi-table disjunctions in join queries
-- are planned using ParadeDB Join Scan rather than falling back to
-- nested-loop join plans.
DROP TABLE IF EXISTS users CASCADE;
CREATE TABLE users (id SERIAL8 PRIMARY KEY, name TEXT, color VARCHAR, age VARCHAR);
CREATE INDEX idxusers ON users USING paradedb (id, (name::pdb.literal), (color::pdb.literal), age);
INSERT INTO users (name, color, age) VALUES ('bob', 'blue', '20');
ANALYZE;
DROP TABLE IF EXISTS products CASCADE;
CREATE TABLE products (id SERIAL8 PRIMARY KEY, name TEXT, color VARCHAR);
CREATE INDEX idxproducts ON products USING paradedb (id, (name::pdb.literal), (color::pdb.literal));
INSERT INTO products (name, color) VALUES ('bob', 'blue');
ANALYZE;
DROP TABLE IF EXISTS orders CASCADE;
CREATE TABLE orders (id SERIAL8 PRIMARY KEY, name TEXT, color VARCHAR);
CREATE INDEX idxorders ON orders USING paradedb (id, (name::pdb.literal), (color::pdb.literal));
INSERT INTO orders (name, color) VALUES ('bob', 'blue');
ANALYZE;
-- When running under the joinscan, we get a `pdb_search_predicate` join filter.
SET paradedb.enable_join_custom_scan = on;
SET work_mem TO '64MB';
EXPLAIN
SELECT users.name, users.color, users.age
FROM users JOIN products ON users.name = products.name JOIN orders ON products.color = orders.color
WHERE ((orders.id = 3) AND (orders.color ||| 'blue')) OR ((users.color ||| 'blue') AND (users.id = 3))
LIMIT 10;
                                                                                                                                                                                                                  QUERY PLAN                                                                                                                                                                                                                  
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)  (cost=10.00..11.00 rows=10 width=12)
   Relation Tree: (users INNER products) INNER orders
   Join Cond: products.color = orders.color, users.name = products.name
   Join Predicate: ((heap:(orders.id = 3) AND orders:{"with_index":{"query":{"match":{"field":"color","value":"blue","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}) OR (users:{"with_index":{"query":{"match":{"field":"color","value":"blue","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}} AND heap:(users.id = 3)))
   Limit: 10
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[name@1 as col_1, NULL as col_2, NULL as col_3, ctid_0@0 as ctid_0, ctid_2@6 as ctid_2]
     :   GlobalLimitExec: skip=0, fetch=10
     :     VisibilityFilterExec: tables=[users, products, orders]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(color@4, color@1)], filter=id@2 = 3 AND __orders_2_tag_0@3 OR __users_0_tag_0@1 AND id@0 = 3
     :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(name@1, name@1)], projection=[ctid_0@0, name@1, id@2, __users_0_tag_0@3, color@4, ctid_1@6]
     :           CooperativeExec
     :             PgSearchScan: table=users, segments=1, tag_0={"with_index":{"query":{"match":{"field":"color","value":"blue","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :           CooperativeExec
     :             PgSearchScan: table=products, segments=1, dynamic_filters=1, query="all"
     :         CooperativeExec
     :           PgSearchScan: table=orders, segments=1, dynamic_filters=1, tag_0={"with_index":{"query":{"match":{"field":"color","value":"blue","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
