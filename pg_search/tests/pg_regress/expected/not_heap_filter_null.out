\i common/common_setup.sql
CREATE EXTENSION IF NOT EXISTS pg_search;
-- Disable parallel workers to avoid differences in plans
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan to OFF;
SET paradedb.enable_columnar_exec = true;
-- NOT over a heap filter must follow three-valued logic: NOT NULL is NULL (#7167)
CREATE TABLE not_heap_null (id int PRIMARY KEY, body text, flag boolean);
INSERT INTO not_heap_null VALUES
    (1, 'hello true', true),
    (2, 'hello false', false),
    (3, 'hello null', NULL),
    (4, 'other', false);
CREATE INDEX not_heap_null_idx ON not_heap_null USING bm25 (id, body) WITH (key_field = 'id');
WARNING:  key_field is deprecated as of 0.26.0 and is a no-op; it no longer needs to be provided
SET paradedb.enable_filter_pushdown = on;
EXPLAIN (COSTS OFF) SELECT id FROM not_heap_null WHERE body @@@ 'hello' AND NOT flag;
                                                                                                                                  QUERY PLAN                                                                                                                                   
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Base Scan) on not_heap_null
   Table: not_heap_null
   Index: not_heap_null_idx
   Exec Method: ColumnarExecState
   Columnar: id
   Scores: false
   Tantivy Query: {"boolean":{"must":[{"heap_filter":{"indexed_query":{"boolean":{"must":[{"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"hello","lenient":null,"conjunction_mode":null}}}}]}},"always_filters":[{"heap_filter":"(NOT flag)"}]}}]}}
(7 rows)

