   ->  Custom Scan (ParadeDB Base Scan) on numeric_precision_19
         Table: numeric_precision_19
         Index: numeric_precision_19_idx
         Exec Method: ColumnarExecState
         Columnar: id, value
         Scores: false
         Full Index Scan: true
         Tantivy Query: {"with_index":{"query":{"all":{"field":"id"}}}}
(10 rows)

SELECT id, value FROM numeric_precision_19 WHERE id @@@ pdb.all() ORDER BY id;
 id |        value        
----+---------------------
  1 | 1234567890123456.78
(1 row)

DROP TABLE numeric_scale_18, numeric_scale_19, numeric_scale_neg19,
           numeric_scale_delayed, numeric_precision_19;
