WHERE p.title ||| 'error' AND c.body ||| 'question';
 id_join_rows 
--------------
         2667
(1 row)

-- =====================================================================
-- `id=2, owner_user_id=4` favors the second field. A join on `id` can take
-- the two whole `id` ranges or the comments edges with three tasks that cut
-- every posts segment; the two whole tasks are cheaper.
-- =====================================================================
DROP INDEX pbh_posts_idx;
CREATE INDEX pbh_posts_idx ON pbh_posts USING paradedb (id, owner_user_id, title)
WITH (partition_by = 'id=2, owner_user_id=4', target_segment_count = 8);
WARNING:  only 0 parallel workers were available for index build
SELECT count(*) AS segments FROM paradedb.index_info('pbh_posts_idx');
 segments 
----------
        8
(1 row)

EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.id, c.id
FROM pbh_posts p JOIN pbh_comments c ON c.post_id = p.id
WHERE p.title ||| 'error' AND c.body ||| 'question'
ORDER BY p.id, c.id
LIMIT 10;
                                                                                                                                                         QUERY PLAN                                                                                                                                                          
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, c.id
   Relation Tree: p INNER c
   Join Cond: c.post_id = p.id
   Limit: 10
   Order By: c.post_id asc, c.id asc
   DataFusion Physical Plan: 
     : ┌───── DistributedExec
     : │ ProjectionExec: expr=[id@1 as col_1, id@4 as col_2, ctid_0@0 as ctid_0, ctid_1@2 as ctid_1]
     : │   SortPreservingMergeExec: [post_id@3 ASC NULLS LAST, id@4 ASC NULLS LAST], fetch=10
     : │     [Stage 1] => NetworkCoalesceExec: output_partitions=2, input_tasks=2
     : └──────────────────────────────────────────────────
     :   ┌───── Stage 1 ── tasks=2, partitions=2
     :   │ SortExec: TopK(fetch=10), expr=[id@1 ASC NULLS LAST, id@4 ASC NULLS LAST], preserve_partitioning=[true]
     :   │   VisibilityFilterExec: tables=[p, c]
     :   │     HashJoinExec: mode=Partitioned, join_type=Inner, on=[(id@1, post_id@1)]
     :   │       DistributedLeafExec:
     :   │         t0: PgSearchScan: table=p, segments={partial=0, included=4, pruned=4}, partition=id[-∞..8001), query={"with_index":{"query":{"match":{"field":"title","value":"error","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   │         t1: PgSearchScan: table=p, segments={partial=0, included=4, pruned=4}, partition=id[8001..∞), query={"with_index":{"query":{"match":{"field":"title","value":"error","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   │       DistributedLeafExec:
     :   │         t0: PgSearchScan: table=c, segments={partial=1, included=4, pruned=3}, partition=post_id[-∞..8001), dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"body","value":"question","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   │         t1: PgSearchScan: table=c, segments={partial=1, included=3, pruned=4}, partition=post_id[8001..∞), dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"body","value":"question","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   └──────────────────────────────────────────────────
