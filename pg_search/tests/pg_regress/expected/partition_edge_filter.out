-- Scored Top-K: the edges are checked on the rows the query returns.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.id, pdb.score(p.id) AS score, u.id IS NULL AS orphan
FROM pef_posts p LEFT JOIN pef_users u ON u.id = p.owner_user_id AND u.id @@@ pdb.all()
WHERE p.title ||| 'error without owner'
ORDER BY pdb.score(p.id) DESC, p.id
LIMIT 8;
                                                                                                                                                                   QUERY PLAN                                                                                                                                                                    
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, (pdb.score(p.id)), ((u.id IS NULL))
   Relation Tree: p LEFT u
   Join Cond: u.id = p.owner_user_id
   Limit: 8
   Order By: pdb.score() desc, p.id asc
   DataFusion Physical Plan: 
     : ┌───── DistributedExec
     : │ ProjectionExec: expr=[id@2 as col_1, pdb.score()@0 as col_2, id@3 IS NULL as col_3, ctid_0@1 as ctid_0]
     : │   SortPreservingMergeExec: [pdb.score()@0 DESC, id@2 ASC NULLS LAST], fetch=8
     : │     [Stage 2] => NetworkCoalesceExec: output_partitions=3, input_tasks=3
     : └──────────────────────────────────────────────────
     :   ┌───── Stage 2 ── tasks=3, partitions=3
     :   │ SortExec: TopK(fetch=8), expr=[pdb.score()@0 DESC, id@2 ASC NULLS LAST], preserve_partitioning=[true]
     :   │   VisibilityFilterExec: tables=[p]
     :   │     HashJoinExec: mode=CollectLeft, join_type=Right, on=[(id@0, owner_user_id@2)], projection=[pdb.score()@1, ctid_0@2, id@4, id@0]
     :   │       CoalescePartitionsExec
     :   │         [Stage 1] => NetworkBroadcastExec: partitions_per_consumer=1, stage_partitions=3, input_tasks=3
     :   │       DistributedLeafExec:
     :   │         t0: PgSearchScan: table=p, segments={partial=4, included=2, pruned=3}, partition=owner_user_id[-∞..1356), dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"title","value":"error without owner","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   │         t1: PgSearchScan: table=p, segments={partial=5, included=0, pruned=4}, partition=owner_user_id[1356..1601), dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"title","value":"error without owner","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   │         t2: PgSearchScan: table=p, segments={partial=4, included=2, pruned=3}, partition=owner_user_id[1601..∞), dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"title","value":"error without owner","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   └──────────────────────────────────────────────────
     :     ┌───── Stage 1 ── tasks=3, partitions=9
     :     │ BroadcastExec: input_partitions=1, consumer_tasks=3, output_partitions=3
     :     │   DistributedLeafExec:
     :     │     t0: PgSearchScan: table=u, segments={partial=1, included=1, pruned=2}, partition=id[-∞..1356), visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
     :     │     t1: PgSearchScan: table=u, segments={partial=1, included=0, pruned=3}, partition=id[1356..1601), visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
     :     │     t2: PgSearchScan: table=u, segments={partial=1, included=2, pruned=1}, partition=id[1601..∞), visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
     :     └──────────────────────────────────────────────────
(30 rows)

