-- =====================================================================
-- The range-partitioned join reaches into crossing segments in every task
-- and must produce the same rows and the same scores.
-- =====================================================================
SET max_parallel_workers_per_gather TO 3;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT count(*) AS total, count(*) FILTER (WHERE u.id IS NULL) AS orphans
FROM pef_posts p LEFT JOIN pef_users u ON u.id = p.owner_user_id AND u.id @@@ pdb.all()
WHERE p.title ||| 'error';
                                                                                                                                                           QUERY PLAN                                                                                                                                                           
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Output: (count(*)), (count(*) FILTER (WHERE (u.id IS NULL)))
   Backend: DataFusion
   Indexes: pef_posts_idx (p), pef_users_idx (u)
   Aggregates: COUNT(*), COUNT(*)
   DataFusion Physical Plan: 
     : ┌───── DistributedExec
     : │ AggregateExec: mode=Final, gby=[], aggr=[count(1) as agg_0, count(1) FILTER (WHERE u_1.id IS NULL) as agg_1]
     : │   CoalescePartitionsExec
     : │     [Stage 2] => NetworkCoalesceExec: output_partitions=3, input_tasks=3
     : └──────────────────────────────────────────────────
     :   ┌───── Stage 2 ── tasks=3, partitions=3
     :   │ AggregateExec: mode=Partial, gby=[], aggr=[count(1) as agg_0, count(1) FILTER (WHERE u_1.id IS NULL) as agg_1]
     :   │   HashJoinExec: mode=CollectLeft, join_type=Right, on=[(id@0, owner_user_id@0)], projection=[id@0]
     :   │     CoalescePartitionsExec
     :   │       [Stage 1] => NetworkBroadcastExec: partitions_per_consumer=1, stage_partitions=3, input_tasks=3
     :   │     DistributedLeafExec:
     :   │       t0: PgSearchScan: table=p, segments={partial=4, included=2, pruned=3}, partition=owner_user_id[-∞..1356), visibility=eager, query={"with_index":{"query":{"match":{"field":"title","value":"error","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   │       t1: PgSearchScan: table=p, segments={partial=5, included=0, pruned=4}, partition=owner_user_id[1356..1601), visibility=eager, query={"with_index":{"query":{"match":{"field":"title","value":"error","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   │       t2: PgSearchScan: table=p, segments={partial=4, included=2, pruned=3}, partition=owner_user_id[1601..∞), visibility=eager, query={"with_index":{"query":{"match":{"field":"title","value":"error","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   └──────────────────────────────────────────────────
     :     ┌───── Stage 1 ── tasks=3, partitions=9
     :     │ BroadcastExec: input_partitions=1, consumer_tasks=3, output_partitions=3
     :     │   DistributedLeafExec:
     :     │     t0: PgSearchScan: table=u, segments={partial=1, included=1, pruned=2}, partition=id[-∞..1356), visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
     :     │     t1: PgSearchScan: table=u, segments={partial=1, included=0, pruned=3}, partition=id[1356..1601), visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
     :     │     t2: PgSearchScan: table=u, segments={partial=1, included=2, pruned=1}, partition=id[1601..∞), visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
     :     └──────────────────────────────────────────────────
(28 rows)

