-- Test 4: one column indexed as a member and through a tokenizer cast, with
-- both fields in one spec. Each brand bucket has one cast bucket with its key.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}, "aggs": {"casts": {"terms": {"field": "maker_cast"}}}}')
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item';
                                                                                                                                       QUERY PLAN                                                                                                                                        
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Output: (pdb.agg('{"aggs": {"casts": {"terms": {"field": "maker_cast"}}}, "terms": {"field": "brand", "order": {"_key": "asc"}}}'::jsonb))
   Backend: DataFusion
   Indexes: pagc_products_idx (p), pagc_orders_idx (o)
   Aggregates: pdb.agg({"aggs":{"casts":{"terms":{"field":"maker_cast"}}},"terms":{"field":"brand","order":{"_key":"asc"}}})
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[__grouping_id@2 as __grouping_id, __pdb_k0@0 as __pdb_k0, __pdb_k1@1 as __pdb_k1, __pdb_m0@3 as __pdb_m0]
     :   AggregateExec: mode=Final, gby=[__pdb_k0@0 as __pdb_k0, __pdb_k1@1 as __pdb_k1, __grouping_id@2 as __grouping_id], aggr=[count(1) as __pdb_m0]
     :     TantivyDecodeExec: decode=[brand, maker_cast]
     :       AggregateExec: mode=Partial, gby=[(NULL as __pdb_k0, NULL as __pdb_k1), (brand@1 as __pdb_k0, NULL as __pdb_k1), (brand@1 as __pdb_k0, maker_cast@0 as __pdb_k1)], aggr=[count(1) as __pdb_m0]
     :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@0)], projection=[maker_cast@1, brand@2]
     :           CooperativeExec
     :             PgSearchScan: table=p, segments=1, fetch=[maker_cast, brand], visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"item","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :           CooperativeExec
     :             PgSearchScan: table=o, segments=1, dynamic_filters=1, visibility=eager, query="all"
(15 rows)

SELECT pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}, "aggs": {"casts": {"terms": {"field": "maker_cast"}}}}')
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item';
                                                                                                                                                                                                                                                                                                                                agg                                                                                                                                                                                                                                                                                                                                
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": "acme", "casts": {"buckets": [{"key": "acme", "doc_count": 6}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}, "doc_count": 6}, {"key": "orbit", "casts": {"buckets": [{"key": "orbit", "doc_count": 6}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}, "doc_count": 6}, {"key": "zenith", "casts": {"buckets": [{"key": "zenith", "doc_count": 6}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}, "doc_count": 6}, {"key": null, "casts": {"buckets": [{"key": null, "doc_count": 6}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}, "doc_count": 6}], "sum_other_doc_count": 0}
