-- Test 3: on a single table, a member key with a NUMERIC metric
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT category, SUM(price)
FROM pagc_products
WHERE description ||| 'item'
GROUP BY category
ORDER BY category;
                                                                                                                                  QUERY PLAN                                                                                                                                  
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: category, (sum(price))
   Sort Key: pagc_products.category
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: category, (sum(price))
         Backend: DataFusion
         Indexes: pagc_products_idx (pagc_products)
         Group By: category
         Aggregates: SUM(price)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Final, gby=[category@0 as category], aggr=[numeric64_sum(pagc_products_0.price, 2) as agg_0]
           :   TantivyDecodeExec: decode=[category]
           :     AggregateExec: mode=Partial, gby=[category@0 as category], aggr=[numeric64_sum(pagc_products_0.price, 2) as agg_0]
           :       TantivyFetchExec: fetch=[category]
           :         CooperativeExec
           :           PgSearchScan: table=pagc_products, segments=1, visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"item","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(16 rows)

