-- Test 5: the window form, which the Join Scan runs
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.id, pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}}') OVER ()
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item'
ORDER BY p.id
LIMIT 2;
                                                                                                                         QUERY PLAN                                                                                                                          
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, (pdb.window_agg('pdb.agg(''{"terms":{"field":"brand","order":{"_key":"asc"}}}'') OVER ()'::text))
   Relation Tree: p INNER o
   Join Cond: p.id = o.product_id
   Limit: 2
   Order By: p.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[get_field(__topk@0, c0) as col_1, window_agg_1@1 as col_2, get_field(__topk@0, c1) as ctid_0]
     :   GlobalLimitExec: skip=0, fetch=2
     :     UnnestExec
     :       AggregateExec: mode=Single, gby=[], aggr=[topk_as_agg(p_0.id, p_0.ctid_0, 2, [1]) ORDER BY [p_0.id ASC NULLS LAST] as __topk, pdb_agg({"terms":{"field":"brand","order":{"_key":"asc"}}}) as window_agg_1]
     :         VisibilityFilterExec: tables=[p, o], pruned=[o]
     :           HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, product_id@0)], projection=[id@1, ctid_0@0, brand@2, ctid_1@4]
     :             CooperativeExec
     :               PgSearchScan: table=p, segments=1, eager=[brand], query={"with_index":{"query":{"match":{"field":"description","value":"item","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :             CooperativeExec
     :               PgSearchScan: table=o, segments=1, dynamic_filters=1, query="all"
(17 rows)

SELECT p.id, pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}}') OVER ()
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item'
ORDER BY p.id
LIMIT 2;
 id |                                                                                     agg                                                                                      
----+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
  1 | {"buckets": [{"key": "acme", "doc_count": 6}, {"key": "orbit", "doc_count": 6}, {"key": "zenith", "doc_count": 6}, {"key": null, "doc_count": 6}], "sum_other_doc_count": 0}
  1 | {"buckets": [{"key": "acme", "doc_count": 6}, {"key": "orbit", "doc_count": 6}, {"key": "zenith", "doc_count": 6}, {"key": null, "doc_count": 6}], "sum_other_doc_count": 0}
(2 rows)

-- Test 6: a member computed from an expression is not read over a join
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT pdb.agg('{"terms": {"field": "name_upper"}}')
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item';
ERROR:  Cannot execute pdb.agg: Field 'name_upper' is an expression index, which cannot be read back as a column
SELECT pdb.agg('{"terms": {"field": "name_upper"}}')
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item';
ERROR:  Cannot execute pdb.agg: Field 'name_upper' is an expression index, which cannot be read back as a column
-- Test 7: a BIGINT member over an INTEGER column holds a cast value, so it is
-- not read over a join either
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT pdb.agg('{"sum": {"field": "stock"}}')
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item';
ERROR:  Cannot execute pdb.agg: Field 'stock' is an expression index, which cannot be read back as a column
SELECT pdb.agg('{"sum": {"field": "stock"}}')
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item';
ERROR:  Cannot execute pdb.agg: Field 'stock' is an expression index, which cannot be read back as a column
DROP TABLE pagc_products, pagc_orders;
DROP TYPE pagc_product_fields;
RESET paradedb.enable_aggregate_custom_scan;
RESET max_parallel_workers_per_gather;
