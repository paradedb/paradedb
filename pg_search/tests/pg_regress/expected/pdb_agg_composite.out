-- pdb.agg() on fields indexed as members of a ROW(...) composite. A member that
-- is a column keeps the column's value, so the join path reads it back like a
-- bare tokenizer cast, and the SQL GROUP BY over the same tables is the reference
-- for each answer. A member that does not hold a column's value is not read over
-- a join.
\i common/common_setup.sql
CREATE EXTENSION IF NOT EXISTS pg_search;
-- Disable parallel workers to avoid differences in plans
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan to OFF;
SET paradedb.enable_columnar_exec = true;
SET max_parallel_workers_per_gather = 0;
SET paradedb.enable_aggregate_custom_scan TO on;
DROP TABLE IF EXISTS pagc_products, pagc_orders CASCADE;
DROP TYPE IF EXISTS pagc_product_fields;
CREATE TYPE pagc_product_fields AS (
    category pdb.literal,
    brand pdb.literal,
    price NUMERIC(10, 2),
    name_upper pdb.literal,
    stock BIGINT
);
CREATE TABLE pagc_products (
    id INTEGER PRIMARY KEY,
    description TEXT,
    legacy TEXT,
    name TEXT,
    category TEXT,
    maker TEXT,
    price NUMERIC(10, 2),
    stock INTEGER
);
-- The dropped column leaves a gap in the attribute numbers of the columns after it.
ALTER TABLE pagc_products DROP COLUMN legacy;
CREATE TABLE pagc_orders (
    id INTEGER PRIMARY KEY,
    product_id INTEGER
);
INSERT INTO pagc_products (id, description, name, category, maker, price, stock)
SELECT i,
       'item ' || i,
       (ARRAY['alice', 'bob', 'cloe'])[1 + i % 3],
       (ARRAY['shoes', 'hats'])[1 + i % 2],
       CASE WHEN i % 4 = 0 THEN NULL ELSE (ARRAY['acme', 'zenith', 'orbit'])[1 + i % 3] END,
       (i * 1.25)::numeric(10, 2),
       i
FROM generate_series(1, 12) AS i;
INSERT INTO pagc_orders (id, product_id)
SELECT i, 1 + i % 12
FROM generate_series(1, 24) AS i;
CREATE INDEX pagc_products_idx ON pagc_products USING paradedb (
    id,
    description,
    (ROW(category, maker, price, upper(name), stock)::pagc_product_fields),
    (maker::pdb.literal('alias=maker_cast'))
);
CREATE INDEX pagc_orders_idx ON pagc_orders USING paradedb (id, product_id);
-- Test 1: terms on a member over a join
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.category, COUNT(*)
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item'
GROUP BY p.category
ORDER BY p.category;
                                                                                                                                     QUERY PLAN                                                                                                                                     
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: p.category, (count(*))
   Sort Key: p.category
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: p.category, (count(*))
         Backend: DataFusion
         Indexes: pagc_products_idx (p), pagc_orders_idx (o)
         Group By: category
         Aggregates: COUNT(*)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Final, gby=[category@0 as category], aggr=[count(1) as agg_0]
           :   TantivyDecodeExec: decode=[category]
           :     AggregateExec: mode=Partial, gby=[category@0 as category], aggr=[count(1) as agg_0]
           :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, product_id@0)], projection=[category@0]
           :         CooperativeExec
           :           PgSearchScan: table=p, segments=1, fetch=[category], visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"item","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
           :         CooperativeExec
           :           PgSearchScan: table=o, segments=1, dynamic_filters=1, visibility=eager, query="all"
(18 rows)

SELECT p.category, COUNT(*)
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item'
GROUP BY p.category
ORDER BY p.category;
 category | count 
----------+-------
 hats     |    12
 shoes    |    12
(2 rows)

EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT pdb.agg('{"terms": {"field": "category", "order": {"_key": "asc"}}}')
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item';
                                                                                                                                   QUERY PLAN                                                                                                                                   
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Output: (pdb.agg('{"terms": {"field": "category", "order": {"_key": "asc"}}}'::jsonb))
   Backend: DataFusion
   Indexes: pagc_products_idx (p), pagc_orders_idx (o)
   Aggregates: pdb.agg({"terms":{"field":"category","order":{"_key":"asc"}}})
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[__grouping_id@1 as __grouping_id, __pdb_k0@0 as __pdb_k0, __pdb_m0@2 as __pdb_m0]
     :   AggregateExec: mode=Final, gby=[__pdb_k0@0 as __pdb_k0, __grouping_id@1 as __grouping_id], aggr=[count(1) as __pdb_m0]
     :     TantivyDecodeExec: decode=[category]
     :       AggregateExec: mode=Partial, gby=[(NULL as __pdb_k0), (category@0 as __pdb_k0)], aggr=[count(1) as __pdb_m0]
     :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@0)], projection=[category@1]
     :           CooperativeExec
     :             PgSearchScan: table=p, segments=1, fetch=[category], visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"item","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :           CooperativeExec
     :             PgSearchScan: table=o, segments=1, dynamic_filters=1, visibility=eager, query="all"
(15 rows)

SELECT pdb.agg('{"terms": {"field": "category", "order": {"_key": "asc"}}}')
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item';
                                                     agg                                                      
--------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": "hats", "doc_count": 12}, {"key": "shoes", "doc_count": 12}], "sum_other_doc_count": 0}
(1 row)

-- Test 2: a member with NULLs named differently from its column, with a metric
-- on a NUMERIC member and a count of a third one
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.maker, COUNT(*), SUM(p.price), COUNT(p.category)
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item'
GROUP BY p.maker
ORDER BY p.maker;
                                                                                                                                            QUERY PLAN                                                                                                                                             
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: p.maker, (count(*)), (sum(p.price)), (count(p.category))
   Sort Key: p.maker
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: p.maker, (count(*)), (sum(p.price)), (count(p.category))
         Backend: DataFusion
         Indexes: pagc_products_idx (p), pagc_orders_idx (o)
         Group By: brand
         Aggregates: COUNT(*), SUM(price), COUNT(category)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Final, gby=[brand@0 as brand], aggr=[count(1) as agg_0, numeric64_sum(p_0.price, 2) as agg_1, count(p_0.category) as agg_2]
           :   TantivyDecodeExec: decode=[brand]
           :     AggregateExec: mode=Partial, gby=[brand@0 as brand], aggr=[count(1) as agg_0, numeric64_sum(p_0.price, 2) as agg_1, count(p_0.category) as agg_2]
           :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@3, product_id@0)], projection=[brand@0, price@1, category@2]
           :         CooperativeExec
           :           PgSearchScan: table=p, segments=1, fetch=[brand], eager=[category], visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"item","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
           :         CooperativeExec
           :           PgSearchScan: table=o, segments=1, dynamic_filters=1, visibility=eager, query="all"
(18 rows)

SELECT p.maker, COUNT(*), SUM(p.price), COUNT(p.category)
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item'
GROUP BY p.maker
ORDER BY p.maker;
 maker  | count |  sum  | count 
--------+-------+-------+-------
 acme   |     6 | 45.00 |     6
 orbit  |     6 | 45.00 |     6
 zenith |     6 | 45.00 |     6
        |     6 | 60.00 |     6
(4 rows)

EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}, "aggs": {"total": {"sum": {"field": "price"}}, "categories": {"value_count": {"field": "category"}}}}')
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item';
                                                                                                                                          QUERY PLAN                                                                                                                                           
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Output: (pdb.agg('{"aggs": {"total": {"sum": {"field": "price"}}, "categories": {"value_count": {"field": "category"}}}, "terms": {"field": "brand", "order": {"_key": "asc"}}}'::jsonb))
   Backend: DataFusion
   Indexes: pagc_products_idx (p), pagc_orders_idx (o)
   Aggregates: pdb.agg({"aggs":{"total":{"sum":{"field":"price"}},"categories":{"value_count":{"field":"category"}}},"terms":{"field":"brand","order":{"_key":"asc"}}})
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[__grouping_id@1 as __grouping_id, __pdb_k0@0 as __pdb_k0, __pdb_m0@2 as __pdb_m0, __pdb_m1@3 as __pdb_m1, __pdb_m2@4 as __pdb_m2, __pdb_m3@5 as __pdb_m3]
     :   AggregateExec: mode=Final, gby=[__pdb_k0@0 as __pdb_k0, __grouping_id@1 as __grouping_id], aggr=[count(1) as __pdb_m0, count(p_0.category) as __pdb_m1, count(p_0.price) as __pdb_m2, numeric64_sum(p_0.price, 2) as __pdb_m3]
     :     TantivyDecodeExec: decode=[brand]
     :       AggregateExec: mode=Partial, gby=[(NULL as __pdb_k0), (brand@1 as __pdb_k0)], aggr=[count(1) as __pdb_m0, count(p_0.category) as __pdb_m1, count(p_0.price) as __pdb_m2, numeric64_sum(p_0.price, 2) as __pdb_m3]
     :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@0)], projection=[price@1, brand@2, category@3]
     :           CooperativeExec
     :             PgSearchScan: table=p, segments=1, fetch=[brand], eager=[category], visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"item","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :           CooperativeExec
     :             PgSearchScan: table=o, segments=1, dynamic_filters=1, visibility=eager, query="all"
(15 rows)

SELECT pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}, "aggs": {"total": {"sum": {"field": "price"}}, "categories": {"value_count": {"field": "category"}}}}')
FROM pagc_products p JOIN pagc_orders o ON p.id = o.product_id
WHERE p.description ||| 'item';
                                                                                                                                                                                                     agg                                                                                                                                                                                                      
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": "acme", "total": {"value": 45.0}, "doc_count": 6, "categories": {"value": 6.0}}, {"key": "orbit", "total": {"value": 45.0}, "doc_count": 6, "categories": {"value": 6.0}}, {"key": "zenith", "total": {"value": 45.0}, "doc_count": 6, "categories": {"value": 6.0}}, {"key": null, "total": {"value": 60.0}, "doc_count": 6, "categories": {"value": 6.0}}], "sum_other_doc_count": 0}
