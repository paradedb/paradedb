-- =====================================================================
-- pdb.agg() on the DataFusion aggregate backend
-- =====================================================================
-- Covers pdb.agg() over joins and over a single table routed to
-- DataFusion, with the Tantivy backend's output on the same data as the
-- reference where a query can run on both.
\i common/common_setup.sql
CREATE EXTENSION IF NOT EXISTS pg_search;
-- Disable parallel workers to avoid differences in plans
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan to OFF;
SET paradedb.enable_columnar_exec = true;
SET max_parallel_workers_per_gather = 0;
SET paradedb.enable_aggregate_custom_scan TO on;
DROP TABLE IF EXISTS pa_products, pa_tags CASCADE;
CREATE TABLE pa_products (
    id SERIAL PRIMARY KEY,
    description TEXT,
    category TEXT,
    brand TEXT,
    price FLOAT,
    rating INTEGER,
    created_at TIMESTAMP,
    in_stock BOOLEAN,
    metadata JSONB,
    price_num NUMERIC(10, 2)
);
CREATE TABLE pa_tags (
    id SERIAL PRIMARY KEY,
    product_id INTEGER,
    tag_name TEXT,
    weight INTEGER
);
CREATE INDEX pa_products_idx ON pa_products
USING paradedb (id, description, category, brand, price, rating, created_at, in_stock, metadata, price_num)
WITH (
    key_field = 'id',
    text_fields = '{"description": {}, "category": {"fast": true}, "brand": {"fast": true}, "cat_kw": {"column": "category", "fast": true, "tokenizer": {"type": "keyword"}}}',
    numeric_fields = '{"price": {"fast": true}, "rating": {"fast": true}, "price_num": {"fast": true}}',
    boolean_fields = '{"in_stock": {"fast": true}}',
    json_fields = '{"metadata": {"fast": true}}'
);
CREATE INDEX pa_tags_idx ON pa_tags
USING paradedb (id, product_id, tag_name, weight)
WITH (
    key_field = 'id',
    numeric_fields = '{"product_id": {"fast": true}, "weight": {"fast": true}}',
    text_fields = '{"tag_name": {"fast": true}}'
);
-- Two batches per table so each index has several segments, which the MPP
-- section needs to spread work across producers.
SET paradedb.global_mutable_segment_rows = 0;
INSERT INTO pa_products (description, category, brand, price, rating, created_at, in_stock, metadata, price_num) VALUES
    ('Laptop with fast processor', 'Electronics', 'Apple', 1299.99, 5, '2024-01-01 10:00:00', true, '{"color": "silver", "qty": 3}', 1299.99),
    ('Gaming laptop with RGB', 'Electronics', 'Dell', 1499.99, 5, '2024-01-02 10:00:00', false, '{"color": "black", "qty": 1}', 1499.99),
    ('Budget laptop', 'Electronics', 'HP', 499.99, 3, '2024-01-03 10:00:00', true, '{"color": "black", "qty": 7}', 499.99),
    ('Wireless keyboard', 'Electronics', 'Logitech', 79.99, 4, '2024-01-04 10:00:00', true, '{"color": "black", "qty": 9}', 79.99);
INSERT INTO pa_products (description, category, brand, price, rating, created_at, in_stock, metadata, price_num) VALUES
    ('Running shoes', 'Sports', 'Nike', 89.99, 5, '2024-01-05 10:00:00', true, '{"color": "red", "qty": 2}', 89.99),
    ('Basketball shoes', 'Sports', 'Adidas', 119.99, 4, '2024-01-06 10:00:00', false, '{"color": "red", "qty": 1}', 119.99),
    ('Winter jacket', 'Clothing', 'North Face', 199.99, 4, '2024-01-07 10:00:00', true, '{"color": "blue", "qty": 4}', 199.99),
    ('Toy laptop', 'Toys', 'Fisher Price', 29.99, NULL, '2024-01-08 10:00:00', true, NULL, NULL);
INSERT INTO pa_tags (product_id, tag_name, weight) VALUES
    (1, 'tech', 10), (1, 'computer', 5),
    (2, 'tech', 10), (2, 'gaming', 7),
    (3, 'tech', 10), (3, 'budget', 1),
    (4, 'tech', 3);
INSERT INTO pa_tags (product_id, tag_name, weight) VALUES
    (5, 'fitness', 4), (5, 'running', 6),
    (6, 'fitness', 4),
    (7, 'outdoor', 2),
    (8, 'tech', 1), (8, 'kids', 2);
RESET paradedb.global_mutable_segment_rows;
-- Row estimates feed the MPP planner; unanalyzed tables leave them unknown.
ANALYZE pa_products;
ANALYZE pa_tags;
-- =====================================================================
-- SECTION 1: terms over a join
-- =====================================================================
-- Test 1.1: terms per SQL group
EXPLAIN (FORMAT TEXT, COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.category, pdb.agg('{"terms": {"field": "tag_name"}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes'
GROUP BY p.category
ORDER BY p.category;
                                                                                                  QUERY PLAN                                                                                                  
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: p.category, (pdb.agg('{"terms": {"field": "tag_name"}}'::jsonb))
   Sort Key: p.category
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: p.category, (pdb.agg('{"terms": {"field": "tag_name"}}'::jsonb))
         Backend: DataFusion
         Indexes: pa_products_idx (p), pa_tags_idx (t)
         Group By: category
         Aggregates: pdb.agg({"terms":{"field":"tag_name"}})
         DataFusion Physical Plan: 
           : ProjectionExec: expr=[category@0 as category, __grouping_id@2 as __grouping_id, __pdb_k0@1 as __pdb_k0, __pdb_m0@3 as __pdb_m0]
           :   AggregateExec: mode=Final, gby=[category@0 as category, __pdb_k0@1 as __pdb_k0, __grouping_id@2 as __grouping_id], aggr=[count(1) as __pdb_m0]
           :     AggregateExec: mode=Partial, gby=[(category@0 as category, NULL as __pdb_k0), (category@0 as category, tag_name@1 as __pdb_k0)], aggr=[count(1) as __pdb_m0]
           :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@0)], projection=[category@1, tag_name@3]
           :         CooperativeExec
           :           PgSearchScan: table=p, segments=2, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"laptop OR shoes","lenient":null,"conjunction_mode":null}}}}
           :         CooperativeExec
           :           PgSearchScan: table=t, segments=2, dynamic_filters=1, query="all"
(18 rows)

SELECT p.category, pdb.agg('{"terms": {"field": "tag_name"}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes'
GROUP BY p.category
ORDER BY p.category;
  category   |                                                                                                          agg                                                                                                          
-------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Electronics | {"buckets": [{"key": "tech", "doc_count": 3}, {"key": "budget", "doc_count": 1}, {"key": "computer", "doc_count": 1}, {"key": "gaming", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
 Sports      | {"buckets": [{"key": "fitness", "doc_count": 2}, {"key": "running", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
 Toys        | {"buckets": [{"key": "kids", "doc_count": 1}, {"key": "tech", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
(3 rows)

-- Test 1.2: scalar query, nested terms with metric sub-aggregations
EXPLAIN (FORMAT TEXT, COSTS OFF, VERBOSE, TIMING OFF)
SELECT pdb.agg('{"terms": {"field": "category"}, "aggs": {"tags": {"terms": {"field": "tag_name", "size": 2}, "aggs": {"w": {"sum": {"field": "weight"}}}}, "uniq_brands": {"cardinality": {"field": "brand"}}, "avg_price": {"avg": {"field": "price"}}}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes OR jacket OR keyboard';
                                                                                                                                                  QUERY PLAN                                                                                                                                                   
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Output: pdb.agg_fn('pdb.agg'::text)
   Backend: DataFusion
   Indexes: pa_products_idx (p), pa_tags_idx (t)
   Aggregates: pdb.agg({"aggs":{"tags":{"aggs":{"w":{"sum":{"field":"weight"}}},"terms":{"size":2,"field":"tag_name"}},"avg_price":{"avg":{"field":"price"}},"uniq_brands":{"cardinality":{"field":"brand"}}},"terms":{"field":"category"}})
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[__grouping_id@2 as __grouping_id, __pdb_k0@0 as __pdb_k0, __pdb_k1@1 as __pdb_k1, __pdb_m0@3 as __pdb_m0, __pdb_m1@4 as __pdb_m1, __pdb_m2@5 as __pdb_m2, __pdb_m3@6 as __pdb_m3]
     :   AggregateExec: mode=Final, gby=[__pdb_k0@0 as __pdb_k0, __pdb_k1@1 as __pdb_k1, __grouping_id@2 as __grouping_id], aggr=[count(1) as __pdb_m0, avg(p_0.price) as __pdb_m1, sum(t_1.weight) as __pdb_m2, approx_distinct(p_0.brand) as __pdb_m3]
     :     AggregateExec: mode=Partial, gby=[(NULL as __pdb_k0, NULL as __pdb_k1), (category@0 as __pdb_k0, NULL as __pdb_k1), (category@0 as __pdb_k0, tag_name@3 as __pdb_k1)], aggr=[count(1) as __pdb_m0, avg(p_0.price) as __pdb_m1, sum(t_1.weight) as __pdb_m2, approx_distinct(p_0.brand) as __pdb_m3]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@0)], projection=[category@1, brand@2, price@3, tag_name@5, weight@6]
     :         CooperativeExec
     :           PgSearchScan: table=p, segments=2, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"laptop OR shoes OR jacket OR keyboard","lenient":null,"conjunction_mode":null}}}}
     :         CooperativeExec
     :           PgSearchScan: table=t, segments=2, dynamic_filters=1, query="all"
(14 rows)

SELECT pdb.agg('{"terms": {"field": "category"}, "aggs": {"tags": {"terms": {"field": "tag_name", "size": 2}, "aggs": {"w": {"sum": {"field": "weight"}}}}, "uniq_brands": {"cardinality": {"field": "brand"}}, "avg_price": {"avg": {"field": "price"}}}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes OR jacket OR keyboard';
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        agg                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": "Electronics", "tags": {"buckets": [{"w": {"value": 33.0}, "key": "tech", "doc_count": 4}, {"w": {"value": 1.0}, "key": "budget", "doc_count": 1}], "sum_other_doc_count": 2, "doc_count_error_upper_bound": 0}, "avg_price": {"value": 954.2757142857142}, "doc_count": 7, "uniq_brands": {"value": 4.0}}, {"key": "Sports", "tags": {"buckets": [{"w": {"value": 8.0}, "key": "fitness", "doc_count": 2}, {"w": {"value": 6.0}, "key": "running", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}, "avg_price": {"value": 99.99}, "doc_count": 3, "uniq_brands": {"value": 2.0}}, {"key": "Toys", "tags": {"buckets": [{"w": {"value": 2.0}, "key": "kids", "doc_count": 1}, {"w": {"value": 1.0}, "key": "tech", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}, "avg_price": {"value": 29.99}, "doc_count": 2, "uniq_brands": {"value": 1.0}}, {"key": "Clothing", "tags": {"buckets": [{"w": {"value": 2.0}, "key": "outdoor", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}, "avg_price": {"value": 199.99}, "doc_count": 1, "uniq_brands": {"value": 1.0}}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
(1 row)

-- Test 1.3: standard aggregates alongside pdb.agg(), with HAVING
EXPLAIN (FORMAT TEXT, COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.category, COUNT(*), SUM(t.weight), pdb.agg('{"terms": {"field": "tag_name"}}') AS tags
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes OR jacket OR keyboard'
GROUP BY p.category
HAVING COUNT(*) > 1
ORDER BY p.category;
                                                                                                              QUERY PLAN                                                                                                              
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: p.category, (count(*)), (sum(t.weight)), (pdb.agg('{"terms": {"field": "tag_name"}}'::jsonb))
   Sort Key: p.category
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: p.category, (count(*)), (sum(t.weight)), (pdb.agg('{"terms": {"field": "tag_name"}}'::jsonb))
         Backend: DataFusion
         Indexes: pa_products_idx (p), pa_tags_idx (t)
         Group By: category
         Aggregates: COUNT(*), SUM(weight), pdb.agg({"terms":{"field":"tag_name"}})
         DataFusion Physical Plan: 
           : ProjectionExec: expr=[category@0 as category, __common_expr_1@3 as agg_0, agg_1@4 as agg_1, __grouping_id@2 as __grouping_id, __pdb_k0@1 as __pdb_k0, __common_expr_1@3 as __pdb_m0]
           :   FilterExec: __grouping_id@2 != 1 OR __common_expr_1@3 > 1
           :     AggregateExec: mode=Final, gby=[category@0 as category, __pdb_k0@1 as __pdb_k0, __grouping_id@2 as __grouping_id], aggr=[count(1) as __common_expr_1, sum(t_1.weight) as agg_1]
           :       AggregateExec: mode=Partial, gby=[(category@0 as category, NULL as __pdb_k0), (category@0 as category, tag_name@1 as __pdb_k0)], aggr=[count(1) as __common_expr_1, sum(t_1.weight) as agg_1]
           :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@0)], projection=[category@1, tag_name@3, weight@4]
           :           CooperativeExec
           :             PgSearchScan: table=p, segments=2, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"laptop OR shoes OR jacket OR keyboard","lenient":null,"conjunction_mode":null}}}}
           :           CooperativeExec
           :             PgSearchScan: table=t, segments=2, dynamic_filters=1, query="all"
(19 rows)

SELECT p.category, COUNT(*), SUM(t.weight), pdb.agg('{"terms": {"field": "tag_name"}}') AS tags
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes OR jacket OR keyboard'
GROUP BY p.category
HAVING COUNT(*) > 1
ORDER BY p.category;
  category   | count | sum |                                                                                                         tags                                                                                                          
-------------+-------+-----+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Electronics |     7 |  46 | {"buckets": [{"key": "tech", "doc_count": 4}, {"key": "budget", "doc_count": 1}, {"key": "computer", "doc_count": 1}, {"key": "gaming", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
 Sports      |     3 |  14 | {"buckets": [{"key": "fitness", "doc_count": 2}, {"key": "running", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
 Toys        |     2 |   3 | {"buckets": [{"key": "kids", "doc_count": 1}, {"key": "tech", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
(3 rows)

-- Test 1.4: order by a metric sub-aggregation, min_doc_count, size
SELECT pdb.agg('{"terms": {"field": "tag_name", "order": {"total_w": "desc"}, "min_doc_count": 2, "size": 2}, "aggs": {"total_w": {"sum": {"field": "weight"}}}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes OR jacket OR keyboard';
                                                                                 agg                                                                                 
---------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": "tech", "total_w": {"value": 34.0}, "doc_count": 5}, {"key": "fitness", "total_w": {"value": 8.0}, "doc_count": 2}], "sum_other_doc_count": 0}
(1 row)

-- Test 1.5: per-aggregate FILTER
SELECT p.category, pdb.agg('{"terms": {"field": "tag_name"}}') FILTER (WHERE t.weight > 5)
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes OR jacket OR keyboard'
GROUP BY p.category
ORDER BY p.category;
  category   |                                                                      agg                                                                      
-------------+-----------------------------------------------------------------------------------------------------------------------------------------------
 Clothing    | {"buckets": [], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
 Electronics | {"buckets": [{"key": "tech", "doc_count": 3}, {"key": "gaming", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
 Sports      | {"buckets": [{"key": "running", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
 Toys        | {"buckets": [], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
(4 rows)

-- Test 1.6: bool and datetime keys, datetime metrics
SELECT pdb.agg('{"terms": {"field": "in_stock"}, "aggs": {"first": {"min": {"field": "created_at"}}, "last": {"max": {"field": "created_at"}}}}'),
       pdb.agg('{"terms": {"field": "created_at", "size": 3, "order": {"_key": "asc"}}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes';
                                                                                                                                                                                                                                                        agg                                                                                                                                                                                                                                                         |                                                                                            agg                                                                                             
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": 1, "last": {"value": 758023200000000.0, "key_as_string": "2024-01-08T10:00:00Z"}, "first": {"value": 757418400000000.0, "key_as_string": "2024-01-01T10:00:00Z"}, "doc_count": 8, "key_as_string": "true"}, {"key": 0, "last": {"value": 757850400000000.0, "key_as_string": "2024-01-06T10:00:00Z"}, "first": {"value": 757504800000000.0, "key_as_string": "2024-01-02T10:00:00Z"}, "doc_count": 3, "key_as_string": "false"}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0} | {"buckets": [{"key": "2024-01-01T10:00:00Z", "doc_count": 2}, {"key": "2024-01-02T10:00:00Z", "doc_count": 2}, {"key": "2024-01-03T10:00:00Z", "doc_count": 2}], "sum_other_doc_count": 5}
(1 row)

-- Test 1.7: missing on a numeric key
SELECT pdb.agg('{"terms": {"field": "rating", "missing": 0, "order": {"_key": "desc"}}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes';
                                                                           agg                                                                           
---------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": 5, "doc_count": 6}, {"key": 4, "doc_count": 1}, {"key": 3, "doc_count": 2}, {"key": 0, "doc_count": 2}], "sum_other_doc_count": 0}
(1 row)

-- Test 1.8: ORDER BY an aggregate with LIMIT stays correct without TopK pushdown
SELECT p.category, COUNT(*), pdb.agg('{"terms": {"field": "tag_name"}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes OR jacket OR keyboard'
GROUP BY p.category
ORDER BY COUNT(*) DESC, p.category
LIMIT 2;
  category   | count |                                                                                                          agg                                                                                                          
-------------+-------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Electronics |     7 | {"buckets": [{"key": "tech", "doc_count": 4}, {"key": "budget", "doc_count": 1}, {"key": "computer", "doc_count": 1}, {"key": "gaming", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
 Sports      |     3 | {"buckets": [{"key": "fitness", "doc_count": 2}, {"key": "running", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
(2 rows)

-- Test 1.9: a NULL key gets its own bucket. The Tantivy backend gives it one
-- too through its `missing` sentinel, rendered as `null` for text keys and
-- leaked as an extreme value for numeric ones.
SELECT pdb.agg('{"terms": {"field": "rating", "order": {"_key": "asc"}}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes';
                                                                            agg                                                                             
------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": 3, "doc_count": 2}, {"key": 4, "doc_count": 1}, {"key": 5, "doc_count": 6}, {"key": null, "doc_count": 2}], "sum_other_doc_count": 0}
(1 row)

-- Test 1.10: a `missing` literal takes the column's type
SELECT pdb.agg('{"terms": {"field": "tag_name", "missing": 0}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop';
                                                                                                                          agg                                                                                                                           
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": "tech", "doc_count": 4}, {"key": "budget", "doc_count": 1}, {"key": "computer", "doc_count": 1}, {"key": "gaming", "doc_count": 1}, {"key": "kids", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
(1 row)

SELECT pdb.agg('{"terms": {"field": "rating", "missing": "none"}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop';
ERROR:  Cannot execute pdb.agg: `missing` for numeric field 'rating' must be a number
-- Test 1.11: cardinality on a float field counts exactly; bool and datetime
-- take the HLL
SELECT pdb.agg('{"cardinality": {"field": "price"}}'),
       pdb.agg('{"cardinality": {"field": "in_stock"}}'),
       pdb.agg('{"cardinality": {"field": "created_at"}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes';
      agg       |      agg       |      agg       
----------------+----------------+----------------
 {"value": 6.0} | {"value": 2.0} | {"value": 6.0}
(1 row)

-- Test 1.12: an aliased index field resolves by its index name
SELECT pdb.agg('{"terms": {"field": "cat_kw", "order": {"_key": "asc"}}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes';
                                                                         agg                                                                         
-----------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": "Electronics", "doc_count": 6}, {"key": "Sports", "doc_count": 3}, {"key": "Toys", "doc_count": 2}], "sum_other_doc_count": 0}
(1 row)

-- Test 1.13: `min_doc_count: 0` has no grouped-scan equivalent, and `size: 0`
-- keeps no buckets
SELECT pdb.agg('{"terms": {"field": "tag_name", "min_doc_count": 0}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop';
ERROR:  Cannot execute pdb.agg: terms `min_doc_count: 0` is not supported over joins
SELECT pdb.agg('{"terms": {"field": "tag_name", "size": 0}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop';
                                     agg                                     
-----------------------------------------------------------------------------
 {"buckets": [], "sum_other_doc_count": 8, "doc_count_error_upper_bound": 0}
(1 row)

-- Test 1.14: a self-join resolves each side through its alias
SELECT pdb.agg('{"terms": {"field": "a.category"}}'), pdb.agg('{"cardinality": {"field": "b.brand"}}')
FROM pa_products a JOIN pa_products b ON a.category = b.category
WHERE a.description @@@ 'laptop';
                                                                         agg                                                                         |      agg       
-----------------------------------------------------------------------------------------------------------------------------------------------------+----------------
 {"buckets": [{"key": "Electronics", "doc_count": 12}, {"key": "Toys", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0} | {"value": 5.0}
(1 row)

-- Test 1.15: a LEFT JOIN's unmatched side lands in the NULL bucket
SELECT pdb.agg('{"terms": {"field": "tag_name", "order": {"_key": "asc"}}}')
FROM pa_products p LEFT JOIN pa_tags t ON p.id = t.product_id AND t.weight > 5
WHERE p.description @@@ 'laptop OR shoes';
                                                                                      agg                                                                                       
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": "gaming", "doc_count": 1}, {"key": "running", "doc_count": 1}, {"key": "tech", "doc_count": 3}, {"key": null, "doc_count": 2}], "sum_other_doc_count": 0}
(1 row)

-- Test 1.16: terms on a text-valued JSON sub-field, alone and under a JSON
-- GROUP BY expression
SELECT pdb.agg('{"terms": {"field": "metadata.color", "order": {"_key": "asc"}}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes';
