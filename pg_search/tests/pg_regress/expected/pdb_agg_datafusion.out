-- The leader's visibility decision reaches the workers
BEGIN;
DELETE FROM pa_tags WHERE tag_name = 'gaming';
SELECT pdb.agg('{"terms": {"field": "tag_name", "order": {"_key": "asc"}}}'::jsonb, 'transaction')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes OR jacket OR keyboard';
                                                                                                                                              agg                                                                                                                                              
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": "budget", "doc_count": 1}, {"key": "computer", "doc_count": 1}, {"key": "fitness", "doc_count": 2}, {"key": "kids", "doc_count": 1}, {"key": "outdoor", "doc_count": 1}, {"key": "running", "doc_count": 1}, {"key": "tech", "doc_count": 5}], "sum_other_doc_count": 0}
(1 row)

SELECT pdb.agg('{"terms": {"field": "tag_name", "order": {"_key": "asc"}}}'::jsonb, 'raw')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes OR jacket OR keyboard';
                                                                                                                                                               agg                                                                                                                                                                
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": "budget", "doc_count": 1}, {"key": "computer", "doc_count": 1}, {"key": "fitness", "doc_count": 2}, {"key": "gaming", "doc_count": 1}, {"key": "kids", "doc_count": 1}, {"key": "outdoor", "doc_count": 1}, {"key": "running", "doc_count": 1}, {"key": "tech", "doc_count": 5}], "sum_other_doc_count": 0}
(1 row)

ROLLBACK;
