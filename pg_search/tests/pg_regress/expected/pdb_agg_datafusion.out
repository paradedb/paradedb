-- =====================================================================
-- SECTION 3: field resolution and visibility
-- =====================================================================
-- Test 3.1: a field name present in both tables must be qualified
SELECT pdb.agg('{"cardinality": {"field": "id"}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop';
ERROR:  Cannot execute pdb.agg: Aggregation field 'id' exists in more than one table. Qualify it with the table alias, as in 'alias.id'.
SELECT pdb.agg('{"cardinality": {"field": "p.id"}}'), pdb.agg('{"value_count": {"field": "t.id"}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop';
      agg       |      agg       
----------------+----------------
 {"value": 4.0} | {"value": 8.0}
(1 row)

-- Test 3.2: an aggregation the backend does not run is an error, not a fallback
SELECT pdb.agg('{"range": {"field": "price", "ranges": [{"to": 100}]}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop';
ERROR:  Cannot execute pdb.agg: `range` aggregations are not supported on the DataFusion backend
-- Test 3.3: raw visibility skips the heap check; nothing is deleted here so the
-- result matches
SELECT p.category, pdb.agg('{"terms": {"field": "tag_name"}}'::jsonb, 'raw')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop OR shoes'
GROUP BY p.category
ORDER BY p.category;
  category   |                                                                                                          agg                                                                                                          
-------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Electronics | {"buckets": [{"key": "tech", "doc_count": 3}, {"key": "budget", "doc_count": 1}, {"key": "computer", "doc_count": 1}, {"key": "gaming", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
 Sports      | {"buckets": [{"key": "fitness", "doc_count": 2}, {"key": "running", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
 Toys        | {"buckets": [{"key": "kids", "doc_count": 1}, {"key": "tech", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
(3 rows)

-- Test 3.4: raw visibility sees a row deleted in this transaction
BEGIN;
DELETE FROM pa_tags WHERE tag_name = 'gaming';
SELECT pdb.agg('{"terms": {"field": "tag_name"}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop';
                                                                                                         agg                                                                                                         
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": "tech", "doc_count": 4}, {"key": "budget", "doc_count": 1}, {"key": "computer", "doc_count": 1}, {"key": "kids", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
(1 row)

SELECT pdb.agg('{"terms": {"field": "tag_name"}}'::jsonb, 'raw')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop';
                                                                                                                          agg                                                                                                                           
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": "tech", "doc_count": 4}, {"key": "budget", "doc_count": 1}, {"key": "computer", "doc_count": 1}, {"key": "gaming", "doc_count": 1}, {"key": "kids", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
(1 row)

ROLLBACK;
-- Test 3.5: conflicting visibility settings are rejected
SELECT pdb.agg('{"sum": {"field": "weight"}}'::jsonb, 'raw'), pdb.agg('{"sum": {"field": "price"}}'::jsonb)
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop';
ERROR:  pdb.agg() calls have contradicting visibility settings: 'raw' and 'transaction'. All pdb.agg() calls in a query must use the same visibility value, and omitting the argument selects 'transaction'.
-- =====================================================================
-- SECTION 4: single table routed to DataFusion
-- =====================================================================
-- Test 4.1: reference result on the Tantivy backend. A nested `aggs` under
-- GROUP BY does not run there, so the metric is a second call.
EXPLAIN (FORMAT TEXT, COSTS OFF, VERBOSE, TIMING OFF)
SELECT category, pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}}'), pdb.agg('{"sum": {"field": "price"}}'), COUNT(*)
FROM pa_products
WHERE description @@@ 'laptop OR shoes'
GROUP BY category
ORDER BY category;
                                                                                                                 QUERY PLAN                                                                                                                 
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan) on public.pa_products
   Output: category, pdb.agg_fn('pdb.agg'::text), pdb.agg_fn('pdb.agg'::text), pdb.agg_fn('COUNT(*)'::text)
   Index: pa_products_idx
   Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"laptop OR shoes","lenient":null,"conjunction_mode":null}}}}
     Applies to Aggregates: CUSTOM_AGG({"terms":{"field":"brand","order":{"_key":"asc"}}}), CUSTOM_AGG({"sum":{"field":"price"}}), COUNT(*)
     Group By: category
     Aggregate Definition: {"grouped":{"aggs":{"0":{"terms":{"field":"brand","order":{"_key":"asc"}}},"1":{"sum":{"field":"price","missing":null}}},"terms":{"field":"category","order":{"_key":"asc"},"segment_size":65000,"size":65000}}}
(7 rows)

SELECT category, pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}}'), pdb.agg('{"sum": {"field": "price"}}'), COUNT(*)
FROM pa_products
WHERE description @@@ 'laptop OR shoes'
GROUP BY category
ORDER BY category;
  category   |                                                                    agg                                                                    |              agg              | count 
-------------+-------------------------------------------------------------------------------------------------------------------------------------------+-------------------------------+-------
 Electronics | {"buckets": [{"key": "Apple", "doc_count": 1}, {"key": "Dell", "doc_count": 1}, {"key": "HP", "doc_count": 1}], "sum_other_doc_count": 0} | {"value": 3299.9700000000003} |     3
 Sports      | {"buckets": [{"key": "Adidas", "doc_count": 1}, {"key": "Nike", "doc_count": 1}], "sum_other_doc_count": 0}                               | {"value": 209.98}             |     2
 Toys        | {"buckets": [{"key": "Fisher Price", "doc_count": 1}], "sum_other_doc_count": 0}                                                          | {"value": 29.99}              |     1
(3 rows)

-- Test 4.2: the same query on DataFusion, forced through the bucket cap
SET paradedb.max_term_agg_buckets TO 1;
EXPLAIN (FORMAT TEXT, COSTS OFF, VERBOSE, TIMING OFF)
SELECT category, pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}}'), pdb.agg('{"sum": {"field": "price"}}'), COUNT(*)
FROM pa_products
WHERE description @@@ 'laptop OR shoes'
GROUP BY category
ORDER BY category;
                                                                                                       QUERY PLAN                                                                                                       
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: category, (pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}}'::jsonb)), (pdb.agg('{"sum": {"field": "price"}}'::jsonb)), (count(*))
   Sort Key: pa_products.category
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: category, (pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}}'::jsonb)), (pdb.agg('{"sum": {"field": "price"}}'::jsonb)), (count(*))
         Backend: DataFusion
         Indexes: pa_products_idx (pa_products)
         Group By: category
         Aggregates: pdb.agg({"terms":{"field":"brand","order":{"_key":"asc"}}}), pdb.agg({"sum":{"field":"price"}}), COUNT(*)
         DataFusion Physical Plan: 
           : ProjectionExec: expr=[category@0 as category, __common_expr_1@3 as agg_2, __grouping_id@2 as __grouping_id, __pdb_k0@1 as __pdb_k0, __common_expr_1@3 as __pdb_m0, __pdb_m1@4 as __pdb_m1]
           :   AggregateExec: mode=Final, gby=[category@0 as category, __pdb_k0@1 as __pdb_k0, __grouping_id@2 as __grouping_id], aggr=[count(1) as __common_expr_1, sum(pa_products_0.price) as __pdb_m1]
           :     AggregateExec: mode=Partial, gby=[(category@0 as category, NULL as __pdb_k0), (category@0 as category, brand@1 as __pdb_k0)], aggr=[count(1) as __common_expr_1, sum(pa_products_0.price) as __pdb_m1]
           :       CooperativeExec
           :         PgSearchScan: table=pa_products, segments=2, query={"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"laptop OR shoes","lenient":null,"conjunction_mode":null}}}}
(15 rows)

SELECT category, pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}}'), pdb.agg('{"sum": {"field": "price"}}'), COUNT(*)
FROM pa_products
WHERE description @@@ 'laptop OR shoes'
GROUP BY category
ORDER BY category;
