SELECT pdb.agg('{"terms": {"field": "tag_name", "missing": 0}}')
FROM pa_products p JOIN pa_tags t ON p.id = t.product_id
WHERE p.description @@@ 'laptop';
                                                                                                                          agg                                                                                                                           
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"buckets": [{"key": "tech", "doc_count": 4}, {"key": "budget", "doc_count": 1}, {"key": "computer", "doc_count": 1}, {"key": "gaming", "doc_count": 1}, {"key": "kids", "doc_count": 1}], "sum_other_doc_count": 0, "doc_count_error_upper_bound": 0}
(1 row)

SELECT pdb.agg('{"terms": {"field": "rating", "missing": "none"}}')
