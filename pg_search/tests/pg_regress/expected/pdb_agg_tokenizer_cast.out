-- Test 4: a SQL GROUP BY beside pdb.agg(), both on casts
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT o.status, pdb.agg('{"terms": {"field": "name", "order": {"_key": "asc"}}}')
FROM pac_products p JOIN pac_orders o ON p.id = o.product_id
WHERE p.description ||| 'item'
GROUP BY o.status
ORDER BY o.status;
                                                                                                                                          QUERY PLAN                                                                                                                                          
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: o.status, (pdb.agg('{"terms": {"field": "name", "order": {"_key": "asc"}}}'::jsonb))
   Sort Key: o.status
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: o.status, (pdb.agg('{"terms": {"field": "name", "order": {"_key": "asc"}}}'::jsonb))
         Backend: DataFusion
         Indexes: pac_products_idx (p), pac_orders_idx (o)
         Group By: order_status
         Aggregates: pdb.agg({"terms":{"field":"name","order":{"_key":"asc"}}})
         DataFusion Physical Plan: 
           : ProjectionExec: expr=[order_status@0 as order_status, __grouping_id@2 as __grouping_id, __pdb_k0@1 as __pdb_k0, __pdb_m0@3 as __pdb_m0]
           :   AggregateExec: mode=Final, gby=[order_status@0 as order_status, __pdb_k0@1 as __pdb_k0, __grouping_id@2 as __grouping_id], aggr=[count(1) as __pdb_m0]
           :     TantivyDecodeExec: decode=[order_status, name]
           :       AggregateExec: mode=Partial, gby=[(order_status@1 as order_status, NULL as __pdb_k0), (order_status@1 as order_status, name@0 as __pdb_k0)], aggr=[count(1) as __pdb_m0]
           :         TantivyFetchExec: fetch=[order_status]
           :           HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@1)], projection=[name@1, order_status@2]
           :             CooperativeExec
           :               PgSearchScan: table=p, segments=1, pruned=0, fetch=[name], visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"item","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
           :             CooperativeExec
           :               PgSearchScan: table=o, segments=1, pruned=0, dynamic_filters=1, visibility=eager, query="all"
(20 rows)

