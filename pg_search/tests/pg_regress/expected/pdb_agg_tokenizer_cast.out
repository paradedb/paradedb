     :     TantivyDecodeExec: decode=[name]
     :       AggregateExec: mode=Partial, gby=[(NULL as __pdb_k0), (name@0 as __pdb_k0)], aggr=[count(1) as __pdb_m0, count(pac_products_0.price) as __pdb_m1, numeric64_sum(pac_products_0.price, 2) as __pdb_m2]
