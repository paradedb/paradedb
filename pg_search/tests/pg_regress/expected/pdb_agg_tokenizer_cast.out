     : ProjectionExec: expr=[__grouping_id@1 as __grouping_id, __pdb_k0@0 as __pdb_k0, __pdb_m0@2 as __pdb_m0, __pdb_m1@3 as __pdb_m1, __pdb_m2@4 as __pdb_m2]
