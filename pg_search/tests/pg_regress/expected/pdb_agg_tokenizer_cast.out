-- Test 5: on a single table, a cast key with a NUMERIC metric
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT name, SUM(price)
FROM pac_products
WHERE description ||| 'item'
GROUP BY name
ORDER BY name;
                                                                                                                                      QUERY PLAN                                                                                                                                       
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: name, (sum(price))
   Sort Key: pac_products.name
   ->  Custom Scan (ParadeDB Aggregate Scan)
         Output: name, (sum(price))
         Backend: DataFusion
         Indexes: pac_products_idx (pac_products)
         Group By: name
         Aggregates: SUM(price)
         DataFusion Physical Plan: 
           : AggregateExec: mode=Final, gby=[name@0 as name], aggr=[numeric64_sum(pac_products_0.price, 2) as agg_0]
           :   TantivyDecodeExec: decode=[name]
           :     AggregateExec: mode=Partial, gby=[name@0 as name], aggr=[numeric64_sum(pac_products_0.price, 2) as agg_0]
           :       TantivyFetchExec: fetch=[name]
           :         CooperativeExec
           :           PgSearchScan: table=pac_products, segments=1, pruned=0, visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"item","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(16 rows)

