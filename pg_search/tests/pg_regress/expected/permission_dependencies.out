-- Plan controls run as owner so the later tenant policy does not hide alpha.
DO $$ DECLARE p jsonb; BEGIN
 EXECUTE 'EXPLAIN (COSTS OFF, FORMAT JSON) SELECT * FROM permission_breadth.native_inline()' INTO p;
 ASSERT NOT jsonb_path_exists(p, '$.** ? (@."Node Type" == "Function Scan")'),
  'ordinary SQL functions must retain native inlining';
 ASSERT jsonb_path_exists(p, '$.** ? (@."Relation Name" == "docs")'),
  'the ordinary function body must actually be in the outer plan';
 EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, FORMAT JSON) SELECT * FROM permission_breadth.public_inline()' INTO p;
 ASSERT NOT jsonb_path_exists(p, '$.** ? (@."Node Type" == "Function Scan")'),
  'permitted search SQL functions must retain native inlining';
 ASSERT (p->0->'Plan'->>'Actual Rows')::numeric=1,
  'the inlined search must execute and return the matching row';
END $$;
SELECT count(*) AS cases, bool_and(passed) AS all_passed FROM permission_breadth.results \gset
ROLLBACK;
\if :all_passed
 \echo PASS: :cases breadth permission assertions.
PASS: 129 breadth permission assertions.
\else
 DO $$ BEGIN RAISE EXCEPTION 'breadth permission assertions failed'; END $$;
\endif
