\i common/common_setup.sql
CREATE EXTENSION IF NOT EXISTS pg_search;
-- Disable parallel workers to avoid differences in plans
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan to OFF;
SET paradedb.enable_columnar_exec = true;
\set VERBOSITY default
CREATE TABLE projection_search_predicate (
    id INTEGER PRIMARY KEY,
    body TEXT,
    category TEXT
);
INSERT INTO projection_search_predicate VALUES
    (1, 'mechanical keyboard', 'electronics'),
    (2, 'wireless mouse', 'electronics'),
    (3, 'keyboard stand', 'accessories');
CREATE INDEX projection_search_predicate_idx
ON projection_search_predicate USING paradedb (id, body);
-- PostgreSQL drops the redundant branch, and the search predicate with it. The scan runs on
-- what remains and the projections see no search terms, as with `pdb.all()`.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT id, pdb.score(id)
FROM projection_search_predicate
WHERE category = 'electronics' OR (category = 'electronics' AND body === 'keyboard')
ORDER BY id;
WARNING:  BaseScan: PostgreSQL simplified the search predicate away, so `pdb.score` and `pdb.snippet` only reflect the remaining predicates. To disable this warning: SET paradedb.planner_warnings = 'off' (table: projection_search_predicate)
                                                              QUERY PLAN                                                              
--------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: id, (pdb.score(id))
   Sort Key: projection_search_predicate.id
   ->  Custom Scan (ParadeDB Base Scan) on public.projection_search_predicate
         Output: id, pdb.score(id)
         Table: projection_search_predicate
         Index: projection_search_predicate_idx
         Worker Selection: Row-capped
         Exec Method: ColumnarExecState
         Columnar: id
         Scores: true
         Full Index Scan: true
         Tantivy Query: {"heap_filter":{"indexed_query":"all","always_filters":[{"heap_filter":"(category = 'electronics'::text)"}]}}
(13 rows)

