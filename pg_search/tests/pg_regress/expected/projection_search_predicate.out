-- The operator is written against one side of a join.
CREATE TABLE projection_search_predicate_labels (
    id INTEGER PRIMARY KEY,
    label TEXT
);
INSERT INTO projection_search_predicate_labels VALUES (1, 'x'), (2, 'y'), (3, 'z');
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.id, l.label, pdb.score(p.id)
FROM projection_search_predicate p
JOIN projection_search_predicate_labels l ON p.id = l.id
WHERE p.category = 'electronics' OR (p.category = 'electronics' AND p.body === 'keyboard')
ORDER BY p.id;
WARNING:  BaseScan: PostgreSQL simplified the search predicate away, so `pdb.score` and `pdb.snippet` only reflect the remaining predicates. To disable this warning: SET paradedb.planner_warnings = 'off' (table: p)
WARNING:  JoinScan not used: at least one relation lacks a ParadeDB index (tables: l, p)
                                                                 QUERY PLAN                                                                 
--------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: p.id, l.label, (pdb.score(p.id))
   Sort Key: p.id
   ->  Nested Loop
         Output: p.id, l.label, (pdb.score(p.id))
         Inner Unique: true
         ->  Custom Scan (ParadeDB Base Scan) on public.projection_search_predicate p
               Output: p.id, pdb.score(p.id), pdb.score(p.id)
               Table: projection_search_predicate
               Index: projection_search_predicate_idx
               Worker Selection: Row-capped
               Exec Method: NormalScanExecState
               Scores: true
               Full Index Scan: true
               Tantivy Query: {"heap_filter":{"indexed_query":"all","always_filters":[{"heap_filter":"(category = 'electronics'::text)"}]}}
         ->  Bitmap Heap Scan on public.projection_search_predicate_labels l
               Output: l.id, l.label
               Recheck Cond: (p.id = l.id)
               ->  Bitmap Index Scan on projection_search_predicate_labels_pkey
                     Index Cond: (l.id = p.id)
(20 rows)

