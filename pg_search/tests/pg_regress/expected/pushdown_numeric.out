   ->  Custom Scan (ParadeDB Base Scan) on numeric_pushdown
         Table: numeric_pushdown
         Index: numeric_pushdown_idx
         Exec Method: TopKScanExecState
         Scores: false
            TopK Order By: id asc
            TopK Limit: 10
         Full Index Scan: true
         Tantivy Query: {"boolean":{"must":[{"heap_filter":{"indexed_query":{"boolean":{"must":[{"with_index":{"query":"all"}}]}},"always_filters":[{"heap_filter":"((numeric_col)::integer > 1)"}]}}]}}
