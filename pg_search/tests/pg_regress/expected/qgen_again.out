SET statement_timeout TO 60000;
--
-- PostgreSQL query:
EXPLAIN
SELECT COUNT(*) FROM users RIGHT JOIN products ON users.id = products.id JOIN orders ON products.age = orders.age  WHERE ((orders.id  =  '4') OR (products.id  =  '4')) AND ((users.id  =  '4') OR (NOT (products.id  =  '4')));
                                      QUERY PLAN                                       
---------------------------------------------------------------------------------------
 Aggregate  (cost=3.83..3.84 rows=1 width=8)
   ->  Hash Left Join  (cost=2.47..3.82 rows=2 width=0)
         Hash Cond: (products.id = users.id)
         Filter: ((users.id = '4'::bigint) OR (products.id <> '4'::bigint))
         ->  Hash Join  (cost=1.25..2.59 rows=2 width=8)
               Hash Cond: (products.age = orders.age)
               Join Filter: ((orders.id = '4'::bigint) OR (products.id = '4'::bigint))
               ->  Seq Scan on products  (cost=0.00..1.11 rows=11 width=12)
               ->  Hash  (cost=1.11..1.11 rows=11 width=12)
                     ->  Seq Scan on orders  (cost=0.00..1.11 rows=11 width=12)
         ->  Hash  (cost=1.10..1.10 rows=10 width=8)
               ->  Seq Scan on users  (cost=0.00..1.10 rows=10 width=8)
(12 rows)

