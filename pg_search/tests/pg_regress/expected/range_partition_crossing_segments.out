-- Top K by score. The rows without an owner are in the first partition only.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.id, pdb.score(p.id) AS score, u.id IS NULL AS orphan
FROM rpx_posts p LEFT JOIN rpx_users u ON u.id = p.owner_user_id AND u.id @@@ pdb.all()
WHERE p.title ||| 'error without owner'
ORDER BY pdb.score(p.id) DESC, p.id
LIMIT 8;
                                                                                                                                                                   QUERY PLAN                                                                                                                                                                    
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, (pdb.score(p.id)), ((u.id IS NULL))
   Relation Tree: p LEFT u
   Join Cond: u.id = p.owner_user_id
   Limit: 8
   Order By: pdb.score(p) desc, p.id asc
   DataFusion Physical Plan: 
     : ┌───── DistributedExec
     : │ ProjectionExec: expr=[id@2 as col_1, pdb.score(p)@0 as col_2, id@3 IS NULL as col_3, ctid_0@1 as ctid_0]
     : │   SortPreservingMergeExec: [pdb.score(p)@0 DESC, id@2 ASC NULLS LAST], fetch=8
     : │     [Stage 1] => NetworkCoalesceExec: output_partitions=3, input_tasks=3
     : └──────────────────────────────────────────────────
     :   ┌───── Stage 1 ── tasks=3, partitions=3
     :   │ SortExec: TopK(fetch=8), expr=[pdb.score(p)@0 DESC, id@2 ASC NULLS LAST], preserve_partitioning=[true]
     :   │   VisibilityFilterExec: tables=[p]
     :   │     HashJoinExec: mode=Partitioned, join_type=Right, on=[(id@0, owner_user_id@2)], projection=[pdb.score(p)@1, ctid_0@2, id@4, id@0]
     :   │       DistributedLeafExec:
     :   │         t0: PgSearchScan: table=u, segments={partial=1, included=1, pruned=2}, partition=id[-∞..1228), visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
     :   │         t1: PgSearchScan: table=u, segments={partial=1, included=0, pruned=3}, partition=id[1228..1754), visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
     :   │         t2: PgSearchScan: table=u, segments={partial=1, included=2, pruned=1}, partition=id[1754..∞), visibility=eager, query={"with_index":{"query":{"all":{"field":"id"}}}}
     :   │       DistributedLeafExec:
     :   │         t0: PgSearchScan: table=p, segments={partial=2, included=3, pruned=4}, partition=owner_user_id[-∞..1228), dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"title","value":"error without owner","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   │         t1: PgSearchScan: table=p, segments={partial=3, included=0, pruned=6}, partition=owner_user_id[1228..1754), dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"title","value":"error without owner","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   │         t2: PgSearchScan: table=p, segments={partial=2, included=3, pruned=4}, partition=owner_user_id[1754..∞), dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"title","value":"error without owner","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   └──────────────────────────────────────────────────
(25 rows)

