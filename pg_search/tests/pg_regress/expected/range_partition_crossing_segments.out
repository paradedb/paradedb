-- Scored, with a Top K on another column.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.id, pdb.score(p.id) AS score
FROM rpx_users u JOIN rpx_posts p ON u.id = p.owner_user_id
WHERE u.id @@@ pdb.all() AND p.title ||| 'error without owner'
ORDER BY p.id DESC
LIMIT 6;
                                                                                                                                                                   QUERY PLAN                                                                                                                                                                    
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, (pdb.score(p.id))
   Relation Tree: u INNER p
   Join Cond: u.id = p.owner_user_id
   Limit: 6
   Order By: p.id desc
   DataFusion Physical Plan: 
     : ┌───── DistributedExec
     : │ ProjectionExec: expr=[id@2 as col_1, pdb.score(p)@0 as col_2, ctid_1@1 as ctid_1]
     : │   SortPreservingMergeExec: [id@2 DESC], fetch=6
     : │     [Stage 1] => NetworkCoalesceExec: output_partitions=3, input_tasks=3
     : └──────────────────────────────────────────────────
     :   ┌───── Stage 1 ── tasks=3, partitions=3
     :   │ SortExec: TopK(fetch=6), expr=[id@2 DESC], preserve_partitioning=[true]
     :   │   VisibilityFilterExec: tables=[u, p], pruned=[u]
     :   │     HashJoinExec: mode=Partitioned, join_type=Inner, on=[(id@0, owner_user_id@2)], projection=[pdb.score(p)@2, ctid_1@3, id@5, ctid_0@1]
     :   │       DistributedLeafExec:
     :   │         t0: PgSearchScan: table=u, segments={partial=1, included=1, pruned=2}, partition=id[-∞..1228), query={"with_index":{"query":{"all":{"field":"id"}}}}
     :   │         t1: PgSearchScan: table=u, segments={partial=1, included=0, pruned=3}, partition=id[1228..1754), query={"with_index":{"query":{"all":{"field":"id"}}}}
     :   │         t2: PgSearchScan: table=u, segments={partial=1, included=2, pruned=1}, partition=id[1754..∞), query={"with_index":{"query":{"all":{"field":"id"}}}}
     :   │       DistributedLeafExec:
     :   │         t0: PgSearchScan: table=p, segments={partial=2, included=3, pruned=4}, partition=owner_user_id[-∞..1228), dynamic_filters=2, query={"with_index":{"query":{"match":{"field":"title","value":"error without owner","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   │         t1: PgSearchScan: table=p, segments={partial=3, included=0, pruned=6}, partition=owner_user_id[1228..1754), dynamic_filters=2, query={"with_index":{"query":{"match":{"field":"title","value":"error without owner","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   │         t2: PgSearchScan: table=p, segments={partial=2, included=3, pruned=4}, partition=owner_user_id[1754..∞), dynamic_filters=2, query={"with_index":{"query":{"match":{"field":"title","value":"error without owner","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :   └──────────────────────────────────────────────────
(25 rows)

