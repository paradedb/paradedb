-- ============================================================
-- Test 14: range co-partitioned inputs keep RankJoinExec (mode=Partitioned) under
-- DistributedExec, with the policy applied on every task's leaf. Extra rows let the join
-- key split into two partitions; the indexes are rebuilt with partition keys.
-- ============================================================
INSERT INTO rjf_clients
SELECT g, 1 + g % 2, CASE WHEN g % 7 = 0 THEN 'zebra client' ELSE 'corp' END
FROM generate_series(100, 160) g;
INSERT INTO rjf_jobs
SELECT g, 1 + g % 2, 100 + g % 61, CASE WHEN g % 5 = 0 THEN 'zebra job' ELSE 'noise' END, 'a'
FROM generate_series(200, 320) g;
DROP INDEX rjf_clients_bm25, rjf_jobs_bm25;
SET max_parallel_maintenance_workers = 0;
CREATE INDEX rjf_clients_bm25 ON rjf_clients USING bm25 (id, division, name)
WITH (target_segment_count = 3, partition_by = 'id');
WARNING:  only 0 parallel workers were available for index build
CREATE INDEX rjf_jobs_bm25 ON rjf_jobs USING bm25 (id, division, client_id, body)
WITH (target_segment_count = 3, partition_by = 'client_id,id');
WARNING:  only 0 parallel workers were available for index build
ANALYZE rjf_clients, rjf_jobs;
SET paradedb.enable_range_partitioned_join = on;
SET paradedb.mpp_min_rows = 0;
SET max_parallel_workers_per_gather = 3;
SET max_parallel_workers = 8;
SET min_parallel_table_scan_size = 0;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET ROLE rjf_const_user;
SELECT explain_redact_oid($$
SELECT j.id, c.id
FROM rjf_jobs j JOIN rjf_clients c ON c.id = j.client_id
WHERE j.body @@@ 'zebra' OR c.name @@@ 'zebra'
ORDER BY pdb.score(j.id) + pdb.score(c.id) DESC, j.id
LIMIT 10
$$);
                                                                                                                                                                                         explain_redact_oid                                                                                                                                                                                         
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: j INNER c
   Join Cond: c.id = j.client_id
   Join Predicate: (j:{"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"zebra","lenient":null,"conjunction_mode":null}}}} OR c:{"with_index":{"query":{"parse_with_field":{"field":"name","query_string":"zebra","lenient":null,"conjunction_mode":null}}}})
   Limit: 10
   Order By: pdb.score(j) + pdb.score(c) desc, j.id asc
   DataFusion Physical Plan: 
     : ┌───── DistributedExec
     : │ ProjectionExec: expr=[id@2 as col_1, id@5 as col_2, pdb.score(j)@0 + pdb.score(c)@3 as col_3, ctid_0@1 as ctid_0, ctid_1@4 as ctid_1]
     : │   SortPreservingMergeExec: [pdb.score(j)@0 + pdb.score(c)@3 DESC, id@2 ASC NULLS LAST], fetch=10
     : │     [Stage 1] => NetworkCoalesceExec: output_partitions=2, input_tasks=2
     : └──────────────────────────────────────────────────
     :   ┌───── Stage 1 ── tasks=2, partitions=2
     :   │ LocalLimitExec: fetch=10
     :   │   VisibilityFilterExec: tables=[j, c]
     :   │     RankJoinExec: mode=Partitioned, on=[(id@2, client_id@2)], order=[pdb.score(j)@0 + pdb.score(c)@3 DESC, id@2 ASC NULLS LAST], projection=[pdb.score(j)@3, ctid_0@4, id@6, pdb.score(c)@0, ctid_1@1, id@2]
     :   │       DistributedLeafExec:
     :   │         t0: PgSearchScan: table=c, segments={partial=1, included=1, pruned=1}, partition=id[-∞..127), lazy_sort=20, dynamic_filters=1, query={"const_score":{"query":{"term_set":{"terms":[{"field":"division","value":1}]}},"score":0.0}}, disjunct={"with_index":{"query":{"parse_with_field":{"field":"name","query_string":"zebra","lenient":null,"conjunction_mode":null}}}}
     :   │         t1: PgSearchScan: table=c, segments={partial=1, included=1, pruned=1}, partition=id[127..∞), lazy_sort=20, dynamic_filters=1, query={"const_score":{"query":{"term_set":{"terms":[{"field":"division","value":1}]}},"score":0.0}}, disjunct={"with_index":{"query":{"parse_with_field":{"field":"name","query_string":"zebra","lenient":null,"conjunction_mode":null}}}}
     :   │       DistributedLeafExec:
     :   │         t0: PgSearchScan: table=j, segments={partial=1, included=1, pruned=1}, partition=client_id[-∞..127), lazy_sort=20, dynamic_filters=1, query={"const_score":{"query":{"term_set":{"terms":[{"field":"division","value":1}]}},"score":0.0}}, disjunct={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"zebra","lenient":null,"conjunction_mode":null}}}}
     :   │         t1: PgSearchScan: table=j, segments={partial=1, included=1, pruned=1}, partition=client_id[127..∞), lazy_sort=20, dynamic_filters=1, query={"const_score":{"query":{"term_set":{"terms":[{"field":"division","value":1}]}},"score":0.0}}, disjunct={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"zebra","lenient":null,"conjunction_mode":null}}}}
     :   └──────────────────────────────────────────────────
(23 rows)

