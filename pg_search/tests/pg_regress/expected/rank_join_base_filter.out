     : ProjectionExec: expr=[id@2 as col_1, id@5 as col_2, pdb.score(j)@0 + pdb.score(c)@3 as col_3, ctid_0@1 as ctid_0, ctid_1@4 as ctid_1]
     :   SortExec: TopK(fetch=10), expr=[pdb.score(j)@0 + pdb.score(c)@3 DESC, id@2 ASC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[j, c]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@2, client_id@2)], filter=__j_0_tag_0@0 OR __c_1_tag_0@1, projection=[pdb.score(j)@4, ctid_0@5, id@7, pdb.score(c)@0, ctid_1@1, id@2]
     :         CooperativeExec
     :           PgSearchScan: table=c, segments=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"name","query_string":"zebra","lenient":null,"conjunction_mode":null}}}}
     :         CooperativeExec
     :           PgSearchScan: table=j, segments=1, dynamic_filters=1, query={"boolean":{"should":[{"with_index":{"query":{"range":{"field":"division","lower_bound":{"included":1},"upper_bound":{"excluded":2}}}}},{"with_index":{"query":{"range":{"field":"division","lower_bound":{"included":2},"upper_bound":{"excluded":3}}}}}]}}, tag_0={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"zebra","lenient":null,"conjunction_mode":null}}}}
(15 rows)

SELECT j.id AS job, c.id AS client, pdb.score(j.id) AS job_score, pdb.score(c.id) AS client_score
FROM rjf_jobs j JOIN rjf_clients c ON c.id = j.client_id
WHERE (j.body @@@ 'zebra' OR c.name @@@ 'zebra')
  AND (j.division @@@ pdb.range(int4range(1, 2)) OR j.division @@@ pdb.range(int4range(2, 3)))
ORDER BY pdb.score(j.id) + pdb.score(c.id) DESC, j.id
LIMIT 10;
