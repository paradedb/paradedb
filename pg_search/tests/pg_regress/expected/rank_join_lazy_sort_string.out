-- Tests string and bytes (`NumericBytes`) columns as the primary ORDER BY key of the lazy-sorted probe
-- `HashJoinExec` rewrite in `RankJoinRule` (https://github.com/paradedb/paradedb/issues/7244).
-- Each query is run with the join custom scan on (lazy-sorted probe) and off (ground truth).
CREATE EXTENSION IF NOT EXISTS pg_search;
SET max_parallel_workers_per_gather = 0;
SET paradedb.enable_custom_scan = on;
SET paradedb.enable_join_custom_scan = on;
SET paradedb.enable_rank_join = on;
SET paradedb.rank_join_min_rows = 0;
DROP TABLE IF EXISTS lss_posts CASCADE;
DROP TABLE IF EXISTS lss_users CASCADE;
CREATE TABLE lss_users (
    id INT PRIMARY KEY,
    bio TEXT NOT NULL
) WITH (autovacuum_enabled = false);
CREATE TABLE lss_posts (
    id INT PRIMARY KEY,
    user_id INT NOT NULL,
    title TEXT COLLATE "C",
    amount NUMERIC(40, 0)
) WITH (autovacuum_enabled = false);
CREATE INDEX lss_users_bm25 ON lss_users USING paradedb (id, bio);
CREATE INDEX lss_posts_bm25 ON lss_posts USING paradedb (
    id, user_id, (title::pdb.unicode_words('columnar=true')), amount
);
-- Two inserts per table produce multiple segments, so per-segment term ordinals differ.
SET paradedb.global_mutable_segment_rows = 0;
INSERT INTO lss_users
SELECT i, CASE WHEN i % 10 = 0 THEN 'rare reviewer' ELSE 'common reader' END
FROM generate_series(1, 50) i;
INSERT INTO lss_users
SELECT i, CASE WHEN i % 10 = 0 THEN 'rare reviewer' ELSE 'common reader' END
FROM generate_series(51, 100) i;
INSERT INTO lss_posts
SELECT i,
       (i % 100) + 1,
       CASE WHEN i % 97 = 0 THEN NULL ELSE md5(i::text) END,
       CASE WHEN i % 19 = 0 THEN NULL ELSE ((i * 7919) % 2001 - 1000) * 10::numeric ^ 25 + i END
FROM generate_series(1, 500) i;
INSERT INTO lss_posts
SELECT i,
       (i % 100) + 1,
       CASE WHEN i % 97 = 0 THEN NULL ELSE md5(i::text) END,
       CASE WHEN i % 19 = 0 THEN NULL ELSE ((i * 7919) % 2001 - 1000) * 10::numeric ^ 25 + i END
FROM generate_series(501, 1000) i;
RESET paradedb.global_mutable_segment_rows;
ANALYZE lss_users, lss_posts;
-- =============================================================================
-- TEST 1: TEXT primary sort key (ASC)
-- =============================================================================
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.id, p.title
FROM lss_posts p
WHERE p.user_id IN (SELECT u.id FROM lss_users u WHERE u.bio ||| 'rare')
ORDER BY p.title ASC, p.id ASC
LIMIT 5;
                                                                                                                   QUERY PLAN                                                                                                                   
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, p.title
   Relation Tree: p SEMI u
   Join Cond: p.user_id = u.id
   Limit: 5
   Order By: p.title asc, p.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, title@1 as col_2, ctid_0@0 as ctid_0]
     :   HashJoinExec: mode=CollectLeft, join_type=RightSemi, on=[(id@0, user_id@1)], projection=[ctid_0@0, title@2, id@3], fetch=5
     :     CooperativeExec
     :       PgSearchScan: table=u, segments=2, visibility=eager, query={"with_index":{"query":{"match":{"field":"bio","value":"rare","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :     VisibilityFilterExec: tables=[p]
     :       CooperativeExec
     :         PgSearchScan: table=p, segments=2, lazy_sort=10, eager=[title], dynamic_filters=1, query="all"
(14 rows)

SELECT p.id, p.title
FROM lss_posts p
WHERE p.user_id IN (SELECT u.id FROM lss_users u WHERE u.bio ||| 'rare')
ORDER BY p.title ASC, p.id ASC
LIMIT 5;
 id  |              title               
-----+----------------------------------
 899 | 01882513d5fa7c329e940dda99b12147
 339 | 04025959b191f8f9de3f924f0940515f
 629 | 051e4e127b92f5d98d3c79b195f2b291
 269 | 06138bc5af6023646ede0e1f7c1eac75
 249 | 077e29b11be80ab57e1a2ecabb7da330
(5 rows)

SET paradedb.enable_join_custom_scan = off;
SELECT p.id, p.title
FROM lss_posts p
WHERE p.user_id IN (SELECT u.id FROM lss_users u WHERE u.bio ||| 'rare')
ORDER BY p.title ASC, p.id ASC
LIMIT 5;
 id  |              title               
-----+----------------------------------
 899 | 01882513d5fa7c329e940dda99b12147
 339 | 04025959b191f8f9de3f924f0940515f
 629 | 051e4e127b92f5d98d3c79b195f2b291
 269 | 06138bc5af6023646ede0e1f7c1eac75
 249 | 077e29b11be80ab57e1a2ecabb7da330
(5 rows)

RESET paradedb.enable_join_custom_scan;
-- =============================================================================
-- TEST 2: TEXT primary sort key (DESC, NULLs first)
-- =============================================================================
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.id, p.title
FROM lss_posts p
WHERE p.user_id IN (SELECT u.id FROM lss_users u WHERE u.bio ||| 'rare')
ORDER BY p.title DESC, p.id ASC
LIMIT 5;
                                                                                                                   QUERY PLAN                                                                                                                   
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, p.title
   Relation Tree: p SEMI u
   Join Cond: p.user_id = u.id
   Limit: 5
   Order By: p.title desc, p.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, title@1 as col_2, ctid_0@0 as ctid_0]
     :   HashJoinExec: mode=CollectLeft, join_type=RightSemi, on=[(id@0, user_id@1)], projection=[ctid_0@0, title@2, id@3], fetch=5
     :     CooperativeExec
     :       PgSearchScan: table=u, segments=2, visibility=eager, query={"with_index":{"query":{"match":{"field":"bio","value":"rare","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :     VisibilityFilterExec: tables=[p]
     :       CooperativeExec
     :         PgSearchScan: table=p, segments=2, lazy_sort=10, eager=[title], dynamic_filters=1, query="all"
(14 rows)

SELECT p.id, p.title
FROM lss_posts p
WHERE p.user_id IN (SELECT u.id FROM lss_users u WHERE u.bio ||| 'rare')
ORDER BY p.title DESC, p.id ASC
LIMIT 5;
