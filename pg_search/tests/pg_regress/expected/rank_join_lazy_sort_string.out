-- =============================================================================
-- TEST 3: Bytes primary sort key (`NUMERIC` wider than 18 digits is stored as `NumericBytes`)
-- =============================================================================
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT p.id, p.amount
FROM lss_posts p
WHERE p.user_id IN (SELECT u.id FROM lss_users u WHERE u.bio ||| 'rare')
ORDER BY p.amount ASC, p.id ASC
LIMIT 5;
                                                                                                                   QUERY PLAN                                                                                                                   
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, p.amount
   Relation Tree: p SEMI u
   Join Cond: p.user_id = u.id
   Limit: 5
   Order By: p.amount asc, p.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, amount@1 as col_2, ctid_0@0 as ctid_0]
     :   HashJoinExec: mode=CollectLeft, join_type=RightSemi, on=[(id@0, user_id@1)], projection=[ctid_0@0, amount@2, id@3], fetch=5
     :     CooperativeExec
     :       PgSearchScan: table=u, segments=2, visibility=eager, query={"with_index":{"query":{"match":{"field":"bio","value":"rare","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :     VisibilityFilterExec: tables=[p]
     :       CooperativeExec
     :         PgSearchScan: table=p, segments=2, lazy_sort=10, eager=[amount], dynamic_filters=1, query="all"
(14 rows)

SELECT p.id, p.amount
FROM lss_posts p
WHERE p.user_id IN (SELECT u.id FROM lss_users u WHERE u.bio ||| 'rare')
ORDER BY p.amount ASC, p.id ASC
LIMIT 5;
 id  |            amount             
-----+-------------------------------
 659 | -9869999999999999999999999341
 329 | -9509999999999999999999999671
 729 | -9339999999999999999999999271
 799 | -8809999999999999999999999201
  69 | -8619999999999999999999999931
(5 rows)

SET paradedb.enable_join_custom_scan = off;
SELECT p.id, p.amount
FROM lss_posts p
WHERE p.user_id IN (SELECT u.id FROM lss_users u WHERE u.bio ||| 'rare')
ORDER BY p.amount ASC, p.id ASC
LIMIT 5;
 id  |            amount             
-----+-------------------------------
 659 | -9869999999999999999999999341
 329 | -9509999999999999999999999671
 729 | -9339999999999999999999999271
 799 | -8809999999999999999999999201
  69 | -8619999999999999999999999931
