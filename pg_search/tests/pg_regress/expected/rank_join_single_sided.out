-- ============================================================
-- Test 3: 3-table join ordered by 3rd table (c.upvotes DESC NULLS FIRST)
-- Shape: Outer RankJoinExec(Inner RankJoinExec(u [RA], p [RA]) [cascading RA], c [SA])
-- ============================================================
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT u.id AS u_id, p.id AS p_id, c.id AS c_id, c.upvotes
FROM rj_users u
JOIN rj_posts p ON u.id = p.user_id
JOIN rj_comments c ON p.id = c.post_id
WHERE u.bio @@@ 'rust' AND p.title @@@ 'bm25' AND c.body @@@ 'helpful'
ORDER BY c.upvotes DESC NULLS FIRST, u.id ASC, p.id ASC, c.id ASC
LIMIT 5;
                                                                                                         QUERY PLAN                                                                                                          
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: (u INNER p) INNER c
   Join Cond: p.id = c.post_id, u.id = p.user_id
   Limit: 5
   Order By: c.upvotes desc, u.id asc, p.id asc, c.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@1 as col_1, id@3 as col_2, id@6 as col_3, upvotes@5 as col_4, ctid_0@0 as ctid_0, ctid_1@2 as ctid_1, ctid_2@4 as ctid_2]
     :   GlobalLimitExec: skip=0, fetch=5
     :     VisibilityFilterExec: tables=[u, p, c]
     :       ProjectionExec: expr=[ctid_0@0 as ctid_0, id@1 as id, ctid_1@2 as ctid_1, id@3 as id, ctid_2@4 as ctid_2, upvotes@6 as upvotes, id@7 as id]
     :         RankJoinExec: mode=CollectLeft, on=[(id@3, post_id@1)], order=[upvotes@6 DESC, id@1 ASC NULLS LAST, id@3 ASC NULLS LAST, id@7 ASC NULLS LAST]
     :           ProjectionExec: expr=[ctid_0@0 as ctid_0, id@1 as id, ctid_1@2 as ctid_1, id@3 as id]
     :             RankJoinExec: mode=CollectLeft, on=[(id@1, user_id@2)], order=[0 DESC NULLS LAST]
     :               CooperativeExec
     :                 PgSearchScan: table=u, segments=2, lazy_sort=0, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"rust","lenient":null,"conjunction_mode":null}}}}
     :               CooperativeExec
     :                 PgSearchScan: table=p, segments=2, lazy_sort=0, dynamic_filters=2, query={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"bm25","lenient":null,"conjunction_mode":null}}}}
     :           CooperativeExec
     :             PgSearchScan: table=c, segments=2, lazy_sort=30, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"helpful","lenient":null,"conjunction_mode":null}}}}
(19 rows)

