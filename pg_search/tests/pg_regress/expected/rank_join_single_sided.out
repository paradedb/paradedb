-- ============================================================
-- Test 4: With MPP enabled, verify that disabling RankJoin uses MPP (DistributedExec),
-- whereas enabling RankJoin requires a single df-d task (Maximum(1)), preventing MPP
-- distribution so in-memory dynamic filters work.
-- ============================================================
SET paradedb.mpp_min_rows = 0;
SET max_parallel_workers_per_gather = 3;
SET max_parallel_workers = 8;
SET min_parallel_table_scan_size = 0;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
-- Baseline with RankJoin disabled: plans DistributedExec across the 2 segments
SET paradedb.enable_rank_join = off;
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT u.id AS u_id, p.id AS p_id, c.id AS c_id, u.reputation
FROM rj_users u
JOIN rj_posts p ON u.id = p.user_id
JOIN rj_comments c ON p.id = c.post_id
WHERE u.bio @@@ 'rust' AND p.title @@@ 'bm25' AND c.body @@@ 'helpful'
ORDER BY u.reputation DESC NULLS LAST, u.id ASC, p.id ASC, c.id ASC
LIMIT 5;
                                                                                                    QUERY PLAN                                                                                                    
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: (u INNER p) INNER c
   Join Cond: p.id = c.post_id, u.id = p.user_id
   Limit: 5
   Order By: u.reputation desc nulls last, u.id asc, p.id asc, c.id asc
   DataFusion Physical Plan: 
     : ┌───── DistributedExec
     : │ ProjectionExec: expr=[id@1 as col_1, id@4 as col_2, id@6 as col_3, reputation@2 as col_4, ctid_0@0 as ctid_0, ctid_1@3 as ctid_1, ctid_2@5 as ctid_2]
     : │   SortPreservingMergeExec: [reputation@2 DESC NULLS LAST, id@1 ASC NULLS LAST, id@4 ASC NULLS LAST, id@6 ASC NULLS LAST], fetch=5
     : │     [Stage 3] => NetworkCoalesceExec: output_partitions=2, input_tasks=2
     : └──────────────────────────────────────────────────
     :   ┌───── Stage 3 ── tasks=2, partitions=2
     :   │ SortExec: TopK(fetch=5), expr=[reputation@2 DESC NULLS LAST, id@1 ASC NULLS LAST, id@4 ASC NULLS LAST, id@6 ASC NULLS LAST], preserve_partitioning=[true]
     :   │   VisibilityFilterExec: tables=[u, p, c]
     :   │     HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@4, post_id@1)], projection=[ctid_0@0, id@1, reputation@2, ctid_1@3, id@4, ctid_2@5, id@7]
     :   │       CoalescePartitionsExec
     :   │         [Stage 2] => NetworkBroadcastExec: partitions_per_consumer=1, stage_partitions=2, input_tasks=2
     :   │       DistributedLeafExec:
     :   │         t0: PgSearchScan: table=c, segments=2, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"helpful","lenient":null,"conjunction_mode":null}}}}
     :   │         t1: PgSearchScan: table=c, segments=2, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"helpful","lenient":null,"conjunction_mode":null}}}}
     :   └──────────────────────────────────────────────────
     :     ┌───── Stage 2 ── tasks=2, partitions=4
     :     │ BroadcastExec: input_partitions=1, consumer_tasks=2, output_partitions=2
     :     │   HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, user_id@2)], projection=[ctid_0@0, id@1, reputation@2, ctid_1@3, id@4]
     :     │     CoalescePartitionsExec
     :     │       [Stage 1] => NetworkBroadcastExec: partitions_per_consumer=1, stage_partitions=2, input_tasks=2
     :     │     DistributedLeafExec:
     :     │       t0: PgSearchScan: table=p, segments=2, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"bm25","lenient":null,"conjunction_mode":null}}}}
     :     │       t1: PgSearchScan: table=p, segments=2, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"bm25","lenient":null,"conjunction_mode":null}}}}
     :     └──────────────────────────────────────────────────
     :       ┌───── Stage 1 ── tasks=2, partitions=4
     :       │ BroadcastExec: input_partitions=1, consumer_tasks=2, output_partitions=2
     :       │   DistributedLeafExec:
     :       │     t0: PgSearchScan: table=u, segments=2, query={"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"rust","lenient":null,"conjunction_mode":null}}}}
     :       │     t1: PgSearchScan: table=u, segments=2, query={"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"rust","lenient":null,"conjunction_mode":null}}}}
     :       └──────────────────────────────────────────────────
(36 rows)

