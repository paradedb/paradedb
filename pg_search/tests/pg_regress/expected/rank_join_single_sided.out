-- ============================================================
-- Test 6: RankJoinRule expression shapes and eligibility gates
-- ============================================================
SET paradedb.enable_rank_join = on;
SET paradedb.rank_join_min_rows = 0;
-- 6a: Weighted additive score expression -> plans RankJoinExec
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT u.id AS u_id, p.id AS p_id
FROM rj_users u
JOIN rj_posts p ON u.id = p.user_id
WHERE u.bio @@@ 'rust' AND p.title @@@ 'bm25'
ORDER BY 2.0 * paradedb.score(u.id) + 3.0 * paradedb.score(p.id) DESC
LIMIT 5;
                                                                                                        QUERY PLAN                                                                                                        
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: u INNER p
   Join Cond: u.id = p.user_id
   Limit: 5
   Order By: 2 * pdb.score(u) + 3 * pdb.score(p) desc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, NULL as col_2, 2 * CAST(pdb.score(u)@0 AS Float64) + 3 * CAST(pdb.score(p)@3 AS Float64) as col_3, ctid_0@1 as ctid_0, ctid_1@4 as ctid_1]
     :   GlobalLimitExec: skip=0, fetch=5
     :     VisibilityFilterExec: tables=[u, p]
     :       ProjectionExec: expr=[pdb.score(u)@0 as pdb.score(u), ctid_0@1 as ctid_0, id@2 as id, pdb.score(p)@3 as pdb.score(p), ctid_1@4 as ctid_1]
     :         RankJoinExec: mode=CollectLeft, on=[(id@2, user_id@2)], order=[2 * pdb.score(u)@0 + 3 * pdb.score(p)@3 DESC]
     :           CooperativeExec
     :             PgSearchScan: table=u, segments=2, lazy_sort=10, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"rust","lenient":null,"conjunction_mode":null}}}}
     :           CooperativeExec
     :             PgSearchScan: table=p, segments=2, lazy_sort=10, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"bm25","lenient":null,"conjunction_mode":null}}}}
(15 rows)

-- 6b: Multiplicative score expression -> plans RankJoinExec
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT u.id AS u_id, p.id AS p_id
FROM rj_users u
JOIN rj_posts p ON u.id = p.user_id
WHERE u.bio @@@ 'rust' AND p.title @@@ 'bm25'
ORDER BY paradedb.score(u.id) * paradedb.score(p.id) DESC
LIMIT 5;
                                                                                                        QUERY PLAN                                                                                                        
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: u INNER p
   Join Cond: u.id = p.user_id
   Limit: 5
   Order By: pdb.score(u) * pdb.score(p) desc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, NULL as col_2, pdb.score(u)@0 * pdb.score(p)@3 as col_3, ctid_0@1 as ctid_0, ctid_1@4 as ctid_1]
     :   GlobalLimitExec: skip=0, fetch=5
     :     VisibilityFilterExec: tables=[u, p]
     :       ProjectionExec: expr=[pdb.score(u)@0 as pdb.score(u), ctid_0@1 as ctid_0, id@2 as id, pdb.score(p)@3 as pdb.score(p), ctid_1@4 as ctid_1]
     :         RankJoinExec: mode=CollectLeft, on=[(id@2, user_id@2)], order=[pdb.score(u)@0 * pdb.score(p)@3 DESC]
     :           CooperativeExec
     :             PgSearchScan: table=u, segments=2, lazy_sort=10, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"rust","lenient":null,"conjunction_mode":null}}}}
     :           CooperativeExec
     :             PgSearchScan: table=p, segments=2, lazy_sort=10, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"bm25","lenient":null,"conjunction_mode":null}}}}
(15 rows)

-- 6c: Gate 1 rejection (constant-score pdb.all() leg in two-sided score sum) -> HashJoinExec
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT u.id AS u_id, p.id AS p_id
FROM rj_users u
JOIN rj_posts p ON u.id = p.user_id
WHERE u.id @@@ pdb.all() AND p.title @@@ 'bm25'
ORDER BY paradedb.score(u.id) + paradedb.score(p.id) DESC
LIMIT 5;
                                                                                                QUERY PLAN                                                                                                
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: u INNER p
   Join Cond: u.id = p.user_id
   Limit: 5
   Order By: pdb.score(u) + pdb.score(p) desc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, NULL as col_2, pdb.score(u)@0 + pdb.score(p)@3 as col_3, ctid_0@1 as ctid_0, ctid_1@4 as ctid_1]
     :   SortExec: TopK(fetch=5), expr=[pdb.score(u)@0 + pdb.score(p)@3 DESC], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[u, p]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@2, user_id@2)], projection=[pdb.score(u)@0, ctid_0@1, id@2, pdb.score(p)@3, ctid_1@4]
     :         CooperativeExec
     :           PgSearchScan: table=u, segments=2, query={"with_index":{"query":{"all":{"field":"id"}}}}
     :         CooperativeExec
     :           PgSearchScan: table=p, segments=2, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"bm25","lenient":null,"conjunction_mode":null}}}}
(14 rows)

-- 6d: Gate 2 rejection (100x boost imbalance between scored legs) -> HashJoinExec
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT u.id AS u_id, p.id AS p_id
FROM rj_users u
JOIN rj_posts p ON u.id = p.user_id
WHERE u.bio @@@ 'rust'::pdb.boost(100) AND p.title @@@ 'bm25'
ORDER BY paradedb.score(u.id) + paradedb.score(p.id) DESC
LIMIT 5;
                                                                                                                QUERY PLAN                                                                                                                
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: u INNER p
   Join Cond: u.id = p.user_id
   Limit: 5
   Order By: pdb.score(u) + pdb.score(p) desc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, NULL as col_2, pdb.score(u)@0 + pdb.score(p)@3 as col_3, ctid_0@1 as ctid_0, ctid_1@4 as ctid_1]
     :   SortExec: TopK(fetch=5), expr=[pdb.score(u)@0 + pdb.score(p)@3 DESC], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[u, p]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@2, user_id@2)], projection=[pdb.score(u)@0, ctid_0@1, id@2, pdb.score(p)@3, ctid_1@4]
     :         CooperativeExec
     :           PgSearchScan: table=u, segments=2, query={"with_index":{"query":{"score_adjusted":{"field":"bio","query":{"parse_with_field":{"query_string":"rust","lenient":null,"conjunction_mode":null}},"score":{"Boost":100.0}}}}}
     :         CooperativeExec
     :           PgSearchScan: table=p, segments=2, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"bm25","lenient":null,"conjunction_mode":null}}}}
(14 rows)

-- 6e: Single-sided score sort over cross-table OR -> rejected (HashJoinExec)
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT u.id AS u_id, p.id AS p_id
FROM rj_users u
JOIN rj_posts p ON u.id = p.user_id
WHERE u.bio @@@ 'rust' OR p.title @@@ 'bm25'
ORDER BY paradedb.score(u.id) DESC
LIMIT 5;
                                                                                                                                     QUERY PLAN                                                                                                                                     
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: u INNER p
   Join Cond: u.id = p.user_id
   Join Predicate: (u:{"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"rust","lenient":null,"conjunction_mode":null}}}} OR p:{"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"bm25","lenient":null,"conjunction_mode":null}}}})
   Limit: 5
   Order By: pdb.score(u) desc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, NULL as col_2, pdb.score(u)@0 as col_3, ctid_0@1 as ctid_0, ctid_1@3 as ctid_1]
     :   SortExec: TopK(fetch=5), expr=[pdb.score(u)@0 DESC], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[u, p]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@2, user_id@1)], filter=__u_0_tag_0@0 OR __p_1_tag_0@1, projection=[pdb.score(u)@0, ctid_0@1, id@2, ctid_1@4]
     :         CooperativeExec
     :           PgSearchScan: table=u, segments=2, dynamic_filters=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"rust","lenient":null,"conjunction_mode":null}}}}
     :         CooperativeExec
     :           PgSearchScan: table=p, segments=2, dynamic_filters=1, tag_0={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"bm25","lenient":null,"conjunction_mode":null}}}}
(15 rows)

-- 6f: Gate 3 unscored RA selectivity (< 0.08 rejected vs >= 0.08 accepted when rank_join_min_rows > 0)
SET paradedb.rank_join_min_rows = 1;
-- Selective RA side (u.id = 2 matches 1/50 = 0.02 < 0.08) -> rejected (HashJoinExec)
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT u.id AS u_id, p.id AS p_id
FROM rj_users u
JOIN rj_posts p ON u.id = p.user_id
WHERE u.id = 2 AND p.title @@@ 'bm25'
ORDER BY p.views DESC NULLS LAST
LIMIT 5;
                                                                                                                               QUERY PLAN                                                                                                                               
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: u INNER p
   Join Cond: u.id = p.user_id
   Limit: 5
   Order By: p.views desc nulls last
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@1 as col_1, NULL as col_2, views@3 as col_3, ctid_0@0 as ctid_0, ctid_1@2 as ctid_1]
     :   SortExec: TopK(fetch=5), expr=[views@3 DESC NULLS LAST], preserve_partitioning=[false]
     :     VisibilityFilterExec: tables=[u, p]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(user_id@1, id@1)], projection=[ctid_0@3, id@4, ctid_1@0, views@2]
     :         CooperativeExec
     :           PgSearchScan: table=p, segments=2, dynamic_filters=1, query={"boolean":{"must":[{"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"bm25","lenient":null,"conjunction_mode":null}}}},{"term":{"field":"user_id","value":2}}]}}
     :         CooperativeExec
     :           PgSearchScan: table=u, segments={included=1, pruned=1}, dynamic_filters=1, query={"term":{"field":"id","value":2}}
(14 rows)

-- Non-selective RA side (u.bio @@@ 'rust' matches 25/50 = 0.50 >= 0.08) -> RankJoinExec
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT u.id AS u_id, p.id AS p_id
FROM rj_users u
JOIN rj_posts p ON u.id = p.user_id
WHERE u.bio @@@ 'rust' AND p.title @@@ 'bm25'
ORDER BY p.views DESC NULLS LAST
LIMIT 5;
                                                                                                      QUERY PLAN                                                                                                       
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: u INNER p
   Join Cond: u.id = p.user_id
   Limit: 5
   Order By: p.views desc nulls last
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@1 as col_1, NULL as col_2, views@3 as col_3, ctid_0@0 as ctid_0, ctid_1@2 as ctid_1]
     :   GlobalLimitExec: skip=0, fetch=5
     :     VisibilityFilterExec: tables=[u, p]
     :       ProjectionExec: expr=[ctid_0@0 as ctid_0, id@1 as id, ctid_1@2 as ctid_1, views@4 as views]
     :         RankJoinExec: mode=CollectLeft, on=[(id@1, user_id@1)], order=[views@4 DESC NULLS LAST]
     :           CooperativeExec
     :             PgSearchScan: table=u, segments=2, lazy_sort=0, dynamic_filters=1, query={"with_index":{"query":{"parse_with_field":{"field":"bio","query_string":"rust","lenient":null,"conjunction_mode":null}}}}
     :           CooperativeExec
     :             PgSearchScan: table=p, segments=2, lazy_sort=20, query={"with_index":{"query":{"parse_with_field":{"field":"title","query_string":"bm25","lenient":null,"conjunction_mode":null}}}}
(15 rows)

