BEGIN;
SET LOCAL ROLE authenticated;
EXPLAIN (COSTS OFF, TIMING OFF)
SELECT id FROM leaky_rls_indexed WHERE body @@@ 'sheriff' AND secret::int > 0 ORDER BY id LIMIT 5;
