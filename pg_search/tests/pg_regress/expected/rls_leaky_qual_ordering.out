         Exec Method: NormalScanExecState
         Scores: false
         Tantivy Query: {"boolean":{"must":[{"heap_filter":{"indexed_query":{"boolean":{"must":[{"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"sheriff","lenient":null,"conjunction_mode":null}}}},{"term":{"field":"org_id","value":1}}]}},"always_filters":[{"heap_filter":"((secret)::integer > 0)"}]}}]}}
(7 rows)

SELECT count(*) FROM leaky_rls_agg WHERE body @@@ 'sheriff' AND secret::int > 0;
