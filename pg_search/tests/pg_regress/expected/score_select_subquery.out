-- Regression test for https://github.com/paradedb/paradedb/issues/4596
-- pdb.score() and pdb.snippet() with a SELECT subquery in WHERE clause
-- should use ParadeDB Base Scan, not Index Scan
CREATE EXTENSION IF NOT EXISTS pg_search;
DROP TABLE IF EXISTS animals CASCADE;
CREATE TABLE animals (
    id SERIAL PRIMARY KEY,
    description TEXT
);
INSERT INTO animals (description) VALUES
('description 1 dog'),
('description 2 cat'),
('description 3 dog'),
('description 4 parrot');
CREATE INDEX animals_idx ON animals
USING paradedb (id, description);
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan = OFF;
-- Test 1: pdb.score() with (SELECT true) should use ParadeDB Base Scan
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT id, pdb.score(id) AS score
FROM animals
WHERE description ||| 'dog' AND (SELECT true)
LIMIT 1;
                                                                                                 QUERY PLAN                                                                                                  
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   InitPlan 1
     ->  Result
   ->  Result
         One-Time Filter: (InitPlan 1).col1
         ->  Custom Scan (ParadeDB Base Scan) on animals
               Filter: (InitPlan 1).col1
               Table: animals
               Index: animals_idx
               Exec Method: TopKScanExecState
               Scores: true
                  TopK Limit: 1
               Tantivy Query: {"with_index":{"query":{"match":{"field":"description","value":"dog","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(13 rows)

SELECT id, pdb.score(id) AS score
FROM animals
WHERE description ||| 'dog' AND (SELECT true)
ORDER BY score DESC
LIMIT 1;
 id |   score   
----+-----------
  1 | 0.6931472
(1 row)

-- Test 2: pdb.snippet() with (SELECT true) should use ParadeDB Base Scan
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT id, pdb.snippet(description) AS snippet
FROM animals
WHERE description ||| 'dog' AND (SELECT true)
LIMIT 1;
                                                                                                 QUERY PLAN                                                                                                  
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   InitPlan 1
     ->  Result
   ->  Result
         One-Time Filter: (InitPlan 1).col1
         ->  Custom Scan (ParadeDB Base Scan) on animals
               Filter: (InitPlan 1).col1
               Table: animals
               Index: animals_idx
               Exec Method: TopKScanExecState
               Scores: false
                  TopK Limit: 1
               Tantivy Query: {"with_index":{"query":{"match":{"field":"description","value":"dog","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(13 rows)

SELECT id, pdb.snippet(description) AS snippet
FROM animals
WHERE description ||| 'dog' AND (SELECT true)
ORDER BY id
LIMIT 1;
 id |         snippet          
----+--------------------------
  1 | description 1 <b>dog</b>
(1 row)

-- Test 3: (SELECT false) should return no rows
SELECT id, pdb.score(id) AS score
FROM animals
WHERE description ||| 'dog' AND (SELECT false)
ORDER BY score DESC
LIMIT 1;
 id | score 
----+-------
(0 rows)

-- Test 4: pdb.score() with a function subquery (RLS policy pattern)
CREATE FUNCTION has_access() RETURNS boolean LANGUAGE sql STABLE AS $$ SELECT true $$;
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT id, pdb.score(id) AS score
FROM animals
WHERE description ||| 'dog' AND (SELECT has_access())
LIMIT 1;
                                                                                                 QUERY PLAN                                                                                                  
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   InitPlan 1
     ->  Result
   ->  Result
         One-Time Filter: (InitPlan 1).col1
         ->  Custom Scan (ParadeDB Base Scan) on animals
               Filter: (InitPlan 1).col1
               Table: animals
               Index: animals_idx
               Exec Method: TopKScanExecState
               Scores: true
                  TopK Limit: 1
               Tantivy Query: {"with_index":{"query":{"match":{"field":"description","value":"dog","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(13 rows)

SELECT id, pdb.score(id) AS score
FROM animals
WHERE description ||| 'dog' AND (SELECT has_access())
ORDER BY score DESC
LIMIT 1;
 id |   score   
----+-----------
  1 | 0.6931472
(1 row)

DROP FUNCTION has_access();
-- Test 5: pdb.score() with a table lookup subquery
CREATE TABLE config (name TEXT, value BOOLEAN);
INSERT INTO config VALUES ('enabled', true);
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT id, pdb.score(id) AS score
FROM animals
WHERE description ||| 'dog' AND (SELECT value FROM config WHERE name = 'enabled' LIMIT 1)
LIMIT 1;
                                                                                                 QUERY PLAN                                                                                                  
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   InitPlan 1
     ->  Limit
           ->  Seq Scan on config
                 Filter: (name = 'enabled'::text)
   ->  Result
         One-Time Filter: (InitPlan 1).col1
         ->  Custom Scan (ParadeDB Base Scan) on animals
               Filter: (InitPlan 1).col1
               Table: animals
               Index: animals_idx
               Exec Method: TopKScanExecState
               Scores: true
                  TopK Limit: 1
               Tantivy Query: {"with_index":{"query":{"match":{"field":"description","value":"dog","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(15 rows)

SELECT id, pdb.score(id) AS score
FROM animals
WHERE description ||| 'dog' AND (SELECT value FROM config WHERE name = 'enabled' LIMIT 1)
ORDER BY score DESC
LIMIT 1;
 id |   score   
----+-----------
  1 | 0.6931472
(1 row)

DROP TABLE config;
-- =============================================================================
-- Test 6: JoinScan with pdb.score() combined with an InitPlan (`PARAM_EXEC`) or
-- prepared parameter (`PARAM_EXTERN`) in the SELECT target list.
--
-- Bug (backend SIGSEGV crash in `PgExprUdf`):
-- 1. In `6a` below, PostgreSQL plans the scalar subquery
--    `(SELECT 1.0::real WHERE current_setting('server_version_num') <> '')`
--    as an `InitPlan` (`T_SubPlan`) and replaces it in the outer target list
--    with a `T_Param` node (`paramkind = PARAM_EXEC`, `paramid = 0`).
-- 2. In `JoinScan`, `resolve_target_entry_expr` (`customscan/joinscan/planning.rs`)
--    accepts `pdb.score(a.id) - $0` as `ResolvedExpr::Expression` to be evaluated
--    inside DataFusion (`can_pg_project` also rejects host-side projection for
--    any expression that references `pdb.score`).
-- 3. During DataFusion plan construction, `PredicateTranslator::translate`
--    (`customscan/datafusion/translator.rs`) translates `pdb.score(a.id)` natively,
--    but has no arm for `pg_sys::NodeTag::T_Param`, so the `T_Param` child falls
--    through `_ => None` into `try_wrap_as_udf` (`customscan/datafusion/expr_translators.rs`).
-- 4. `try_wrap_as_udf` does not check for `T_Param` (or `T_SubPlan`), so it wraps
--    the bare `T_Param` (which has 0 `input_vars`) into a nullary `PgExprUdf` with
--    `Volatility::Immutable`.
-- 5. Because the `PgExprUdf` is nullary and marked `Immutable`, DataFusion's
--    `SimplifyExpressions` constant-folder invokes `PgExprUdf::invoke_with_args`
--    during plan optimization (even on plain `EXPLAIN`, before execution starts).
--    `PgExprUdf::get_or_init_state` (`customscan/pg_expr_udf.rs`) creates a
--    standalone `EState` via `pg_sys::CreateExecutorState()` whose
--    `es_param_exec_vals` / `ecxt_param_exec_info` and `ecxt_param_list_info` are
--    `NULL`. When `ExecEvalExpr` executes `ExecEvalParamExec` (or
--    `ExecEvalParamExtern` in `6b`), it dereferences a `NULL` pointer and terminates
--    the backend with signal 11 (`SIGSEGV`).
--
-- Note: The same crash affects any `T_Param` (`PARAM_EXEC` or `PARAM_EXTERN`) or
-- `T_SubPlan` that reaches `try_wrap_as_udf` in a `SELECT` expression or join filter.
-- =============================================================================
CREATE TABLE shelters (
    id INT PRIMARY KEY,
    animal_id INT,
    name TEXT
);
INSERT INTO shelters (id, animal_id, name) VALUES
(10, 1, 'downtown dog rescue'),
(20, 2, 'uptown cat haven'),
(30, 3, 'westside dog shelter'),
(40, 4, 'avian sanctuary');
CREATE INDEX shelters_idx ON shelters
USING paradedb (id, animal_id, name);
SET paradedb.enable_join_custom_scan = on;
SET paradedb.rank_join_min_rows = 0;
-- 6a: InitPlan (`PARAM_EXEC`) combined with `pdb.score()` in the SELECT list of a JoinScan
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT a.id,
       pdb.score(a.id) - (SELECT 1.0::real WHERE current_setting('server_version_num') <> '') AS score
FROM animals a
JOIN shelters s ON s.animal_id = a.id
WHERE a.description ||| 'dog' OR s.name ||| 'cat'
ORDER BY pdb.score(a.id) + pdb.score(s.id) DESC, a.id
LIMIT 5;
                                                                                                                                                                                    QUERY PLAN                                                                                                                                                                                     
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: a INNER s
   Join Cond: s.animal_id = a.id
   Join Predicate: (a:{"with_index":{"query":{"match":{"field":"description","value":"dog","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}} OR s:{"with_index":{"query":{"match":{"field":"name","value":"cat","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}})
   Limit: 5
   Order By: pdb.score(a) + pdb.score(s) desc, s.animal_id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, NULL as col_2, pdb.score(a)@0 + pdb.score(s)@3 as col_3, pdb.score(a)@0 as col_4, ctid_0@1 as ctid_0]
     :   GlobalLimitExec: skip=0, fetch=5
     :     VisibilityFilterExec: tables=[a, s], pruned=[s]
     :       RankJoinExec: mode=CollectLeft, on=[(id@2, animal_id@1)], order=[pdb.score(a)@0 + pdb.score(s)@3 DESC, animal_id@4 ASC NULLS LAST]
     :         CooperativeExec
     :           PgSearchScan: table=a, segments=1, lazy_sort=10, dynamic_filters=1, disjunct={"with_index":{"query":{"match":{"field":"description","value":"dog","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :         CooperativeExec
     :           PgSearchScan: table=s, segments=1, lazy_sort=10, dynamic_filters=1, disjunct={"with_index":{"query":{"match":{"field":"name","value":"cat","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
   InitPlan 1
     ->  Result
           One-Time Filter: (current_setting('server_version_num'::text) <> ''::text)
(18 rows)

SELECT a.id,
       pdb.score(a.id) - (SELECT 1.0::real WHERE current_setting('server_version_num') <> '') AS score
FROM animals a
JOIN shelters s ON s.animal_id = a.id
WHERE a.description ||| 'dog' OR s.name ||| 'cat'
ORDER BY pdb.score(a.id) + pdb.score(s.id) DESC, a.id
LIMIT 5;
 id |    score    
----+-------------
  2 |          -1
  1 | -0.30685282
  3 | -0.30685282
(3 rows)

-- 6b: Generic prepared-statement parameter (`PARAM_EXTERN`) combined with `pdb.score()`
-- in the SELECT list of a JoinScan
SET plan_cache_mode = force_generic_plan;
PREPARE join_score_param(real) AS
SELECT a.id,
       pdb.score(a.id) - $1 AS score
FROM animals a
JOIN shelters s ON s.animal_id = a.id
WHERE a.description ||| 'dog' OR s.name ||| 'cat'
ORDER BY pdb.score(a.id) + pdb.score(s.id) DESC, a.id
LIMIT 5;
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
EXECUTE join_score_param(1.0);
                                                                                                                                                                                    QUERY PLAN                                                                                                                                                                                     
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: a INNER s
   Join Cond: s.animal_id = a.id
   Join Predicate: (a:{"with_index":{"query":{"match":{"field":"description","value":"dog","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}} OR s:{"with_index":{"query":{"match":{"field":"name","value":"cat","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}})
   Limit: 5
   Order By: pdb.score(a) + pdb.score(s) desc, s.animal_id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@2 as col_1, NULL as col_2, pdb.score(a)@0 + pdb.score(s)@3 as col_3, pdb.score(a)@0 as col_4, ctid_0@1 as ctid_0]
     :   GlobalLimitExec: skip=0, fetch=5
     :     VisibilityFilterExec: tables=[a, s], pruned=[s]
     :       RankJoinExec: mode=CollectLeft, on=[(id@2, animal_id@1)], order=[pdb.score(a)@0 + pdb.score(s)@3 DESC, animal_id@4 ASC NULLS LAST]
     :         CooperativeExec
     :           PgSearchScan: table=a, segments=1, lazy_sort=10, dynamic_filters=1, disjunct={"with_index":{"query":{"match":{"field":"description","value":"dog","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :         CooperativeExec
     :           PgSearchScan: table=s, segments=1, lazy_sort=10, dynamic_filters=1, disjunct={"with_index":{"query":{"match":{"field":"name","value":"cat","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(15 rows)

EXECUTE join_score_param(1.0);
 id |    score    
----+-------------
  2 |          -1
  1 | -0.30685282
  3 | -0.30685282
(3 rows)

DEALLOCATE join_score_param;
RESET plan_cache_mode;
RESET paradedb.rank_join_min_rows;
RESET paradedb.enable_join_custom_scan;
RESET max_parallel_workers_per_gather;
RESET enable_indexscan;
DROP TABLE IF EXISTS shelters CASCADE;
DROP TABLE IF EXISTS animals CASCADE;
