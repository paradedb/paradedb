   Segment Count: 4
   Segments Pruned: 4
   Heap Fetches: 0
   Exec Method: ColumnarExecState
   Columnar: id
   Scores: false
   Tantivy Query: {"boolean":{"must":[{"with_index":{"query":{"all":{"field":"id"}}}},{"postgres_expression":{"expr":{"expr_desc":"paradedb.term_with_operator('price'::paradedb.fieldname, '='::text, $1)"}}}]}}
(10 rows)

