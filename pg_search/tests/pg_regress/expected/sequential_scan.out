-- Membership correctness across the spilled, on-disk sorted set (probes low/mid/high keys).
SELECT explain_seqscan($$SELECT id FROM sequential_scan WHERE body ||| 'keyword' AND id IN (1, 10000, 20000) ORDER BY id$$);
                                                                                                                                                                                                  explain_seqscan                                                                                                                                                                                                  
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: id
   ->  Bitmap Heap Scan on sequential_scan
         Recheck Cond: (id = ANY ('{1,10000,20000}'::integer[]))
         Filter: paradedb.search_with_query_input_ctid_or_row(anchor, '{"with_index":{"oid":N,"query":{"match":{"field":"body","value":"keyword","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}'::paradedb.searchqueryinput, ctid, CASE WHEN (paradedb.ctid_is_valid(ctid) AND keep) THEN '{}'::record[] ELSE (ARRAY[sequential_scan.*])::record[] END)
         ->  Bitmap Index Scan on sequential_scan_pkey
               Index Cond: (id = ANY ('{1,10000,20000}'::integer[]))
(7 rows)

