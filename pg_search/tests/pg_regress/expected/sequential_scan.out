----+---------
  1 | f
(1 row)

ROLLBACK TO before_first_fetch;
FETCH 2 FROM sequential_scan_null_cursor;
 id | missing 
----+---------
  2 | f
  3 | t
(2 rows)

CLOSE sequential_scan_null_cursor;
ROLLBACK;
