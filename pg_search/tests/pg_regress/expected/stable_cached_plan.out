   Tantivy Query: {"boolean":{"must":[{"with_index":{"query":{"match":{"field":"body","value":"canal","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}},{"postgres_expression":{"expr":{"expr_desc":"paradedb.term_with_operator('tenant_id'::paradedb.fieldname, '>'::text, stable_plan_tenant())"}}}]}}
     Applies to Aggregates: COUNT(*)
     Aggregate Definition: {"0":{"filter":"*"}}
