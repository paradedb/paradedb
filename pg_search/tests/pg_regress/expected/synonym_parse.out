-- A fuzzy query keeps the typed word fuzzy, so it finds `soda`. It matches the alternatives
-- exactly, so `couch` does not find `coach`.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT id FROM parse_products
WHERE description @@@ (SELECT pdb.expand('sofa', rule) FROM parse_synonyms)::pdb.fuzzy(1);
                                                                                                          QUERY PLAN                                                                                                           
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Base Scan) on public.parse_products
   Output: id
   Table: parse_products
   Index: parse_products_idx
   Worker Selection: Cost model
   Exec Method: ColumnarExecState
   Columnar: id
   Scores: false
   Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"description","query_string":"sofa","lenient":null,"conjunction_mode":null,"fuzzy_data":{"distance":1,"prefix":false,"transposition_cost_one":false}}}}}
   Synonyms: parse_synonyms_idx
(10 rows)

SELECT id FROM parse_products
WHERE description @@@ (SELECT pdb.expand('sofa', rule) FROM parse_synonyms)::pdb.fuzzy(1)
ORDER BY id;
