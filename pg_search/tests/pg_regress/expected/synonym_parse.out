-- A generic plan has no text, so it gives the parameter to the index when the query runs.
PREPARE parse_sofa(text) AS SELECT id FROM parse_products
WHERE description @@@ (SELECT pdb.expand($1, rule) FROM parse_synonyms) ORDER BY id;
SET plan_cache_mode = force_generic_plan;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF) EXECUTE parse_sofa('sofa');
                                                                                                                           QUERY PLAN                                                                                                                           
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: id
   Sort Key: parse_products.id
   ->  Custom Scan (ParadeDB Base Scan) on public.parse_products
         Output: id
         Table: parse_products
         Index: parse_products_idx
         Worker Selection: Row-capped
         Exec Method: ColumnarExecState
         Columnar: id
         Scores: false
         Tantivy Query: {"postgres_expression":{"expr":{"expr_desc":"paradedb.with_index('parse_products_idx'::regclass, paradedb.to_search_query_input('description'::paradedb.fieldname, paradedb.expand_with_index($1, 'parse_synonyms_idx'::regclass)))"}}}
(12 rows)

