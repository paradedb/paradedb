         Worker Selection: Row-capped
         Exec Method: ColumnarExecState
         Columnar: id
         Scores: false
         Tantivy Query: {"postgres_expression":{"expr":{"expr_desc":"paradedb.with_index('parse_products_idx'::regclass, paradedb.to_search_query_input('description'::paradedb.fieldname, paradedb.expand_with_index($1, 'parse_synonyms_idx'::regclass)))"}}}
(12 rows)

