-- A `pdb.expand` subquery makes the query parser expand each word and each quoted phrase of its
-- query string.
CREATE EXTENSION IF NOT EXISTS pg_search;
DROP TABLE IF EXISTS parse_products, parse_notes, parse_stems, parse_grams, parse_synonyms;
CREATE TABLE parse_synonyms (rule pdb.synonym_rule NOT NULL);
INSERT INTO parse_synonyms VALUES
    ('sofa, couch, divan'),
    ('sneakers => running shoes'),
    ('trail shoes, hikers');
CREATE TABLE parse_products (id int PRIMARY KEY, description text, category text, metadata jsonb);
INSERT INTO parse_products VALUES
    (1, 'red couch'),
    (2, 'red leather sofa'),
    (3, 'oak divan'),
    (4, 'blue running shoes'),
    (5, 'blue shoes for running'),
    (6, 'blue sneakers'),
    (7, 'green hikers'),
    (8, 'trail map'),
    (9, 'red chair'),
    (10, 'soda can'),
    (11, 'night coach'),
    (12, 'running shoes sale'),
    (13, 'hikers sale');
INSERT INTO parse_products VALUES
    (14, 'oak table', 'sofa', '{"seat": "sofa"}'),
    (15, 'pine table', 'couch', '{"seat": "couch"}');
CREATE INDEX parse_products_idx ON parse_products
    USING bm25 (id, description, category, metadata);
-- The rules table needs no index. The subquery reads the rules, and the parsed query expands
-- with them when the query runs.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT id FROM parse_products
WHERE description @@@ (SELECT pdb.expand('sofa', rule) FROM parse_synonyms);
WARNING:  a `pdb.expand` subquery reads its rules from the table on every query, because "parse_synonyms" has no synonym index for these rules with the tokenizer of field `description`. To disable this warning: SET paradedb.planner_warnings = 'off'
                                                                                          QUERY PLAN                                                                                          
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Base Scan) on public.parse_products
   Output: parse_products.id
   Table: parse_products
   Index: parse_products_idx
   Worker Selection: Row-capped
   Exec Method: ColumnarExecState
   Columnar: id
   Scores: false
   Tantivy Query: {"postgres_expression":{"expr":{"expr_desc":"paradedb.with_index('parse_products_idx'::regclass, paradedb.to_search_query_input('description'::paradedb.fieldname, $1))"}}}
   InitPlan 1
     ->  Aggregate
           Output: pdb.expand('sofa'::text, (parse_synonyms.rule)::text)
           ->  Seq Scan on public.parse_synonyms
                 Output: parse_synonyms.rule
(14 rows)

SELECT id FROM parse_products
WHERE description @@@ (SELECT pdb.expand('sofa', rule) FROM parse_synonyms) ORDER BY id;
