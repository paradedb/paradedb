   Index: phrase_products_idx
   Worker Selection: Cost model
   Exec Method: ColumnarExecState
   Columnar: id
   Scores: false
   Tantivy Query: {"with_index":{"query":{"tokenized_phrase":{"field":"description","phrase":"blue sneakers","slop":null}}}}
   Synonyms: phrase_synonyms_idx
(10 rows)

SELECT id FROM phrase_products
WHERE description ### (SELECT pdb.expand('blue sneakers', rule) FROM phrase_synonyms) ORDER BY id;
