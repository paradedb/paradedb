-- A phrase of one word scores its alternatives as one term, the same as a match.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT id, pdb.score(id) FROM phrase_products
WHERE description ### (SELECT pdb.expand('sofa', rule) FROM phrase_synonyms)
ORDER BY pdb.score(id) DESC, id;
                                                        QUERY PLAN                                                        
--------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: id, (pdb.score(id))
   Sort Key: (pdb.score(phrase_products.id)) DESC, phrase_products.id
   ->  Custom Scan (ParadeDB Base Scan) on public.phrase_products
         Output: id, pdb.score(id)
         Table: phrase_products
         Index: phrase_products_idx
         Worker Selection: Cost model
         Exec Method: ColumnarExecState
         Columnar: id
         Scores: true
         Tantivy Query: {"with_index":{"query":{"tokenized_phrase":{"field":"description","phrase":"sofa","slop":null}}}}
         Synonyms: phrase_synonyms_idx
(13 rows)

