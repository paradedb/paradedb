\i common/common_setup.sql
CREATE EXTENSION IF NOT EXISTS pg_search;
-- Disable parallel workers to avoid differences in plans
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan to OFF;
SET paradedb.enable_columnar_exec = true;
-- Query-time synonyms. A set is the rows of pdb.synonym_rules that share a set_name, one
-- Solr-format rule each, and attaches to an index or to a field. Expansion happens when a match
-- query is built, so a change to the rules is live on the next query with no reindex.
-- A set appears with its first rule.
INSERT INTO pdb.synonym_rules (set_name, rule) VALUES
    ('shop', '# comments and blank lines are skipped'),
    ('shop', ''),
    ('shop', 'couch, sofa, divan'),
    ('shop', 'sneakers => running shoes'),
    ('shop', 'tv, television'),
    ('shop', 'red, crimson'),
    ('shop', 'living room, lounge'),
    ('colors', 'red, crimson, scarlet');
SELECT name, version FROM pdb.synonym_sets ORDER BY name;
  name  | version 
--------+---------
 colors |       2
 shop   |       2
(2 rows)

SELECT set_name, rule FROM pdb.synonym_rules ORDER BY set_name, rule;
 set_name |                  rule                  
----------+----------------------------------------
 colors   | red, crimson, scarlet
 shop     | 
 shop     | # comments and blank lines are skipped
 shop     | couch, sofa, divan
 shop     | living room, lounge
 shop     | red, crimson
 shop     | sneakers => running shoes
 shop     | tv, television
(8 rows)

-- A bad rule fails at INSERT, with the rule and the reason, and leaves no set behind.
INSERT INTO pdb.synonym_rules (set_name, rule) VALUES ('bad', 'a => b => c');
ERROR:  invalid synonym rule 'a => b => c': a rule can have at most one '=>'
SELECT count(*) FROM pdb.synonym_sets WHERE name = 'bad';
 count 
-------
     0
(1 row)

-- 'none' is the value that turns expansion off, so it cannot name a set.
INSERT INTO pdb.synonym_rules (set_name, rule) VALUES ('none', 'a, b');
ERROR:  new row for relation "synonym_sets" violates check constraint "synonym_sets_name_check"
DROP TABLE IF EXISTS products;
CREATE TABLE products (
    id serial8 NOT NULL PRIMARY KEY,
    description text,
    attrs jsonb
);
INSERT INTO products (description, attrs) VALUES
    ('A red sofa for the living room', '{"color": "red"}'),
    ('Leather couch with cushions', '{"color": "brown"}'),
    ('Antique divan', '{"color": "crimson"}'),
    ('Running shoes for marathons', '{"color": "white"}'),
    ('Sneakers for the gym', '{"color": "black"}'),
    ('Big television', '{"color": "black"}'),
    ('A sofa and a couch, both red', '{"color": "red"}'),
    ('Sofas on sale', '{"color": "blue"}'),
    ('Couches on sale', '{"color": "blue"}');
-------------------------------------------------------------
-- Index level: WITH (synonyms = ...)
-------------------------------------------------------------
CREATE INDEX idx_products ON products USING bm25 (id, description, attrs)
    WITH (synonyms = 'shop');
-- Equivalents: every term of the group finds the whole group.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
                                                                                               QUERY PLAN                                                                                               
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Sort
   Output: id, description
   Sort Key: products.id
   ->  Custom Scan (ParadeDB Base Scan) on public.products
         Output: id, description
         Table: products
         Index: idx_products
         Worker Selection: Cost model
         Exec Method: NormalScanExecState
         Scores: false
         Tantivy Query: {"with_index":{"query":{"match":{"field":"description","value":"sofa","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(11 rows)

SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  2 | Leather couch with cushions
  3 | Antique divan
  7 | A sofa and a couch, both red
(4 rows)

SELECT id, description FROM products WHERE description ||| 'divan' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  2 | Leather couch with cushions
  3 | Antique divan
  7 | A sofa and a couch, both red
(4 rows)

-- Directed: the left side is replaced, here by a two-word phrase.
SELECT id, description FROM products WHERE description ||| 'sneakers' ORDER BY id;
 id |         description         
----+-----------------------------
  4 | Running shoes for marathons
(1 row)

-- The other direction does not expand.
SELECT id, description FROM products WHERE description ||| 'running shoes' ORDER BY id;
 id |         description         
----+-----------------------------
  4 | Running shoes for marathons
(1 row)

-- Scoring: the alternatives of one input share a DisjunctionMax, so the row with both "sofa" and
-- "couch" scores once for that input, with the best alternative, and not twice.
SELECT id, description, paradedb.score(id) FROM products WHERE description ||| 'sofa' ORDER BY id;
 id |          description           |   score   
----+--------------------------------+-----------
  1 | A red sofa for the living room | 1.0608165
  2 | Leather couch with cushions    | 1.3862944
  3 | Antique divan                  |  2.384951
  7 | A sofa and a couch, both red   | 1.0608165
(4 rows)

SELECT id, description, paradedb.score(id) FROM products WHERE description ||| 'couch' ORDER BY id;
 id |          description           |   score   
----+--------------------------------+-----------
  1 | A red sofa for the living room | 1.0608165
  2 | Leather couch with cushions    | 1.3862944
  3 | Antique divan                  |  2.384951
  7 | A sofa and a couch, both red   | 1.0608165
(4 rows)

-- Conjunction: every group must match.
SELECT id, description FROM products WHERE description &&& 'red sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  7 | A sofa and a couch, both red
(2 rows)

SELECT id, description FROM products WHERE description &&& 'leather couch' ORDER BY id;
 id |         description         
----+-----------------------------
  2 | Leather couch with cushions
(1 row)

-- A multi-word key: the typed words of one key form one group, so the conjunction has one Must
-- with the key as a phrase next to its alternative, and 'lounge' finds the phrase too.
SELECT * FROM pdb.synonym_expansion('shop', paradedb.tokenizer('default'), 'living room');
 position |    token    |      alternatives      
----------+-------------+------------------------
        0 | living room | {"living room",lounge}
(1 row)

SELECT id, description FROM products WHERE description &&& 'living room' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
(1 row)

SELECT id, description FROM products WHERE description &&& 'lounge' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
(1 row)

-- Fuzzy: the typed token stays fuzzy (sofa ~ sofas), the alternatives are exact
-- (couch does not reach couches).
SELECT id, description FROM products WHERE description ||| 'sofa'::pdb.fuzzy(1) ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  2 | Leather couch with cushions
  3 | Antique divan
  7 | A sofa and a couch, both red
  8 | Sofas on sale
(5 rows)

-- A tokenizer cast on the query gives exact tokens, with no expansion.
SELECT id, description FROM products WHERE description ||| 'sofa'::pdb.simple ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  7 | A sofa and a couch, both red
(2 rows)

-- Term and phrase queries are exact by definition.
SELECT id, description FROM products WHERE description === 'sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  7 | A sofa and a couch, both red
(2 rows)

SELECT id, description FROM products WHERE description ### 'red sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
(1 row)

-- JSON fields expand with the index set too.
SELECT id, attrs FROM products WHERE attrs->'color' ||| 'red' ORDER BY id;
 id |        attrs         
----+----------------------
  1 | {"color": "red"}
  3 | {"color": "crimson"}
  7 | {"color": "red"}
(3 rows)

-------------------------------------------------------------
-- The compiled rows: one per set and analyzer, stored by the first query that needs one.
-------------------------------------------------------------
SELECT f.set_name, jsonb_object_keys(f.analyzer) AS analyzer, f.version = s.version AS current
FROM pdb.synonym_fsts f JOIN pdb.synonym_sets s ON s.name = f.set_name
ORDER BY 1, 2;
 set_name |   analyzer   | current 
----------+--------------+---------
 shop     | UnicodeWords | t
(1 row)

-------------------------------------------------------------
-- The debug surface
-------------------------------------------------------------
SELECT * FROM pdb.synonym_expansion('shop', paradedb.tokenizer('default'), 'red sofa and sneakers');
 position |  token   |    alternatives    
----------+----------+--------------------
        0 | red      | {red,crimson}
        1 | sofa     | {couch,sofa,divan}
        2 | and      | {and}
        3 | sneakers | {"running shoes"}
(4 rows)

SELECT * FROM pdb.synonym_expansion('shop', paradedb.tokenizer('default'), 'running shoes');
 position |  token  | alternatives 
----------+---------+--------------
        0 | running | {running}
        1 | shoes   | {shoes}
(2 rows)

-- A right side that the analyzer removes, here a stopword, keeps the typed term.
INSERT INTO pdb.synonym_rules (set_name, rule) VALUES ('stop', 'sofa => the'), ('stop', 'couch => the settee');
SELECT * FROM pdb.synonym_expansion('stop', paradedb.tokenizer('default', stopwords_language => 'English'), 'sofa couch');
 position | token | alternatives 
----------+-------+--------------
        0 | sofa  | {sofa}
        1 | couch | {settee}
(2 rows)

-------------------------------------------------------------
-- Reload: a change is visible to its own transaction before commit, and to every query after.
-------------------------------------------------------------
BEGIN;
DELETE FROM pdb.synonym_rules WHERE set_name = 'shop' AND rule = 'couch, sofa, divan';
INSERT INTO pdb.synonym_rules (set_name, rule) VALUES ('shop', 'sofa, settee');
SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  7 | A sofa and a couch, both red
(2 rows)

ROLLBACK;
-- Rolled back: the old rules apply again.
SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  2 | Leather couch with cushions
  3 | Antique divan
  7 | A sofa and a couch, both red
(4 rows)

-- The version moves once per statement, also for a COPY, and the compiled rows follow it.
SELECT version FROM pdb.synonym_sets WHERE name = 'shop';
 version 
---------
       2
(1 row)

INSERT INTO pdb.synonym_rules (set_name, rule) VALUES ('shop', 'sofa, loveseat'), ('shop', 'lamp, light');
SELECT version FROM pdb.synonym_sets WHERE name = 'shop';
 version 
---------
       3
(1 row)

COPY pdb.synonym_rules (set_name, rule) FROM stdin;
SELECT version FROM pdb.synonym_sets WHERE name = 'shop';
 version 
---------
       4
(1 row)

SELECT f.set_name, jsonb_object_keys(f.analyzer) AS analyzer, f.version = s.version AS current
FROM pdb.synonym_fsts f JOIN pdb.synonym_sets s ON s.name = f.set_name
ORDER BY 1, 2;
 set_name |   analyzer   | current 
----------+--------------+---------
 shop     | UnicodeWords | t
(1 row)

INSERT INTO products (description, attrs) VALUES ('Loveseat for two', '{"color": "green"}');
SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  2 | Leather couch with cushions
  3 | Antique divan
  7 | A sofa and a couch, both red
 10 | Loveseat for two
(5 rows)

-------------------------------------------------------------
-- ALTER INDEX changes the set with no reindex.
-------------------------------------------------------------
ALTER INDEX idx_products SET (synonyms = 'colors');
SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  7 | A sofa and a couch, both red
(2 rows)

SELECT id, description FROM products WHERE description ||| 'crimson' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  7 | A sofa and a couch, both red
(2 rows)

-- The first query on the new set stored one more compiled row.
SELECT set_name, count(*) FROM pdb.synonym_fsts GROUP BY set_name ORDER BY set_name;
 set_name | count 
----------+-------
 colors   |     1
 shop     |     1
(2 rows)

ALTER INDEX idx_products RESET (synonyms);
SELECT id, description FROM products WHERE description ||| 'crimson' ORDER BY id;
 id | description 
----+-------------
(0 rows)

-- A missing set fails at query time, with its name.
ALTER INDEX idx_products SET (synonyms = 'nope');
SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
ERROR:  synonym set 'nope' does not exist
ALTER INDEX idx_products SET (synonyms = 'shop');
-- Deleting all rules leaves an empty set, which expands nothing.
DELETE FROM pdb.synonym_rules WHERE set_name = 'colors';
ALTER INDEX idx_products SET (synonyms = 'colors');
SELECT id, description FROM products WHERE description ||| 'crimson' ORDER BY id;
 id | description 
----+-------------
(0 rows)

-- DELETE FROM pdb.synonym_sets removes the set with its rules and compiled rows.
DELETE FROM pdb.synonym_sets WHERE name = 'colors';
SELECT count(*) FROM pdb.synonym_fsts WHERE set_name = 'colors';
 count 
-------
     0
(1 row)

SELECT id, description FROM products WHERE description ||| 'crimson' ORDER BY id;
 id | description 
----+-------------
(0 rows)

ALTER INDEX idx_products SET (synonyms = 'shop');
-------------------------------------------------------------
-- A writer needs a grant on pdb.synonym_rules only, and a reader needs no write grant at all.
-------------------------------------------------------------
CREATE ROLE synonyms_test_writer;
GRANT SELECT ON products TO synonyms_test_writer;
GRANT INSERT ON pdb.synonym_rules TO synonyms_test_writer;
SET ROLE synonyms_test_writer;
INSERT INTO pdb.synonym_rules (set_name, rule) VALUES ('writer', 'a, b');
SELECT name FROM pdb.synonym_sets WHERE name = 'writer';
  name  
--------
 writer
(1 row)

RESET ROLE;
DELETE FROM pdb.synonym_fsts;
SET ROLE synonyms_test_writer;
-- The query stores the compiled row through the builder, which runs as the extension owner.
SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  2 | Leather couch with cushions
  3 | Antique divan
  7 | A sofa and a couch, both red
 10 | Loveseat for two
(5 rows)

SELECT set_name, count(*) FROM pdb.synonym_fsts GROUP BY set_name ORDER BY set_name;
 set_name | count 
----------+-------
 shop     |     1
(1 row)

RESET ROLE;
-- The trigger functions run as the extension owner, so no other role can hang them on a table.
GRANT CREATE ON SCHEMA public TO synonyms_test_writer;
SET ROLE synonyms_test_writer;
CREATE TABLE mine (set_name text);
CREATE TRIGGER mine_ensure BEFORE INSERT ON mine FOR EACH ROW EXECUTE FUNCTION pdb.ensure_synonym_set();
ERROR:  permission denied for function pdb.ensure_synonym_set
CREATE TRIGGER mine_bump AFTER INSERT ON mine FOR EACH STATEMENT EXECUTE FUNCTION pdb.synonym_rules_bump_version();
ERROR:  permission denied for function pdb.synonym_rules_bump_version
DROP TABLE mine;
RESET ROLE;
DROP OWNED BY synonyms_test_writer;
DROP ROLE synonyms_test_writer;
-- The builder refuses an analyzer it cannot read.
SELECT pdb.synonym_fst_build('shop', '{"Nope": {}}');
ERROR:  the analyzer of a stored synonym set does not load: unknown variant `Nope`, expected one of `Simple`, `Keyword`, `KeywordDeprecated`, `Raw`, `LiteralNormalized`, `WhiteSpace`, `RegexTokenizer`, `ChineseCompatible`, `SourceCode`, `Ngram`, `EdgeNgram`, `ChineseLinderaDeprecated`, `ChineseLindera`, `JapaneseLinderaDeprecated`, `JapaneseLindera`, `KoreanLinderaDeprecated`, `KoreanLindera`, `ICUTokenizer`, `Jieba`, `LinderaDeprecated`, `Lindera`, `UnicodeWordsDeprecated`, `UnicodeWords`, `RegexTokenizerDeprecated`
-------------------------------------------------------------
-- UPDATE: a changed rule, and a rule moved to a set that appears with it.
-------------------------------------------------------------
UPDATE pdb.synonym_rules SET rule = 'tv, television, telly' WHERE set_name = 'shop' AND rule = 'tv, television';
SELECT id, description FROM products WHERE description ||| 'telly' ORDER BY id;
 id |  description   
----+----------------
  6 | Big television
(1 row)

UPDATE pdb.synonym_rules SET set_name = 'screens' WHERE rule = 'tv, television, telly';
SELECT name FROM pdb.synonym_sets WHERE name IN ('screens', 'shop') ORDER BY name;
  name   
---------
 screens
 shop
(2 rows)

SELECT id, description FROM products WHERE description ||| 'telly' ORDER BY id;
 id | description 
----+-------------
(0 rows)

-------------------------------------------------------------
-- A stale compiled row is replaced by the next query. A read-only transaction reads but never
-- stores.
-------------------------------------------------------------
UPDATE pdb.synonym_fsts SET version = 0 WHERE set_name = 'shop';
INSERT INTO pdb.synonym_rules (set_name, rule) VALUES ('stop', 'x, y');
SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  2 | Leather couch with cushions
  3 | Antique divan
  7 | A sofa and a couch, both red
 10 | Loveseat for two
(5 rows)

SELECT f.version = s.version AS current FROM pdb.synonym_fsts f JOIN pdb.synonym_sets s ON s.name = f.set_name WHERE f.set_name = 'shop';
 current 
---------
 t
(1 row)

DELETE FROM pdb.synonym_fsts;
INSERT INTO pdb.synonym_rules (set_name, rule) VALUES ('stop', 'm, n');
BEGIN READ ONLY;
SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  2 | Leather couch with cushions
  3 | Antique divan
  7 | A sofa and a couch, both red
 10 | Loveseat for two
(5 rows)

COMMIT;
SELECT count(*) FROM pdb.synonym_fsts;
 count 
-------
     0
(1 row)

-- The copy it compiled stays in memory until the next change. Then a query stores again.
INSERT INTO pdb.synonym_rules (set_name, rule) VALUES ('stop', 'o, p');
SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  2 | Leather couch with cushions
  3 | Antique divan
  7 | A sofa and a couch, both red
 10 | Loveseat for two
(5 rows)

SELECT count(*) FROM pdb.synonym_fsts;
 count 
-------
     1
(1 row)

-------------------------------------------------------------
-- Parallel workers expand the same way as the leader.
-------------------------------------------------------------
SET debug_parallel_query = on;
SET max_parallel_workers_per_gather = 2;
SET parallel_tuple_cost = 0;
SET parallel_setup_cost = 0;
SET min_parallel_table_scan_size = 0;
SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  2 | Leather couch with cushions
  3 | Antique divan
  7 | A sofa and a couch, both red
 10 | Loveseat for two
(5 rows)

SELECT id, description FROM products WHERE description &&& 'red sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  7 | A sofa and a couch, both red
(2 rows)

-- Also with no compiled row to read. The rule change drops every copy in memory, then the
-- workers compile their own and the leader stores one at plan time.
DELETE FROM pdb.synonym_fsts;
INSERT INTO pdb.synonym_rules (set_name, rule) VALUES ('shop', 'bench, seat');
SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  2 | Leather couch with cushions
  3 | Antique divan
  7 | A sofa and a couch, both red
 10 | Loveseat for two
(5 rows)

SELECT set_name, count(*) FROM pdb.synonym_fsts GROUP BY set_name ORDER BY set_name;
 set_name | count 
----------+-------
 shop     |     1
(1 row)

-- A one-token top-k by score is kept serial as Block-WAND prunable. A rule turns the token
-- into a union that does not prune, so the scan gets workers.
EXPLAIN (COSTS OFF, TIMING OFF)
SELECT id FROM products WHERE description ||| 'sofa' ORDER BY paradedb.score(id) DESC LIMIT 3;
                                                                                                  QUERY PLAN                                                                                                  
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Gather Merge
         Workers Planned: 1
         ->  Parallel Custom Scan (ParadeDB Base Scan) on products
               Table: products
               Index: idx_products
               Exec Method: TopKScanExecState
               Scores: true
                  TopK Order By: pdb.score() desc
                  TopK Limit: 3
               Tantivy Query: {"with_index":{"query":{"match":{"field":"description","value":"sofa","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(11 rows)

-- A token in no rule is still one term, so the scan stays serial.
EXPLAIN (COSTS OFF, TIMING OFF)
SELECT id FROM products WHERE description ||| 'leather' ORDER BY paradedb.score(id) DESC LIMIT 3;
                                                                                                   QUERY PLAN                                                                                                    
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Gather
   Workers Planned: 1
   Single Copy: true
   ->  Limit
         ->  Custom Scan (ParadeDB Base Scan) on products
               Table: products
               Index: idx_products
               Exec Method: TopKScanExecState
               Scores: true
                  TopK Order By: pdb.score() desc
                  TopK Limit: 3
               Tantivy Query: {"with_index":{"query":{"match":{"field":"description","value":"leather","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(12 rows)

SET paradedb.enable_synonyms = off;
EXPLAIN (COSTS OFF, TIMING OFF)
SELECT id FROM products WHERE description ||| 'sofa' ORDER BY paradedb.score(id) DESC LIMIT 3;
                                                                                                  QUERY PLAN                                                                                                  
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Gather
   Workers Planned: 1
   Single Copy: true
   ->  Limit
         ->  Custom Scan (ParadeDB Base Scan) on products
               Table: products
               Index: idx_products
               Exec Method: TopKScanExecState
               Scores: true
                  TopK Order By: pdb.score() desc
                  TopK Limit: 3
               Tantivy Query: {"with_index":{"query":{"match":{"field":"description","value":"sofa","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(12 rows)

RESET paradedb.enable_synonyms;
RESET debug_parallel_query;
RESET max_parallel_workers_per_gather;
RESET parallel_tuple_cost;
RESET parallel_setup_cost;
RESET min_parallel_table_scan_size;
-------------------------------------------------------------
-- The kill switch, and the cap on alternatives.
-------------------------------------------------------------
SET paradedb.enable_synonyms = off;
SELECT id, description FROM products WHERE description ||| 'sofa' ORDER BY id;
 id |          description           
----+--------------------------------
  1 | A red sofa for the living room
  7 | A sofa and a couch, both red
(2 rows)

RESET paradedb.enable_synonyms;
-- The rule is 'couch, sofa, divan', plus 'sofa, loveseat' from the INSERT above. With a cap of two,
-- the typed term survives the cut.
SET paradedb.synonyms_max_alternatives = 2;
SELECT * FROM pdb.synonym_expansion('shop', paradedb.tokenizer('default'), 'sofa divan');
 position | token | alternatives  
----------+-------+---------------
        0 | sofa  | {couch,sofa}
        1 | divan | {couch,divan}
(2 rows)

SELECT id, description FROM products WHERE description ||| 'divan' ORDER BY id;
 id |         description          
----+------------------------------
  2 | Leather couch with cushions
  3 | Antique divan
  7 | A sofa and a couch, both red
(3 rows)

RESET paradedb.synonyms_max_alternatives;
DROP TABLE products;
-------------------------------------------------------------
-- Field level: synonyms=... on the tokenizer cast overrides the index option.
-------------------------------------------------------------
INSERT INTO pdb.synonym_rules (set_name, rule) VALUES ('colors', 'red, crimson, scarlet');
DROP TABLE IF EXISTS fields;
CREATE TABLE fields (
    id serial8 NOT NULL PRIMARY KEY,
    title text,
    body text,
    notes text
);
INSERT INTO fields (title, body, notes) VALUES
    ('red sofa', 'crimson couch', 'scarlet divan');
CREATE INDEX idx_fields ON fields USING bm25 (
    id,
    (title::pdb.simple('synonyms=colors')),
    (body::pdb.simple('synonyms=none')),
    notes
) WITH (synonyms = 'shop');
-- title: the colors set, so crimson finds red and sofa does not find couch.
SELECT id FROM fields WHERE title ||| 'crimson' ORDER BY id;
 id 
----
  1
(1 row)

SELECT id FROM fields WHERE title ||| 'couch' ORDER BY id;
 id 
----
(0 rows)

-- body: no expansion at all.
SELECT id FROM fields WHERE body ||| 'red' ORDER BY id;
 id 
----
(0 rows)

SELECT id FROM fields WHERE body ||| 'crimson' ORDER BY id;
 id 
----
  1
(1 row)

-- notes: the index set.
SELECT id FROM fields WHERE notes ||| 'sofa' ORDER BY id;
 id 
----
  1
(1 row)

SELECT id FROM fields WHERE notes ||| 'red' ORDER BY id;
 id 
----
(0 rows)

DROP TABLE fields;
-------------------------------------------------------------
-- The rules go through the field's analyzer, so a stemmer applies to both sides.
-------------------------------------------------------------
DROP TABLE IF EXISTS stemmed;
CREATE TABLE stemmed (
    id serial8 NOT NULL PRIMARY KEY,
    description text
);
INSERT INTO stemmed (description) VALUES
    ('running shoes for marathons'),
    ('a runner shoe'),
    ('sneaker for the gym');
CREATE INDEX idx_stemmed ON stemmed USING bm25 (id, (description::pdb.simple('stemmer=english')))
    WITH (synonyms = 'shop');
-- "sneakers" stems to "sneaker", and "running shoes" to the phrase "run shoe".
SELECT * FROM pdb.synonym_expansion('shop', paradedb.tokenizer('default', stemmer => 'English'), 'sneaker');
 position |  token  | alternatives 
----------+---------+--------------
