-- A filtered window aggregate in a subquery without a LIMIT: no Top-K
-- aggregate, so JoinScan computes it in a DataFusion window node.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT * FROM (
    SELECT
        p.id,
        r.score,
        COUNT(*) FILTER (WHERE r.score > 80) OVER () AS high_count
    FROM products p
    JOIN product_reviews r ON p.id = r.product_id
    WHERE p.description ||| 'laptop'
) s
ORDER BY score DESC
LIMIT 5;
                                                                                                                       QUERY PLAN                                                                                                                       
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: p.id, r.score, (pdb.window_agg('count(*) FILTER (WHERE (r.score > 80)) OVER ()'::text))
   ->  Sort
         Output: p.id, r.score, (pdb.window_agg('count(*) FILTER (WHERE (r.score > 80)) OVER ()'::text))
         Sort Key: r.score DESC
         ->  Custom Scan (ParadeDB Join Scan)
               Output: p.id, r.score, (pdb.window_agg('count(*) FILTER (WHERE (r.score > 80)) OVER ()'::text))
               Relation Tree: p INNER r
               Join Cond: p.id = r.product_id
               DataFusion Physical Plan: 
                 : ProjectionExec: expr=[id@1 as col_1, score@3 as col_2, window_agg_1@4 as col_3, ctid_0@0 as ctid_0, ctid_1@2 as ctid_1]
                 :   WindowAggExec: wdw=[window_agg_1: Ok(Field { name: "window_agg_1", data_type: Int64 }), frame: WindowFrame { units: Rows, start_bound: Preceding(UInt64(NULL)), end_bound: Following(UInt64(NULL)), is_causal: false }]
                 :     VisibilityFilterExec: tables=[p, r]
                 :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, product_id@1)], projection=[ctid_0@0, id@1, ctid_1@2, score@4]
                 :         CooperativeExec
                 :           PgSearchScan: table=p, segments=1, query={"with_index":{"query":{"match":{"field":"description","value":"laptop","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
                 :         CooperativeExec
                 :           PgSearchScan: table=r, segments=1, dynamic_filters=1, query="all"
(18 rows)

