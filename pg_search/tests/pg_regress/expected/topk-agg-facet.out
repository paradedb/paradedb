-- Test 41c: Validation errors for invalid pdb.combine_agg / pdb.agg OVER () usage
-- Bare pdb.agg() OVER () in a GROUP BY query must suggest pdb.combine_agg
SELECT in_stock, pdb.agg('{"avg": {"field": "rating"}}'::jsonb) OVER ()
FROM products
WHERE description ||| 'laptop'
GROUP BY in_stock;
ERROR:  `pdb.agg()` cannot be used directly as a window function in a `GROUP BY` or aggregate query. Use `pdb.combine_agg(pdb.agg(...)) OVER ()` instead.
-- Bare pdb.agg() OVER () combined with an aggregate function without GROUP BY
SELECT COUNT(*), pdb.agg('{"avg": {"field": "rating"}}'::jsonb) OVER ()
FROM products
WHERE description ||| 'laptop';
ERROR:  `pdb.agg() OVER ()` cannot be combined with aggregate functions without a `GROUP BY` clause. Remove `OVER ()` to use `pdb.agg()` as an aggregate function, or add a `GROUP BY` clause with `pdb.combine_agg(pdb.agg(...)) OVER ()`.
-- pdb.combine_agg without OVER ()
SELECT in_stock, pdb.combine_agg('{"avg": {"field": "rating"}}'::jsonb)
FROM products
WHERE description ||| 'laptop'
GROUP BY in_stock;
ERROR:  `pdb.combine_agg()` must be used as a window function: `pdb.combine_agg(pdb.agg(...)) OVER ()`
-- pdb.combine_agg OVER () without GROUP BY
SELECT pdb.combine_agg(pdb.agg('{"avg": {"field": "rating"}}'::jsonb)) OVER ()
FROM products
WHERE description ||| 'laptop';
ERROR:  `pdb.combine_agg(pdb.agg(...)) OVER ()` requires a `GROUP BY` clause. For queries without `GROUP BY`, use `pdb.agg(...) OVER ()` directly.
-- pdb.combine_agg OVER () with HAVING
SELECT in_stock, COUNT(*), pdb.combine_agg(pdb.agg('{"avg": {"field": "rating"}}'::jsonb)) OVER ()
FROM products
WHERE description ||| 'laptop'
GROUP BY in_stock
HAVING COUNT(*) > 1;
ERROR:  `HAVING` is not supported in queries using `pdb.combine_agg(pdb.agg(...)) OVER ()`
-- Negative LIMIT / OFFSET with pdb.combine_agg must error
SELECT
    in_stock,
    pdb.combine_agg(pdb.agg('{"value_count": {"field": "id"}}'::jsonb)) OVER ()
FROM products
WHERE description ||| 'laptop'
GROUP BY in_stock
ORDER BY in_stock
LIMIT -1;
ERROR:  Cannot execute pdb.combine_agg: LIMIT must not be negative
SELECT
    in_stock,
    pdb.combine_agg(pdb.agg('{"value_count": {"field": "id"}}'::jsonb)) OVER ()
FROM products
WHERE description ||| 'laptop'
GROUP BY in_stock
ORDER BY in_stock
OFFSET -1;
ERROR:  Cannot execute pdb.combine_agg: OFFSET must not be negative
-- FETCH FIRST ... WITH TIES with pdb.combine_agg must error
SELECT
    in_stock,
    pdb.combine_agg(pdb.agg('{"value_count": {"field": "id"}}'::jsonb)) OVER ()
FROM products
WHERE description ||| 'laptop'
GROUP BY in_stock
ORDER BY in_stock
FETCH FIRST 1 ROWS WITH TIES;
ERROR:  Cannot execute pdb.combine_agg: `FETCH FIRST ... WITH TIES` is not supported with `pdb.combine_agg()`
-- Cleanup
DROP TABLE product_reviews CASCADE;
DROP TABLE product_categories CASCADE;
DROP TABLE products CASCADE;
