-- Test 27c: Window aggregates embedded in target list expressions:
-- constant arithmetic, a cast, a source column mixed with a window value,
-- and two window functions in one entry.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT
    p.id,
    r.score,
    COUNT(*) OVER () + 1 AS count_plus_one,
    AVG(r.score) OVER ()::float8 AS avg_score,
    r.score + COUNT(*) OVER () AS score_plus_count,
    COUNT(*) OVER () + SUM(r.score) OVER () AS count_plus_sum
FROM products p
JOIN product_reviews r ON p.id = r.product_id
WHERE p.description ||| 'laptop'
ORDER BY r.score DESC
LIMIT 3;
                                                                                                                                                                        QUERY PLAN                                                                                                                                                                         
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, r.score, ((pdb.window_agg('count(*) OVER ()'::text) + 1)), ((pdb.window_agg('avg(score) OVER ()'::text))::double precision), ((r.score + pdb.window_agg('count(*) OVER ()'::text))), ((pdb.window_agg('count(*) OVER ()'::text) + pdb.window_agg('sum(score) OVER ()'::text)))
   Relation Tree: p INNER r
   Join Cond: p.id = r.product_id
   Limit: 3
   Order By: r.score desc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[get_field(__topk@0, c0) as col_1, get_field(__topk@0, c1) as col_2, window_agg_1@1 + 1 as col_3, pdb_eval_expr_funcexpr_956c81fe(window_agg_2@2) as col_4, get_field(__topk@0, c1) + window_agg_1@1 as col_5, window_agg_1@1 + window_agg_5@3 as col_6, get_field(__topk@0, c2) as ctid_0, get_field(__topk@0, c3) as ctid_1]
     :   GlobalLimitExec: skip=0, fetch=3
     :     UnnestExec
     :       AggregateExec: mode=Single, gby=[], aggr=[topk_as_agg(p_0.id, r_1.score, p_0.ctid_0, r_1.ctid_1, 3, [2, 3]) ORDER BY [r_1.score DESC NULLS FIRST] as __topk, count(1) as window_agg_1, avg(r_1.score) as window_agg_2, sum(r_1.score) as window_agg_5]
     :         VisibilityFilterExec: tables=[p, r]
     :           HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, product_id@1)], projection=[id@1, score@4, ctid_0@0, ctid_1@2]
     :             CooperativeExec
     :               PgSearchScan: table=p, segments=1, query={"with_index":{"query":{"match":{"field":"description","value":"laptop","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :             CooperativeExec
     :               PgSearchScan: table=r, segments=1, dynamic_filters=1, query="all"
(17 rows)

