-- Test 41a: Single-table GROUP BY with pdb.combine_agg(pdb.agg(...)) OVER ()
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT
    in_stock,
    COUNT(*) AS group_rows,
    COUNT(*) OVER () AS total_groups,
    pdb.combine_agg(pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}}'::jsonb)) OVER () AS brands
FROM products
WHERE description ||| 'laptop'
GROUP BY in_stock
ORDER BY in_stock;
                                                                                                                                   QUERY PLAN                                                                                                                                    
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Output: in_stock, (count(*)), (pdb.window_agg('count(*) OVER ()'::text)), (pdb.window_agg('pdb.combine_agg(pdb.agg(''{"terms":{"field":"brand","order":{"_key":"asc"}}}'')) OVER ()'::text))
   Backend: DataFusion
   Indexes: products_idx (products)
   Group By: in_stock
   Aggregates: COUNT(*), COUNT(*) OVER (), pdb.combine_agg(pdb.agg({"terms":{"field":"brand","order":{"_key":"asc"}}})) OVER ()
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[get_field(__topk@0, c0) as in_stock, get_field(__topk@0, c1) as agg_0, win_0@1 as win_0, win_1@2 as win_1]
     :   UnnestExec
     :     AggregateExec: mode=Single, gby=[], aggr=[topk_as_agg(products_0.in_stock, agg_0, 18446744073709551615, []) ORDER BY [products_0.in_stock ASC NULLS LAST] as __topk, count(1) as win_0, pdb_combine_agg({"terms":{"field":"brand","order":{"_key":"asc"}}}) as win_1]
     :       AggregateExec: mode=Single, gby=[in_stock@0 as in_stock], aggr=[count(1) as agg_0, pdb_precombine_agg({"terms":{"field":"brand","order":{"_key":"asc"}}}) as precombine_1]
     :         CooperativeExec
     :           PgSearchScan: table=products, segments=1, visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"laptop","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(13 rows)

