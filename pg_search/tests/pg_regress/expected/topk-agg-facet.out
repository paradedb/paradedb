-- Test 27f: SQL window aggregates over a JOIN with a parameterized LIMIT.
-- In a generic plan the fetch is not known at planning, so the Top-K
-- aggregate carries it as unbound text and execution binds it once the
-- parameter resolves. The window aggregates stay in the Top-K aggregate node.
SET plan_cache_mode = force_generic_plan;
PREPARE window_join_param_limit(int) AS
SELECT
    p.id,
    r.score,
    COUNT(*) OVER () AS total_count,
    SUM(r.score) OVER () AS total_score,
    r.score + COUNT(*) OVER () AS score_plus_count
FROM products p
JOIN product_reviews r ON p.id = r.product_id
WHERE p.description ||| 'laptop'
ORDER BY r.score DESC
LIMIT $1;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
EXECUTE window_join_param_limit(3);
                                                                                                                                 QUERY PLAN                                                                                                                                 
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, r.score, (pdb.window_agg('count(*) OVER ()'::text)), (pdb.window_agg('sum(score) OVER ()'::text)), ((r.score + pdb.window_agg('count(*) OVER ()'::text)))
   Relation Tree: p INNER r
   Join Cond: p.id = r.product_id
   Limit: $1
   Order By: r.score desc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[get_field(__topk@0, c0) as col_1, get_field(__topk@0, c1) as col_2, window_agg_1@1 as col_3, window_agg_2@2 as col_4, get_field(__topk@0, c1) + window_agg_1@1 as col_5, get_field(__topk@0, c2) as ctid_0, get_field(__topk@0, c3) as ctid_1]
     :   UnnestExec
     :     AggregateExec: mode=Single, gby=[], aggr=[topk_as_agg(p_0.id, r_1.score, p_0.ctid_0, r_1.ctid_1, $1, [2, 3]) ORDER BY [r_1.score DESC NULLS FIRST] as __topk, count(1) as window_agg_1, sum(r_1.score) as window_agg_2]
     :       VisibilityFilterExec: tables=[p, r]
     :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, product_id@1)], projection=[id@1, score@4, ctid_0@0, ctid_1@2]
     :           CooperativeExec
     :             PgSearchScan: table=p, segments=1, query={"with_index":{"query":{"match":{"field":"description","value":"laptop","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :           CooperativeExec
     :             PgSearchScan: table=r, segments=1, dynamic_filters=1, query="all"
(16 rows)

EXECUTE window_join_param_limit(3);
 id | score | total_count | total_score | score_plus_count 
----+-------+-------------+-------------+------------------
  1 |    95 |           4 |         321 |               99
  3 |    91 |           4 |         321 |               95
  1 |    70 |           4 |         321 |               74
(3 rows)

DEALLOCATE window_join_param_limit;
-- A pdb.agg() window has no Postgres fallback, so a generic plan must stay on
-- the Top-K aggregate path. Plain EXPLAIN shows k as the unbound
-- `LIMIT + OFFSET` text; each EXECUTE binds its own values on the one plan.
PREPARE pdb_agg_join_param_fetch(int, int) AS
SELECT
    p.id,
    r.score,
    pdb.agg('{"avg": {"field": "score"}}'::jsonb) OVER () AS avg_score
FROM products p
JOIN product_reviews r ON p.id = r.product_id
WHERE p.description ||| 'laptop'
ORDER BY r.score DESC, r.id
LIMIT $1 OFFSET $2;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
EXECUTE pdb_agg_join_param_fetch(2, 1);
                                                                                                                           QUERY PLAN                                                                                                                            
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, r.score, (pdb.window_agg('pdb.agg(''{"avg":{"field":"score"}}'') OVER ()'::text)), r.id
   Relation Tree: p INNER r
   Join Cond: p.id = r.product_id
   Limit: $1
   Offset: $2
   Order By: r.score desc, r.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[get_field(__topk@0, c0) as col_1, get_field(__topk@0, c1) as col_2, window_agg_1@1 as col_3, get_field(__topk@0, c2) as col_4, get_field(__topk@0, c3) as ctid_0, get_field(__topk@0, c4) as ctid_1]
     :   UnnestExec
     :     AggregateExec: mode=Single, gby=[], aggr=[topk_as_agg(p_0.id, r_1.score, r_1.id, p_0.ctid_0, r_1.ctid_1, $1 + $2, [3, 4]) ORDER BY [r_1.score DESC NULLS FIRST, r_1.id ASC NULLS LAST] as __topk, pdb_agg({"avg":{"field":"score"}}) as window_agg_1]
     :       VisibilityFilterExec: tables=[p, r]
     :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, product_id@1)], projection=[id@1, score@4, id@5, ctid_0@0, ctid_1@2]
     :           CooperativeExec
     :             PgSearchScan: table=p, segments=1, query={"with_index":{"query":{"match":{"field":"description","value":"laptop","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :           CooperativeExec
     :             PgSearchScan: table=r, segments=1, dynamic_filters=1, query="all"
(17 rows)

EXECUTE pdb_agg_join_param_fetch(2, 1);
 id | score |    avg_score     
----+-------+------------------
  3 |    91 | {"value": 80.25}
  1 |    70 | {"value": 80.25}
(2 rows)

EXECUTE pdb_agg_join_param_fetch(3, 0);
 id | score |    avg_score     
----+-------+------------------
  1 |    95 | {"value": 80.25}
  3 |    91 | {"value": 80.25}
  1 |    70 | {"value": 80.25}
(3 rows)

-- The same rows as with the values written in.
SELECT
    p.id,
    r.score,
    pdb.agg('{"avg": {"field": "score"}}'::jsonb) OVER () AS avg_score
FROM products p
JOIN product_reviews r ON p.id = r.product_id
WHERE p.description ||| 'laptop'
