-- Test 27: Window function with JOIN (This is supported. Joinscan should engage)
-- Create a second table for JOIN testing
CREATE TABLE product_categories (
    name TEXT PRIMARY KEY,
    description TEXT,
    priority INTEGER
);
INSERT INTO product_categories VALUES 
('Laptops', 'Portable computing devices', 1);
CREATE INDEX product_categories_idx ON product_categories
USING paradedb ((name::pdb.simple('columnar=true')), (description::pdb.simple('columnar=true')), priority);
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT 
    p.id,
    p.name,
    p.rating,
    pc.description as category_desc,
    COUNT(*) OVER() AS total_count
FROM products p
JOIN product_categories pc ON p.category = pc.name
WHERE p.description ||| 'laptop'
ORDER BY p.rating DESC
LIMIT 3;
                                                                                                                            QUERY PLAN                                                                                                                             
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, p.name, p.rating, pc.description, (pdb.window_agg('count(*) OVER ()'::text))
   Relation Tree: p INNER pc
   Join Cond: p.category = pc.name
   Limit: 3
   Order By: p.rating desc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[NULL as col_1, NULL as col_2, get_field(__topk@0, c0) as col_3, NULL as col_4, window_agg_1@1 as col_5, get_field(__topk@0, c1) as ctid_0, get_field(__topk@0, c2) as ctid_1]
     :   GlobalLimitExec: skip=0, fetch=3
     :     UnnestExec
     :       AggregateExec: mode=Single, gby=[], aggr=[topk_as_agg(p_0.rating, p_0.ctid_0, pc_1.ctid_1, 3, [1, 2]) ORDER BY [p_0.rating DESC NULLS FIRST] as __topk, count(1) as window_agg_1]
     :         VisibilityFilterExec: tables=[p, pc]
     :           HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(name@1, category@1)], projection=[rating@4, ctid_0@2, ctid_1@0]
     :             CooperativeExec
     :               PgSearchScan: table=pc, segments=1, query="all"
     :             CooperativeExec
     :               PgSearchScan: table=p, segments=1, dynamic_filters=1, query={"with_index":{"query":{"match":{"field":"description","value":"laptop","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(17 rows)

SELECT
    p.id,
    p.name,
    p.rating,
    pc.description as category_desc,
    COUNT(*) OVER() AS total_count
FROM products p
JOIN product_categories pc ON p.category = pc.name
WHERE p.description ||| 'laptop'
ORDER BY p.rating DESC
LIMIT 3;
 id |    name     | rating |       category_desc        | total_count 
