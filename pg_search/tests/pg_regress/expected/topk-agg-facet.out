-- Prepared statement with parameterized LIMIT $1 OFFSET $2 under generic plan
BEGIN;
SET LOCAL plan_cache_mode = 'force_generic_plan';
PREPARE combine_agg_limit(int, int) AS
SELECT
    brand,
    COUNT(*) AS group_rows,
    COUNT(*) OVER () AS total_groups,
    pdb.combine_agg(pdb.agg('{"terms": {"field": "brand", "order": {"_key": "asc"}}}'::jsonb)) OVER () AS brands
FROM products
WHERE description ||| 'laptop'
GROUP BY brand
ORDER BY brand
LIMIT $1 OFFSET $2;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
EXECUTE combine_agg_limit(2, 0);
                                                                                                                                     QUERY PLAN                                                                                                                                     
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Output: brand, (count(*)), (pdb.window_agg('count(*) OVER ()'::text)), (pdb.window_agg('pdb.combine_agg(pdb.agg(''{"terms":{"field":"brand","order":{"_key":"asc"}}}'')) OVER ()'::text))
   Backend: DataFusion
   Indexes: products_idx (products)
   Group By: brand
   Aggregates: COUNT(*), COUNT(*) OVER (), pdb.combine_agg(pdb.agg({"terms":{"field":"brand","order":{"_key":"asc"}}})) OVER ()
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[get_field(__topk@0, c0) as brand, get_field(__topk@0, c1) as agg_0, win_0@1 as win_0, win_1@2 as win_1]
     :   UnnestExec
     :     AggregateExec: mode=Single, gby=[], aggr=[topk_as_agg(products_0.brand, agg_0, $1 + $2, []) ORDER BY [products_0.brand ASC NULLS LAST] as __topk, count(1) as win_0, pdb_combine_agg({"terms":{"field":"brand","order":{"_key":"asc"}}}) as win_1]
     :       AggregateExec: mode=Single, gby=[brand@0 as brand], aggr=[count(1) as agg_0, pdb_precombine_agg({"terms":{"field":"brand","order":{"_key":"asc"}}}) as precombine_1]
     :         CooperativeExec
     :           PgSearchScan: table=products, segments=1, eager=[brand], visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"laptop","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
(13 rows)

EXECUTE combine_agg_limit(2, 0);
 brand | group_rows | total_groups |                                                                                    brands                                                                                    
-------+------------+--------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 ASUS  |          1 |            4 | {"buckets": [{"key": "ASUS", "doc_count": 1}, {"key": "Apple", "doc_count": 1}, {"key": "HP", "doc_count": 1}, {"key": "Lenovo", "doc_count": 1}], "sum_other_doc_count": 0}
 Apple |          1 |            4 | {"buckets": [{"key": "ASUS", "doc_count": 1}, {"key": "Apple", "doc_count": 1}, {"key": "HP", "doc_count": 1}, {"key": "Lenovo", "doc_count": 1}], "sum_other_doc_count": 0}
(2 rows)

