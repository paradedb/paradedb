     : ProjectionExec: expr=[get_field(__topk@0, c0) as col_1, get_field(__topk@0, c1) as col_2, window_agg_1@1 as col_3, window_agg_2@2 as col_4, window_agg_3@3 as col_5, window_agg_4@4 as col_6, window_agg_5@5 as col_7, window_agg_6@6 as col_8, window_agg_7@7 as col_9, window_agg_8@8 as col_10, get_field(__topk@0, c2) as ctid_0, get_field(__topk@0, c3) as ctid_1]
