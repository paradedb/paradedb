-- Test 41b: JOIN + GROUP BY + ORDER BY + LIMIT with pdb.combine_agg(pdb.agg(...)) OVER ()
-- and SQL window aggregates over groups
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT
    p.id,
    COUNT(*) AS review_count,
    COUNT(*) OVER () AS total_product_groups,
    SUM(COUNT(*)) OVER () AS total_reviews,
    pdb.combine_agg(pdb.agg('{
        "terms": {"field": "brand", "order": {"_key": "asc"}},
        "aggs": {
            "avg_score": {"avg": {"field": "score"}}
        }
    }'::jsonb)) OVER () AS by_brand
FROM products p
JOIN product_reviews r ON p.id = r.product_id
WHERE p.description ||| 'laptop'
GROUP BY p.id
ORDER BY review_count DESC, p.id ASC
LIMIT 2;
                                                                                                                                                           QUERY PLAN                                                                                                                                                           
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Aggregate Scan)
   Output: p.id, (count(*)), (pdb.window_agg('count(*) OVER ()'::text)), (pdb.window_agg('sum(count(*)) OVER ()'::text)), (pdb.window_agg('pdb.combine_agg(pdb.agg(''{"aggs":{"avg_score":{"avg":{"field":"score"}}},"terms":{"field":"brand","order":{"_key":"asc"}}}'')) OVER ()'::text))
   Backend: DataFusion
   Indexes: products_idx (p), product_reviews_idx (r)
   Group By: id
   Aggregates: COUNT(*), COUNT(*) OVER (), SUM(COUNT(*)) OVER (), pdb.combine_agg(pdb.agg({"aggs":{"avg_score":{"avg":{"field":"score"}}},"terms":{"field":"brand","order":{"_key":"asc"}}})) OVER ()
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[get_field(__topk@0, c0) as id, get_field(__topk@0, c1) as agg_0, win_0@1 as win_0, win_1@2 as win_1, win_2@3 as win_2]
     :   UnnestExec
     :     AggregateExec: mode=Single, gby=[], aggr=[topk_as_agg(p_0.id, agg_0, 2, []) ORDER BY [agg_0 DESC NULLS FIRST, p_0.id ASC NULLS LAST] as __topk, count(1) as win_0, sum(agg_0) as win_1, pdb_combine_agg({"aggs":{"avg_score":{"avg":{"field":"score"}}},"terms":{"field":"brand","order":{"_key":"asc"}}}) as win_2]
     :       AggregateExec: mode=Single, gby=[id@0 as id], aggr=[count(1) as agg_0, pdb_precombine_agg({"aggs":{"avg_score":{"avg":{"field":"score"}}},"terms":{"field":"brand","order":{"_key":"asc"}}}) as precombine_2]
     :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@0, product_id@0)], projection=[id@0, brand@1, score@3]
     :           CooperativeExec
     :             PgSearchScan: table=p, segments=1, eager=[brand], visibility=eager, query={"with_index":{"query":{"match":{"field":"description","value":"laptop","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :           CooperativeExec
     :             PgSearchScan: table=r, segments=1, dynamic_filters=1, visibility=eager, query="all"
(16 rows)

