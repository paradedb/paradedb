 HP    |          1 |            4 | {"buckets": [{"key": "ASUS", "doc_count": 1}, {"key": "Apple", "doc_count": 1}, {"key": "HP", "doc_count": 1}, {"key": "Lenovo", "doc_count": 1}], "sum_other_doc_count": 0}
(2 rows)

EXECUTE combine_agg_limit(NULL, 0);
