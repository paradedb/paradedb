-- Test 27d: pdb.agg() as a global window function over a JOIN. JoinScan
-- computes the document as one more aggregate in its Top-K aggregate node,
-- above the SQL window aggregate. The spec reads fields of both tables.
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT
    p.id,
    r.score,
    pdb.agg('{
        "terms": {"field": "brand", "order": {"_key": "asc"}},
        "aggs": {
            "avg_score": {"avg": {"field": "score"}},
            "scores": {"terms": {"field": "score", "order": {"_key": "asc"}}}
        }
    }'::jsonb) OVER () AS by_brand,
    COUNT(*) OVER () AS total_count
FROM products p
JOIN product_reviews r ON p.id = r.product_id
WHERE p.description ||| 'laptop'
ORDER BY r.score DESC
LIMIT 3;
                                                                                                                                                                                         QUERY PLAN                                                                                                                                                                                         
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, r.score, (pdb.window_agg('pdb.agg(''{"aggs":{"scores":{"terms":{"field":"score","order":{"_key":"asc"}}},"avg_score":{"avg":{"field":"score"}}},"terms":{"field":"brand","order":{"_key":"asc"}}}'') OVER ()'::text)), (pdb.window_agg('count(*) OVER ()'::text))
   Relation Tree: p INNER r
   Join Cond: p.id = r.product_id
   Limit: 3
   Order By: r.score desc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[get_field(__topk@0, c0) as col_1, get_field(__topk@0, c1) as col_2, window_agg_1@1 as col_3, window_agg_2@2 as col_4, get_field(__topk@0, c2) as ctid_0, get_field(__topk@0, c3) as ctid_1]
     :   GlobalLimitExec: skip=0, fetch=3
     :     UnnestExec
     :       AggregateExec: mode=Single, gby=[], aggr=[topk_as_agg(p_0.id, r_1.score, p_0.ctid_0, r_1.ctid_1, 3, [2, 3]) ORDER BY [r_1.score DESC NULLS FIRST] as __topk, pdb_agg({"aggs":{"scores":{"terms":{"field":"score","order":{"_key":"asc"}}},"avg_score":{"avg":{"field":"score"}}},"terms":{"field":"brand","order":{"_key":"asc"}}}) as window_agg_1, count(1) as window_agg_2]
     :         VisibilityFilterExec: tables=[p, r]
     :           HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, product_id@1)], projection=[id@1, score@5, ctid_0@0, ctid_1@3, brand@2]
     :             CooperativeExec
     :               PgSearchScan: table=p, segments=1, eager=[brand], query={"with_index":{"query":{"match":{"field":"description","value":"laptop","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :             CooperativeExec
     :               PgSearchScan: table=r, segments=1, dynamic_filters=1, query="all"
(17 rows)

SELECT
    p.id,
    r.score,
    pdb.agg('{
        "terms": {"field": "brand", "order": {"_key": "asc"}},
        "aggs": {
            "avg_score": {"avg": {"field": "score"}},
            "scores": {"terms": {"field": "score", "order": {"_key": "asc"}}}
        }
    }'::jsonb) OVER () AS by_brand,
    COUNT(*) OVER () AS total_count
FROM products p
