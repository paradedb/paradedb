-- Test 27b: Global window function over a JOIN with fast-field join keys
-- JoinScan absorbs the empty OVER () window aggregates and computes them
-- in its DataFusion plan (issue #5637).
CREATE TABLE product_reviews (
    id SERIAL PRIMARY KEY,
    product_id INTEGER,
    content TEXT,
    score INTEGER
);
INSERT INTO product_reviews (product_id, content, score) VALUES
(1, 'Excellent build quality', 95),
(1, 'Battery could be better', 70),
(2, 'Great value ultrabook', 88),
(3, 'Keyboard is fantastic', 91),
(5, 'Runs hot under load', 65);
CREATE INDEX product_reviews_idx ON product_reviews
USING paradedb (
    id,
    product_id,
    (content::pdb.unicode_words),
    score
); 
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT
    p.id,
    p.name,
    r.score,
    COUNT(*) OVER () AS total_count,
    SUM(r.score) OVER () AS total_score,
    AVG(r.score) OVER () AS avg_score,
    MIN(r.score) OVER () AS min_score,
    MAX(r.score) OVER () AS max_score
FROM products p
JOIN product_reviews r ON p.id = r.product_id
WHERE p.description ||| 'laptop'
ORDER BY r.score DESC
LIMIT 3;
                                                                                                                                                             QUERY PLAN                                                                                                                                                             
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, p.name, r.score, (pdb.window_agg('count(*) OVER ()'::text)), (pdb.window_agg('sum(score) OVER ()'::text)), (pdb.window_agg('avg(score) OVER ()'::text)), (pdb.window_agg('min(score) OVER ()'::text)), (pdb.window_agg('max(score) OVER ()'::text))
   Relation Tree: p INNER r
   Join Cond: p.id = r.product_id
   Limit: 3
   Order By: r.score desc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[get_field(__topk@0, c0) as col_1, NULL as col_2, get_field(__topk@0, c1) as col_3, window_agg_1@1 as col_4, window_agg_2@2 as col_5, window_agg_3@3 as col_6, window_agg_4@4 as col_7, window_agg_5@5 as col_8, get_field(__topk@0, c2) as ctid_0, get_field(__topk@0, c3) as ctid_1]
     :   GlobalLimitExec: skip=0, fetch=3
     :     UnnestExec
     :       AggregateExec: mode=Single, gby=[], aggr=[topk_as_agg(p_0.id, r_1.score, p_0.ctid_0, r_1.ctid_1, 3, [2, 3]) ORDER BY [r_1.score DESC NULLS FIRST] as __topk, count(1) as window_agg_1, sum(r_1.score) as window_agg_2, avg(r_1.score) as window_agg_3, min(r_1.score) as window_agg_4, max(r_1.score) as window_agg_5]
     :         VisibilityFilterExec: tables=[p, r]
