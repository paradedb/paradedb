DEALLOCATE pdb_agg_join_param_fetch;
-- OFFSET alone parameterized: k is the static LIMIT plus the bound OFFSET.
PREPARE pdb_agg_join_param_offset(int) AS
SELECT
    p.id,
    r.score,
    pdb.agg('{"avg": {"field": "score"}}'::jsonb) OVER () AS avg_score
FROM products p
JOIN product_reviews r ON p.id = r.product_id
WHERE p.description ||| 'laptop'
ORDER BY r.score DESC, r.id
LIMIT 2 OFFSET $1;
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
EXECUTE pdb_agg_join_param_offset(1);
                                                                                                                           QUERY PLAN                                                                                                                           
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Output: p.id, r.score, (pdb.window_agg('pdb.agg(''{"avg":{"field":"score"}}'') OVER ()'::text)), r.id
   Relation Tree: p INNER r
   Join Cond: p.id = r.product_id
   Limit: 2
   Offset: $1
   Order By: r.score desc, r.id asc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[get_field(__topk@0, c0) as col_1, get_field(__topk@0, c1) as col_2, window_agg_1@1 as col_3, get_field(__topk@0, c2) as col_4, get_field(__topk@0, c3) as ctid_0, get_field(__topk@0, c4) as ctid_1]
     :   UnnestExec
     :     AggregateExec: mode=Single, gby=[], aggr=[topk_as_agg(p_0.id, r_1.score, r_1.id, p_0.ctid_0, r_1.ctid_1, 2 + $1, [3, 4]) ORDER BY [r_1.score DESC NULLS FIRST, r_1.id ASC NULLS LAST] as __topk, pdb_agg({"avg":{"field":"score"}}) as window_agg_1]
     :       VisibilityFilterExec: tables=[p, r]
     :         HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, product_id@1)], projection=[id@1, score@4, id@5, ctid_0@0, ctid_1@2]
     :           CooperativeExec
     :             PgSearchScan: table=p, segments=1, query={"with_index":{"query":{"match":{"field":"description","value":"laptop","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :           CooperativeExec
     :             PgSearchScan: table=r, segments=1, dynamic_filters=1, query="all"
(17 rows)

EXECUTE pdb_agg_join_param_offset(1);
