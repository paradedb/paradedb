-- pdb.agg() with a FILTER. The same spec without and with a filter is two
-- aggregates, and EXPLAIN shows each pdb_agg(...) call with its FILTER. Plain
-- EXPLAIN: the VERBOSE output list deparses the search operator with the index
-- OID, which changes from run to run.
EXPLAIN (COSTS OFF)
SELECT
    p.id,
    r.score,
    pdb.agg('{"avg": {"field": "score"}}'::jsonb) OVER () AS avg_score,
    pdb.agg('{"avg": {"field": "score"}}'::jsonb) FILTER (WHERE r.score > 80) OVER () AS high_avg_score,
    pdb.agg('{"value_count": {"field": "score"}}'::jsonb) FILTER (WHERE p.description ||| 'gaming') OVER () AS gaming_reviews
FROM products p
JOIN product_reviews r ON p.id = r.product_id
WHERE p.description ||| 'laptop'
ORDER BY r.score DESC
LIMIT 3;
                                                                                                                                                                                                                QUERY PLAN                                                                                                                                                                                                                 
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: p INNER r
   Join Cond: p.id = r.product_id
   Limit: 3
   Order By: r.score desc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[get_field(__topk@0, c0) as col_1, get_field(__topk@0, c1) as col_2, window_agg_1@1 as col_3, window_agg_2@2 as col_4, window_agg_3@3 as col_5, get_field(__topk@0, c2) as ctid_0, get_field(__topk@0, c3) as ctid_1]
     :   GlobalLimitExec: skip=0, fetch=3
     :     UnnestExec
     :       AggregateExec: mode=Single, gby=[], aggr=[topk_as_agg(p_0.id, r_1.score, p_0.ctid_0, r_1.ctid_1, 3, [2, 3]) ORDER BY [r_1.score DESC NULLS FIRST] as __topk, pdb_agg({"avg":{"field":"score"}}) as window_agg_1, pdb_agg({"avg":{"field":"score"}}) FILTER (WHERE r_1.score > Int64(80)) as window_agg_2, pdb_agg({"value_count":{"field":"score"}}) FILTER (WHERE p_0.__p_0_tag_0) as window_agg_3]
     :         VisibilityFilterExec: tables=[p, r]
     :           ProjectionExec: expr=[CAST(score@0 AS Float64) as __common_expr_1, id@1 as id, score@0 as score, ctid_0@2 as ctid_0, ctid_1@3 as ctid_1, __p_0_tag_0@4 as __p_0_tag_0]
     :             HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, product_id@1)], projection=[score@5, id@1, ctid_0@0, ctid_1@3, __p_0_tag_0@2]
     :               CooperativeExec
     :                 PgSearchScan: table=p, segments=1, query={"with_index":{"query":{"match":{"field":"description","value":"laptop","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}, tag_0={"with_index":{"query":{"match":{"field":"description","value":"gaming","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}}
     :               CooperativeExec
     :                 PgSearchScan: table=r, segments=1, dynamic_filters=1, query="all"
(17 rows)

SELECT
    p.id,
    r.score,
    pdb.agg('{"avg": {"field": "score"}}'::jsonb) OVER () AS avg_score,
    pdb.agg('{"avg": {"field": "score"}}'::jsonb) FILTER (WHERE r.score > 80) OVER () AS high_avg_score,
    pdb.agg('{"value_count": {"field": "score"}}'::jsonb) FILTER (WHERE p.description ||| 'gaming') OVER () AS gaming_reviews
FROM products p
