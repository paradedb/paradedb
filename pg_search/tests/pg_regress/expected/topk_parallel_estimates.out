-- ============================================================================
-- The rare phrase stays serial. Its posting lists are short, so workers would only add startup.
-- The floor keeps the estimate honest, it does not push every phrase to parallel.
-- ============================================================================
EXPLAIN (COSTS OFF, VERBOSE, TIMING OFF)
SELECT id, body FROM logs
WHERE body @@@ '"crashed while writing the audit ledger"'
ORDER BY pdb.score(id) DESC, id LIMIT 5;
                                                                                        QUERY PLAN                                                                                        
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: id, body, (pdb.score(id))
   ->  Custom Scan (ParadeDB Base Scan) on public.logs
         Output: id, body, pdb.score(id)
         Table: logs
         Index: logs_idx
         Worker Selection: Cost model
         Exec Method: TopKScanExecState
         Scores: true
            TopK Order By: pdb.score() desc, id asc
            TopK Limit: 5
         Tantivy Query: {"with_index":{"query":{"parse_with_field":{"field":"body","query_string":"\"crashed while writing the audit ledger\"","lenient":null,"conjunction_mode":null}}}}
(12 rows)

SELECT id, body FROM logs
WHERE body @@@ '"crashed while writing the audit ledger"'
ORDER BY pdb.score(id) DESC, id LIMIT 5;
