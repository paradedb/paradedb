\i common/common_setup.sql
CREATE EXTENSION IF NOT EXISTS pg_search;
-- Disable parallel workers to avoid differences in plans
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan to OFF;
SET paradedb.enable_columnar_exec = true;
CALL paradedb.create_paradedb_test_table(
  schema_name => 'public',
  table_name => 'mock_items'
);
CREATE INDEX search_idx on mock_items
USING paradedb (id, description, rating, (category::pdb.literal), (metadata::pdb.literal_normalized('lowercase=true')));
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT id, description, rating, pdb.score(id) FROM mock_items
WHERE description ||| 'keyboard' OR description ||| 'shoes' AND rating > 2
ORDER BY rating DESC
LIMIT 5;
                                                                                                                                                                                                                                                        QUERY PLAN                                                                                                                                                                                                                                                        
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Custom Scan (ParadeDB Base Scan) on mock_items
         Table: mock_items
         Index: search_idx
         Exec Method: TopKScanExecState
         Scores: true
            TopK Order By: rating desc
            TopK Limit: 5
         Tantivy Query: {"boolean":{"should":[{"with_index":{"query":{"match":{"field":"description","value":"keyboard","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}},{"boolean":{"must":[{"with_index":{"query":{"match":{"field":"description","value":"shoes","tokenizer":null,"distance":null,"transposition_cost_one":null,"prefix":null,"conjunction_mode":false}}}},{"range":{"field":"rating","lower_bound":{"excluded":2},"upper_bound":null}}]}}]}}
(9 rows)

SELECT id, description, rating, pdb.score(id) FROM mock_items
WHERE description ||| 'keyboard' OR description ||| 'shoes' AND rating > 2
ORDER BY rating DESC
LIMIT 5;
 id |       description        | rating |   score   
----+--------------------------+--------+-----------
  3 | Sleek running shoes      |      5 | 3.4849067
  5 | Generic shoes            |      4 | 3.8772602
  2 | Plastic Keyboard         |      4 | 3.2668595
  1 | Ergonomic metal keyboard |      4 | 2.8213787
  4 | White jogging shoes      |      3 | 3.4849067
(5 rows)

