-- Check V1 diagnostics before planner rewrites.
\set VERBOSITY default
\pset format unaligned
SET paradedb.planner_warnings = 'off';
SHOW paradedb.v1api_warnings;
paradedb.v1api_warnings
Warning
(1 row)
CREATE TABLE v1_api_items (id integer PRIMARY KEY, body text);
INSERT INTO v1_api_items VALUES (1, 'running shoes'), (2, 'walking boots');
CREATE INDEX v1_api_idx ON v1_api_items USING bm25 (id, body)
WITH (key_field = 'id', text_fields = '{"body": {"tokenizer": {"type": "default"}}}');
WARNING:  USING bm25 uses the deprecated ParadeDB V1 API
HINT:  Use USING paradedb.
WARNING:  key_field uses the deprecated ParadeDB V1 API
HINT:  Remove key_field and put the indexed key column first in the CREATE INDEX column list.
WARNING:  text_fields uses the deprecated ParadeDB V1 API
HINT:  Configure text columns using tokenizer casts, such as field::pdb.simple. Use alias and columnar for aliases and columnar storage. Custom stopword lists and arbitrary record modes have no direct V2 equivalent. To request V2 support, open a GitHub issue with your SQL and index definition at https://github.com/paradedb/paradedb/issues/new?template=feature_request.yml
SELECT id, pdb.score(id) = paradedb.score(id) AS same_score,
       paradedb.snippet(body) AS snippet
FROM v1_api_items WHERE id @@@ paradedb.term('body', 'shoes');
WARNING:  paradedb.score() uses the deprecated ParadeDB V1 API
HINT:  Use pdb.score(...) with the same arguments.
WARNING:  paradedb.snippet() uses the deprecated ParadeDB V1 API
HINT:  Use pdb.snippet(...) with the same arguments. For multiple snippets, use pdb.snippets(...).
WARNING:  paradedb.term() uses the deprecated ParadeDB V1 API
HINT:  Use field @@@ pdb.term(value), or use field === value for text tokens.
id|same_score|snippet
1|t|running <b>shoes</b>
(1 row)
WITH matches AS (
    SELECT id FROM v1_api_items WHERE body @@@ pdb.match('shoes')
)
SELECT id FROM matches;
id
1
(1 row)
SELECT id FROM v1_api_items WHERE id @@@ paradedb.term_with_operator('body', '=', 'shoes'::text);
WARNING:  paradedb.term_with_operator() uses the deprecated ParadeDB V1 API
HINT:  Use SQL operators for column-value comparisons. To match an indexed text token, use field @@@ pdb.term(value).
id
