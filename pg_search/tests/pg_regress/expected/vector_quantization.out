RESET paradedb.max_scan_levels;
RESET paradedb.vector_cluster_max_probe;
RESET paradedb.vector_clustering_threshold;
DROP TABLE q_cosine;
DROP TABLE q_l2;
DROP TABLE q_odd;
DROP FUNCTION quant_explain(text);
DROP FUNCTION quant_fixture_vector(integer, integer);
