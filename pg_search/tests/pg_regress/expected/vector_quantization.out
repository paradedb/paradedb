(1 row)

SELECT quantized.ids = exact.ids AS odd_recall_at_10_is_one
FROM q_odd_quantized quantized
CROSS JOIN LATERAL (
    SELECT array_agg(id) AS ids
    FROM (
        SELECT id
        FROM q_odd
        WHERE id @@@ pdb.all()
        ORDER BY vec <-> quant_fixture_vector(100, 0), id
        LIMIT 10
    ) hits
) exact;
