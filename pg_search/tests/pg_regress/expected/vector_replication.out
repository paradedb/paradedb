SET client_min_messages = WARNING;
CREATE EXTENSION IF NOT EXISTS vector;
\i common/common_setup.sql
CREATE EXTENSION IF NOT EXISTS pg_search;
-- Disable parallel workers to avoid differences in plans
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan to OFF;
SET paradedb.enable_columnar_exec = true;
-- Every assertion compares one build with another or reads a count the option fixes, never a
-- cluster count or a partial probe, so none depends on how a build clustered. One process
-- builds each index; the probe budget covers every cluster and adaptive stopping is off, so
-- a full-probe query scores every row.
SET max_parallel_maintenance_workers = 0;
SET paradedb.vector_adaptive_probing = off;
SET paradedb.vector_clustering_threshold = 64;
SET paradedb.vector_cluster_max_probe = 100000;
SET paradedb.vector_stats = on;
CREATE FUNCTION replication_fixture_vector(d integer, n integer)
RETURNS vector
LANGUAGE SQL IMMUTABLE PARALLEL SAFE
AS $$
    SELECT (
        '[' || string_agg(
            (((hashtextextended(n::text || ':' || i::text, 81985529216486895) & 1048575)
                / 524287.5) - 1.0)::text,
            ',' ORDER BY i
        ) || ']'
    )::vector
    FROM generate_series(1, d) i
$$;
CREATE FUNCTION replication_explain(query_text text)
RETURNS jsonb
LANGUAGE plpgsql
AS $$
DECLARE
    plan jsonb;
BEGIN
    EXECUTE 'EXPLAIN (ANALYZE, VERBOSE, COSTS OFF, TIMING OFF, BUFFERS ON, SUMMARY OFF, FORMAT JSON) '
        || query_text
        INTO plan;
    RETURN plan;
END
$$;
-- Two copies of one table, indexed with identical options but the replication.
-- target_leaf_size = 10 gives this fixture at least 4 clusters, so routed and located queries
-- both open several.
CREATE TABLE replication_on (id integer PRIMARY KEY, emb vector(768));
INSERT INTO replication_on SELECT g, replication_fixture_vector(768, g) FROM generate_series(1, 200) g;
CREATE TABLE replication_off AS SELECT * FROM replication_on;
ALTER TABLE replication_off ADD PRIMARY KEY (id);
CREATE INDEX replication_on_idx ON replication_on
USING paradedb (id, emb vector_cosine_ops)
WITH (quantization = '[1,1]', target_segment_count = 1, target_leaf_size = 10, replication = 2);
CREATE INDEX replication_off_idx ON replication_off
USING paradedb (id, emb vector_cosine_ops)
WITH (quantization = '[1,1]', target_segment_count = 1, target_leaf_size = 10, replication = 1);
-- 1. The option took: a replicated index holds two rows per vector, an unreplicated one one.
SELECT bool_and(vector_format = 'ivf' AND quantized AND vector_total_rows = 2 * vector_num_vectors)
    AS replicated_two_rows_per_vector
FROM paradedb.vector_info('replication_on_idx', 'emb');
 replicated_two_rows_per_vector 
--------------------------------
 t
(1 row)

SELECT bool_and(vector_total_rows = vector_num_vectors) AS unreplicated_one_row_per_vector
FROM paradedb.vector_info('replication_off_idx', 'emb');
 unreplicated_one_row_per_vector 
---------------------------------
 t
(1 row)

-- 2. At full probe replication changes no result: the same top-10 set for three query vectors.
SELECT q,
       (SELECT array_agg(id ORDER BY id) FROM (
            SELECT id FROM replication_on WHERE id @@@ pdb.all()
            ORDER BY emb <=> replication_fixture_vector(768, q), id LIMIT 10) s)
     = (SELECT array_agg(id ORDER BY id) FROM (
            SELECT id FROM replication_off WHERE id @@@ pdb.all()
            ORDER BY emb <=> replication_fixture_vector(768, q), id LIMIT 10) s)
        AS same_top10
FROM (VALUES (0), (7), (1000)) AS queries (q)
ORDER BY q;
  q   | same_top10 
------+------------
    0 | t
    7 | t
 1000 | t
(3 rows)

-- 3. A filter matching 5% of the rows takes the located path on the replicated index, which holds
-- one primary row per document: it drops nothing and returns the unreplicated index's ids.
WITH plan AS (
    SELECT replication_explain(
        'SELECT id FROM replication_on '
        'WHERE id @@@ paradedb.range(''id'', int4range(1, 11, ''[)'')) '
        'ORDER BY emb <=> replication_fixture_vector(768, 0), id LIMIT 10'
    ) AS value
), segment_info AS (
    SELECT (jsonb_path_query_first(value, '$.**."Segment Info"') #>> '{}')::jsonb AS value
    FROM plan
)
SELECT
    (jsonb_path_query_first(value, '$.**.access_path') #>> '{}') = 'Located' AS located,
    (jsonb_path_query_first(value, '$.**.replication_dropped') #>> '{}')::bigint = 0 AS nothing_dropped
FROM segment_info;
 located | nothing_dropped 
---------+-----------------
 t       | t
(1 row)

SELECT (SELECT array_agg(id ORDER BY id) FROM (
            SELECT id FROM replication_on
            WHERE id @@@ paradedb.range('id', int4range(1, 11, '[)'))
            ORDER BY emb <=> replication_fixture_vector(768, 0), id LIMIT 10) s)
     = (SELECT array_agg(id ORDER BY id) FROM (
            SELECT id FROM replication_off
            WHERE id @@@ paradedb.range('id', int4range(1, 11, '[)'))
            ORDER BY emb <=> replication_fixture_vector(768, 0), id LIMIT 10) s)
        AS located_same_ids;
 located_same_ids 
------------------
 t
(1 row)

-- 4. The option round-trips through REINDEX.
ALTER INDEX replication_on_idx SET (replication = 1);
REINDEX INDEX replication_on_idx;
SELECT bool_and(vector_total_rows = vector_num_vectors) AS one_row_per_vector
FROM paradedb.vector_info('replication_on_idx', 'emb');
 one_row_per_vector 
--------------------
 t
(1 row)

ALTER INDEX replication_on_idx SET (replication = 2);
REINDEX INDEX replication_on_idx;
SELECT bool_and(vector_total_rows = 2 * vector_num_vectors) AS two_rows_per_vector
FROM paradedb.vector_info('replication_on_idx', 'emb');
 two_rows_per_vector 
---------------------
 t
(1 row)

DROP TABLE replication_off;
DROP TABLE replication_on;
DROP FUNCTION replication_explain(text);
DROP FUNCTION replication_fixture_vector(integer, integer);
