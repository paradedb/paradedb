-- Inner join (`JOIN`) under HashJoinExec (Regime 2), projecting distance and tie-breaker `DESC`
EXPLAIN (FORMAT TEXT, COSTS OFF, TIMING OFF)
SELECT c.id, c.parent_id, p.category, round((c.vec <=> '[1,0,0]'::vector)::numeric, 4) AS dist
FROM vsp_children c
JOIN vsp_parents p ON p.id = c.parent_id
WHERE c.id @@@ pdb.all()
  AND p.id @@@ pdb.all()
  AND p.category = ANY('{alpha}')
  AND (p.metadata->>'score')::float8 BETWEEN 20 AND 30
ORDER BY c.vec <=> '[1,0,0]'::vector, c.id DESC
LIMIT 2;
                                                                                                                                                                                  QUERY PLAN                                                                                                                                                                                   
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Custom Scan (ParadeDB Join Scan)
   Relation Tree: c INNER p
   Join Cond: p.id = c.parent_id
   Limit: 2
   Order By: vec <=> vector asc, c.id desc
   DataFusion Physical Plan: 
     : ProjectionExec: expr=[id@3 as col_1, parent_id@1 as col_2, NULL as col_3, NULL as col_4, NULL as col_5, ctid_0@0 as ctid_0, ctid_1@4 as ctid_1]
     :   GlobalLimitExec: skip=0, fetch=2
     :     VisibilityFilterExec: tables=[c, p]
     :       HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(id@1, parent_id@1)], projection=[ctid_0@2, parent_id@3, pdb.vector_score(c)@4, id@5, ctid_1@0]
     :         CooperativeExec
     :           PgSearchScan: table=p, segments=1, query={"boolean":{"must":[{"with_index":{"query":{"all":{"field":"id"}}}},{"term_set":{"terms":[{"field":"category","value":"alpha"}]}},{"range":{"field":"metadata.score","lower_bound":{"included":20.0},"upper_bound":null}},{"range":{"field":"metadata.score","lower_bound":null,"upper_bound":{"included":30.0}}}]}}
     :         CooperativeExec
     :           PgSearchScan: table=c, segments=1, lazy_sort=4, dynamic_filters=1, query={"with_index":{"query":{"all":{"field":"id"}}}}
(14 rows)

