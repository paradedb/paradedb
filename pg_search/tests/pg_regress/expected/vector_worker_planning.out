SET client_min_messages = WARNING;
CREATE EXTENSION IF NOT EXISTS vector;
\i common/common_setup.sql
CREATE EXTENSION IF NOT EXISTS pg_search;
-- Disable parallel workers to avoid differences in plans
SET max_parallel_workers_per_gather = 0;
SET enable_indexscan to OFF;
SET paradedb.enable_columnar_exec = true;
SET max_parallel_workers_per_gather = 2;
SET max_parallel_workers = 8;
SET parallel_setup_cost = 1000;
SET parallel_tuple_cost = 0.1;
SET parallel_leader_participation = on;
SET plan_cache_mode = force_generic_plan;
SET paradedb.global_mutable_segment_rows = 0;
CREATE TABLE vector_worker_docs (id int PRIMARY KEY, body text, embedding vector(3));
CREATE INDEX vector_worker_idx ON vector_worker_docs USING paradedb
    (id, body, embedding vector_l2_ops)
    WITH (mutable_segment_rows = 0, layer_sizes = '10TB', background_layer_sizes = '10TB');
INSERT INTO vector_worker_docs
SELECT i, CASE WHEN i % 2 = 0 THEN 'river' ELSE 'canal' END, ARRAY[i::real, 1, 0]::vector
FROM generate_series(1, 500) i;
INSERT INTO vector_worker_docs
SELECT i, CASE WHEN i % 2 = 0 THEN 'river' ELSE 'canal' END, ARRAY[i::real, 1, 0]::vector
FROM generate_series(501, 1000) i;
INSERT INTO vector_worker_docs
SELECT i, CASE WHEN i % 2 = 0 THEN 'river' ELSE 'canal' END, ARRAY[i::real, 1, 0]::vector
FROM generate_series(1001, 1500) i;
INSERT INTO vector_worker_docs
SELECT i, CASE WHEN i % 2 = 0 THEN 'river' ELSE 'canal' END, ARRAY[i::real, 1, 0]::vector
FROM generate_series(1501, 2000) i;
ANALYZE vector_worker_docs;
SET vector_worker.term = 'canal';
SET vector_worker.qvec = '[0,1,0]';
PREPARE vector_worker_query(vector) AS
SELECT id FROM vector_worker_docs
WHERE body @@@ current_setting('vector_worker.term')
ORDER BY embedding <-> $1 LIMIT 3;
PREPARE vector_worker_param_query(text, vector) AS
SELECT id FROM vector_worker_docs WHERE body @@@ $1
ORDER BY embedding <-> $2 LIMIT 3;
-- Runtime vector filters retain per-segment parallelism, including generic plans.
DO $$
DECLARE
    query text;
    plan jsonb;
BEGIN
    FOREACH query IN ARRAY ARRAY[
        $q$SELECT id FROM vector_worker_docs WHERE body @@@ current_setting('vector_worker.term') ORDER BY embedding <-> '[0,1,0]' LIMIT 3$q$,
        $q$SELECT id FROM vector_worker_docs WHERE body @@@ current_setting('vector_worker.term') ORDER BY embedding <-> current_setting('vector_worker.qvec')::vector(3) LIMIT 3$q$,
        $q$EXECUTE vector_worker_query('[0,1,0]')$q$,
        $q$EXECUTE vector_worker_param_query('canal', '[0,1,0]')$q$
    ] LOOP
        EXECUTE 'EXPLAIN (VERBOSE, FORMAT JSON) ' || query INTO plan;
        ASSERT (jsonb_path_query_first(plan, '$.**."Workers Planned"') #>> '{}')::int = 2, plan::text;
        ASSERT jsonb_path_query_first(plan, '$.**."Worker Selection"') #>> '{}' = 'Per-segment', plan::text;
    END LOOP;

    EXECUTE $q$EXPLAIN (VERBOSE, FORMAT JSON) SELECT id FROM vector_worker_docs
        WHERE body @@@ 'canal' ORDER BY embedding <-> '[0,1,0]' LIMIT 3$q$ INTO plan;
    ASSERT jsonb_path_query_first(plan, '$.**."Workers Planned"') IS NULL, plan::text;
    ASSERT jsonb_path_query_first(plan, '$.**."Worker Selection"') #>> '{}' LIKE 'Cost model%', plan::text;

    EXECUTE $q$EXPLAIN (VERBOSE, FORMAT JSON) SELECT id FROM vector_worker_docs
        WHERE body @@@ current_setting('vector_worker.term') ORDER BY id LIMIT 3$q$ INTO plan;
    ASSERT jsonb_path_query_first(plan, '$.**."Workers Planned"') IS NULL, plan::text;
    ASSERT jsonb_path_query_first(plan, '$.**."Worker Selection"') #>> '{}' LIKE 'Cost model%', plan::text;
END
$$;
-- Reuse the generic plan after changing the STABLE filter's value.
EXECUTE vector_worker_query('[0,1,0]');
 id 
----
  1
  3
  5
(3 rows)

SET vector_worker.term = 'river';
EXECUTE vector_worker_query('[0,1,0]');
 id 
----
  2
  4
  6
(3 rows)

SELECT generic_plans >= 2 AND custom_plans = 0 AS reused_generic_plan
FROM pg_prepared_statements WHERE name = 'vector_worker_query';
 reused_generic_plan 
---------------------
 t
(1 row)

DO $$
DECLARE
    workers int;
    expected_workers int;
    plan jsonb;
BEGIN
    FOR workers, expected_workers IN VALUES (7, 3), (1, 1), (0, 0) LOOP
        PERFORM set_config('max_parallel_workers_per_gather', workers::text, false);
        EXECUTE 'DISCARD PLANS';
        EXECUTE $q$EXPLAIN (VERBOSE, FORMAT JSON) EXECUTE vector_worker_query('[0,1,0]')$q$ INTO plan;
        ASSERT COALESCE((jsonb_path_query_first(plan, '$.**."Workers Planned"') #>> '{}')::int, 0) = expected_workers, plan::text;
    END LOOP;
END
$$;
EXECUTE vector_worker_query('[0,1,0]');
 id 
----
  2
  4
  6
(3 rows)

SET max_parallel_workers_per_gather = 2;
DO $$
DECLARE
    plan jsonb;
BEGIN
    EXECUTE $q$EXPLAIN (VERBOSE, FORMAT JSON)
        SELECT matches.id FROM (VALUES ('canal'), ('river')) AS terms(term)
        CROSS JOIN LATERAL (
            SELECT id FROM vector_worker_docs WHERE body @@@ terms.term
            ORDER BY embedding <-> '[0,1,0]' LIMIT 1
        ) AS matches$q$ INTO plan;
    ASSERT jsonb_path_query_first(plan, '$.**."Workers Planned"') IS NULL, plan::text;
END
$$;
CREATE TABLE vector_worker_single AS TABLE vector_worker_docs;
CREATE INDEX vector_worker_single_idx ON vector_worker_single USING paradedb
    (id, body, embedding vector_l2_ops) WITH (target_segment_count = 1);
ANALYZE vector_worker_single;
SET max_parallel_workers_per_gather = 2;
DO $$
DECLARE
    plan jsonb;
BEGIN
    EXECUTE $q$EXPLAIN (VERBOSE, FORMAT JSON) SELECT id FROM vector_worker_single
        WHERE body @@@ current_setting('vector_worker.term')
        ORDER BY embedding <-> '[0,1,0]' LIMIT 3$q$ INTO plan;
    ASSERT jsonb_path_query_first(plan, '$.**."Workers Planned"') IS NULL, plan::text;
END
$$;
DEALLOCATE vector_worker_query;
DEALLOCATE vector_worker_param_query;
DROP TABLE vector_worker_single;
DROP TABLE vector_worker_docs;
RESET vector_worker.term;
RESET vector_worker.qvec;
RESET paradedb.global_mutable_segment_rows;
RESET plan_cache_mode;
RESET parallel_tuple_cost;
RESET parallel_setup_cost;
RESET parallel_leader_participation;
RESET max_parallel_workers;
RESET max_parallel_workers_per_gather;
